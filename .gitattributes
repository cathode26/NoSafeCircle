# Raw Unity logs are machine evidence; new logs are normalized upstream.
Pipeline/TaskGraph/evidence/**/artifacts/*.log -whitespace

# Delivery/validation manifest JSON is machine-generated evidence, never hand-edited.
# Every line of a newly-committed manifest reads as "trailing whitespace" to git's own
# whitespace check under core.autocrlf=true, because the whole file is new in the diff -
# reproduced on the very commit that introduced NSC-124's manifest, against its own
# immediate parent, with no other change in the range. -whitespace suppresses the false
# positive the same way the sibling .log rule above already does.
Pipeline/TaskGraph/evidence/**/artifacts/*.json -whitespace

# Preserve vendored distribution bytes, including their original line endings.
# The upstream files contain intentional whitespace that we do not edit.
Assets/Plugins/Demigiant/DOTween/** -text -whitespace
Assets/Plugins/Demigiant/DOTween.meta -text -whitespace
Assets/Plugins/deVoid/Signals/Signals.cs -text -whitespace
Assets/Plugins/deVoid/Signals/LICENSE.txt -text -whitespace

# Pinned art-conformance inventory blobs (CRLF as authored 09-17, not real trailing
# whitespace -- git's whitespace check reads CR-at-EOL identically to blank-at-eol).
# NSC-065's delivery record and contract hash gates hash these committed bytes, so
# do not normalize line endings; that would change every pinned hash. Confirmed by
# the Art Director Agent 2026-09-23: zero lines with real trailing space in any of
# these six files.
Assets/NoSafeCircle/DoorPrototype/Art/Enemies/Source/Death/death-inventory.json -text -whitespace
Assets/NoSafeCircle/DoorPrototype/Art/Environment/Props/PropCatalog.json -text -whitespace
Assets/NoSafeCircle/DoorPrototype/Art/Environment/Props/Source/architecture_inventory.json -text -whitespace
Assets/NoSafeCircle/DoorPrototype/Art/Environment/Props/Source/furnishings_inventory.json -text -whitespace
Assets/NoSafeCircle/DoorPrototype/Art/Environment/Props/Source/hazard_route_inventory.json -text -whitespace
Assets/NoSafeCircle/DoorPrototype/Art/Spells/Fireball/Source/source-inventory.json -text -whitespace

# Preserve imported historical evidence and original host guidance byte-for-byte.
Docs/AI-Pipeline/Historical-Context-Sessions/reports/untracked-project-outputs-20260920/** -text -whitespace
Docs/AI-Pipeline/Agent-Operations/host-guides/originals/** -text -whitespace

# Exact historical bytes from the authored-guides and durable-reports import.
Docs/AI-Pipeline/Agent-Operations/host-documents-20260920/originals/** -text -whitespace
