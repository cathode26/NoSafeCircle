{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "revised"
      ]
    },
    "content_id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "addressed_rule_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^NSC-(TONE|CANON|MECH|FORMAT)-[0-9]{2}$"
      }
    },
    "changes_made": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "status",
    "content_id",
    "label",
    "text",
    "addressed_rule_ids",
    "changes_made",
    "reason"
  ]
}
