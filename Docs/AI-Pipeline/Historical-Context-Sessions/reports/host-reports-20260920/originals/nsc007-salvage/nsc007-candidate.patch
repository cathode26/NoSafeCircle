+        public static void SetMouse(Mouse mouseDevice, Vector2 screenPosition, bool rightButtonPressed)
+        {
+            InputSystem.QueueStateEvent(mouseDevice, new MouseState
+            {
+                position = screenPosition,
+                buttons = rightButtonPressed ? (ushort)(1 << (int)MouseButton.Right) : (ushort)0
+            });
+            InputSystem.Update();
+        }
+
+        public static void AdvanceTime(System.Action<float> tick, float totalSeconds, float step)
+        {
+            var elapsed = 0f;
+            while (elapsed < totalSeconds)
+            {
+                float dt = Mathf.Min(step, totalSeconds - elapsed);
+                tick(dt);
+                elapsed += dt;
+            }
+        }
+
+        public static float FlatDistance(Vector3 a, Vector3 b)
+        {
+            Vector3 offset = a - b;
+            offset.y = 0f;
+            return offset.magnitude;
+        }
