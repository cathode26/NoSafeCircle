+using UnityEngine;
+
+namespace NoSafeCircle.DoorPrototype
+{
+    /// One runtime-created in-flight shot, owned and Tick-driven entirely by the Fireball that
+    /// spawned it (AC-001). Flies in a straight line at chest height until it detonates on
+    /// contact (AC-007) or reaches its lifetime, at which point it fizzles in place with no
+    /// damage. Owns its own placeholder visual/material.
+    public sealed class FireballProjectile : MonoBehaviour
+    {
+        private Vector3 direction;
+        private float speed;
+        private float remainingLifetime;
+        private float damage;
+        private float impactRadius;
+        private bool hasAreaDamage;
+        private CharacterController wizardController;
+        private Material ownedMaterial;
+
+        public bool IsFinished { get; private set; }
+
+        public void Initialize(
+            Vector3 direction,
+            float speed,
+            float lifetime,
+            float damage,
+            float impactRadius,
+            bool hasAreaDamage,
+            CharacterController wizardController,
+            Color placeholderColor)
+        {
+            this.direction = direction;
+            this.speed = speed;
+            remainingLifetime = lifetime;
+            this.damage = damage;
+            this.impactRadius = impactRadius;
+            this.hasAreaDamage = hasAreaDamage;
+            this.wizardController = wizardController;
+
+            CreateVisual(placeholderColor);
+        }
+
+        private void CreateVisual(Color placeholderColor)
+        {
+            var visual = GameObject.CreatePrimitive(PrimitiveType.Sphere);
+            visual.name = "Visual";
+            Destroy(visual.GetComponent<Collider>());
+            visual.transform.SetParent(transform, false);
+            visual.transform.localScale = Vector3.one * 0.5f;
+
+            Renderer renderer = visual.GetComponent<Renderer>();
+            if (renderer == null) return;
+
+            ownedMaterial = renderer.material;
+            ownedMaterial.color = placeholderColor;
+        }
+
+        /// Advances flight by deltaTime. Called from the owning Fireball's own Tick so tests can
+        /// drive projectile flight deterministically instead of waiting on real frames.
+        public void Tick(float deltaTime)
+        {
+            if (IsFinished) return;
+
+            Vector3 previousPosition = transform.position;
+            Vector3 nextPosition = previousPosition + direction * (speed * deltaTime);
+
+            if (IsBlockedByCollider(previousPosition, nextPosition, out Vector3 blockedContactPoint))
+            {
+                DetonateOnCollider(blockedContactPoint);
+                return;
+            }
+
+            transform.position = nextPosition;
+            remainingLifetime -= deltaTime;
+
+            EnemyHealth hitEnemy = FindContactEnemy(nextPosition);
+            if (hitEnemy != null)
+            {
+                DetonateOnEnemy(nextPosition, hitEnemy);
+                return;
+            }
+
+            if (remainingLifetime <= 0f)
+            {
+                Finish();
+            }
+        }
+
+        private void DetonateOnEnemy(Vector3 detonationPoint, EnemyHealth hitEnemy)
+        {
+            hitEnemy.TakeDamage(damage);
+
+            if (hasAreaDamage)
+            {
+                ApplyAreaDamage(detonationPoint, hitEnemy);
+            }
+
+            Finish();
+        }
+
+        /// AC-007: a detonation against a blocking collider (wall/door) still splashes every
+        /// unobstructed enemy within impactRadius exactly like a direct enemy hit, just with no
+        /// directly-hit enemy to exclude.
+        private void DetonateOnCollider(Vector3 detonationPoint)
+        {
+            if (hasAreaDamage)
+            {
+                ApplyAreaDamage(detonationPoint, excludedEnemy: null);
+            }
+
+            Finish();
+        }
+
+        /// AC-007: every other active, non-defeated enemy within impactRadius of the detonation
+        /// point that has an unobstructed line takes damage once; the already-hit enemy is
+        /// excluded so it is never damaged twice by the same cast.
+        private void ApplyAreaDamage(Vector3 detonationPoint, EnemyHealth excludedEnemy)
+        {
+            foreach (EnemyHealth enemy in FindObjectsByType<EnemyHealth>(FindObjectsSortMode.None))
+            {
+                if (enemy == null || enemy == excludedEnemy || enemy.IsDefeated) continue;
+
+                if (FlatDistance(enemy.transform.position, detonationPoint) > impactRadius) continue;
+                if (!HasUnobstructedLine(detonationPoint, enemy.transform.position)) continue;
+
+                enemy.TakeDamage(damage);
+            }
+        }
+
+        private EnemyHealth FindContactEnemy(Vector3 position)
+        {
+            EnemyHealth closest = null;
+            float closestDistance = float.MaxValue;
+
+            foreach (EnemyHealth enemy in FindObjectsByType<EnemyHealth>(FindObjectsSortMode.None))
+            {
+                if (enemy == null || enemy.IsDefeated) continue;
+
+                float distance = FlatDistance(enemy.transform.position, position);
+                if (distance > impactRadius || distance >= closestDistance) continue;
+
+                closestDistance = distance;
+                closest = enemy;
+            }
+
+            return closest;
+        }
+
+        private static float FlatDistance(Vector3 a, Vector3 b)
+        {
+            Vector3 offset = a - b;
+            offset.y = 0f;
+            return offset.magnitude;
+        }
+
+        /// AC-007: chest-height raycast against non-trigger colliders on the default layer mask,
+        /// the same query EnemyLanternWispCaster.HasUnobstructedViewOfWizard already uses, ignoring
+        /// the wizard's own CharacterController and this projectile's own (collider-free) visual.
+        private bool IsBlockedByCollider(Vector3 from, Vector3 to, out Vector3 contactPoint)
+        {
+            contactPoint = to;
+
+            Vector3 offset = to - from;
+            float distance = offset.magnitude;
+            if (distance <= 0f) return false;
+
+            if (!Physics.Raycast(from, offset / distance, out RaycastHit hit, distance,
+                    Physics.DefaultRaycastLayers, QueryTriggerInteraction.Ignore))
+            {
+                return false;
+            }
+
+            if (IsIgnoredCollider(hit.transform)) return false;
+
+            contactPoint = hit.point;
+            return true;
+        }
+
+        private bool HasUnobstructedLine(Vector3 detonationPoint, Vector3 enemyPosition)
+        {
+            Vector3 eyeTarget = enemyPosition + Vector3.up;
+            Vector3 offset = eyeTarget - detonationPoint;
+            float distance = offset.magnitude;
+            if (distance <= 0.01f) return true;
+
+            if (!Physics.Raycast(detonationPoint, offset / distance, out RaycastHit hit, distance,
+                    Physics.DefaultRaycastLayers, QueryTriggerInteraction.Ignore))
+            {
+                return true;
+            }
+
+            return IsIgnoredCollider(hit.transform);
+        }
+
+        private bool IsIgnoredCollider(Transform hitTransform)
+        {
+            if (hitTransform == transform || hitTransform.IsChildOf(transform)) return true;
+
+            return wizardController != null &&
+                (hitTransform == wizardController.transform || hitTransform.IsChildOf(wizardController.transform));
+        }
+
+        /// Owner-invoked cleanup (contact, lifetime expiry, wall block, or forced removal by
+        /// Fireball on reset/suspend/disable/destroy). Idempotent so it is safe to call once more
+        /// from an owner that no longer needs to track this instance.
+        public void Finish()
+        {
+            if (IsFinished) return;
+
+            IsFinished = true;
+            if (ownedMaterial != null) Destroy(ownedMaterial);
+            Destroy(gameObject);
+        }
+    }
+}
