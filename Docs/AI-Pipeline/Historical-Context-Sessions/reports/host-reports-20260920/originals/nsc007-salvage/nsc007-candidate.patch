+            GameObject doorVisual = GameObject.CreatePrimitive(PrimitiveType.Cube);
+            doorVisual.transform.position = position;
+            doorwayBlocker = doorVisual.GetComponent<Collider>();
+            FireballTestSupport.SetPrivateField(door, "doorVisual", doorVisual);
+            FireballTestSupport.SetPrivateField(door, "doorwayBlocker", doorwayBlocker);
+            spawnedObjects.Add(doorObject);
+            spawnedObjects.Add(doorVisual);
+            Physics.SyncTransforms();
+            return door;
+        }
