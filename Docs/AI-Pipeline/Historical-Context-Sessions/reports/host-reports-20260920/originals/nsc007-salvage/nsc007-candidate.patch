@@ -0,0 +1,318 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Reflection;
+using NUnit.Framework;
+using UnityEditor;
+using UnityEditor.SceneManagement;
+using UnityEngine;
+using UnityEngine.InputSystem;
+using UnityEngine.SceneManagement;
+using Object = UnityEngine.Object;
+
+namespace NoSafeCircle.DoorPrototype.Tests.Editor
+{
+    // VAL-005/VAL-007/AC-009/AC-010: committed-scene and committed-asset conformance. Every test
+    // that opens Assets/Scenes/DoorPrototype.unity does so additively, scopes lookup to that
+    // scene, closes it without saving, and asserts the scene's bytes are unchanged. The
+    // InputSystem_Actions tests below load the committed asset directly and touch no scene.
+    public sealed class FireballCommittedSceneConformanceTests
+    {
+        private const string CanonicalScenePath = "Assets/Scenes/DoorPrototype.unity";
+        private const string InputActionsAssetPath = "Assets/InputSystem_Actions.inputactions";
+        private const string DemoRunFlowSourcePath = "Assets/NoSafeCircle/DoorPrototype/Scripts/DemoRunFlow.cs";
+
+        [SetUp]
+        public void SetUp()
+        {
+            EditorSceneManager.NewScene(NewSceneSetup.EmptyScene, NewSceneMode.Single);
+        }
+
+        [TearDown]
+        public void TearDown()
+        {
+            EditorSceneManager.NewScene(NewSceneSetup.EmptyScene, NewSceneMode.Single);
+        }
+
+        // AC-009: the committed scene's Player has a Fireball wired to its own PlayerMovement,
+        // PlayerMana, PlayerHealth, and the committed InputActionAsset.
+        [Test]
+        public void CommittedScene_PlayerFireball_ReferencesMovementManaHealthAndCommittedInputActions()
+        {
+            WithCommittedSceneOpen(scene =>
+            {
+                GameObject player = FindInSceneRoots(scene, "Player");
+                Assert.IsNotNull(player, "Expected a Player in the committed scene.");
+
+                Fireball fireball = player.GetComponent<Fireball>();
+                Assert.IsNotNull(fireball, "Expected a Fireball component on the committed scene's Player.");
+
+                var serializedFireball = new SerializedObject(fireball);
+                Assert.AreSame(player.GetComponent<PlayerMovement>(),
+                    serializedFireball.FindProperty("playerMovement").objectReferenceValue,
+                    "Fireball must reference the Player's own PlayerMovement.");
+                Assert.AreSame(player.GetComponent<PlayerMana>(),
+                    serializedFireball.FindProperty("playerMana").objectReferenceValue,
+                    "Fireball must reference the Player's own PlayerMana.");
+                Assert.AreSame(player.GetComponent<PlayerHealth>(),
+                    serializedFireball.FindProperty("playerHealth").objectReferenceValue,
+                    "Fireball must reference the Player's own PlayerHealth.");
+
+                var committedInputActions = AssetDatabase.LoadAssetAtPath<InputActionAsset>(InputActionsAssetPath);
+                Assert.IsNotNull(committedInputActions, "Expected the committed InputSystem_Actions asset to load.");
+                Assert.AreSame(committedInputActions,
+                    serializedFireball.FindProperty("inputActions").objectReferenceValue,
+                    "Fireball must reference the committed InputActionAsset.");
+            });
+        }
+
+        // AC-010: TitleScreenController and WizardGameEntryController each have their optional
+        // Fireball reference assigned to the Player's Fireball component.
+        [Test]
+        public void CommittedScene_TitleScreenAndEntryControllers_ReferenceThePlayersFireball()
+        {
+            WithCommittedSceneOpen(scene =>
+            {
+                GameObject player = FindInSceneRoots(scene, "Player");
+                GameObject canvas = FindInSceneRoots(scene, "Canvas");
+                Assert.IsNotNull(player, "Expected a Player in the committed scene.");
+                Assert.IsNotNull(canvas, "Expected a Canvas in the committed scene.");
+
+                Fireball fireball = player.GetComponent<Fireball>();
+                Assert.IsNotNull(fireball);
+
+                TitleScreenController titleController = canvas.GetComponent<TitleScreenController>();
+                WizardGameEntryController entryController = canvas.GetComponent<WizardGameEntryController>();
+                Assert.IsNotNull(titleController, "Expected a TitleScreenController on the committed scene's Canvas.");
+                Assert.IsNotNull(entryController, "Expected a WizardGameEntryController on the committed scene's Canvas.");
+
+                Assert.AreSame(fireball,
+                    new SerializedObject(titleController).FindProperty("fireball").objectReferenceValue,
+                    "TitleScreenController's optional Fireball reference must be assigned to the Player's Fireball.");
+                Assert.AreSame(fireball,
+                    new SerializedObject(entryController).FindProperty("fireball").objectReferenceValue,
+                    "WizardGameEntryController's optional Fireball reference must be assigned to the Player's Fireball.");
+            });
+        }
+
+        // AC-004/AC-010: Fireball is never added to TitleScreenController's gameplayInputBehaviours
+        // array, which still holds exactly its two debug controls.
+        [Test]
+        public void CommittedScene_TitleScreenGameplayInputBehaviours_DoesNotContainFireball_AndHoldsExactlyTheTwoDebugControls()
+        {
+            WithCommittedSceneOpen(scene =>
+            {
+                GameObject canvas = FindInSceneRoots(scene, "Canvas");
+                Assert.IsNotNull(canvas, "Expected a Canvas in the committed scene.");
+                TitleScreenController titleController = canvas.GetComponent<TitleScreenController>();
+                Assert.IsNotNull(titleController);
+
+                SerializedProperty behaviours =
+                    new SerializedObject(titleController).FindProperty("gameplayInputBehaviours");
+                Assert.AreEqual(2, behaviours.arraySize,
+                    "Expected TitleScreenController.gameplayInputBehaviours to hold exactly its two debug controls.");
+
+                var actualTypeNames = new List<string>();
+                for (int index = 0; index < behaviours.arraySize; index++)
+                {
+                    Object behaviour = behaviours.GetArrayElementAtIndex(index).objectReferenceValue;
+                    Assert.IsNotNull(behaviour, $"Expected gameplayInputBehaviours[{index}] to be assigned.");
+                    Assert.IsNotInstanceOf<Fireball>(behaviour,
+                        "Fireball must never be added to TitleScreenController's gameplayInputBehaviours array.");
+                    actualTypeNames.Add(behaviour.GetType().Name);
+                }
+
+                CollectionAssert.AreEquivalent(
+                    new[] { nameof(DebugDamageControl), nameof(DebugManaSpendControl) },
+                    actualTypeNames,
+                    "Expected exactly DebugDamageControl and DebugManaSpendControl in gameplayInputBehaviours.");
+            });
+        }
+
+        // VAL-007: exactly one Fireball implementation is wired into the committed scene.
+        [Test]
+        public void CommittedScene_ContainsExactlyOneFireballComponent()
+        {
+            WithCommittedSceneOpen(scene =>
+            {
+                int count = 0;
+                foreach (GameObject root in scene.GetRootGameObjects())
+                {
+                    count += root.GetComponentsInChildren<Fireball>(true).Length;
+                }
+
+                Assert.AreEqual(1, count, "Expected exactly one Fireball component in the committed scene.");
+            });
+        }
+
+        // AC-004/VAL-005: the committed physical binding - Button type, sole <Mouse>/rightButton
+        // binding, Keyboard&Mouse-only group, no gamepad/joystick/touch/XR binding.
+        [Test]
+        public void CommittedInputActions_FireballAction_IsButtonWithSoleRightMouseBindingInKeyboardMouseGroup()
+        {
+            InputActionAsset asset = AssetDatabase.LoadAssetAtPath<InputActionAsset>(InputActionsAssetPath);
+            Assert.IsNotNull(asset, "Expected the committed InputSystem_Actions asset to load.");
+
+            InputActionMap playerMap = asset.FindActionMap("Player", true);
+            InputAction fireballAction = playerMap.FindAction("Fireball", true);
+
+            Assert.AreEqual(InputActionType.Button, fireballAction.type,
+                "Expected the committed Fireball action to be Button-type.");
+
+            var bindings = fireballAction.bindings;
+            Assert.AreEqual(1, bindings.Count, "Expected the Fireball action to have exactly one binding.");
+            Assert.AreEqual("<Mouse>/rightButton", bindings[0].path);
+
+            string[] groups = SplitGroups(bindings[0].groups);
+            CollectionAssert.AreEqual(new[] { "Keyboard&Mouse" }, groups,
+                "Expected the Fireball binding's groups to contain only Keyboard&Mouse.");
+
+            foreach (InputBinding binding in bindings)
+            {
+                string[] bindingGroups = SplitGroups(binding.groups);
+                Assert.IsFalse(Array.Exists(bindingGroups,
+                        group => group == "Gamepad" || group == "Joystick" || group == "Touch" || group == "XR"),
+                    "The Fireball action must have no gamepad, joystick, touch, or XR binding.");
+            }
+        }
+
+        // AC-004: no other Player action (MoveToCursor, Interact, Attack, Jump, or any other)
+        // also binds <Mouse>/rightButton.
+        [Test]
+        public void CommittedInputActions_RightMouseButton_IsNotBoundByAnyOtherPlayerAction()
+        {
+            InputActionAsset asset = AssetDatabase.LoadAssetAtPath<InputActionAsset>(InputActionsAssetPath);
+            InputActionMap playerMap = asset.FindActionMap("Player", true);
+
+            foreach (InputAction action in playerMap.actions)
+            {
+                if (action.name == "Fireball") continue;
+
+                foreach (InputBinding binding in action.bindings)
+                {
+                    Assert.AreNotEqual("<Mouse>/rightButton", binding.path,
+                        $"Expected no other Player action ('{action.name}') to also bind <Mouse>/rightButton.");
+                }
+            }
+        }
+
+        // AC-004: the stock Attack action is left untouched.
+        [Test]
+        public void CommittedInputActions_AttackAction_StillHasExactlyItsSixBaseBindings()
+        {
+            InputActionAsset asset = AssetDatabase.LoadAssetAtPath<InputActionAsset>(InputActionsAssetPath);
+            InputActionMap playerMap = asset.FindActionMap("Player", true);
+            InputAction attackAction = playerMap.FindAction("Attack", true);
+
+            var actual = new List<(string path, string groups)>();
+            foreach (InputBinding binding in attackAction.bindings)
+            {
+                actual.Add((binding.path, binding.groups));
+            }
+
+            var expected = new[]
+            {
+                ("<Gamepad>/buttonWest", ";Gamepad"),
+                ("<Mouse>/leftButton", ";Keyboard&Mouse"),
+                ("<Touchscreen>/primaryTouch/tap", ";Touch"),
+                ("<Joystick>/trigger", "Joystick"),
+                ("<XRController>/{PrimaryAction}", "XR"),
+                ("<Keyboard>/enter", "Keyboard&Mouse"),
+            };
+
+            Assert.AreEqual(expected.Length, actual.Count, "Expected Attack to still have exactly six bindings.");
+            for (int index = 0; index < expected.Length; index++)
+            {
+                Assert.AreEqual(expected[index].path, actual[index].path,
+                    $"Expected Attack binding {index} to keep its committed path.");
+                Assert.AreEqual(expected[index].groups, actual[index].groups,
+                    $"Expected Attack binding {index} to keep its committed groups.");
+            }
+        }
+
+        // VAL-007: DemoRunFlow's embedded legacy fireball (fields, methods, nested type) is gone.
+        [Test]
+        public void DemoRunFlow_NoLongerDeclaresLegacyFireballMembers()
+        {
+            Type demoRunFlowType = typeof(DemoRunFlow);
+            const BindingFlags allDeclared = BindingFlags.Public | BindingFlags.NonPublic |
+                BindingFlags.Instance | BindingFlags.Static | BindingFlags.DeclaredOnly;
+
+            MethodInfo[] methods = demoRunFlowType.GetMethods(allDeclared);
+            Assert.IsFalse(Array.Exists(methods, method => method.Name == "TryFireAtCursor"),
+                "Expected DemoRunFlow to no longer declare TryFireAtCursor.");
+            Assert.IsFalse(Array.Exists(methods, method => method.Name == "AdvanceFireballs"),
+                "Expected DemoRunFlow to no longer declare AdvanceFireballs.");
+
+            Type[] nestedTypes = demoRunFlowType.GetNestedTypes(allDeclared);
+            Assert.IsFalse(Array.Exists(nestedTypes, nested => nested.Name == "Fireball"),
+                "Expected DemoRunFlow to no longer declare a nested Fireball type.");
+
+            FieldInfo[] fields = demoRunFlowType.GetFields(allDeclared);
+            string[] removedFieldNames =
+            {
+                "fireballSpeed", "fireballLifetime", "fireballHitRadius",
+                "fireballDamage", "fireballManaCost", "fireballCooldown",
+                "fireballs", "castCooldown"
+            };
+            foreach (string removedFieldName in removedFieldNames)
+            {
+                Assert.IsFalse(Array.Exists(fields, field => field.Name == removedFieldName),
+                    $"Expected DemoRunFlow to no longer declare a '{removedFieldName}' field.");
+            }
+        }
+
+        // VAL-007: DemoRunFlow no longer polls Mouse.current directly.
+        [Test]
+        public void DemoRunFlowSource_ContainsNoMouseCurrentUsage()
+        {
+            string source = File.ReadAllText(DemoRunFlowSourcePath);
+            StringAssert.DoesNotContain("Mouse.current", source,
+                "Expected DemoRunFlow.cs to contain no direct Mouse.current polling.");
+        }
+
+        private static void WithCommittedSceneOpen(Action<Scene> body)
+        {
+            byte[] bytesBefore = File.ReadAllBytes(CanonicalScenePath);
+            Scene openedScene = default;
+
+            try
+            {
+                openedScene = EditorSceneManager.OpenScene(CanonicalScenePath, OpenSceneMode.Additive);
+                body(openedScene);
+            }
+            finally
+            {
+                if (openedScene.IsValid() && openedScene.isLoaded)
+                {
+                    EditorSceneManager.CloseScene(openedScene, true);
+                }
+
+                CollectionAssert.AreEqual(bytesBefore, File.ReadAllBytes(CanonicalScenePath),
+                    "Committed-scene conformance inspection must not change canonical scene bytes.");
+            }
+        }
+
+        private static GameObject FindInSceneRoots(Scene scene, string objectName)
+        {
+            foreach (GameObject root in scene.GetRootGameObjects())
+            {
+                if (root.name == objectName) return root;
+
+                foreach (Transform candidate in root.GetComponentsInChildren<Transform>(true))
+                {
+                    if (candidate.name == objectName) return candidate.gameObject;
+                }
+            }
+
+            return null;
+        }
+
+        private static string[] SplitGroups(string groups)
+        {
+            return string.IsNullOrEmpty(groups)
+                ? Array.Empty<string>()
+                : groups.Split(';', StringSplitOptions.RemoveEmptyEntries);
+        }
+    }
+}
