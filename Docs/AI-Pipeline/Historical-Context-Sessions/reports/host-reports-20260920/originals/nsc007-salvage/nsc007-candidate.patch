+            Assert.AreSame(door, interactionController.PendingDoor);
+            Assert.GreaterOrEqual(door.Progress, progressBeforeCast);
+
+            AdvanceDoorTime(door, door.Duration * 0.3f);
+
+            Assert.IsTrue(interactionController.IsInteracting);
+            Assert.AreSame(door, interactionController.PendingDoor);
+            Assert.Greater(door.Progress, progressBeforeCast,
+                "The door's opening timer must keep advancing after a tap cast during the attempt.");
+        }
+
+        [UnityTest]
+        public IEnumerator ChargedCastAndRelease_DuringDoorOpeningAttempt_DoesNotInterfereWithTheAttempt()
+        {
+            AdvanceDoorTime(door, door.Duration * 0.3f);
+            float progressBeforeCharge = door.Progress;
+            Assert.Greater(progressBeforeCharge, 0f, "Test setup must actually advance the door's opening timer.");
+
+            HoldAndRelease(FarTarget, 0.9f);
+
+            yield return null;
+
+            Assert.IsTrue(interactionController.IsInteracting);
+            Assert.AreSame(door, interactionController.PendingDoor);
+            Assert.GreaterOrEqual(door.Progress, progressBeforeCharge);
+
+            AdvanceDoorTime(door, door.Duration * 0.3f);
+
+            Assert.IsTrue(interactionController.IsInteracting);
+            Assert.AreSame(door, interactionController.PendingDoor);
+            Assert.Greater(door.Progress, progressBeforeCharge,
+                "The door's opening timer must keep advancing after a charge and release during the attempt.");
+        }
+
+        private static void AdvanceDoorTime(DoorInteractable target, float totalSeconds)
+        {
+            FireballTestSupport.AdvanceTime(target.Tick, totalSeconds, 0.05f);
+        }
+    }
+}
