+                FireballTestSupport.SetPrivateField(health, "maxHealth", maxHealth.Value);
+            }
+            enemyObject.SetActive(true);
+            spawnedObjects.Add(enemyObject);
+            return health;
+        }
+
+        protected static int ActiveProjectileCount()
+        {
+            return Object.FindObjectsByType<FireballProjectile>(FindObjectsSortMode.None).Length;
+        }
+    }
