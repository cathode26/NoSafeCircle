diff --git a/Assets/NoSafeCircle/DoorPrototype/Scripts/Fireball.cs b/Assets/NoSafeCircle/DoorPrototype/Scripts/Fireball.cs
new file mode 100644
index 0000000..0b622f9
--- /dev/null
+++ b/Assets/NoSafeCircle/DoorPrototype/Scripts/Fireball.cs
@@ -0,0 +1,368 @@
+using System.Collections.Generic;
+using UnityEngine;
+using UnityEngine.InputSystem;
+
+namespace NoSafeCircle.DoorPrototype
+{
+    /// Owns tap/charge/cast state and every FireballProjectile it creates. Tap is a quick
+    /// press-and-release before tapHoldThreshold; holding past it charges a more expensive,
+    /// wider-area shot up to fullChargeDuration, capped by whatever PlayerMana.CurrentMana can
+    /// currently afford. Configured cost/damage/area scale linearly between the tap and full
+    /// values so they increase monotonically with charge progress (AC-002).
+    public sealed class Fireball : MonoBehaviour
+    {
+        private static readonly Color PlaceholderProjectileColor = new Color(1f, 0.45f, 0.1f);
+
+        [SerializeField] private PlayerMovement playerMovement;
+        [SerializeField] private PlayerMana playerMana;
+        [SerializeField] private PlayerHealth playerHealth;
+        [SerializeField] private InputActionAsset inputActions;
+
+        // Tap tier: matches the retired DemoRunFlow fireball's tuned values so first-playable
+        // feel does not regress (AC-002).
+        [SerializeField, Min(0.01f)] private float tapManaCost = 20f;
+        [SerializeField, Min(0.01f)] private float tapDamage = 25f;
+        [SerializeField, Min(0.01f)] private float tapContactRadius = 0.9f;
+        [SerializeField, Min(0.01f)] private float projectileSpeed = 12f;
+        [SerializeField, Min(0.01f)] private float projectileLifetime = 3f;
+        [SerializeField, Min(0f)] private float castCooldown = 0.5f;
+
+        [SerializeField, Min(0.01f)] private float tapHoldThreshold = 0.25f;
+        [SerializeField, Min(0.01f)] private float fullChargeDuration = 1.5f;
+        [SerializeField, Min(0.01f)] private float fullManaCost = 40f;
+        [SerializeField, Min(0.01f)] private float fullDamage = 65f;
+        [SerializeField, Min(0.01f)] private float fullAreaRadius = 2.5f;
+
+        private readonly List<FireballProjectile> ownedProjectiles = new List<FireballProjectile>();
+
+        private InputAction fireballAction;
+        private CharacterController wizardController;
+
+        private bool isSuspended;
+        private bool wasFireballPressed;
+        private bool isAttemptActive;
+        private bool isCharging;
+        private bool ownsMovementRestriction;
+        private float holdDuration;
+        private float cooldownRemaining;
+
+        public bool IsCharging => isCharging;
+        public float ChargeProgress { get; private set; }
+
+        private void Awake()
+        {
+            wizardController = GetComponent<CharacterController>();
+
+            var playerMap = inputActions != null ? inputActions.FindActionMap("Player", false) : null;
+            if (playerMap == null)
+            {
+                Debug.LogWarning("Fireball has no 'Player' action map assigned/found; Fireball input " +
+                    "will be unavailable.");
+                return;
+            }
+
+            fireballAction = playerMap.FindAction("Fireball", false);
+            if (fireballAction == null)
+            {
+                Debug.LogWarning("Fireball could not find the 'Fireball' action on the Player action map.");
+            }
+        }
+
+        private void OnEnable()
+        {
+            fireballAction?.Enable();
+            if (playerHealth != null) playerHealth.Damaged += HandlePlayerDamaged;
+        }
+
+        private void OnDisable()
+        {
+            fireballAction?.Disable();
+            if (playerHealth != null) playerHealth.Damaged -= HandlePlayerDamaged;
+
+            CancelActiveAttempt();
+            RemoveAllOwnedProjectiles();
+        }
+
+        private void OnDestroy()
+        {
+            CancelActiveAttempt();
+            RemoveAllOwnedProjectiles();
+        }
+
+        private void Update()
+        {
+            Tick(Time.deltaTime);
+        }
+
+        /// Advances cooldown, owned-projectile flight, and press/hold/release state by
+        /// deltaTime. Public so Play Mode tests can drive it deterministically (AC-002),
+        /// mirroring PlayerMovement.Tick/PlayerMana.Tick/DoorInteractable.Tick.
+        public void Tick(float deltaTime)
+        {
+            AdvanceOwnedProjectiles(deltaTime);
+
+            if (isSuspended) return;
+            if (fireballAction == null || playerMovement == null || playerMana == null) return;
+
+            if (cooldownRemaining > 0f)
+            {
+                cooldownRemaining = Mathf.Max(0f, cooldownRemaining - deltaTime);
+            }
+
+            HandleFireballInput(deltaTime);
+        }
+
+        private void HandleFireballInput(float deltaTime)
+        {
+            bool isPressed = fireballAction.IsPressed();
+            bool isFreshPress = isPressed && !wasFireballPressed;
+            bool isFreshRelease = !isPressed && wasFireballPressed;
+            wasFireballPressed = isPressed;
+
+            if (isFreshPress)
+            {
+                BeginPressAttempt();
+            }
+
+            if (isAttemptActive && isPressed)
+            {
+                holdDuration += deltaTime;
+                UpdateChargeState();
+            }
+
+            if (isFreshRelease && isAttemptActive)
+            {
+                ReleaseCast();
+            }
+        }
+
+        /// AC-006: a charge only starts if the tap cost is currently affordable; otherwise the
+        /// press itself spends nothing but raises PlayerMana.CastDenied through Spend's own
+        /// refusal path. AC-004/VAL-001: a press during the cast cooldown does neither.
+        private void BeginPressAttempt()
+        {
+            holdDuration = 0f;
+            isCharging = false;
+            ChargeProgress = 0f;
+
+            if (cooldownRemaining > 0f)
+            {
+                isAttemptActive = false;
+                return;
+            }
+
+            if (playerMana.CurrentMana < tapManaCost)
+            {
+                playerMana.Spend(tapManaCost);
+                isAttemptActive = false;
+                return;
+            }
+
+            isAttemptActive = true;
+        }
+
+        /// AC-005: requests Fireball's one movement restriction exactly once, the moment a hold
+        /// crosses tapHoldThreshold. AC-003: without a valid pointer target at that moment, the
+        /// pending attempt is cleared instead of starting a restricted charge.
+        private void UpdateChargeState()
+        {
+            if (!isAttemptActive) return;
+
+            if (!isCharging && holdDuration >= tapHoldThreshold)
+            {
+                if (playerMovement == null || !playerMovement.HasPointerWorldTarget)
+                {
+                    isAttemptActive = false;
+                    return;
+                }
+
+                isCharging = true;
+                RequestRestrictionIfNeeded();
+            }
+
+            if (isCharging)
+            {
+                ChargeProgress = ComputeCappedChargeProgress();
+            }
+        }
+
+        /// AC-006: charge growth is capped by the highest tier PlayerMana.CurrentMana can
+        /// currently pay, in addition to the natural hold-time progress toward fullChargeDuration.
+        private float ComputeCappedChargeProgress()
+        {
+            float naturalProgress = fullChargeDuration > tapHoldThreshold
+                ? Mathf.Clamp01((holdDuration - tapHoldThreshold) / (fullChargeDuration - tapHoldThreshold))
+                : 1f;
+
+            float manaCapProgress = fullManaCost > tapManaCost
+                ? Mathf.Clamp01((playerMana.CurrentMana - tapManaCost) / (fullManaCost - tapManaCost))
+                : 1f;
+
+            return Mathf.Min(naturalProgress, manaCapProgress);
+        }
+
+        private void ReleaseCast()
+        {
+            bool wasCharging = isCharging;
+            isAttemptActive = false;
+            isCharging = false;
+
+            if (!wasCharging)
+            {
+                Fire(tapManaCost, tapDamage, tapContactRadius, hasAreaDamage: false);
+                return;
+            }
+
+            float finalProgress = ComputeCappedChargeProgress();
+            ChargeProgress = 0f;
+
+            float cost = Mathf.Lerp(tapManaCost, fullManaCost, finalProgress);
+            float damage = Mathf.Lerp(tapDamage, fullDamage, finalProgress);
+            float radius = Mathf.Lerp(tapContactRadius, fullAreaRadius, finalProgress);
+
+            Fire(cost, damage, radius, hasAreaDamage: true);
+        }
+
+        /// AC-003/AC-005/AC-006: the single fire path shared by tap and charged casts. Every
+        /// early-return releases any owned restriction so it is never released twice and never
+        /// leaked.
+        private void Fire(float manaCost, float damage, float radius, bool hasAreaDamage)
+        {
+            if (playerMovement == null || !playerMovement.HasPointerWorldTarget)
+            {
+                ReleaseRestrictionIfNeeded();
+                return;
+            }
+
+            Vector3 origin = transform.position;
+            Vector3 direction = playerMovement.PointerWorldTarget - origin;
+            direction.y = 0f;
+
+            if (direction.sqrMagnitude < 0.0001f)
+            {
+                ReleaseRestrictionIfNeeded();
+                return;
+            }
+
+            direction.Normalize();
+
+            if (!playerMana.Spend(manaCost))
+            {
+                ReleaseRestrictionIfNeeded();
+                return;
+            }
+
+            ReleaseRestrictionIfNeeded();
+            SpawnProjectile(origin, direction, damage, radius, hasAreaDamage);
+            cooldownRemaining = castCooldown;
+        }
+
+        private void SpawnProjectile(Vector3 origin, Vector3 direction, float damage, float radius, bool hasAreaDamage)
+        {
+            var projectileObject = new GameObject("FireballProjectile");
+            projectileObject.transform.position = origin + Vector3.up;
+
+            var projectile = projectileObject.AddComponent<FireballProjectile>();
+            projectile.Initialize(
+                direction,
+                projectileSpeed,
+                projectileLifetime,
+                damage,
+                radius,
+                hasAreaDamage,
+                wizardController,
+                PlaceholderProjectileColor);
+
+            ownedProjectiles.Add(projectile);
+        }
+
+        private void AdvanceOwnedProjectiles(float deltaTime)
+        {
+            for (int index = ownedProjectiles.Count - 1; index >= 0; index--)
+            {
+                FireballProjectile projectile = ownedProjectiles[index];
+                if (projectile == null)
+                {
+                    ownedProjectiles.RemoveAt(index);
+                    continue;
+                }
+
+                projectile.Tick(deltaTime);
+
+                if (projectile.IsFinished)
+                {
+                    ownedProjectiles.RemoveAt(index);
+                }
+            }
+        }
+
+        private void RemoveAllOwnedProjectiles()
+        {
+            for (int index = ownedProjectiles.Count - 1; index >= 0; index--)
+            {
+                FireballProjectile projectile = ownedProjectiles[index];
+                if (projectile != null) projectile.Finish();
+            }
+
+            ownedProjectiles.Clear();
+        }
+
+        private void RequestRestrictionIfNeeded()
+        {
+            if (ownsMovementRestriction || playerMovement == null) return;
+
+            playerMovement.RequestMovementRestriction();
+            ownsMovementRestriction = true;
+        }
+
+        private void ReleaseRestrictionIfNeeded()
+        {
+            if (!ownsMovementRestriction) return;
+
+            playerMovement?.ReleaseMovementRestriction();
+            ownsMovementRestriction = false;
+        }
+
+        /// AC-005: PlayerHealth.Damaged cancels an active charge only - a still-pending tap
+        /// attempt (not yet past tapHoldThreshold) is untouched.
+        private void HandlePlayerDamaged(float amount)
+        {
+            if (!isCharging) return;
+
+            CancelActiveAttempt();
+        }
+
+        private void CancelActiveAttempt()
+        {
+            isAttemptActive = false;
+            isCharging = false;
+            ChargeProgress = 0f;
+            ReleaseRestrictionIfNeeded();
+        }
+
+        /// AC-008: clears charge/cast state, releases any owned restriction, removes every
+        /// owned projectile, and re-enables input.
+        public void ResetFireball()
+        {
+            CancelActiveAttempt();
+            RemoveAllOwnedProjectiles();
+            holdDuration = 0f;
+            cooldownRemaining = 0f;
+            isSuspended = false;
+        }
+
+        /// AC-008: same active-operation cleanup as ResetFireball, but stays suspended until
+        /// EnableGameplayInput()/ResetFireball() re-enables input.
+        public void SuspendGameplayInput()
+        {
+            CancelActiveAttempt();
+            RemoveAllOwnedProjectiles();
+            isSuspended = true;
+        }
+
+        public void EnableGameplayInput()
+        {
+            isSuspended = false;
+        }
+    }
+}
