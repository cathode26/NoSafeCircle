+    /// Shared harness for every Fireball behavior fixture below: a real Player (CharacterController,
+    /// PlayerHealth, PlayerMana, PlayerMovement, PlayerInteractionController, Fireball) driven
+    /// through a temporary in-memory InputActionAsset whose Player map carries PointerPosition,
+    /// MoveToCursor, and a Button-type Fireball action bound to <Mouse>/rightButton (VAL-001).
+    /// Tick(float) always advances PlayerMovement before Fireball, since Fireball only reads the
+    /// pointer target PlayerMovement's own Tick computes and never advances movement itself.
+    public abstract class FireballPlayModeTestBase : InputTestFixture
+    {
+        protected readonly List<GameObject> spawnedObjects = new List<GameObject>();
+
+        protected GameObject playerObject;
+        protected GameObject cameraObject;
+        protected Camera testCamera;
+        protected RenderTexture testRenderTexture;
+        protected InputActionAsset testInputActions;
+        protected Mouse mouseDevice;
+
+        protected CharacterController characterController;
+        protected PlayerHealth playerHealth;
+        protected PlayerMana playerMana;
+        protected PlayerMovement playerMovement;
+        protected PlayerInteractionController interactionController;
+        protected Fireball fireball;
+
+        public override void Setup()
+        {
+            base.Setup();
+
+            mouseDevice = InputSystem.AddDevice<Mouse>();
+
+            cameraObject = new GameObject("TestCamera");
+            cameraObject.tag = "MainCamera";
+            testCamera = cameraObject.AddComponent<Camera>();
+            testCamera.transform.SetPositionAndRotation(new Vector3(0f, 10f, -10f), Quaternion.identity);
+            testCamera.transform.LookAt(Vector3.zero);
+
+            // Batch mode has no interactive Game View; give the camera a fixed pixel surface so
+            // WorldToScreenPoint/ScreenPointToRay are deterministic here too.
+            testRenderTexture = new RenderTexture(800, 600, 24);
+            testRenderTexture.Create();
+            testCamera.targetTexture = testRenderTexture;
+
+            testInputActions = FireballTestSupport.BuildInputActions(mouseDevice);
+
+            playerObject = new GameObject("TestPlayer");
+            playerObject.SetActive(false);
+
+            playerObject.transform.position = Vector3.zero;
+            characterController = playerObject.AddComponent<CharacterController>();
+            playerHealth = playerObject.AddComponent<PlayerHealth>();
+            playerMana = playerObject.AddComponent<PlayerMana>();
+            interactionController = playerObject.AddComponent<PlayerInteractionController>();
+            playerMovement = playerObject.AddComponent<PlayerMovement>();
+            FireballTestSupport.SetPrivateField(playerMovement, "inputActions", testInputActions);
+            FireballTestSupport.SetPrivateField(playerMovement, "interactionController", interactionController);
+
+            fireball = playerObject.AddComponent<Fireball>();
+            FireballTestSupport.SetPrivateField(fireball, "playerMovement", playerMovement);
+            FireballTestSupport.SetPrivateField(fireball, "playerMana", playerMana);
+            FireballTestSupport.SetPrivateField(fireball, "playerHealth", playerHealth);
+            FireballTestSupport.SetPrivateField(fireball, "inputActions", testInputActions);
+
+            playerObject.SetActive(true);
+        }
+
+        public override void TearDown()
+        {
+            foreach (FireballProjectile projectile in
+                Object.FindObjectsByType<FireballProjectile>(FindObjectsSortMode.None))
+            {
+                if (projectile != null) Object.DestroyImmediate(projectile.gameObject);
+            }
+
+            for (int index = spawnedObjects.Count - 1; index >= 0; index--)
+            {
+                if (spawnedObjects[index] != null) Object.DestroyImmediate(spawnedObjects[index]);
+            }
+            spawnedObjects.Clear();
+
+            if (playerObject != null) Object.Destroy(playerObject);
+            if (cameraObject != null) Object.Destroy(cameraObject);
+
+            if (testInputActions != null)
+            {
+                testInputActions.Disable();
+                Object.Destroy(testInputActions);
+            }
+
+            if (testRenderTexture != null)
+            {
+                testRenderTexture.Release();
+                Object.Destroy(testRenderTexture);
+            }
+
+            playerObject = null;
+            cameraObject = null;
+            testInputActions = null;
+            testRenderTexture = null;
+            mouseDevice = null;
+
+            base.TearDown();
+        }
+
+        /// Advances PlayerMovement (so its shared pointer-target projection is current) and then
+        /// Fireball by the same deltaTime. Tests must always advance time through this method
+        /// rather than calling fireball.Tick directly, since Fireball never advances movement itself.
+        protected void Tick(float deltaTime)
+        {
+            playerMovement.Tick(deltaTime);
+            fireball.Tick(deltaTime);
+        }
+
+        protected void PressFireball(Vector3 pointerWorldTarget)
+        {
+            FireballTestSupport.SetMouse(mouseDevice, testCamera.WorldToScreenPoint(pointerWorldTarget), true);
+        }
+
+        protected void ReleaseFireball(Vector3 pointerWorldTarget)
+        {
+            FireballTestSupport.SetMouse(mouseDevice, testCamera.WorldToScreenPoint(pointerWorldTarget), false);
+        }
+
+        /// A quick press-and-release well inside the default 0.25s tap/hold threshold.
+        protected void Tap(Vector3 pointerWorldTarget)
+        {
+            PressFireball(pointerWorldTarget);
+            Tick(0.02f);
+            ReleaseFireball(pointerWorldTarget);
+            Tick(0.02f);
+        }
+
+        protected void HoldAndRelease(Vector3 pointerWorldTarget, float holdSeconds, float step = 0.02f)
+        {
+            PressFireball(pointerWorldTarget);
+            FireballTestSupport.AdvanceTime(Tick, holdSeconds, step);
+            ReleaseFireball(pointerWorldTarget);
+            Tick(step);
+        }
+
+        protected EnemyHealth CreateEnemy(Vector3 position)
+        {
+            return CreateEnemy(position, null);
+        }
+
+        protected EnemyHealth CreateEnemy(Vector3 position, float? maxHealth)
+        {
+            var enemyObject = new GameObject("TestEnemy");
+            enemyObject.SetActive(false);
+            enemyObject.transform.position = position;
+            EnemyHealth health = enemyObject.AddComponent<EnemyHealth>();
+            if (maxHealth.HasValue)
