+            new WizardVariant("Masculine_White", "masculine-light"),
+            new WizardVariant("Masculine_Black", "masculine-dark"),
+            new WizardVariant("Feminine_White", "feminine-light"),
+            new WizardVariant("Feminine_Black", "feminine-dark")
