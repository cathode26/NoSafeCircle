   182	        private static void AssertSourceImport(string path)
   183	        {
   184	            TextureImporter importer = AssetImporter.GetAtPath(path) as TextureImporter;
   185	            Assert.IsNotNull(importer, path);
   186	            Assert.AreEqual(TextureImporterType.Sprite, importer.textureType, path);
   187	            Assert.AreEqual(SpriteImportMode.Single, importer.spriteImportMode, path);
   188	            Assert.AreEqual(FilterMode.Point, importer.filterMode, path);
   189	            Assert.AreEqual(TextureImporterCompression.Uncompressed, importer.textureCompression, path);
   190	            Assert.IsFalse(importer.mipmapEnabled, path);
   191	            Assert.AreEqual(180f, importer.spritePixelsPerUnit, path);
   192	
   193	            var textureSettings = new TextureImporterSettings();
   194	            importer.ReadTextureSettings(textureSettings);
   195	            Assert.AreEqual((int)SpriteAlignment.Custom, textureSettings.spriteAlignment, path);
   196	            Assert.That(textureSettings.spritePivot.x, Is.EqualTo(0.5f).Within(0.001f), path);
   197	            Assert.That(textureSettings.spritePivot.y, Is.EqualTo(0f).Within(0.001f), path);
   198	
   199	            Sprite sprite = AssetDatabase.LoadAssetAtPath<Sprite>(path);
   200	            Assert.IsNotNull(sprite, path);
   201	            Assert.That(sprite.rect.width, Is.EqualTo(SourceSize).Within(0.001f), path);
   202	            Assert.That(sprite.rect.height, Is.EqualTo(SourceSize).Within(0.001f), path);
   203	            Assert.That(sprite.pivot.x, Is.EqualTo(SourceSize * 0.5f).Within(0.001f), path);
   204	            Assert.That(sprite.pivot.y, Is.EqualTo(0f).Within(0.001f), path);
   205	
   206	            var sourceTexture = new Texture2D(2, 2, TextureFormat.RGBA32, false);
   207	            try
   208	            {
   209	                Assert.IsTrue(sourceTexture.LoadImage(File.ReadAllBytes(path)), path);
   210	                Assert.AreEqual(SourceSize, sourceTexture.width, path);
   211	                Assert.AreEqual(SourceSize, sourceTexture.height, path);
   212	                Color32[] pixels = sourceTexture.GetPixels32();
   213	                Assert.IsTrue(pixels.Any(pixel => pixel.a == 0), "No transparent pixels: " + path);
   214	                Assert.IsTrue(pixels.Any(pixel => pixel.a > 0), "No visible character pixels: " + path);
   215	            }
   216	            finally
   217	            {
   218	                Object.DestroyImmediate(sourceTexture);
   219	            }
   220	        }
   221	
   222	        private static void AssertStateAndClip(
   223	            IReadOnlyDictionary<string, AnimatorState> statesByName,
   224	            string expectedName,
   225	            IReadOnlyList<string> expectedSourcePaths,
   226	            int expectedFrameRate,
   227	            ISet<string> expectedStateNames,
   228	            ISet<string> expectedClipPaths)
   229	        {
   230	            Assert.IsTrue(expectedStateNames.Add(expectedName), expectedName);
   231	            Assert.IsTrue(statesByName.TryGetValue(expectedName, out AnimatorState state), expectedName);
   232	
   233	            string clipPath = GeneratedRoot + "/" + expectedName + ".anim";
   234	            Assert.IsTrue(expectedClipPaths.Add(clipPath), clipPath);
   235	            AnimationClip clip = AssetDatabase.LoadAssetAtPath<AnimationClip>(clipPath);
   236	            Assert.IsNotNull(clip, clipPath);
   237	            Assert.AreSame(clip, state.motion, expectedName);
   238	            Assert.AreEqual(expectedName, clip.name, clipPath);
   239	            Assert.AreEqual(expectedFrameRate, clip.frameRate, clipPath);
   240	            Assert.IsTrue(AnimationUtility.GetAnimationClipSettings(clip).loopTime, clipPath);
   241	
   242	            EditorCurveBinding[] bindings = AnimationUtility.GetObjectReferenceCurveBindings(clip);
   243	            Assert.AreEqual(1, bindings.Length, clipPath);
   244	            EditorCurveBinding binding = bindings[0];
   245	            Assert.AreEqual("Visual", binding.path, clipPath);
   246	            Assert.AreEqual(typeof(SpriteRenderer), binding.type, clipPath);
   247	            Assert.AreEqual("m_Sprite", binding.propertyName, clipPath);
   248	
   249	            ObjectReferenceKeyframe[] keyframes = AnimationUtility.GetObjectReferenceCurve(clip, binding);
   250	            Assert.AreEqual(expectedSourcePaths.Count, keyframes.Length, clipPath);
   251	            for (int frame = 0; frame < expectedSourcePaths.Count; frame++)
   252	            {
   253	                string sourcePath = expectedSourcePaths[frame];
   254	                Sprite expectedSprite = AssetDatabase.LoadAssetAtPath<Sprite>(sourcePath);
   255	                Assert.IsNotNull(expectedSprite, sourcePath);
   256	                Assert.That(
   257	                    keyframes[frame].time,
   258	                    Is.EqualTo(frame / (float)expectedFrameRate).Within(0.0001f),
   259	                    clipPath);
   260	                Assert.AreSame(expectedSprite, keyframes[frame].value, clipPath + " frame " + frame);
   261	                Assert.AreEqual(sourcePath, AssetDatabase.GetAssetPath(keyframes[frame].value), clipPath);
   262	            }
   263	        }
   264	
   265	        private static string StandingPath(string sourceFolder, string direction)
   266	        {
   267	            return SourceRoot + "/" + sourceFolder + "/selected/standing/" + direction + ".png";
   268	        }
   269	
   270	        private static string WalkPath(string sourceFolder, string direction, int frame)
   271	        {
   272	            return SourceRoot + "/" + sourceFolder + "/selected/walk/" + direction +
   273	                "/frame_" + frame.ToString("000") + ".png";
   274	        }
