   167	        private static IEnumerable<string> ExpectedSourcePaths()
   168	        {
   169	            foreach (WizardVariant variant in Variants)
   170	            {
   171	                foreach (string direction in Directions)
   172	                {
   173	                    yield return StandingPath(variant.SourceFolder, direction);
   174	                    for (int frame = 0; frame < WalkFrameCount; frame++)
   175	                    {
   176	                        yield return WalkPath(variant.SourceFolder, direction, frame);
   177	                    }
   178	                }
   179	            }
