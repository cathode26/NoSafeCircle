    94	                        statesByName,
    95	                        idleName,
    96	                        new[] { idleSourcePath },
    97	                        1,
    98	                        expectedStateNames,
    99	                        expectedClipPaths);
   100	
   101	                    string walkName = "Wizard_" + variant.AnimatorName + "_walk_" + direction;
   102	                    string[] walkSourcePaths = Enumerable.Range(0, WalkFrameCount)
   103	                        .Select(frame => WalkPath(variant.SourceFolder, direction, frame))
   104	                        .ToArray();
   105	                    AssertStateAndClip(
   106	                        statesByName,
   107	                        walkName,
   108	                        walkSourcePaths,
   109	                        12,
   110	                        expectedStateNames,
   111	                        expectedClipPaths);
   112	                }
   113	            }
   114	
   115	            CollectionAssert.AreEquivalent(expectedStateNames, stateNames);
   116	
