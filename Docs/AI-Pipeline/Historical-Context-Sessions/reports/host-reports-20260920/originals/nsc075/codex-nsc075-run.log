   598	        private static Vector3 BoundaryMovementFor(string direction, float offset)
   599	        {
   600	            float angle = 0f;
   601	            switch (direction)
   602	            {
   603	                case "north-east": angle = 22.5f; break;
   604	                case "east": angle = -22.5f; break;
   605	                case "south-east": angle = -67.5f; break;
   606	                case "south": angle = -112.5f; break;
   607	                case "south-west": angle = -157.5f; break;
   608	                case "west": angle = 157.5f; break;
   609	                case "north-west": angle = 112.5f; break;
   610	                case "north": angle = 67.5f; break;
   611	                default: throw new ArgumentOutOfRangeException(nameof(direction));
   612	            }
   613	
   614	            float radians = (angle + offset) * Mathf.Deg2Rad;
   615	            float screenX = Mathf.Cos(radians);
   616	            float screenY = Mathf.Sin(radians);
   617	            return new Vector3((screenX + screenY) * 0.5f, 0f,
   618	                (screenX - screenY) * 0.5f);
   619	        }
