   277	        {
   278	            public readonly string AnimatorName;
   279	            public readonly string SourceFolder;
   280	
   281	            public WizardVariant(string animatorName, string sourceFolder)
   282	            {
   283	                AnimatorName = animatorName;
   284	                SourceFolder = sourceFolder;
   285	            }
   286	        }
   287	    }
