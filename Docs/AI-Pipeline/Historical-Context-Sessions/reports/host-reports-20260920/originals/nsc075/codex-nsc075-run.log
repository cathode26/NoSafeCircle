   292	        public void BuilderUsesCanonicalEightDirectionSetForStandingIdleAndWalk()
   293	        {
   294	            string[] expectedDirections =
   295	            {
   296	                "north",
   297	                "north-east",
   298	                "east",
   299	                "south-east",
   300	                "south",
   301	                "south-west",
   302	                "west",
   303	                "north-west"
   304	            };
   305	            System.Type builderType = typeof(NoSafeCircle.DoorPrototype.Editor.DoorPrototypeSceneBuilder)
   306	                .Assembly.GetType("NoSafeCircle.DoorPrototype.Editor.World.DoorPrototypeGlobalSceneBuilder");
   307	            Assert.IsNotNull(builderType);
   308	            FieldInfo directionsField = builderType.GetField(
   309	                "WizardDirections", BindingFlags.NonPublic | BindingFlags.Static);
   310	            FieldInfo standingDirectionsField = builderType.GetField(
   311	                "WizardStandingDirections", BindingFlags.NonPublic | BindingFlags.Static);
   312	            Assert.IsNotNull(directionsField);
   313	            Assert.IsNotNull(standingDirectionsField);
   314	            string[] directions = (string[])directionsField.GetValue(null);
   315	            string[] standingDirections = (string[])standingDirectionsField.GetValue(null);
   316	
   317	            CollectionAssert.AreEqual(expectedDirections, directions);
   318	            CollectionAssert.AreEqual(expectedDirections, standingDirections);
   319	            Assert.AreSame(directions, standingDirections);
   320	        }
   321	    }
