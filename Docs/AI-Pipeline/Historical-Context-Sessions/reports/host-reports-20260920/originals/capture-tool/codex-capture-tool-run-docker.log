new file mode 100644
index 0000000000000000000000000000000000000000..a73860532b62b494749ff759ec78a341633b7642
--- /dev/null
+++ b/Assets/NoSafeCircle/DoorPrototype/Tests/GameplayCapture/GameplayCaptureSpec.cs
@@ -0,0 +1,330 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using UnityEngine;
+
+namespace NoSafeCircle.DoorPrototype.Tests.GameplayCapture
+{
+    internal readonly struct CaptureResolution : IEquatable<CaptureResolution>
+    {
+        public CaptureResolution(int width, int height)
+        {
+            Width = width;
+            Height = height;
+        }
+
+        public int Width { get; }
+        public int Height { get; }
+
+        public bool Equals(CaptureResolution other)
+        {
+            return Width == other.Width && Height == other.Height;
+        }
+
+        public override bool Equals(object obj)
+        {
+            return obj is CaptureResolution other && Equals(other);
+        }
+
+        public override int GetHashCode()
+        {
+            return (Width * 397) ^ Height;
+        }
+
+        public override string ToString()
+        {
+            return Width.ToString(CultureInfo.InvariantCulture) + "x" +
+                Height.ToString(CultureInfo.InvariantCulture);
+        }
+
+        public static CaptureResolution Parse(string value)
+        {
+            if (string.IsNullOrWhiteSpace(value))
+            {
+                throw new FormatException("A capture resolution must not be empty.");
+            }
+
+            string[] parts = value.Split('x');
+            if (parts.Length != 2 ||
+                !int.TryParse(parts[0], NumberStyles.None, CultureInfo.InvariantCulture, out int width) ||
+                !int.TryParse(parts[1], NumberStyles.None, CultureInfo.InvariantCulture, out int height) ||
+                width <= 0 || height <= 0)
+            {
+                throw new FormatException(
+                    $"Capture resolution '{value}' must use positive WIDTHxHEIGHT integers.");
+            }
+
+            return new CaptureResolution(width, height);
+        }
+    }
+
+    internal readonly struct WizardIdentity
+    {
+        public WizardIdentity(
+            string key,
+            WizardPresentation presentation,
+            WizardSkin skin)
+        {
+            Key = key;
+            Presentation = presentation;
+            Skin = skin;
+        }
+
+        public string Key { get; }
+        public WizardPresentation Presentation { get; }
+        public WizardSkin Skin { get; }
+    }
+
+    internal sealed class GameplayCaptureShot
+    {
+        public GameplayCaptureShot(
+            string name,
+            WizardIdentity identity,
+            string facing,
+            string state,
+            int walkFrameIndex,
+            float worldX,
+            float worldZ,
+            bool disableEnemies,
+            CaptureResolution[] resolutions)
+        {
+            Name = name;
+            Identity = identity;
+            Facing = facing;
+            State = state;
+            WalkFrameIndex = walkFrameIndex;
+            WorldX = worldX;
+            WorldZ = worldZ;
+            DisableEnemies = disableEnemies;
+            Resolutions = resolutions;
+        }
+
+        public string Name { get; }
+        public WizardIdentity Identity { get; }
+        public string Facing { get; }
+        public string State { get; }
+        public int WalkFrameIndex { get; }
+        public float WorldX { get; }
+        public float WorldZ { get; }
+        public bool DisableEnemies { get; }
+        public IReadOnlyList<CaptureResolution> Resolutions { get; }
+    }
+
+    internal sealed class GameplayCaptureSpec
+    {
+        private static readonly string[] DefaultResolutionNames =
+        {
+            "1920x1080",
+            "2560x1440"
+        };
+
+        private static readonly string[] FacingNames =
+        {
+            "south",
+            "south-east",
+            "east",
+            "north-east",
+            "north",
+            "north-west",
+            "west",
+            "south-west"
+        };
+
+        private GameplayCaptureSpec(GameplayCaptureShot[] shots)
+        {
+            Shots = shots;
+        }
+
+        public IReadOnlyList<GameplayCaptureShot> Shots { get; }
+
+        public static GameplayCaptureSpec Parse(string json)
+        {
+            if (string.IsNullOrWhiteSpace(json))
+            {
+                throw new ArgumentException("The gameplay capture spec is empty.", nameof(json));
+            }
+
+            var rawSpec = new RawCaptureSpec();
+            try
+            {
+                JsonUtility.FromJsonOverwrite(json, rawSpec);
+            }
+            catch (Exception exception)
+            {
+                throw new FormatException("The gameplay capture spec is not valid JSON.", exception);
+            }
+
+            if (rawSpec.shots == null || rawSpec.shots.Length == 0)
+            {
+                throw new FormatException("The gameplay capture spec must contain at least one shot.");
+            }
+
+            var names = new HashSet<string>(StringComparer.Ordinal);
+            var shots = new GameplayCaptureShot[rawSpec.shots.Length];
+            for (int index = 0; index < rawSpec.shots.Length; index++)
+            {
+                shots[index] = ParseShot(rawSpec.shots[index], index, names);
+            }
+
+            return new GameplayCaptureSpec(shots);
+        }
+
+        public static bool IsFacingName(string value)
+        {
+            return Array.IndexOf(FacingNames, value) >= 0;
+        }
+
+        public static WizardIdentity ResolveIdentity(string key)
+        {
+            switch (key)
+            {
+                case "masculine-light":
+                    return new WizardIdentity(key, WizardPresentation.Masculine, WizardSkin.White);
+                case "masculine-dark":
+                    return new WizardIdentity(key, WizardPresentation.Masculine, WizardSkin.Black);
+                case "feminine-light":
+                    return new WizardIdentity(key, WizardPresentation.Feminine, WizardSkin.White);
+                case "feminine-dark":
+                    return new WizardIdentity(key, WizardPresentation.Feminine, WizardSkin.Black);
+                default:
+                    throw new FormatException(
+                        $"Unknown wizard identity '{key}'. Expected a key from the game's four-option identity table.");
+            }
+        }
+
+        private static GameplayCaptureShot ParseShot(
+            RawCaptureShot rawShot,
+            int index,
+            ISet<string> names)
+        {
+            if (rawShot == null)
+            {
+                throw new FormatException($"Shot at index {index} is null.");
+            }
+
+            ValidateShotName(rawShot.name, index);
+            if (!names.Add(rawShot.name))
+            {
+                throw new FormatException($"Shot name '{rawShot.name}' is duplicated.");
+            }
+
+            WizardIdentity identity = ResolveIdentity(rawShot.identity);
+            if (!IsFacingName(rawShot.facing))
+            {
+                throw new FormatException(
+                    $"Shot '{rawShot.name}' has unknown facing '{rawShot.facing}'.");
+            }
+
+            if (rawShot.state != "idle" && rawShot.state != "walk")
+            {
+                throw new FormatException(
+                    $"Shot '{rawShot.name}' state must be 'idle' or 'walk'.");
+            }
+
+            if (rawShot.state == "walk" && rawShot.walk_frame_index < 0)
+            {
+                throw new FormatException(
+                    $"Shot '{rawShot.name}' must provide a non-negative walk_frame_index.");
+            }
+
+            if (rawShot.state == "idle" && rawShot.walk_frame_index >= 0)
+            {
+                throw new FormatException(
+                    $"Shot '{rawShot.name}' must omit walk_frame_index for the idle state.");
+            }
+
+            if (rawShot.world_position == null ||
+                !IsFinite(rawShot.world_position.x) ||
+                !IsFinite(rawShot.world_position.z))
+            {
+                throw new FormatException(
+                    $"Shot '{rawShot.name}' requires a finite world_position with x and z values.");
+            }
+
+            string[] resolutionNames = rawShot.resolutions == null || rawShot.resolutions.Length == 0
+                ? DefaultResolutionNames
+                : rawShot.resolutions;
+            var resolutions = new CaptureResolution[resolutionNames.Length];
+            var uniqueResolutions = new HashSet<CaptureResolution>();
+            for (int resolutionIndex = 0; resolutionIndex < resolutionNames.Length; resolutionIndex++)
+            {
+                CaptureResolution resolution = CaptureResolution.Parse(resolutionNames[resolutionIndex]);
+                if (!uniqueResolutions.Add(resolution))
+                {
+                    throw new FormatException(
+                        $"Shot '{rawShot.name}' repeats resolution '{resolution}'.");
+                }
+
+                resolutions[resolutionIndex] = resolution;
+            }
+
+            return new GameplayCaptureShot(
+                rawShot.name,
+                identity,
+                rawShot.facing,
+                rawShot.state,
+                rawShot.walk_frame_index,
+                rawShot.world_position.x,
+                rawShot.world_position.z,
+                rawShot.disable_enemies,
+                resolutions);
+        }
+
+        private static void ValidateShotName(string name, int index)
+        {
+            if (string.IsNullOrWhiteSpace(name))
+            {
+                throw new FormatException($"Shot at index {index} requires a name.");
+            }
+
+            if (!char.IsLetterOrDigit(name[0]))
+            {
+                throw new FormatException(
+                    $"Shot name '{name}' must start with an ASCII letter or digit.");
+            }
+
+            foreach (char character in name)
+            {
+                bool isAsciiLetter = character >= 'A' && character <= 'Z' ||
+                    character >= 'a' && character <= 'z';
+                bool isDigit = character >= '0' && character <= '9';
+                if (!isAsciiLetter && !isDigit && character != '-' && character != '_' && character != '.')
+                {
+                    throw new FormatException(
+                        $"Shot name '{name}' may contain only ASCII letters, digits, '-', '_' and '.'.");
+                }
+            }
+        }
+
+        private static bool IsFinite(float value)
+        {
+            return !float.IsNaN(value) && !float.IsInfinity(value);
+        }
+
+        [Serializable]
+        private sealed class RawCaptureSpec
+        {
+            public RawCaptureShot[] shots;
+        }
+
+        [Serializable]
+        private sealed class RawCaptureShot
+        {
+            public string name;
+            public string identity;
+            public string facing;
+            public string state;
+            public int walk_frame_index = -1;
+            public RawWorldPosition world_position;
+            public bool disable_enemies = true;
+            public string[] resolutions;
+        }
+
+        [Serializable]
+        private sealed class RawWorldPosition
+        {
+            public float x;
+            public float z;
+        }
+    }
+}
