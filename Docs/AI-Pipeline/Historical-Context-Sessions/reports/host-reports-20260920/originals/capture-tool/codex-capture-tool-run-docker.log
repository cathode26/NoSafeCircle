new file mode 100644
index 0000000000000000000000000000000000000000..c207e9ba5a682eb9fad773a07acd2d56b0cc6ac7
--- /dev/null
+++ b/Assets/NoSafeCircle/DoorPrototype/Tests/GameplayCapture/GameplayCaptureManifest.cs
@@ -0,0 +1,112 @@
+using System;
+using UnityEngine;
+
+namespace NoSafeCircle.DoorPrototype.Tests.GameplayCapture
+{
+    [Serializable]
+    internal sealed class CaptureManifest
+    {
+        public string git_commit;
+        public bool git_tree_dirty;
+        public string unity_version;
+        public string scene_path;
+        public string captured_utc;
+        public string screen_space_ui;
+        public ScreenCoordinateManifest screen_coordinates;
+        public ShotManifest[] shots;
+    }
+
+    [Serializable]
+    internal sealed class ScreenCoordinateManifest
+    {
+        public string origin;
+        public string y_direction;
+        public string pivot_definition;
+    }
+
+    [Serializable]
+    internal sealed class ShotManifest
+    {
+        public string name;
+        public string identity;
+        public string facing;
+        public string state;
+        public int walk_frame_index;
+        public string sprite_name;
+        public float sprite_pixels_per_unit;
+        public string texture_filter_mode;
+        public TransformManifest visual_transform;
+        public RenderManifest[] renders;
+    }
+
+    [Serializable]
+    internal sealed class TransformManifest
+    {
+        public Vector3Manifest world_position;
+        public Vector3Manifest local_scale;
+        public QuaternionManifest world_rotation;
+        public Vector3Manifest world_rotation_euler_degrees;
+    }
+
+    [Serializable]
+    internal sealed class RenderManifest
+    {
+        public int width;
+        public int height;
+        public CameraManifest camera;
+        public ScreenPositionManifest wizard_pivot_screen_pixels;
+        public string output_file;
+        public long size_bytes;
+        public string sha256;
+    }
+
+    [Serializable]
+    internal sealed class CameraManifest
+    {
+        public Vector3Manifest world_position;
+        public QuaternionManifest world_rotation;
+        public Vector3Manifest world_rotation_euler_degrees;
+        public float orthographic_size;
+        public float aspect;
+    }
+
+    [Serializable]
+    internal sealed class ScreenPositionManifest
+    {
+        public float x;
+        public float y;
+    }
+
+    [Serializable]
+    internal sealed class Vector3Manifest
+    {
+        public float x;
+        public float y;
+        public float z;
+
+        public static Vector3Manifest From(Vector3 value)
+        {
+            return new Vector3Manifest { x = value.x, y = value.y, z = value.z };
+        }
+    }
+
+    [Serializable]
+    internal sealed class QuaternionManifest
+    {
+        public float x;
+        public float y;
+        public float z;
+        public float w;
+
+        public static QuaternionManifest From(Quaternion value)
+        {
+            return new QuaternionManifest
+            {
+                x = value.x,
+                y = value.y,
+                z = value.z,
+                w = value.w
+            };
+        }
+    }
+}
