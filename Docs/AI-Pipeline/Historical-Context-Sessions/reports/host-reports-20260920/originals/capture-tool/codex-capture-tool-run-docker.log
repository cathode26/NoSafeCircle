diff --git a/Assets/NoSafeCircle/DoorPrototype/Tests/GameplayCapture/GameplayCaptureSpecTests.cs b/Assets/NoSafeCircle/DoorPrototype/Tests/GameplayCapture/GameplayCaptureSpecTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..85425524359c5551f95fda4392292d9e7f806ecb
--- /dev/null
+++ b/Assets/NoSafeCircle/DoorPrototype/Tests/GameplayCapture/GameplayCaptureSpecTests.cs
@@ -0,0 +1,130 @@
+using System;
+using NUnit.Framework;
+
+namespace NoSafeCircle.DoorPrototype.Tests.GameplayCapture
+{
+    public sealed class GameplayCaptureSpecTests
+    {
+        [Test]
+        public void Parse_AppliesCaptureDefaults()
+        {
+            const string json = @"{
+                ""shots"": [{
+                    ""name"": ""gameview"",
+                    ""identity"": ""masculine-light"",
+                    ""facing"": ""south-east"",
+                    ""state"": ""idle"",
+                    ""world_position"": { ""x"": -12.75, ""z"": -22.0 }
+                }]
+            }";
+
+            GameplayCaptureSpec spec = GameplayCaptureSpec.Parse(json);
+
+            Assert.AreEqual(1, spec.Shots.Count);
+            GameplayCaptureShot shot = spec.Shots[0];
+            Assert.IsTrue(shot.DisableEnemies);
+            Assert.AreEqual(-1, shot.WalkFrameIndex);
+            CollectionAssert.AreEqual(
+                new[]
+                {
+                    new CaptureResolution(1920, 1080),
+                    new CaptureResolution(2560, 1440)
+                },
+                shot.Resolutions);
+        }
+
+        [TestCase("south")]
+        [TestCase("south-east")]
+        [TestCase("east")]
+        [TestCase("north-east")]
+        [TestCase("north")]
+        [TestCase("north-west")]
+        [TestCase("west")]
+        [TestCase("south-west")]
+        public void IsFacingName_AcceptsEachGameplayFacing(string facing)
+        {
+            Assert.IsTrue(GameplayCaptureSpec.IsFacingName(facing));
+        }
+
+        [TestCase("South-East")]
+        [TestCase("southeast")]
+        [TestCase("forward")]
+        [TestCase("")]
+        [TestCase(null)]
+        public void IsFacingName_RejectsUnknownFacing(string facing)
+        {
+            Assert.IsFalse(GameplayCaptureSpec.IsFacingName(facing));
+        }
+
+        [TestCase("1920x1080", 1920, 1080)]
+        [TestCase("2560x1440", 2560, 1440)]
+        [TestCase("1x1", 1, 1)]
+        public void ResolutionParse_AcceptsPositiveDimensions(
+            string value,
+            int expectedWidth,
+            int expectedHeight)
+        {
+            CaptureResolution resolution = CaptureResolution.Parse(value);
+
+            Assert.AreEqual(expectedWidth, resolution.Width);
+            Assert.AreEqual(expectedHeight, resolution.Height);
+        }
+
+        [TestCase("1920X1080")]
+        [TestCase("1920")]
+        [TestCase("0x1080")]
+        [TestCase("-1x1080")]
+        [TestCase("1920x")]
+        [TestCase("")]
+        [TestCase(null)]
+        public void ResolutionParse_RejectsMalformedDimensions(string value)
+        {
+            Assert.Throws<FormatException>(() => CaptureResolution.Parse(value));
+        }
+
+        [Test]
+        public void Parse_RejectsUnknownIdentity()
+        {
+            const string json = @"{
+                ""shots"": [{
+                    ""name"": ""unknown"",
+                    ""identity"": ""masculine-blue"",
+                    ""facing"": ""south"",
+                    ""state"": ""idle"",
+                    ""world_position"": { ""x"": 0, ""z"": 0 }
+                }]
+            }";
+
+            FormatException exception = Assert.Throws<FormatException>(
+                () => GameplayCaptureSpec.Parse(json));
+            StringAssert.Contains("Unknown wizard identity", exception.Message);
+        }
+
+        [Test]
+        public void Parse_RequiresWalkFrameAndRejectsItForIdle()
+        {
+            const string missingWalkFrame = @"{
+                ""shots"": [{
+                    ""name"": ""walking"",
+                    ""identity"": ""feminine-light"",
+                    ""facing"": ""west"",
+                    ""state"": ""walk"",
+                    ""world_position"": { ""x"": 0, ""z"": 0 }
+                }]
+            }";
+            const string idleWithWalkFrame = @"{
+                ""shots"": [{
+                    ""name"": ""idle"",
+                    ""identity"": ""feminine-light"",
+                    ""facing"": ""west"",
+                    ""state"": ""idle"",
+                    ""walk_frame_index"": 0,
+                    ""world_position"": { ""x"": 0, ""z"": 0 }
+                }]
+            }";
+
+            Assert.Throws<FormatException>(() => GameplayCaptureSpec.Parse(missingWalkFrame));
+            Assert.Throws<FormatException>(() => GameplayCaptureSpec.Parse(idleWithWalkFrame));
+        }
+    }
+}
