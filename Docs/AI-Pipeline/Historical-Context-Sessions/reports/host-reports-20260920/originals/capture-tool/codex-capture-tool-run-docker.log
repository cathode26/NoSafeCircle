diff --git a/Assets/NoSafeCircle/DoorPrototype/Tests/GameplayCapture/GameplayCaptureRenderer.cs b/Assets/NoSafeCircle/DoorPrototype/Tests/GameplayCapture/GameplayCaptureRenderer.cs
new file mode 100644
index 0000000000000000000000000000000000000000..10bbeb8b0ab35c0b5a31956e792a5ab4d898f0a1
--- /dev/null
+++ b/Assets/NoSafeCircle/DoorPrototype/Tests/GameplayCapture/GameplayCaptureRenderer.cs
@@ -0,0 +1,159 @@
+using System;
+using System.IO;
+using System.Security.Cryptography;
+using UnityEngine;
+
+namespace NoSafeCircle.DoorPrototype.Tests.GameplayCapture
+{
+    internal static class GameplayCaptureRenderer
+    {
+        public static RenderManifest Capture(
+            Camera camera,
+            Transform wizardVisual,
+            CaptureResolution resolution,
+            string outputPath)
+        {
+            if (camera == null) throw new ArgumentNullException(nameof(camera));
+            if (wizardVisual == null) throw new ArgumentNullException(nameof(wizardVisual));
+            if (File.Exists(outputPath))
+            {
+                throw new IOException($"Capture output already exists: {outputPath}");
+            }
+
+            RenderTexture previousTarget = camera.targetTexture;
+            RenderTexture previousActive = RenderTexture.active;
+            float previousAspect = camera.aspect;
+            RenderTexture renderTexture = null;
+            Texture2D readback = null;
+
+            try
+            {
+                renderTexture = new RenderTexture(
+                    resolution.Width,
+                    resolution.Height,
+                    24,
+                    RenderTextureFormat.ARGB32,
+                    RenderTextureReadWrite.Default)
+                {
+                    antiAliasing = 1,
+                    useMipMap = false,
+                    autoGenerateMips = false,
+                    name = $"GameplayCapture_{resolution.Width}x{resolution.Height}"
+                };
+                if (!renderTexture.Create() || !renderTexture.IsCreated())
+                {
+                    throw new InvalidOperationException(
+                        $"Unity could not create the {resolution} gameplay RenderTexture.");
+                }
+
+                camera.targetTexture = renderTexture;
+                camera.aspect = resolution.Width / (float)resolution.Height;
+                camera.Render();
+
+                RenderTexture.active = renderTexture;
+                readback = new Texture2D(
+                    resolution.Width,
+                    resolution.Height,
+                    TextureFormat.RGBA32,
+                    false);
+                readback.ReadPixels(
+                    new Rect(0f, 0f, resolution.Width, resolution.Height),
+                    0,
+                    0,
+                    false);
+                readback.Apply(false, false);
+
+                RejectFlatColor(readback, resolution);
+                byte[] pngBytes = readback.EncodeToPNG();
+                if (pngBytes == null || pngBytes.Length == 0)
+                {
+                    throw new InvalidOperationException(
+                        $"Unity returned no PNG bytes for the {resolution} gameplay capture.");
+                }
+
+                File.WriteAllBytes(outputPath, pngBytes);
+                FileInfo outputFile = new FileInfo(outputPath);
+                if (!outputFile.Exists || outputFile.Length <= 0)
+                {
+                    throw new IOException($"Gameplay capture was not written successfully: {outputPath}");
+                }
+
+                Vector3 viewportPivot = camera.WorldToViewportPoint(wizardVisual.position);
+                return new RenderManifest
+                {
+                    width = resolution.Width,
+                    height = resolution.Height,
+                    camera = new CameraManifest
+                    {
+                        world_position = Vector3Manifest.From(camera.transform.position),
+                        world_rotation = QuaternionManifest.From(camera.transform.rotation),
+                        world_rotation_euler_degrees = Vector3Manifest.From(camera.transform.eulerAngles),
+                        orthographic_size = camera.orthographicSize,
+                        aspect = camera.aspect
+                    },
+                    wizard_pivot_screen_pixels = new ScreenPositionManifest
+                    {
+                        x = viewportPivot.x * resolution.Width,
+                        y = viewportPivot.y * resolution.Height
+                    },
+                    output_file = Path.GetFileName(outputPath),
+                    size_bytes = outputFile.Length,
+                    sha256 = ComputeSha256(outputPath)
+                };
+            }
+            catch (Exception exception)
+            {
+                throw new InvalidOperationException(
+                    $"Gameplay rendering failed for {resolution} at '{outputPath}'.",
+                    exception);
+            }
+            finally
+            {
+                camera.targetTexture = previousTarget;
+                camera.aspect = previousAspect;
+                RenderTexture.active = previousActive;
+
+                if (renderTexture != null)
+                {
+                    renderTexture.Release();
+                    UnityEngine.Object.Destroy(renderTexture);
+                }
+
+                if (readback != null)
+                {
+                    UnityEngine.Object.Destroy(readback);
+                }
+            }
+        }
+
+        private static void RejectFlatColor(Texture2D texture, CaptureResolution resolution)
+        {
+            Color32[] pixels = texture.GetPixels32();
+            if (pixels == null || pixels.Length == 0)
+            {
+                throw new InvalidOperationException(
+                    $"The {resolution} render did not return any readable pixels.");
+            }
+
+            Color32 first = pixels[0];
+            for (int index = 1; index < pixels.Length; index++)
+            {
+                if (!pixels[index].Equals(first)) return;
+            }
+
+            throw new InvalidOperationException(
+                $"The {resolution} gameplay capture is one flat RGBA color " +
+                $"({first.r}, {first.g}, {first.b}, {first.a}).");
+        }
+
+        private static string ComputeSha256(string path)
+        {
+            using (FileStream stream = File.OpenRead(path))
+            using (SHA256 algorithm = SHA256.Create())
+            {
+                byte[] hash = algorithm.ComputeHash(stream);
+                return BitConverter.ToString(hash).Replace("-", string.Empty).ToLowerInvariant();
+            }
+        }
+    }
+}
