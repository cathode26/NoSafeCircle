diff --git a/Assets/NoSafeCircle/DoorPrototype/Tests/GameplayCapture/GameplayCapturePlayModeTest.cs b/Assets/NoSafeCircle/DoorPrototype/Tests/GameplayCapture/GameplayCapturePlayModeTest.cs
new file mode 100644
index 0000000000000000000000000000000000000000..b259d88dccc3a500d5f3a4de57039482939ae086
--- /dev/null
+++ b/Assets/NoSafeCircle/DoorPrototype/Tests/GameplayCapture/GameplayCapturePlayModeTest.cs
@@ -0,0 +1,501 @@
+using System;
+using System.Collections;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Reflection;
+using System.Text;
+using NUnit.Framework;
+using UnityEngine;
+using UnityEngine.SceneManagement;
+using UnityEngine.TestTools;
+
+namespace NoSafeCircle.DoorPrototype.Tests.GameplayCapture
+{
+    public sealed class GameplayCapturePlayModeTest
+    {
+        public const string ExactTestFilter =
+            "NoSafeCircle.DoorPrototype.Tests.GameplayCapture.GameplayCapturePlayModeTest.CaptureShots";
+
+        private const string SceneName = "DoorPrototype";
+        private const string ScenePath = "Assets/Scenes/DoorPrototype.unity";
+        private const string SpecEnvironmentVariable = "NSC_GAMEPLAY_CAPTURE_SPEC";
+        private const string OutputEnvironmentVariable = "NSC_GAMEPLAY_CAPTURE_OUTPUT";
+        private const string CommitEnvironmentVariable = "NSC_GAMEPLAY_CAPTURE_GIT_COMMIT";
+        private const string DirtyEnvironmentVariable = "NSC_GAMEPLAY_CAPTURE_GIT_DIRTY";
+
+        [Explicit("Writes requested gameplay evidence outside the repository.")]
+        [Category("GameplayCapture")]
+        [UnityTest]
+        public IEnumerator CaptureShots()
+        {
+            CaptureInputs inputs = ReadInputs();
+            GameplayCaptureSpec spec = GameplayCaptureSpec.Parse(File.ReadAllText(inputs.SpecPath));
+            IReadOnlyDictionary<string, WizardIdentity> builderIdentities = ReadBuilderIdentityTable();
+            ValidateSpecIdentities(spec, builderIdentities);
+
+            var shotManifests = new ShotManifest[spec.Shots.Count];
+            for (int shotIndex = 0; shotIndex < spec.Shots.Count; shotIndex++)
+            {
+                GameplayCaptureShot shot = spec.Shots[shotIndex];
+                yield return SceneManager.LoadSceneAsync(SceneName, LoadSceneMode.Single);
+
+                Scene scene = SceneManager.GetSceneByName(SceneName);
+                if (!scene.IsValid() || !scene.isLoaded || scene.path != ScenePath)
+                {
+                    throw new InvalidOperationException(
+                        $"Gameplay capture loaded '{scene.path}' instead of '{ScenePath}'.");
+                }
+
+                if (shot.DisableEnemies)
+                {
+                    GameObject enemies = FindRoot(scene, "Enemies");
+                    enemies.SetActive(false);
+                }
+
+                ApplyIdentityThroughSelection(scene, shot.Identity);
+
+                GameObject player = FindRoot(scene, "Player");
+                PlayerMovement movement = RequireComponent<PlayerMovement>(player);
+                PlayerInteractionController interaction =
+                    RequireComponent<PlayerInteractionController>(player);
+                WizardAnimationController wizard =
+                    RequireComponent<WizardAnimationController>(player);
+                Animator animator = RequireComponent<Animator>(player);
+                Transform visual = player.transform.Find("Visual");
+                if (visual == null)
+                {
+                    throw new InvalidOperationException("The Player has no Visual child.");
+                }
+
+                SpriteRenderer spriteRenderer = RequireComponent<SpriteRenderer>(visual.gameObject);
+                movement.ResetMovement();
+                movement.SuspendGameplayInput();
+                interaction.SuspendGameplayInput();
+                movement.enabled = false;
+                wizard.enabled = false;
+
+                Vector3 playerPosition = player.transform.position;
+                player.transform.position = new Vector3(shot.WorldX, playerPosition.y, shot.WorldZ);
+                Physics.SyncTransforms();
+                ApplyAnimationFrame(animator, spriteRenderer, shot);
+
+                // One complete player-loop iteration runs IsometricCameraFollow.LateUpdate after
+                // the deterministic position and animation state have been installed.
+                yield return null;
+
+                GameObject cameraObject = FindRoot(scene, "Main Camera");
+                Camera gameplayCamera = RequireComponent<Camera>(cameraObject);
+                if (!gameplayCamera.orthographic)
+                {
+                    throw new InvalidOperationException("The gameplay camera is not orthographic.");
+                }
+
+                Sprite sprite = spriteRenderer.sprite;
+                if (sprite == null || sprite.texture == null)
+                {
+                    throw new InvalidOperationException(
+                        $"Shot '{shot.Name}' has no Sprite or source Texture after animation sampling.");
+                }
+
+                var renderManifests = new RenderManifest[shot.Resolutions.Count];
+                for (int resolutionIndex = 0;
+                    resolutionIndex < shot.Resolutions.Count;
+                    resolutionIndex++)
+                {
+                    CaptureResolution resolution = shot.Resolutions[resolutionIndex];
+                    string outputPath = Path.Combine(
+                        inputs.OutputDirectory,
+                        shot.Name + "_" + resolution.Height.ToString(CultureInfo.InvariantCulture) + "p.png");
+                    renderManifests[resolutionIndex] = GameplayCaptureRenderer.Capture(
+                        gameplayCamera,
+                        visual,
+                        resolution,
+                        outputPath);
+                }
+
+                shotManifests[shotIndex] = new ShotManifest
+                {
+                    name = shot.Name,
+                    identity = shot.Identity.Key,
+                    facing = shot.Facing,
+                    state = shot.State,
+                    walk_frame_index = shot.WalkFrameIndex,
+                    sprite_name = sprite.name,
+                    sprite_pixels_per_unit = sprite.pixelsPerUnit,
+                    texture_filter_mode = sprite.texture.filterMode.ToString(),
+                    visual_transform = new TransformManifest
+                    {
+                        world_position = Vector3Manifest.From(visual.position),
+                        local_scale = Vector3Manifest.From(visual.localScale),
+                        world_rotation = QuaternionManifest.From(visual.rotation),
+                        world_rotation_euler_degrees = Vector3Manifest.From(visual.eulerAngles)
+                    },
+                    renders = renderManifests
+                };
+            }
+
+            var manifest = new CaptureManifest
+            {
+                git_commit = inputs.GitCommit,
+                git_tree_dirty = inputs.GitTreeDirty,
+                unity_version = Application.unityVersion,
+                scene_path = ScenePath,
+                captured_utc = DateTime.UtcNow.ToString("o", CultureInfo.InvariantCulture),
+                screen_space_ui =
+                    "Excluded. Camera.Render to the gameplay camera's RenderTexture does not include " +
+                    "the Screen Space - Overlay Canvas.",
+                screen_coordinates = new ScreenCoordinateManifest
+                {
+                    origin = "bottom-left of the output PNG",
+                    y_direction = "positive upward",
+                    pivot_definition =
+                        "Visual Transform origin (the imported wizard Sprite pivot at bottom-center)"
+                },
+                shots = shotManifests
+            };
+
+            WriteManifest(inputs.OutputDirectory, manifest);
+        }
+
+        [UnityTearDown]
+        public IEnumerator UnloadCanonicalSceneWithoutSaving()
+        {
+            Scene scene = SceneManager.GetSceneByName(SceneName);
+            if (!scene.IsValid() || !scene.isLoaded) yield break;
+
+            Scene cleanupScene = SceneManager.CreateScene("GameplayCaptureCleanup");
+            SceneManager.SetActiveScene(cleanupScene);
+            yield return SceneManager.UnloadSceneAsync(scene);
+        }
+
+        private static CaptureInputs ReadInputs()
+        {
+            string specPath = ReadRequiredEnvironmentVariable(SpecEnvironmentVariable);
+            string outputDirectory = ReadRequiredEnvironmentVariable(OutputEnvironmentVariable);
+            string gitCommit = ReadRequiredEnvironmentVariable(CommitEnvironmentVariable);
+            string dirtyValue = ReadRequiredEnvironmentVariable(DirtyEnvironmentVariable);
+
+            specPath = Path.GetFullPath(specPath);
+            outputDirectory = Path.GetFullPath(outputDirectory);
+            if (!File.Exists(specPath))
+            {
+                throw new FileNotFoundException("Gameplay capture spec does not exist.", specPath);
+            }
+
+            if (!IsGitCommit(gitCommit))
+            {
+                throw new FormatException(
+                    $"{CommitEnvironmentVariable} must be a 40-character hexadecimal commit.");
+            }
+
+            if (!bool.TryParse(dirtyValue, out bool isDirty))
+            {
+                throw new FormatException(
+                    $"{DirtyEnvironmentVariable} must be 'true' or 'false'.");
+            }
+
+            string projectRoot = Path.GetFullPath(Directory.GetParent(Application.dataPath).FullName);
+            if (IsSameOrChildPath(outputDirectory, projectRoot))
+            {
+                throw new InvalidOperationException(
+                    $"Gameplay capture output must be outside the repository: {outputDirectory}");
+            }
+
+            Directory.CreateDirectory(outputDirectory);
+            string manifestPath = Path.Combine(outputDirectory, "capture-manifest.json");
+            if (File.Exists(manifestPath))
+            {
+                throw new IOException($"Capture manifest already exists: {manifestPath}");
+            }
+
+            return new CaptureInputs(specPath, outputDirectory, gitCommit, isDirty);
+        }
+
+        private static string ReadRequiredEnvironmentVariable(string name)
+        {
+            string value = Environment.GetEnvironmentVariable(name);
+            if (string.IsNullOrWhiteSpace(value))
+            {
+                throw new InvalidOperationException(
+                    $"Required gameplay capture environment variable '{name}' is missing.");
+            }
+
+            return value;
+        }
+
+        private static bool IsSameOrChildPath(string candidate, string parent)
+        {
+            string normalizedCandidate = Path.GetFullPath(candidate)
+                .TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
+            string normalizedParent = Path.GetFullPath(parent)
+                .TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
+            if (string.Equals(normalizedCandidate, normalizedParent, StringComparison.OrdinalIgnoreCase))
+            {
+                return true;
+            }
+
+            return normalizedCandidate.StartsWith(
+                normalizedParent + Path.DirectorySeparatorChar,
+                StringComparison.OrdinalIgnoreCase);
+        }
+
+        private static bool IsGitCommit(string value)
+        {
+            if (value == null || value.Length != 40) return false;
+
+            foreach (char character in value)
+            {
+                bool isDigit = character >= '0' && character <= '9';
+                bool isLowerHex = character >= 'a' && character <= 'f';
+                bool isUpperHex = character >= 'A' && character <= 'F';
+                if (!isDigit && !isLowerHex && !isUpperHex) return false;
+            }
+
+            return true;
+        }
+
+        private static IReadOnlyDictionary<string, WizardIdentity> ReadBuilderIdentityTable()
+        {
+            Assembly editorAssembly = AppDomain.CurrentDomain.GetAssemblies()
+                .SingleOrDefault(candidate =>
+                    candidate.GetName().Name == "NoSafeCircle.DoorPrototype.Editor");
+            if (editorAssembly == null)
+            {
+                throw new InvalidOperationException(
+                    "The Door Prototype Editor assembly containing the wizard identity table is not loaded.");
+            }
+
+            Type builderType = editorAssembly.GetType(
+                "NoSafeCircle.DoorPrototype.Editor.World.DoorPrototypeGlobalSceneBuilder",
+                true);
+            FieldInfo tableField = builderType.GetField(
+                "WizardSelectionDefinitions",
+                BindingFlags.Static | BindingFlags.NonPublic);
+            if (tableField == null || !(tableField.GetValue(null) is Array definitions))
+            {
+                throw new InvalidOperationException(
+                    "The builder's WizardSelectionDefinitions identity table could not be read.");
+            }
+
+            var identities = new Dictionary<string, WizardIdentity>(StringComparer.Ordinal);
+            foreach (object definition in definitions)
+            {
+                Type definitionType = definition.GetType();
+                string key = (string)RequireField(definitionType, "sourceVariant").GetValue(definition);
+                WizardPresentation presentation = (WizardPresentation)RequireField(
+                    definitionType,
+                    "presentation").GetValue(definition);
+                WizardSkin skin = (WizardSkin)RequireField(definitionType, "skin").GetValue(definition);
+                if (!identities.TryAdd(key, new WizardIdentity(key, presentation, skin)))
+                {
+                    throw new InvalidOperationException(
+                        $"The builder's wizard identity table repeats key '{key}'.");
+                }
+            }
+
+            return identities;
+        }
+
+        private static FieldInfo RequireField(Type type, string fieldName)
+        {
+            FieldInfo field = type.GetField(
+                fieldName,
+                BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
+            if (field == null)
+            {
+                throw new InvalidOperationException(
+                    $"Required identity-table field '{fieldName}' is missing from {type.FullName}.");
+            }
+
+            return field;
+        }
+
+        private static void ValidateSpecIdentities(
+            GameplayCaptureSpec spec,
+            IReadOnlyDictionary<string, WizardIdentity> builderIdentities)
+        {
+            foreach (GameplayCaptureShot shot in spec.Shots)
+            {
+                if (!builderIdentities.TryGetValue(shot.Identity.Key, out WizardIdentity identity) ||
+                    identity.Presentation != shot.Identity.Presentation ||
+                    identity.Skin != shot.Identity.Skin)
+                {
+                    throw new InvalidOperationException(
+                        $"Shot '{shot.Name}' identity '{shot.Identity.Key}' does not match the " +
+                        "current DoorPrototypeGlobalSceneBuilder identity table.");
+                }
+            }
+        }
+
+        private static void ApplyIdentityThroughSelection(Scene scene, WizardIdentity identity)
+        {
+            GameObject canvas = FindRoot(scene, "Canvas");
+            TitleScreenController title = RequireComponent<TitleScreenController>(canvas);
+            WizardSelectionController selection =
+                RequireComponent<WizardSelectionController>(canvas);
+            WizardGameEntryController entry = RequireComponent<WizardGameEntryController>(canvas);
+            if (!selection.HasValidOptionCatalog)
+            {
+                throw new InvalidOperationException(
+                    "The scene's WizardSelectionController option catalog is invalid.");
+            }
+
+            int matchingIndex = -1;
+            for (int index = 0; index < selection.OptionCount; index++)
+            {
+                WizardSelectionOptionBinding option = selection.GetOption(index);
+                if (option.Presentation != identity.Presentation || option.Skin != identity.Skin) continue;
+                if (matchingIndex >= 0)
+                {
+                    throw new InvalidOperationException(
+                        $"The scene repeats wizard identity '{identity.Key}'.");
+                }
+
+                matchingIndex = index;
+            }
+
+            if (matchingIndex < 0)
+            {
+                throw new InvalidOperationException(
+                    $"The scene does not contain wizard identity '{identity.Key}'.");
+            }
+
+            title.StartGame();
+            selection.SelectOption(matchingIndex);
+            selection.ConfirmSelection();
+
+            var expected = new ConfirmedWizardSelection(identity.Presentation, identity.Skin);
+            if (selection.ConfirmedSelection != expected || !entry.HasEnteredGameplay ||
+                entry.AppliedSelection != expected)
+            {
+                throw new InvalidOperationException(
+                    $"The game's selection path did not apply wizard identity '{identity.Key}'.");
+            }
+        }
+
+        private static void ApplyAnimationFrame(
+            Animator animator,
+            SpriteRenderer spriteRenderer,
+            GameplayCaptureShot shot)
+        {
+            if (animator.runtimeAnimatorController == null)
+            {
+                throw new InvalidOperationException("The Player Animator has no runtime controller.");
+            }
+
+            string presentation = shot.Identity.Presentation.ToString();
+            string skin = shot.Identity.Skin.ToString();
+            string stateName = $"Wizard_{presentation}_{skin}_{shot.State}_{shot.Facing}";
+            int stateHash = Animator.StringToHash(stateName);
+            if (!animator.HasState(0, stateHash))
+            {
+                throw new InvalidOperationException(
+                    $"The Player Animator does not contain state '{stateName}'.");
+            }
+
+            AnimationClip[] matchingClips = animator.runtimeAnimatorController.animationClips
+                .Where(clip => clip != null && clip.name == stateName)
+                .Distinct()
+                .ToArray();
+            if (matchingClips.Length != 1)
+            {
+                throw new InvalidOperationException(
+                    $"Expected one animation clip named '{stateName}', found {matchingClips.Length}.");
+            }
+
+            AnimationClip clip = matchingClips[0];
+            int frameCount = Mathf.Max(1, Mathf.RoundToInt(clip.length * clip.frameRate));
+            float normalizedTime = 0f;
+            if (shot.State == "walk")
+            {
+                if (shot.WalkFrameIndex >= frameCount)
+                {
+                    throw new InvalidOperationException(
+                        $"Shot '{shot.Name}' requests walk frame {shot.WalkFrameIndex}, but " +
+                        $"'{stateName}' has {frameCount} frames.");
+                }
+
+                normalizedTime = (shot.WalkFrameIndex + 0.5f) / frameCount;
+            }
+
+            animator.speed = 0f;
+            animator.Play(stateHash, 0, normalizedTime);
+            animator.Update(0f);
+            if (!animator.GetCurrentAnimatorStateInfo(0).IsName(stateName) || spriteRenderer.sprite == null)
+            {
+                throw new InvalidOperationException(
+                    $"Animator sampling did not show a Sprite from state '{stateName}'.");
+            }
+        }
+
+        private static GameObject FindRoot(Scene scene, string name)
+        {
+            GameObject[] matches = scene.GetRootGameObjects()
+                .Where(root => root.name == name)
+                .ToArray();
+            if (matches.Length != 1)
+            {
+                throw new InvalidOperationException(
+                    $"Expected exactly one '{name}' root in '{scene.path}', found {matches.Length}.");
+            }
+
+            return matches[0];
+        }
+
+        private static T RequireComponent<T>(GameObject gameObject) where T : Component
+        {
+            T component = gameObject.GetComponent<T>();
+            if (component == null)
+            {
+                throw new InvalidOperationException(
+                    $"GameObject '{gameObject.name}' requires {typeof(T).Name} for gameplay capture.");
+            }
+
+            return component;
+        }
+
+        private static void WriteManifest(string outputDirectory, CaptureManifest manifest)
+        {
+            string finalPath = Path.Combine(outputDirectory, "capture-manifest.json");
+            string temporaryPath = Path.Combine(
+                outputDirectory,
+                ".capture-manifest-" + Guid.NewGuid().ToString("N") + ".tmp");
+            try
+            {
+                string json = JsonUtility.ToJson(manifest, true) + Environment.NewLine;
+                File.WriteAllText(temporaryPath, json, new UTF8Encoding(false));
+                File.Move(temporaryPath, finalPath);
+            }
+            catch (Exception exception)
+            {
+                throw new IOException($"Capture manifest could not be written to '{finalPath}'.", exception);
+            }
+            finally
+            {
+                if (File.Exists(temporaryPath)) File.Delete(temporaryPath);
+            }
+        }
+
+        private readonly struct CaptureInputs
+        {
+            public CaptureInputs(
+                string specPath,
+                string outputDirectory,
+                string gitCommit,
+                bool gitTreeDirty)
+            {
+                SpecPath = specPath;
+                OutputDirectory = outputDirectory;
+                GitCommit = gitCommit;
+                GitTreeDirty = gitTreeDirty;
+            }
+
+            public string SpecPath { get; }
+            public string OutputDirectory { get; }
+            public string GitCommit { get; }
+            public bool GitTreeDirty { get; }
+        }
+    }
+}
