using UnityEngine.TestTools;

namespace NoSafeCircle.DoorPrototype.Tests
{
    public sealed class EnemyLanternWispCasterPlayModeTests
    {
        private GameObject wraithObject;
        private EnemyLanternWispCaster caster;
