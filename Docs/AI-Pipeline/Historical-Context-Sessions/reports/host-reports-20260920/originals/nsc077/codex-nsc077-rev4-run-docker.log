            meleeAnimation.Tick(0.1f);
            Assert.That(meleeAnimation.CurrentState, Does.StartWith("MeleeEnemy_idle_"));
            Assert.AreEqual(
                DirectionFor(player.transform.position - melee.transform.position),
                meleeAnimation.LastDirection);

