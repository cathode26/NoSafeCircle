            EnemyPursuitMovement pursuit = melee.GetComponent<EnemyPursuitMovement>();
            pursuit.enabled = false;
            NavMeshAgent agent = melee.GetComponent<NavMeshAgent>();
            if (agent.isOnNavMesh)
            {
