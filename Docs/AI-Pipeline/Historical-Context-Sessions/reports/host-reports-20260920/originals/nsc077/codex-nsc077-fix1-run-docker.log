   445	        private static void BuildChaseEnemy(
   446	            Transform player,
   447	            string architecturalTileAssetFolder,
   448	            Transform enemiesRoot,
   449	            Vector3 spawnPosition,
   450	            EnemyAnimationAssetBuilder.EnemyAnimationAssets animationAssets)
   451	        {
   452	            var enemy = new GameObject("MeleeEnemy");
   453	            enemy.transform.SetParent(enemiesRoot, false);
   454	            enemy.transform.position = spawnPosition;
   455	
   456	            // Match the agent to the project-configured type the surface was baked with; a
   457	            // mismatched radius/height silently refuses to produce a complete path.
   458	            var agent = enemy.AddComponent<NavMeshAgent>();
   459	            NavMeshBuildSettings navigationSettings = NavMesh.GetSettingsByIndex(0);
   460	            agent.agentTypeID = navigationSettings.agentTypeID;
   461	            agent.radius = navigationSettings.agentRadius;
   462	            agent.height = navigationSettings.agentHeight;
   463	            agent.speed = 2.2f;
   464	            agent.acceleration = 12f;
   465	            agent.angularSpeed = 720f;
   466	            agent.stoppingDistance = 0.6f;
   467	            agent.autoBraking = true;
   468	
   469	            SpriteRenderer visual = DoorPrototypeSceneBuilder.CreateWorldSpriteVisual(
   470	                "Visual",
   471	                "MeleeEnemySprite",
   472	                enemy.transform,
   473	                Vector3.zero,
   474	                Quaternion.Euler(IsometricCameraEulerAngles),
   475	                Vector2.one,
   476	                CreateWizardSilhouettePixels(
   477	                    DoorPrototypeSceneBuilder.WorldSpriteTextureSize,
   478	                    DoorPrototypeSceneBuilder.WorldSpriteTextureSize,
   479	                    EnemySpriteFillColor,
   480	                    EnemySpriteBorderColor),
   481	                architecturalTileAssetFolder);
   482	            visual.sprite = animationAssets.MeleeSouthIdle;
   483	
   484	            // EnemyPursuitMovement and EnemyLockedDoorAttack both resolve their collaborators
   485	            // through GetComponent in Awake, so only the wizard Transform needs injecting here.
   486	            EnemyTargetKnowledge targetKnowledge = enemy.AddComponent<EnemyTargetKnowledge>();
   487	            targetKnowledge.Initialize(player);
   488	
   489	            // Authored enemies only: a closed door's doorwayBlocker or a wall must hide the
   490	            // wizard. Component tests construct EnemyTargetKnowledge directly and keep the
   491	            // distance-only acquisition contract, which defaults this off.
   492	            targetKnowledge.SetRequiresLineOfSight(true);
   493	
   494	            // Each room is 20-26 units deep with a door at either boundary, so a 5-unit leash
   495	            // around a mid-room post keeps every enemy at least ~5 units clear of both doors.
   496	            // Without it, pursuit converges on the doorway and the wizard opens a door into an
   497	            // enemy already standing in it.
   498	            targetKnowledge.SetMaximumPursuitDistanceFromStart(EnemyPursuitLeashDistance);
   499	
   500	            enemy.AddComponent<EnemyPursuitMovement>();

