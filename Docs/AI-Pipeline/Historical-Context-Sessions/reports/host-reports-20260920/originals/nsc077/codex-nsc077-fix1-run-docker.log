+            string[][] stateNames = walking ? WalkStateNames : IdleStateNames;
+            int[][] stateHashes = walking ? WalkStateHashes : IdleStateHashes;
+            string state = stateNames[kindIndex][directionIndex];
+            if (state == currentState) return;
+
+            currentState = state;
