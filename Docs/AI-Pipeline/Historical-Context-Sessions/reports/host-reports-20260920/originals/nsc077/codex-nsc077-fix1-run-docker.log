   303	        private static Dictionary<string, Sprite> ImportSprites(IEnumerable<SourceFrame> frames)
   304	        {
   305	            var spritesByPath = new Dictionary<string, Sprite>(StringComparer.Ordinal);
   306	            foreach (SourceFrame frame in frames)
   307	            {
   308	                AssetDatabase.ImportAsset(frame.Path, ImportAssetOptions.ForceUpdate);
   309	                TextureImporter importer = AssetImporter.GetAtPath(frame.Path) as TextureImporter;
   310	                if (importer == null)
   311	                {
   312	                    throw new FileNotFoundException("Enemy source is not a texture", frame.Path);
   313	                }
   314	
   315	                importer.textureType = TextureImporterType.Sprite;
   316	                importer.textureShape = TextureImporterShape.Texture2D;
   317	                importer.spriteImportMode = SpriteImportMode.Single;
   318	                importer.filterMode = FilterMode.Point;
   319	                importer.textureCompression = TextureImporterCompression.Uncompressed;
   320	                importer.mipmapEnabled = false;
   321	                importer.spritePixelsPerUnit = EnemyPixelsPerUnit;
   322	
   323	                var settings = new TextureImporterSettings();
   324	                importer.ReadTextureSettings(settings);
   325	                settings.spriteAlignment = (int)SpriteAlignment.Custom;
   326	                settings.spritePivot = new Vector2(0.5f, frame.PivotY);
   327	                importer.SetTextureSettings(settings);
   328	                ClearCookieImportDefaults(importer);
   329	                importer.SaveAndReimport();
   330	
   331	                Sprite sprite = AssetDatabase.LoadAssetAtPath<Sprite>(frame.Path);
   332	                if (sprite == null)
   333	                {
   334	                    throw new InvalidDataException(
   335	                        "Enemy source did not import as a Sprite: " + frame.Path);
   336	                }
   337	
   338	                spritesByPath.Add(frame.Path, sprite);
   339	            }
   340	
   341	            return spritesByPath;
   342	        }
