   111	        private static List<SourceFrame> CollectAndValidateSourceFrames(WalkInventory inventory)
   112	        {
   113	            var frames = new List<SourceFrame>(112);
   114	            var expectedPaths = new HashSet<string>(StringComparer.Ordinal);
   115	
   116	            foreach (EnemyDefinition enemy in EnemyDefinitions)
   117	            {
   118	                foreach (DirectionDefinition direction in DirectionDefinitions)
   119	                {
   120	                    string idlePath = IdlePath(enemy.SourceName, direction.Code);
   121	                    AddExpectedPath(expectedPaths, idlePath);
   122	                    frames.Add(LoadSourceFrame(
   123	                        idlePath,
   124	                        enemy.SourceName,
   125	                        direction.Name,
   126	                        IdleSourceSize,
   127	                        FindIdleGroundLineFromBottom(idlePath)));
   128	
   129	                    for (int frameIndex = 0; frameIndex < WalkFrameCount; frameIndex++)
   130	                    {
   131	                        string walkPath = WalkPath(
   132	                            enemy.SourceName, direction.Code, frameIndex);
   133	                        AddExpectedPath(expectedPaths, walkPath);
   134	                        frames.Add(LoadSourceFrame(
   135	                            walkPath,
   136	                            enemy.SourceName,
   137	                            direction.Name,
   138	                            WalkSourceSize,
   139	                            WalkSourceSize - inventory.alpha_bottom_y_from_top));
   140	                    }
   141	                }
   142	            }
   143	
   144	            string[] actualPaths = Directory.GetFiles(SourceRoot, "*.png", SearchOption.AllDirectories)
   145	                .Select(NormalizePath)
   146	                .OrderBy(path => path, StringComparer.Ordinal)
   147	                .ToArray();
   148	            string[] duplicatePaths = actualPaths
   149	                .GroupBy(path => path, StringComparer.Ordinal)
   150	                .Where(group => group.Count() > 1)
   151	                .Select(group => group.Key)
   152	                .ToArray();
   153	            if (duplicatePaths.Length > 0)
   154	            {
   155	                throw new InvalidDataException(
   156	                    "Duplicate enemy source PNG: " + duplicatePaths[0]);
   157	            }
   158	
   159	            string missingPath = expectedPaths.Except(actualPaths).FirstOrDefault();
   160	            if (missingPath != null)
   161	            {
   162	                throw new FileNotFoundException("Missing enemy source PNG", missingPath);
   163	            }
   164	
   165	            string extraPath = actualPaths.Except(expectedPaths).FirstOrDefault();
   166	            if (extraPath != null)
   167	            {
   168	                throw new InvalidDataException("Unexpected enemy source PNG: " + extraPath);
   169	            }
   170	
   171	            return frames;
   172	        }
