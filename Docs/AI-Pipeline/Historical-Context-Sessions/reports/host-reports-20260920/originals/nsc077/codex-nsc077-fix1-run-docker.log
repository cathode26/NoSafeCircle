   255	        private static WalkInventory LoadAndValidateInventory()
   256	        {
   257	            string path = WalkSourceRoot + "/inventory.json";
   258	            if (!File.Exists(path))
   259	            {
   260	                throw new FileNotFoundException("Enemy walk inventory is missing", path);
   261	            }
   262	
   263	            WalkInventory inventory = JsonUtility.FromJson<WalkInventory>(File.ReadAllText(path));
   264	            if (inventory == null || inventory.canvas_size == null ||
   265	                inventory.canvas_size.Length != 2 ||
   266	                inventory.canvas_size[0] != WalkSourceSize ||
   267	                inventory.canvas_size[1] != WalkSourceSize)
   268	            {
   269	                throw new InvalidDataException("Enemy walk inventory has the wrong canvas size: " + path);
   270	            }
   271	
   272	            if (inventory.alpha_bottom_y_from_top != 132)
   273	            {
   274	                throw new InvalidDataException("Enemy walk inventory has the wrong ground line: " + path);
   275	            }
   276	
   277	            string[] entryFiles = inventory.entries == null
   278	                ? Array.Empty<string>()
   279	                : inventory.entries.Select(entry => entry.file).ToArray();
   280	            string duplicate = entryFiles.GroupBy(file => file, StringComparer.Ordinal)
   281	                .FirstOrDefault(group => group.Count() > 1)?.Key;
   282	            if (duplicate != null)
   283	            {
   284	                throw new InvalidDataException("Duplicate enemy walk inventory entry: " + duplicate);
   285	            }
   286	
   287	            string[] expectedFiles = ExpectedWalkFileNames().ToArray();
   288	            string missing = expectedFiles.Except(entryFiles).FirstOrDefault();
   289	            if (missing != null)
   290	            {
   291	                throw new InvalidDataException("Missing enemy walk inventory entry: " + missing);
   292	            }
   293	
   294	            string extra = entryFiles.Except(expectedFiles).FirstOrDefault();
   295	            if (extra != null)
   296	            {
   297	                throw new InvalidDataException("Unexpected enemy walk inventory entry: " + extra);
   298	            }
   299	
   300	            return inventory;
   301	        }
