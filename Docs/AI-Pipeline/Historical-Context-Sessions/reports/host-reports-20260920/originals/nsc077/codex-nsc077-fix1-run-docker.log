   487	        private static IEnumerator WaitForCondition(
   488	            Func<bool> condition,
   489	            float timeoutSeconds,
   490	            string failureMessage)
   491	        {
   492	            float deadline = Time.realtimeSinceStartup + timeoutSeconds;
   493	            bool satisfied = condition();
   494	            while (!satisfied && Time.realtimeSinceStartup < deadline)
   495	            {
   496	                yield return null;
   497	                satisfied = condition();
   498	            }
   499	
   500	            Assert.IsTrue(satisfied, failureMessage);
   501	        }
