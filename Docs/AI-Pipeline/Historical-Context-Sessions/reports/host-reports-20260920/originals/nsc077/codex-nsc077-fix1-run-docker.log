   404	        // The Lantern Wraith holds its ground and casts until its mana runs out. No NavMeshAgent
   405	        // or pursuit components: it owns its range and sight
   406	        // tests directly, so it needs nothing from the navigation surface.
   407	        private static void BuildLanternWraith(
   408	            Transform player,
   409	            string architecturalTileAssetFolder,
   410	            Transform enemiesRoot,
   411	            Vector3 spawnPosition,
   412	            EnemyAnimationAssetBuilder.EnemyAnimationAssets animationAssets)
   413	        {
   414	            var wraith = new GameObject("LanternWraith");
   415	            wraith.transform.SetParent(enemiesRoot, false);
   416	            wraith.transform.position = spawnPosition;
   417	
   418	            SpriteRenderer visual = DoorPrototypeSceneBuilder.CreateWorldSpriteVisual(
   419	                "Visual",
   420	                "LanternWraithSprite",
   421	                wraith.transform,
   422	                Vector3.zero,
   423	                Quaternion.Euler(IsometricCameraEulerAngles),
   424	                Vector2.one,
   425	                CreateWizardSilhouettePixels(
   426	                    DoorPrototypeSceneBuilder.WorldSpriteTextureSize,
   427	                    DoorPrototypeSceneBuilder.WorldSpriteTextureSize,
   428	                    EnemySpriteFillColor,
   429	                    EnemySpriteBorderColor),
   430	                architecturalTileAssetFolder);
