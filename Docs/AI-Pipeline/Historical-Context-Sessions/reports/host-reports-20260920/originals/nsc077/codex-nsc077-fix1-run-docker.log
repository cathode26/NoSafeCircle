   174	        private static void AddExpectedPath(ISet<string> expectedPaths, string path)
   175	        {
   176	            if (!expectedPaths.Add(path))
   177	            {
   178	                throw new InvalidDataException("Duplicate expected enemy source PNG: " + path);
   179	            }
   180	        }
   181	
   182	        private static SourceFrame LoadSourceFrame(
   183	            string path,
   184	            string sourceEnemyName,
   185	            string directionName,
   186	            int expectedSize,
   187	            int groundLineFromBottom)
   188	        {
   189	            if (!File.Exists(path))
   190	            {
   191	                throw new FileNotFoundException("Missing enemy source PNG", path);
   192	            }
   193	
   194	            var texture = new Texture2D(2, 2, TextureFormat.RGBA32, false);
   195	            try
   196	            {
   197	                if (!texture.LoadImage(File.ReadAllBytes(path)))
   198	                {
   199	                    throw new InvalidDataException("Enemy source is not a readable PNG: " + path);
   200	                }
   201	
   202	                if (texture.width != expectedSize || texture.height != expectedSize)
   203	                {
   204	                    throw new InvalidDataException(
   205	                        $"Enemy source has wrong size: {path} ({texture.width}x{texture.height}, " +
   206	                        $"expected {expectedSize}x{expectedSize})");
   207	                }
   208	            }
   209	            finally
   210	            {
   211	                Object.DestroyImmediate(texture);
   212	            }
   213	
   214	            int correction = PivotCorrectionPixels(sourceEnemyName, directionName);
   215	            int correctedGroundLine = groundLineFromBottom + correction;
   216	            if (correctedGroundLine < 0 || correctedGroundLine > expectedSize)
   217	            {
   218	                throw new InvalidDataException("Enemy pivot correction is outside the source: " + path);
   219	            }
   220	
   221	            return new SourceFrame(path, correctedGroundLine / (float)expectedSize);
   222	        }
   223	
   224	        private static int FindIdleGroundLineFromBottom(string path)
   225	        {
   226	            var texture = new Texture2D(2, 2, TextureFormat.RGBA32, false);
   227	            try
   228	            {
   229	                if (!texture.LoadImage(File.ReadAllBytes(path)))
   230	                {
   231	                    throw new InvalidDataException("Enemy idle source is not a readable PNG: " + path);
   232	                }
   233	
   234	                Color32[] pixels = texture.GetPixels32();
   235	                for (int y = 0; y < texture.height; y++)
   236	                {
   237	                    int rowStart = y * texture.width;
   238	                    for (int x = 0; x < texture.width; x++)
   239	                    {
   240	                        if (pixels[rowStart + x].a > 0)
   241	                        {
   242	                            return y;
   243	                        }
   244	                    }
   245	                }
   246	            }
   247	            finally
   248	            {
   249	                Object.DestroyImmediate(texture);
   250	            }
   251	
   252	            throw new InvalidDataException("Enemy idle source has no opaque pixels: " + path);
   253	        }
