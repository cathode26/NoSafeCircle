   383	        private static GameObject CreateAnimationEnemy(
   384	            EnemyAnimationKind kind,
   385	            out EnemyAnimationController animation)
   386	        {
   387	            var enemy = new GameObject(kind.ToString());
   388	            var visual = new GameObject("Visual", typeof(SpriteRenderer));
   389	            visual.transform.SetParent(enemy.transform, false);
   390	            visual.transform.rotation = Quaternion.Euler(
   391	                EnemyAnimationController.IsometricCameraEulerAngles);
   392	            Animator animator = enemy.AddComponent<Animator>();
   393	            animation = enemy.AddComponent<EnemyAnimationController>();
   394	            animation.Initialize(animator, kind);
   395	            return enemy;
   396	        }
