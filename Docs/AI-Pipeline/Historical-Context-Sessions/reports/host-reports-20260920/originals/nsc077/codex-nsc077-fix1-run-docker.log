   411	        private static Vector3 BoundaryMovementFor(string direction, float offset)
   412	        {
   413	            float angle;
   414	            switch (direction)
   415	            {
   416	                case "north-east": angle = 22.5f; break;
   417	                case "east": angle = -22.5f; break;
   418	                case "south-east": angle = -67.5f; break;
   419	                case "south": angle = -112.5f; break;
   420	                case "south-west": angle = -157.5f; break;
   421	                case "west": angle = 157.5f; break;
   422	                case "north-west": angle = 112.5f; break;
   423	                case "north": angle = 67.5f; break;
   424	                default: throw new ArgumentOutOfRangeException(nameof(direction));
   425	            }
   426	
   427	            float radians = (angle + offset) * Mathf.Deg2Rad;
   428	            float screenX = Mathf.Cos(radians);
   429	            float screenY = Mathf.Sin(radians);
   430	            return new Vector3((screenX - screenY) * 0.5f, 0f,
   431	                (screenX + screenY) * 0.5f);
   432	        }
   433	
   434	        private static string DirectionFor(Vector3 movement)
   435	        {
   436	            Vector2 screen = new Vector2(movement.x + movement.z, movement.z - movement.x);
   437	            float angle = Mathf.Atan2(screen.y, screen.x) * Mathf.Rad2Deg;
   438	            if (angle < -157.5f || angle >= 157.5f) return "west";
   439	            if (angle < -112.5f) return "south-west";
   440	            if (angle < -67.5f) return "south";
   441	            if (angle < -22.5f) return "south-east";
   442	            if (angle < 22.5f) return "east";
   443	            if (angle < 67.5f) return "north-east";
   444	            if (angle < 112.5f) return "north";
   445	            return "north-west";
   446	        }
