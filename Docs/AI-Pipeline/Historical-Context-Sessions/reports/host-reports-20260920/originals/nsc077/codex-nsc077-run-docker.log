        public void ReportArrivedAtLastKnownPosition()
        {
            if (State != EnemyTargetKnowledgeState.SearchingLastKnownPosition) return;

            State = EnemyTargetKnowledgeState.Wandering;
            searchTimeRemaining = searchDuration;
        }
