diff --git a/Assets/NoSafeCircle/DoorPrototype/Editor/World/EnemyAnimationAssetBuilder.cs b/Assets/NoSafeCircle/DoorPrototype/Editor/World/EnemyAnimationAssetBuilder.cs
new file mode 100644
index 0000000000000000000000000000000000000000..4782f91be5d54767bb68c81cb0bed5c024ebd14d
