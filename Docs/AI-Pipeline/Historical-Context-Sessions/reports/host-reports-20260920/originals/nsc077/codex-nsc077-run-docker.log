diff --git a/Assets/NoSafeCircle/DoorPrototype/Tests/EnemyLanternWispCasterPlayModeTests.cs b/Assets/NoSafeCircle/DoorPrototype/Tests/EnemyLanternWispCasterPlayModeTests.cs
