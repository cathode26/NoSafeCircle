diff --git a/Assets/NoSafeCircle/DoorPrototype/Tests/Editor/EnemyArtIntegrationTests.cs b/Assets/NoSafeCircle/DoorPrototype/Tests/Editor/EnemyArtIntegrationTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..ab2ade872fe1134521a04541626227364263f944
--- /dev/null
+++ b/Assets/NoSafeCircle/DoorPrototype/Tests/Editor/EnemyArtIntegrationTests.cs
@@ -0,0 +1,509 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using NoSafeCircle.DoorPrototype.Editor.World;
+using NoSafeCircle.DoorPrototype.Enemies;
+using NUnit.Framework;
+using UnityEditor;
