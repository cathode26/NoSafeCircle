diff --git a/Assets/NoSafeCircle/DoorPrototype/Tests/EnemyLanternWispCasterPlayModeTests.cs b/Assets/NoSafeCircle/DoorPrototype/Tests/EnemyLanternWispCasterPlayModeTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..28c65abd8df673c4f9794919aac7c58995396a79
--- /dev/null
+++ b/Assets/NoSafeCircle/DoorPrototype/Tests/EnemyLanternWispCasterPlayModeTests.cs
@@ -0,0 +1,180 @@
+using System.Collections;
+using System.Linq;
+using NoSafeCircle.DoorPrototype.Enemies;
