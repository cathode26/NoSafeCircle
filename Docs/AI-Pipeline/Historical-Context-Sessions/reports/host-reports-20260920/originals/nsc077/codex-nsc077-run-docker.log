            enemyHealth.Initialize(registry);
            Assert.That(registry.ActiveCount, Is.EqualTo(1));

            enemyHealth.TakeDamage(enemyHealth.MaxHealth);

            Assert.That(registry.ActiveCount, Is.EqualTo(0));
        }

