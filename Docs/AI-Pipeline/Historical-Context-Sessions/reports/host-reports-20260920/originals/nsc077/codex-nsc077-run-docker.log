diff --git a/Assets/NoSafeCircle/DoorPrototype/Scripts/Enemies/EnemyLanternWispCaster.cs b/Assets/NoSafeCircle/DoorPrototype/Scripts/Enemies/EnemyLanternWispCaster.cs
index 2c1fb01f5f1df7f3b05f245f52fa691836328737..3ef18b9e399bdca47757de78833a27cdb3a4c606
--- a/Assets/NoSafeCircle/DoorPrototype/Scripts/Enemies/EnemyLanternWispCaster.cs
+++ b/Assets/NoSafeCircle/DoorPrototype/Scripts/Enemies/EnemyLanternWispCaster.cs
@@ -1,14 +1,16 @@
 using System.Collections.Generic;
 using UnityEngine;
 
-namespace NoSafeCircle.DoorPrototype.Enemies
-{
