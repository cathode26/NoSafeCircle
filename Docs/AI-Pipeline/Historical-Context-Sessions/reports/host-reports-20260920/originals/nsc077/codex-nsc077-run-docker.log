from pathlib import Path
files=[
'Assets/NoSafeCircle/DoorPrototype/Editor/World/EnemyAnimationAssetBuilder.cs',
'Assets/NoSafeCircle/DoorPrototype/Scripts/Enemies/EnemyAnimationController.cs',
'Assets/NoSafeCircle/DoorPrototype/Scripts/Enemies/EnemyLanternWispCaster.cs',
'Assets/NoSafeCircle/DoorPrototype/Editor/World/DoorPrototypeGlobalSceneBuilder.cs',
'Assets/NoSafeCircle/DoorPrototype/Tests/Editor/EnemyArtIntegrationTests.cs',
'Assets/NoSafeCircle/DoorPrototype/Tests/EnemyAnimationPlayModeTests.cs',
'Assets/NoSafeCircle/DoorPrototype/Tests/EnemyLanternWispCasterPlayModeTests.cs']
for f in files:
    s=Path(f).read_text()
    bal=0
    state='code'; i=0
    while i<len(s):
        c=s[i]; n=s[i+1] if i+1<len(s) else ''
        if state=='code':
            if c=='/' and n=='/': state='line'; i+=1
            elif c=='/' and n=='*': state='block'; i+=1
            elif c=='\"': state='string'
            elif c==\"'\": state='char'
            elif c=='{': bal+=1
            elif c=='}': bal-=1
        elif state=='line':
            if c=='\\n': state='code'
        elif state=='block':
            if c=='*' and n=='/': state='code'; i+=1
        elif state=='string':
            if c=='\\\\': i+=1
            elif c=='\"': state='code'
        elif state=='char':
            if c=='\\\\': i+=1
            elif c==\"'\": state='code'
        i+=1
    print(f, 'brace_balance', bal, 'lex_state',state)
PY" in /workspace
