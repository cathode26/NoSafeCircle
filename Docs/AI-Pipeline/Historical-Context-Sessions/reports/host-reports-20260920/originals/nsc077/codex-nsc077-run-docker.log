import json, subprocess
c=json.load(open('Tasks/NSC-077.yaml'))
allowed=[]
for r in c['exclusive_resources']:
    if r.startswith('repo-file:') or r.startswith('unity-scene:'):
        allowed.append(r.split(':',1)[1])
changed=set(subprocess.check_output(['git','diff','--name-only','HEAD'],text=True).splitlines())
changed.update(subprocess.check_output(['git','ls-files','--others','--exclude-standard'],text=True).splitlines())
for p in sorted(changed):
    ok=any(p==a or (a.endswith('/Enemies') and p.startswith(a+'/')) for a in allowed)
    print(('OK  ' if ok else 'OUT ')+p)
PY
