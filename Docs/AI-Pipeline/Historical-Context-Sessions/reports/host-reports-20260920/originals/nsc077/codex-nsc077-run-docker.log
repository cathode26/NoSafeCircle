                    HandlePursuing();
                    break;
                case EnemyTargetKnowledgeState.SearchingLastKnownPosition:
                    HandleSearching();
                    break;
                case EnemyTargetKnowledgeState.Wandering:
                    HandleWandering();
                    break;
                case EnemyTargetKnowledgeState.Idle:
