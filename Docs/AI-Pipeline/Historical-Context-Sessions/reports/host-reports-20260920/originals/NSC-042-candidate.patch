+
+        // NSC-042 AC-001: Individual Tilemap sorting paints the exact same WallTile texture
+        // verbatim at every wall cell, so a repeated wall only reads as one continuous wall -
+        // rather than each one-cell sorting segment visibly restarting at a border seam - if
+        // this masonry pattern is genuinely periodic across the texture's own width. Proven by
+        // comparing two side-by-side copies of the actual persisted texture against an
+        // independently generated doubled-width texture built from the same procedural pattern:
+        // that doubled-width image is what a genuinely continuous (non-seamed) wall texture of
+        // twice the width would look like, so any block truncated at the tile edge shows up as
+        // a pixel mismatch at the seam.
+        [Test]
+        public void Build_WallTileTexture_MasonryPatternTilesSeamlesslyAcrossRepeatedWallCells()
+        {
+            DoorPrototypeSceneBuilder.BuildInMemoryForTests();
+
+            var wallTilemap = GameObject.Find("IsometricVisualGrid/WallTilemap")?.GetComponent<Tilemap>();
+            Assert.IsNotNull(wallTilemap);
+            var wallTile = wallTilemap.GetTile<Tile>(Vector3Int.zero);
+            Assert.IsNotNull(wallTile, "Expected a WallTile painted at the origin wall cell.");
+            var wallTexture = wallTile.sprite.texture;
+            Assert.IsNotNull(wallTexture);
+
+            var width = wallTexture.width;
+            var height = wallTexture.height;
+            var singleTilePixels = wallTexture.GetPixels32();
+
+            var createWallPixels = typeof(DoorPrototypeSceneBuilder).GetMethod(
+                "CreateWallPixels", BindingFlags.NonPublic | BindingFlags.Static);
+            Assert.IsNotNull(createWallPixels, "Expected a private static CreateWallPixels(width, height) helper.");
+
+            var continuousDoubleWidthPixels =
+                (Color32[])createWallPixels.Invoke(null, new object[] { width * 2, height });
+
+            for (var y = 0; y < height; y++)
+            {
+                for (var x = 0; x < width * 2; x++)
+                {
+                    var sideBySideTiledPixel = singleTilePixels[y * width + (x % width)];
+                    var continuousPixel = continuousDoubleWidthPixels[y * (width * 2) + x];
+
+                    Assert.AreEqual(continuousPixel, sideBySideTiledPixel,
+                        "AC-001: placing two copies of the persisted WallTile texture side by side must " +
+                        "exactly reproduce the same masonry pattern as one genuinely continuous " +
+                        $"doubled-width wall texture at pixel ({x}, {y}); a mismatch means the pattern is " +
+                        "truncated/reset at each wall-segment boundary instead of tiling seamlessly.");
+                }
+            }
+        }
+
+        // NSC-042 AC-003/VAL-001: scaling a straight wall to roughly 100 visual cells must reuse
+        // the same persisted WallTile asset rather than requiring a Tile/Sprite/Texture asset
+        // count that grows with wall length.
+        [Test]
+        public void Build_WallTileReusedAcrossApproximatelyOneHundredCells_DoesNotGrowArchitecturalAssetCount()
+        {
+            DoorPrototypeSceneBuilder.BuildInMemoryForTests(temporaryArchitecturalTileAssetFolder);
+
+            var wallTilemap = GameObject.Find("IsometricVisualGrid/WallTilemap")?.GetComponent<Tilemap>();
+            Assert.IsNotNull(wallTilemap);
+            var wallTile = wallTilemap.GetTile<Tile>(Vector3Int.zero);
+            Assert.IsNotNull(wallTile, "Expected a persisted WallTile painted at the origin wall cell.");
+
+            var assetCountBeforeLongWall =
+                AssetDatabase.FindAssets(string.Empty, new[] { temporaryArchitecturalTileAssetFolder }).Length;
+
+            const int longWallCellCount = 100;
+            for (var i = 0; i < longWallCellCount; i++)
+            {
+                wallTilemap.SetTile(new Vector3Int(50 + i, 0, 0), wallTile);
+            }
+
+            var assetCountAfterLongWall =
+                AssetDatabase.FindAssets(string.Empty, new[] { temporaryArchitecturalTileAssetFolder }).Length;
+
+            Assert.AreEqual(assetCountBeforeLongWall, assetCountAfterLongWall,
+                "Scaling a straight wall to roughly 100 visual cells must reuse the existing WallTile asset " +
+                "instead of requiring additional Tile/Sprite/Texture assets proportional to wall length.");
+
+            for (var i = 0; i < longWallCellCount; i++)
+            {
+                Assert.AreSame(wallTile, wallTilemap.GetTile(new Vector3Int(50 + i, 0, 0)),
+                    $"Wall cell {50 + i} must reuse the exact same WallTile asset rather than a uniquely " +
+                    "authored one.");
+            }
+        }
