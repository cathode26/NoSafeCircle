+# How the worker's final terminal write waits for `checkouts.lock`. Its
+# legitimate holders are slow (a post-crew child registers a candidate in about
+# 9 s, a foreground `sync_candidate` takes 13-16 s), and one lost 10 s wait used
+# to escape `run_worker` after a successful crew: the launcher recorded
+# `child_failed`, the record stayed `running` without its receipt, and the graph
+# controller waited on it forever (NSC-1163, 2026-09-13). Nothing durable
+# precedes that acquisition and the crew outcome is already fixed, so a lost
+# wait that `_pre_mutation_lock` stamped is retried: up to this many attempts,
+# each waiting this long, with this pause between them. Past the bound the last
+# `TimeoutError` is raised unchanged. Tests shorten all three.
+TERMINAL_WRITE_LOCK_ATTEMPTS = 6
+TERMINAL_WRITE_LOCK_TIMEOUT_SECONDS = 10.0
+TERMINAL_WRITE_RETRY_PAUSE_SECONDS = 2.0
+
+
+def _terminal_write_pause(seconds: float) -> None:
+    """Pause between two lost terminal-write lock waits (a test seam)."""
+    time.sleep(seconds)
+
+
+def locked_record_write(checkouts: Checkouts, write: Callable[[], Any]) -> Any:
+    """Run ``write`` under this root's `checkouts.lock`, retrying only a lost first wait.
+
+    ``write`` runs entirely inside the lock and must re-read everything it
+    decides from. An attempt is retried only when its acquisition timed out
+    before the lock was held (``_pre_mutation_lock`` stamps exactly that timeout,
+    for exactly this lock path) and ``write`` never started, so a retried attempt
+    provably wrote nothing. Any other exception, a timeout raised inside
+    ``write`` included, propagates on its first occurrence. After
+    TERMINAL_WRITE_LOCK_ATTEMPTS lost waits the last one is raised as it was.
+    """
+    lock_path = checkouts.records / "checkouts.lock"
+    attempts = TERMINAL_WRITE_LOCK_ATTEMPTS
+    timeout_seconds = TERMINAL_WRITE_LOCK_TIMEOUT_SECONDS
+    pause_seconds = TERMINAL_WRITE_RETRY_PAUSE_SECONDS
+    if type(attempts) is not int or attempts < 1:
+        raise ValueError("terminal write lock attempts must be a positive integer")
+    attempt = 1
+    while True:
+        entered = False
+        try:
+            with _pre_mutation_lock(lock_path, timeout_seconds=timeout_seconds):
+                entered = True
+                return write()
+        except TimeoutError as exc:
+            if entered or attempt >= attempts or not stamped_lock_contention(exc, lock_path):
+                raise
+        attempt += 1
+        _terminal_write_pause(pause_seconds)
+
 
