+    if run_result.get("run_status") != "needs_human":
+        raise ValueError(
+            f"Decomposition review run_status is {run_result.get('run_status')!r}, expected 'needs_human'"
+        )
+    for field in ("decomposition_result_path", "graph_delta_path"):
+        if field not in run_result or run_result[field] is not None:
+            raise ValueError(
+                f"Decomposition needs_human run names a proposal artifact: {field} is "
+                f"{run_result.get(field)!r}"
+            )
+    # Exact integers only: a JSON boolean is an int to Python and is refused.
+    calls_used = run_result.get("calls_used")
+    if type(calls_used) is not int or not 0 <= calls_used <= run_result["max_calls"]:
+        raise ValueError(
+            f"Decomposition needs_human calls_used is {calls_used!r}, not a count within max_calls"
+        )
+    corrections = run_result.get("author_corrections_used")
+    if corrections is not None and not (type(corrections) is int and corrections in (0, 1)):
+        raise ValueError(
+            f"Decomposition needs_human author_corrections_used is {corrections!r}, not 0 or 1"
+        )
+    reasons = run_result.get("rejection_reasons")
+    if not isinstance(reasons, list) or not all(
+            isinstance(reason, str) and reason.strip() for reason in reasons):
+        raise ValueError("Decomposition needs_human rejection_reasons are not stated reasons")
+    raw_findings = run_result.get("unresolved_findings")
+    if not isinstance(raw_findings, list):
+        raise ValueError("Decomposition needs_human unresolved_findings is not a list")
+    # The producer's own finding contract: a retained finding is exactly one the
+    # D1B.2 circuit could have written, with no field it does not define.
+    findings = [
+        ReviewFinding.from_dict(
+            finding, f"Decomposition needs_human unresolved_findings[{index}]",
+        ).to_dict()
+        for index, finding in enumerate(raw_findings)
+    ]
+    if not findings and not reasons:
+        raise ValueError(
+            "Decomposition needs_human run states no unresolved finding or rejection reason"
+        )
+    next_step = run_result.get("human_next_step")
+    if next_step is not None and not isinstance(next_step, str):
+        raise ValueError("Decomposition needs_human human_next_step is not text")
+    candidate = run_result.get("latest_candidate")
+    if candidate is not None:
+        if not isinstance(candidate, Mapping):
+            raise ValueError("Decomposition needs_human latest_candidate is not an object")
+        candidate = {field: candidate.get(field) for field in _CANDIDATE_IDENTITY_FIELDS}
