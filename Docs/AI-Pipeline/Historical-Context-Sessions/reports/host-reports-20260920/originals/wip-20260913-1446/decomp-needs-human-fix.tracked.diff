+def _needs_human_proof(authenticated: _AuthenticatedRun) -> dict[str, Any]:
+    """The bounded facts of an authenticated run that stopped at the human authority boundary.
+
+    A D1B.2 ``needs_human`` run publishes no proposal artifacts and names none,
+    uses no call beyond its limit, and states at least one unresolved finding
+    or rejection reason; a run that states none is invalid. Only its stated
+    reasons, the next human step, its counts and the latest candidate's
+    identity are retained; the run result stays the authority for the rest.
+    """
