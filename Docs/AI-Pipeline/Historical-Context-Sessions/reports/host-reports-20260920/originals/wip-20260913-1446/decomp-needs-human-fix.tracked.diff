+def _needs_human_reason(facts: Any) -> str:
+    """Why a needs_human decomposition waits for a person; a record that states no reason is refused."""
+    facts = facts if isinstance(facts, Mapping) else {}
+    raw_reasons = facts.get("rejection_reasons")
+    raw_findings = facts.get("unresolved_findings")
+    reasons = ([item for item in raw_reasons if isinstance(item, str) and item]
+               if isinstance(raw_reasons, list) else [])
+    finding_ids = ([item["finding_id"] for item in raw_findings
+                    if isinstance(item, Mapping) and isinstance(item.get("finding_id"), str)
+                    and item["finding_id"]]
+                   if isinstance(raw_findings, list) else [])
+    if not reasons and not finding_ids:
+        raise ValueError("needs_human decomposition record states no reason")
+    parts = []
+    if reasons:
+        parts.append("Rejection reasons: " + "; ".join(reasons) + ".")
+    if finding_ids:
+        parts.append("Unresolved findings: " + ", ".join(finding_ids) + ".")
+    return " ".join(parts)
+
