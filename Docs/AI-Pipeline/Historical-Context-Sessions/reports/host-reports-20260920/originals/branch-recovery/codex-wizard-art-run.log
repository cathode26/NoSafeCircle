   200	        // NSC-070 regression-only invariant: deterministic collision/transform noise at the
   201	        // equal-component boundary must not oscillate a held facing between adjacent states.
   202	        [Test]
   203	        public void DirectionFor_RetainsPriorAxisAtEqualComponentBoundary()
   204	        {
   205	            MethodInfo directionMethod = typeof(WizardAnimationController).GetMethod(
   206	                "StableDirectionFor", BindingFlags.Static | BindingFlags.NonPublic,
   207	                null, new[] { typeof(Vector3), typeof(string) }, null);
   208	            Assert.IsNotNull(directionMethod,
   209	                "The direction classifier needs a prior-facing seam for boundary hysteresis.");
   210	
   211	            string direction = "north-east";
   212	            Vector3[] noisyHeldSamples =
   213	            {
   214	                new Vector3(1f, 0f, 1f),
   215	                new Vector3(1f, 0f, 1.0001f),
   216	                new Vector3(1f, 0f, 1f),
   217	                new Vector3(1f, 0f, 1.0001f)
   218	            };
   219	
   220	            foreach (Vector3 sample in noisyHeldSamples)
   221	            {
   222	                direction = (string)directionMethod.Invoke(null, new object[] { sample, direction });
   223	                Assert.AreEqual("north-east", direction,
   224	                    "Equal-component noise must retain the held world-axis facing.");
   225	            }
   240	            Assert.IsNotNull(wizard);
   241	            Assert.IsNotNull(animator);
   242	
   243	            movement.enabled = false;
   244	            yield return null;
   245	
   246	            // Prime the intended X-axis facing before exercising ambiguous boundary noise.
   247	            // With no prior movement, retaining the canonical initial Z-axis facing is valid.
   248	            player.transform.position += new Vector3(1f, 0f, 0f);
   249	            yield return null;
   250	            const string expectedWalkState = "Wizard_Masculine_White_walk_north-east";
   251	            Assert.AreEqual(expectedWalkState, wizard.CurrentState);
   252	            animator.Update(0f);
   253	            Assert.IsTrue(animator.GetCurrentAnimatorStateInfo(0).IsName(expectedWalkState));
   254	            animator.Update(0.1f);
   255	            float firstWalkTime = animator.GetCurrentAnimatorStateInfo(0).normalizedTime;
   256	
   257	            player.transform.position += new Vector3(1f, 0f, 1.0001f);
