    18	    /// Owns only the Player visual's selected art and animation state.
    19	    /// Movement and collision remain owned by PlayerMovement and CharacterController.
    20	    [RequireComponent(typeof(Animator))]
    21	    public sealed class WizardAnimationController : MonoBehaviour
    22	    {
    23	        private const float DirectionThreshold = 0.01f;
    24	        private const float DirectionSwitchMargin = 0.001f;
    25	        internal const string CanonicalInitialDirection = "south-east";
    26	
    27	        [SerializeField] private WizardPresentation presentation = WizardPresentation.Masculine;
    28	        [SerializeField] private WizardSkin skin = WizardSkin.White;
    29	        [SerializeField] private Animator animator;
    30	
    31	        private SpriteRenderer spriteRenderer;
    32	        private Vector3 previousPosition;
    33	        private string currentState;
    34	        private string lastDirection = CanonicalInitialDirection;
    35	        private bool ignoreNextDisplacement;
    36	
    37	        public WizardPresentation Presentation => presentation;
    38	        public WizardSkin Skin => skin;
    39	        public string CurrentState => currentState;
    40	        public string LastDirection => lastDirection;
    41	
    42	        private void Awake()
    43	        {
    44	            if (animator == null) animator = GetComponent<Animator>();
    45	            spriteRenderer = GetComponentInChildren<SpriteRenderer>();
    46	            previousPosition = transform.position;
    47	        }
    48	
    49	        private void Update()
    50	        {
    51	            if (ignoreNextDisplacement)
    52	            {
    53	                previousPosition = transform.position;
    54	                ignoreNextDisplacement = false;
    55	                return;
    56	            }
    57	
    58	            var displacement = transform.position - previousPosition;
    59	            previousPosition = transform.position;
    60	            displacement.y = 0f;
    61	
    62	            var isWalking = displacement.magnitude >= DirectionThreshold;
    63	            if (isWalking) lastDirection = StableDirectionFor(displacement, lastDirection);
    64	
    65	            var state = StateName(isWalking ? "walk" : "idle", lastDirection);
    66	            if (state == currentState) return;
    67	
    68	            currentState = state;
    69	            if (animator != null && animator.runtimeAnimatorController != null)
    70	                animator.Play(state, 0, 0f);
    71	        }
    72	
    73	        /// <summary>
    74	        /// Applies one validated NSC-062 presentation choice without changing Player gameplay state.
    75	        /// </summary>
    76	        public void ApplyPresentation(WizardPresentation selectedPresentation, WizardSkin selectedSkin)
    77	        {
    78	            if (!Enum.IsDefined(typeof(WizardPresentation), selectedPresentation))
    79	                throw new ArgumentOutOfRangeException(nameof(selectedPresentation));
    80	            if (!Enum.IsDefined(typeof(WizardSkin), selectedSkin))
    81	                throw new ArgumentOutOfRangeException(nameof(selectedSkin));
    82	
    83	            presentation = selectedPresentation;
    84	            skin = selectedSkin;
    85	            currentState = StateName("idle", lastDirection);
    86	            ignoreNextDisplacement = true;
    87	
    88	            if (animator == null) animator = GetComponent<Animator>();
    89	            if (animator == null || animator.runtimeAnimatorController == null) return;
    90	
    91	            animator.Play(currentState, 0, 0f);
    92	            animator.Update(0f);
    93	        }
    94	
    95	        private string StateName(string motion, string direction)
    96	        {
    97	            return $"Wizard_{presentation}_{skin}_{motion}_{direction}";
    98	        }
    99	
   100	        // The fixed camera maps the dominant world axis to a screen diagonal. Using
   101	        // the dominant component keeps a small orthogonal movement component from
   102	        // changing the facing state while the pointer remains in one direction.
   103	        private static string DirectionFor(Vector3 movement)
   104	        {
   105	            if (Mathf.Abs(movement.x) >= Mathf.Abs(movement.z))
   106	                return movement.x >= 0f ? "north-east" : "south-west";
   107	
   108	            return movement.z >= 0f ? "south-east" : "north-west";
   109	        }
   110	
   111	        // Keep the previously selected world axis until the other component exceeds it
   112	        // by a small margin. This prevents equal-component collision/transform noise from
   113	        // changing the held diagonal state every frame while preserving sign changes.
   114	        private static string StableDirectionFor(Vector3 movement, string previousDirection)
   115	        {
   116	            float absoluteX = Mathf.Abs(movement.x);
   117	            float absoluteZ = Mathf.Abs(movement.z);
   118	            bool previousDirectionUsesX = previousDirection == "north-east" ||
   119	                                          previousDirection == "south-west";
   120	            bool useX = previousDirectionUsesX
   121	                ? absoluteX + DirectionSwitchMargin >= absoluteZ
   122	                : absoluteX > absoluteZ + DirectionSwitchMargin;
   123	
   124	            if (useX)
   125	                return movement.x >= 0f ? "north-east" : "south-west";
   126	
   127	            return movement.z >= 0f ? "south-east" : "north-west";
   128	        }
   129	    }
   130	}
