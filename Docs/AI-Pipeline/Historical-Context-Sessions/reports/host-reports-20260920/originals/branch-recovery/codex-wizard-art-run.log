   410	        private static AnimationClip EnsureWizardClip(string name, Sprite[] sprites, int frameRate)
   411	        {
   412	            var path = WizardGeneratedRoot + "/" + name + ".anim";
   413	            var clip = AssetDatabase.LoadAssetAtPath<AnimationClip>(path);
   414	            if (clip == null)
   415	            {
   416	                clip = new AnimationClip { name = name };
   417	                AssetDatabase.CreateAsset(clip, path);
   418	            }
   419	            clip.frameRate = frameRate;
   420	            var keys = new ObjectReferenceKeyframe[sprites.Length];
   421	            for (var i = 0; i < sprites.Length; i++)
   422	                keys[i] = new ObjectReferenceKeyframe { time = i / (float)frameRate, value = sprites[i] };
   423	            AnimationUtility.SetObjectReferenceCurve(clip,
   424	                EditorCurveBinding.PPtrCurve("", typeof(SpriteRenderer), "m_Sprite"), null);
   425	            AnimationUtility.SetObjectReferenceCurve(clip,
   426	                EditorCurveBinding.PPtrCurve("Visual", typeof(SpriteRenderer), "m_Sprite"), keys);
   427	            var settings = AnimationUtility.GetAnimationClipSettings(clip);
   428	            settings.loopTime = true;
   429	            AnimationUtility.SetAnimationClipSettings(clip, settings);
   430	            EditorUtility.SetDirty(clip);
   431	            AssetDatabase.SaveAssetIfDirty(clip);
   432	            return clip;
   433	        }
