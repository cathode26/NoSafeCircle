   388	        private static Sprite ImportWizardSprite(string path)
   389	        {
   390	            AssetDatabase.ImportAsset(path, ImportAssetOptions.ForceUpdate);
   391	            var importer = AssetImporter.GetAtPath(path) as TextureImporter;
   392	            if (importer == null) throw new FileNotFoundException("Wizard source is not a texture", path);
   393	            importer.textureType = TextureImporterType.Sprite;
   394	            importer.spriteImportMode = SpriteImportMode.Single;
   395	            importer.filterMode = FilterMode.Point;
   396	            importer.textureCompression = TextureImporterCompression.Uncompressed;
   397	            importer.mipmapEnabled = false;
   398	            importer.spritePixelsPerUnit = 180f;
   399	            var textureSettings = new TextureImporterSettings();
   400	            importer.ReadTextureSettings(textureSettings);
   401	            textureSettings.spriteAlignment = (int)SpriteAlignment.Custom;
   402	            textureSettings.spritePivot = new Vector2(0.5f, 0f);
   403	            importer.SetTextureSettings(textureSettings);
   404	            importer.SaveAndReimport();
   405	            var sprite = AssetDatabase.LoadAssetAtPath<Sprite>(path);
   406	            if (sprite == null) throw new InvalidDataException("Wizard source did not import as a Sprite: " + path);
   407	            return sprite;
   408	        }
