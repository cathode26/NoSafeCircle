   336	        private static WizardAnimationAssets BuildWizardAnimationAssets()
   337	        {
   338	            EnsureFolder("Assets/NoSafeCircle/DoorPrototype/Art");
   339	            EnsureFolder("Assets/NoSafeCircle/DoorPrototype/Art/Wizard");
   340	            EnsureFolder(WizardGeneratedRoot);
