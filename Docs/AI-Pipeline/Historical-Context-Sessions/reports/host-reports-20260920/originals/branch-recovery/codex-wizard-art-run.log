   343	            if (controller == null) controller = AnimatorController.CreateAnimatorControllerAtPath(controllerPath);
   344	
   345	            var stateMachine = controller.layers[0].stateMachine;
   346	            Sprite defaultIdle = null;
   347	            foreach (var variant in WizardVariants)
   348	            {
   349	                var sourceVariant = variant.Replace("_White", "-light").Replace("_Black", "-dark")
   350	                    .Replace("Masculine", "masculine").Replace("Feminine", "feminine");
   351	                foreach (var standingDirection in WizardStandingDirections)
   352	                {
   353	                    ImportWizardSprite(WizardSourceRoot + "/" + sourceVariant + "/selected/standing/" + standingDirection + ".png");
   354	                }
   355	                foreach (var direction in WizardDirections)
   356	                {
   357	                    var standingPath = WizardSourceRoot + "/" + sourceVariant + "/selected/standing/" + direction + ".png";
   358	                    var idle = ImportWizardSprite(standingPath);
   359	                    var idleName = "Wizard_" + variant + "_idle_" + direction;
   360	                    EnsureWizardState(stateMachine, idleName, EnsureWizardClip(idleName, new[] { idle }, 1));
   361	                    if (variant == "Masculine_White" && direction == WizardCanonicalInitialDirection)
   362	                        defaultIdle = idle;
   363	
   364	                    var walk = new Sprite[6];
   365	                    for (var frame = 0; frame < walk.Length; frame++)
   366	                    {
   367	                        var walkPath = WizardSourceRoot + "/" + sourceVariant + "/selected/walk/" + direction + "/frame_00" + frame + ".png";
   368	                        walk[frame] = ImportWizardSprite(walkPath);
   369	                    }
   370	                    var walkName = "Wizard_" + variant + "_walk_" + direction;
   371	                    EnsureWizardState(stateMachine, walkName, EnsureWizardClip(walkName, walk, 12));
   372	                }
   373	            }
   374	            EditorUtility.SetDirty(controller);
   375	            AssetDatabase.SaveAssetIfDirty(controller);
   376	            return new WizardAnimationAssets(controller, defaultIdle);
   377	        }
