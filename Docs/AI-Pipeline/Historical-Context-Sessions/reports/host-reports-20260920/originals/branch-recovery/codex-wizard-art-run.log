   435	        private static void EnsureWizardState(AnimatorStateMachine stateMachine, string name, AnimationClip clip)
   436	        {
   437	            foreach (var child in stateMachine.states)
   438	            {
   439	                if (child.state.name != name) continue;
   440	                child.state.motion = clip;
   441	                return;
   442	            }
   443	            stateMachine.AddState(name).motion = clip;
   444	        }
