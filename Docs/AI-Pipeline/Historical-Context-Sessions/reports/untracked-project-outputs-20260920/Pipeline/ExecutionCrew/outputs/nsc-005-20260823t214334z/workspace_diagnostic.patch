         public float CurrentMana { get; private set; }
         public event Action<float> ManaSpent;
 
+        /// Raised when a cast attempt is denied due to insufficient mana, carrying the
+        /// requested amount, so spells/UI can present distinct low-mana feedback.
+        public event Action<float> ManaSpendDenied;
+
         private void Awake()
         {
-            CurrentMana = maxMana;
-            timeSinceLastSpend = postCastRegenDelay;
+            ResetState();
         }
 
         private void Update()
@@ -43,12 +46,26 @@ namespace NoSafeCircle.DoorPrototype
         /// the pool doesn't have enough, so callers (spells) know the cast was refused.
         public bool Spend(float amount)
         {
-            if (amount <= 0f || amount > CurrentMana) return false;
+            if (amount <= 0f) return false;
+
+            if (amount > CurrentMana)
+            {
+                ManaSpendDenied?.Invoke(amount);
+                return false;
+            }
 
             CurrentMana -= amount;
             timeSinceLastSpend = 0f;
             ManaSpent?.Invoke(amount);
             return true;
         }
+
+        /// Restores current mana to full and clears the post-cast regeneration-delay
+        /// timer, for use by owner-controlled floor-restart reset flows.
+        public void ResetState()
+        {
+            CurrentMana = maxMana;
+            timeSinceLastSpend = postCastRegenDelay;
+        }
     }
 }
diff --git a/Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerManaUI.cs b/Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerManaUI.cs
