--- a/Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerManaUI.cs
+++ b/Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerManaUI.cs
@@ -7,12 +7,46 @@ namespace NoSafeCircle.DoorPrototype
     {
         [SerializeField] private PlayerMana mana;
         [SerializeField] private Image fillImage;
+        [SerializeField] private Color normalColor = Color.white;
+        [SerializeField] private Color deniedColor = Color.red;
+        [SerializeField] private float deniedFlashDuration = 0.2f;
+
+        private float deniedFlashTimeRemaining;
+
+        private void OnEnable()
+        {
+            if (mana != null)
+            {
+                mana.ManaSpendDenied += HandleManaSpendDenied;
+            }
+        }
+
+        private void OnDisable()
+        {
+            if (mana != null)
+            {
+                mana.ManaSpendDenied -= HandleManaSpendDenied;
+            }
+        }
 
         private void Update()
         {
             if (mana == null || fillImage == null) return;
 
             fillImage.fillAmount = mana.MaxMana > 0f ? mana.CurrentMana / mana.MaxMana : 0f;
+
+            if (deniedFlashTimeRemaining > 0f)
+            {
+                deniedFlashTimeRemaining -= Time.deltaTime;
+                fillImage.color = deniedFlashTimeRemaining > 0f ? deniedColor : normalColor;
+            }
+        }
+
+        /// Flashes the mana indicator so a denied cast (insufficient mana) is
+        /// readable as distinct from a successful spend.
+        private void HandleManaSpendDenied(float requestedAmount)
+        {
+            deniedFlashTimeRemaining = deniedFlashDuration;
         }
     }
 }
