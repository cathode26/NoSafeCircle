@@ -7,12 +7,38 @@ namespace NoSafeCircle.DoorPrototype
     {
         [SerializeField] private PlayerMana mana;
         [SerializeField] private Image fillImage;
+        [SerializeField] private Color normalColor = Color.white;
+        [SerializeField] private Color deniedCastColor = Color.red;
+        [SerializeField] private float deniedCastFeedbackDuration = 0.3f;
+
+        private float deniedCastFeedbackRemaining;
+
+        private void OnEnable()
+        {
+            if (mana != null) mana.ManaSpendDenied += HandleManaSpendDenied;
+        }
+
+        private void OnDisable()
+        {
+            if (mana != null) mana.ManaSpendDenied -= HandleManaSpendDenied;
+        }
 
         private void Update()
         {
             if (mana == null || fillImage == null) return;
 
             fillImage.fillAmount = mana.MaxMana > 0f ? mana.CurrentMana / mana.MaxMana : 0f;
+
+            if (deniedCastFeedbackRemaining > 0f)
+            {
+                deniedCastFeedbackRemaining -= Time.deltaTime;
+                fillImage.color = deniedCastFeedbackRemaining > 0f ? deniedCastColor : normalColor;
+            }
+        }
+
+        private void HandleManaSpendDenied(float amount)
+        {
+            deniedCastFeedbackRemaining = deniedCastFeedbackDuration;
         }
     }
 }
