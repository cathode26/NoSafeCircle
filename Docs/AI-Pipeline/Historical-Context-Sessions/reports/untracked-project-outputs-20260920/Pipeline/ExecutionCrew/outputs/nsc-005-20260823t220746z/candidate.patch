+
+        [SetUp]
+        public void SetUp()
+        {
+            manaObject = new GameObject("TestMana");
+            mana = manaObject.AddComponent<PlayerMana>();
+
+            uiObject = new GameObject("TestManaUI");
+            uiObject.SetActive(false);
+            fillImage = uiObject.AddComponent<Image>();
+            ui = uiObject.AddComponent<PlayerManaUI>();
+            SetPrivateField(ui, "mana", mana);
+            SetPrivateField(ui, "fillImage", fillImage);
+            uiObject.SetActive(true);
+        }
+
+        [TearDown]
