diff --git a/Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerManaUI.cs b/Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerManaUI.cs
index 722718a4cef333f2af2ed4acd81b56976e8da1f7..c3732868f234d220fb09591ddc146b0add52448e 100644
--- a/Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerManaUI.cs
+++ b/Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerManaUI.cs
@@ -7,12 +7,57 @@ namespace NoSafeCircle.DoorPrototype
     {
         [SerializeField] private PlayerMana mana;
         [SerializeField] private Image fillImage;
+        [SerializeField] private Color deniedCastColor = new Color(1f, 0.3f, 0.3f, 1f);
+        [SerializeField] private float deniedCastFlashDuration = 0.25f;
+
+        private Color normalColor;
+        private float deniedFlashTimeRemaining;
+
+        private void Awake()
+        {
+            if (fillImage != null)
+            {
+                normalColor = fillImage.color;
+            }
+        }
+
+        private void OnEnable()
+        {
+            if (mana != null)
+            {
+                mana.CastDenied += HandleCastDenied;
+            }
+        }
+
+        private void OnDisable()
+        {
+            if (mana != null)
+            {
+                mana.CastDenied -= HandleCastDenied;
+            }
+        }
 
         private void Update()
         {
             if (mana == null || fillImage == null) return;
 
             fillImage.fillAmount = mana.MaxMana > 0f ? mana.CurrentMana / mana.MaxMana : 0f;
+
+            if (deniedFlashTimeRemaining > 0f)
+            {
+                deniedFlashTimeRemaining -= Time.deltaTime;
+                fillImage.color = deniedCastColor;
+            }
+            else
+            {
+                fillImage.color = normalColor;
+            }
+        }
+
+        /// Presents readable low-mana feedback when a cast is denied for insufficient mana.
+        private void HandleCastDenied(float attemptedAmount)
+        {
+            deniedFlashTimeRemaining = deniedCastFlashDuration;
         }
     }
 }
