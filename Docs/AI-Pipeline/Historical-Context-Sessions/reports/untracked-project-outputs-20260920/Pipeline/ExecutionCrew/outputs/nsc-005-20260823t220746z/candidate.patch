+        {
+            Object.Destroy(uiObject);
+            Object.Destroy(manaObject);
+        }
+
+        [UnityTest]
+        public IEnumerator PlayerManaUI_ShowsDeniedColor_WhenCastDeniedFires()
+        {
+            yield return null;
+            var normalColor = fillImage.color;
+            var deniedColor = GetPrivateField<Color>(ui, "deniedCastColor");
+            Assert.AreNotEqual(normalColor, deniedColor,
+                "Test setup assumption: the denied-cast color must differ from the resting indicator color to be readable feedback.");
+
+            mana.Spend(mana.CurrentMana + 1f);
+
+            yield return null;
+
+            Assert.AreEqual(deniedColor, fillImage.color,
+                "Mana indicator must visibly present denied-cast feedback so low-mana failure is readable (GDD Section 3).");
+        }
