{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"nl -ba Tasks/NSC-003.yaml | sed -n '1,260p'; nl -ba Tasks/NSC-023.yaml | sed -n '1,260p'; nl -ba Pipeline/TaskGraph/TASK_CONTRACT_SCHEMA_V2.md | sed -n '1,300p'; nl -ba Pipeline/TaskGraph/current_conformance.py | sed -n '1,310p'; nl -ba Pipeline/TaskGraph/execution_authority.py; nl -ba Pipeline/TaskGraph/taskcontrol.py | sed -n '1,390p'\"","aggregated_output":"     1\t{\r\n     2\t  \"schema_version\": \"2.0\",\r\n     3\t  \"id\": \"NSC-003\",\r\n     4\t  \"contract_revision\": 1,\r\n     5\t  \"contract_disposition\": \"active\",\r\n     6\t  \"title\": \"Mouse-Directed Player Movement, Shared Pointer Projection, and Movement Restriction\",\r\n     7\t  \"reconciliation_key\": \"player-movement\",\r\n     8\t  \"kind\": \"implementation\",\r\n     9\t  \"type\": \"implementation\",\r\n    10\t  \"execution_scope\": \"single_agent\",\r\n    11\t  \"execution_reason\": \"All required responsibilities are cohesively owned by one system (PlayerMovement.cs) plus its Input Actions and builder/scene wiring; it is a bounded rewrite of one component's input/locomotion model rather than a multi-system integration.\",\r\n    12\t  \"decomposition_state\": \"concrete\",\r\n    13\t  \"decomposition_reason\": \"The required behavior (mouse-directed movement via Input System, shared pointer projection, movement-restriction interface, reset entry point) is fully specified by current GDD text without inventing new design.\",\r\n    14\t  \"parent\": \"NSC-002\",\r\n    15\t  \"depends_on\": [],\r\n    16\t  \"exclusive_resources\": [\r\n    17\t    \"repo-file:Assets/InputSystem_Actions.inputactions\",\r\n    18\t    \"repo-file:Assets/NoSafeCircle/DoorPrototype/Editor/DoorPrototypeSceneBuilder.cs\",\r\n    19\t    \"unity-scene:Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\"\r\n    20\t  ],\r\n    21\t  \"acceptance_criteria\": [\r\n    22\t    {\r\n    23\t      \"reference\": \"GDD §2 Move and Aim\",\r\n    24\t      \"requirement\": \"Movement is mouse-directed: a click sets a destination the wizard walks toward, and holding continues steering toward the current cursor position, consumed through Unity Input System/Input Actions rather than direct hardware polling.\",\r\n    25\t      \"criterion_id\": \"AC-001\"\r\n    26\t    },\r\n    27\t    {\r\n    28\t      \"reference\": \"GDD §2 Player Movement ownership\",\r\n    29\t      \"requirement\": \"Exposes a shared world-space pointer target produced by projecting the cursor onto the gameplay plane, consumable by cursor-aimed spells and Door/Interaction without those systems independently projecting screen coordinates.\",\r\n    30\t      \"criterion_id\": \"AC-002\"\r\n    31\t    },\r\n    32\t    {\r\n    33\t      \"reference\": \"GDD §2 Player Movement ownership; §4 Development Agent Ownership Invariants\",\r\n    34\t      \"requirement\": \"Exposes an owner-controlled movement-restriction request/release interface that Charged Fireball can use to restrict movement while charging without Fireball mutating movement internals directly.\",\r\n    35\t      \"criterion_id\": \"AC-003\"\r\n    36\t    },\r\n    37\t    {\r\n    38\t      \"reference\": \"GDD §2 Floor-run restart ownership\",\r\n    39\t      \"requirement\": \"Exposes an owner-controlled reset entry point that restores player position/movement state to the floor's initial state, consumed by the Floor Run/Restart Orchestrator rather than having position mutated externally.\",\r\n    40\t      \"criterion_id\": \"AC-004\"\r\n    41\t    },\r\n    42\t    {\r\n    43\t      \"reference\": \"GDD §2 Victory/input-shutdown ownership; §4 Development Agent Ownership Invariants and final escape/victory coordination\",\r\n    44\t      \"requirement\": \"Exposes an owner-controlled gameplay-enable/suspend interface, consumed by the Game Flow/Victory capability, that immediately stops or cancels any in-progress input-driven movement (including an active click-to-destination approach), rejects new movement commands while suspended, and can be re-enabled only through an authorized reset/test flow rather than external mutation of movement internals.\",\r\n    45\t      \"criterion_id\": \"AC-005\"\r\n    46\t    }\r\n    47\t  ],\r\n    48\t  \"completion_gates\": [\r\n    49\t    {\r\n    50\t      \"reference\": \"GDD §2 Move and Aim\",\r\n    51\t      \"requirement\": \"Play Mode validation that clicking a location moves the wizard toward it and that holding steers continuously toward the live cursor position.\",\r\n    52\t      \"gate_id\": \"VAL-001\"\r\n    53\t    },\r\n    54\t    {\r\n    55\t      \"reference\": \"Victory/input-shutdown ownership\",\r\n    56\t      \"requirement\": \"Play Mode check: invoking the suspend interface while movement is active immediately halts the wizard's in-progress movement (including an active click-to-destination approach), and further movement input has no effect until an authorized re-enable/reset flow runs.\",\r\n    57\t      \"gate_id\": \"VAL-002\"\r\n    58\t    }\r\n    59\t  ],\r\n    60\t  \"downstream_integration_obligations\": [\r\n    61\t    {\r\n    62\t      \"reference\": \"GDD §2 Player Movement ownership\",\r\n    63\t      \"requirement\": \"Validate that the exposed world-space pointer target is correctly consumable by a cursor-aimed spell or Door/Interaction integration once those systems exist.\",\r\n    64\t      \"obligation_id\": \"INT-001\"\r\n    65\t    }\r\n    66\t  ],\r\n    67\t  \"gdd_evidence\": [\r\n    68\t    {\r\n    69\t      \"reference\": \"GDD §2 Player Actions and Systems — Move and Aim\",\r\n    70\t      \"requirement\": \"Mouse-directed movement through the shared Unity Input System/Input Actions layer: click to set a destination or hold to keep steering toward the cursor; Player Movement owns the shared cursor-to-gameplay-plane projection and exposes the resulting world-space pointer target consumed by movement, cursor-aimed spells, and cursor-targeted interactions (Force Wave is the exception).\"\r\n    71\t    },\r\n    72\t    {\r\n    73\t      \"reference\": \"GDD §2 Resources, Feedback, and Failure — Player Movement ownership\",\r\n    74\t      \"requirement\": \"Player Movement owns position, locomotion, movement-restriction state, and the shared cursor-to-gameplay-plane projection; runtime input is routed through Input System/Input Actions rather than direct hardware polling; Charged Fireball requests/releases its movement restriction through an owner-controlled Player Movement interface without mutating movement internals.\"\r\n    75\t    },\r\n    76\t    {\r\n    77\t      \"reference\": \"GDD §2 Loss — Floor-run restart ownership\",\r\n    78\t      \"requirement\": \"Player Movement/player position is a required reset participant invoked by the Floor Run/Restart Orchestrator through an owner-controlled reset entry point.\"\r\n    79\t    },\r\n    80\t    {\r\n    81\t      \"reference\": \"Section 2 — Victory/input-shutdown ownership bullet\",\r\n    82\t      \"requirement\": \"Player Movement, Door/Interaction, Fireball, Frost Field, and Force Wave each expose an owner-controlled gameplay-enable/suspend interface that can immediately stop or cancel their current input-driven activity, reject new gameplay commands while suspended, and be re-enabled by an authorized reset/test flow.\"\r\n    83\t    }\r\n    84\t  ],\r\n    85\t  \"basis\": \"direct_gdd\",\r\n    86\t  \"source_scope\": \"required\",\r\n    87\t  \"confidence\": \"high\",\r\n    88\t  \"notes\": \"Exact movement speed/feel tuning is left to playtesting per GDD and is not part of this item's required acceptance surface.\",\r\n    89\t  \"repository_state_at_bootstrap\": \"partial\",\r\n    90\t  \"repository_evidence_at_bootstrap\": [\r\n    91\t    {\r\n    92\t      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerMovement.cs\",\r\n    93\t      \"evidence_type\": \"code\",\r\n    94\t      \"observation\": \"Implements only CharacterController-driven WASD movement via direct Keyboard.current polling; no mouse-directed movement, cursor projection, movement-restriction interface, or reset entry point exist.\"\r\n    95\t    },\r\n    96\t    {\r\n    97\t      \"path\": \"Assets/InputSystem_Actions.inputactions\",\r\n    98\t      \"evidence_type\": \"project_setting\",\r\n    99\t      \"observation\": \"Unmodified stock Unity template action asset; Player map has only WASD/Dpad Move and button actions (Attack/Interact/Crouch/Jump/etc.), no cursor-to-gameplay-plane or click-to-move action, and PlayerMovement.cs does not reference it.\"\r\n   100\t    },\r\n   101\t    {\r\n   102\t      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\",\r\n   103\t      \"evidence_type\": \"scene\",\r\n   104\t      \"observation\": \"PlayerMovement.cs (guid 356044e6782dd0641a7e69b0abfa5c4a) is serialized on the Player GameObject, confirming current WASD movement is the integrated state, not merely available via the builder.\"\r\n   105\t    }\r\n   106\t  ],\r\n   107\t  \"provenance\": {\r\n   108\t    \"origin\": \"verified_reconciliation_bootstrap\",\r\n   109\t    \"source_schema_version\": \"1.0\",\r\n   110\t    \"reconciliation_run_id\": \"20260821T193541Z-998ee7b5\",\r\n   111\t    \"verification_run_id\": \"20260821T195959Z-43dba5de\",\r\n   112\t    \"bootstrap_status_observation\": \"open\",\r\n   113\t    \"migration_id\": \"task-contract-schema-v2-20260822-r2\"\r\n   114\t  }\r\n   115\t}\r\n     1\t{\r\n     2\t  \"schema_version\": \"2.0\",\r\n     3\t  \"id\": \"NSC-023\",\r\n     4\t  \"contract_revision\": 1,\r\n     5\t  \"contract_disposition\": \"active\",\r\n     6\t  \"title\": \"Fixed Isometric Camera\",\r\n     7\t  \"reconciliation_key\": \"fixed-isometric-camera\",\r\n     8\t  \"kind\": \"implementation\",\r\n     9\t  \"type\": \"world-foundation\",\r\n    10\t  \"execution_scope\": \"single_agent\",\r\n    11\t  \"execution_reason\": \"The fixed-camera behavior is a bounded implementation contract. Historical delivery does not make its execution scope not-applicable; current completion is derived elsewhere.\",\r\n    12\t  \"decomposition_state\": \"concrete\",\r\n    13\t  \"decomposition_reason\": \"The fixed projection/no-free-rotation behavior is a concrete bounded contract. Delivery state is intentionally separate from decomposition state.\",\r\n    14\t  \"parent\": \"NSC-022\",\r\n    15\t  \"depends_on\": [],\r\n    16\t  \"exclusive_resources\": [],\r\n    17\t  \"acceptance_criteria\": [\r\n    18\t    {\r\n    19\t      \"reference\": \"GDD - Executive Summary / 2.5D Isometric Visual and World Representation\",\r\n    20\t      \"requirement\": \"Camera renders the gameplay world using a fixed orthographic 2.5D isometric projection at a consistent dimetric angle.\",\r\n    21\t      \"criterion_id\": \"AC-001\"\r\n    22\t    },\r\n    23\t    {\r\n    24\t      \"reference\": \"GDD - 2.5D Isometric Visual and World Representation\",\r\n    25\t      \"requirement\": \"No player-controllable free rotation of the world view is exposed; the camera's rotation never changes at runtime.\",\r\n    26\t      \"criterion_id\": \"AC-002\"\r\n    27\t    }\r\n    28\t  ],\r\n    29\t  \"completion_gates\": [\r\n    30\t    {\r\n    31\t      \"reference\": \"Bootstrap repository evidence — DoorPrototypeSceneBuilderTests\",\r\n    32\t      \"requirement\": \"Unity validation confirms the canonical camera is orthographic and uses the fixed approved isometric rotation without a runtime rotation controller.\",\r\n    33\t      \"gate_id\": \"VAL-001\"\r\n    34\t    },\r\n    35\t    {\r\n    36\t      \"reference\": \"Bootstrap repository evidence — IsometricCameraFollow validation\",\r\n    37\t      \"requirement\": \"Unity validation confirms target-follow translation does not change the camera's fixed rotation.\",\r\n    38\t      \"gate_id\": \"VAL-002\"\r\n    39\t    }\r\n    40\t  ],\r\n    41\t  \"downstream_integration_obligations\": [\r\n    42\t    {\r\n    43\t      \"reference\": \"GDD - Camera completion and future integration\",\r\n    44\t      \"requirement\": \"Once the Tilemap/SpriteRenderer world-visual foundation exists, validate that the fixed isometric camera framing remains visually compatible with the new visual layer (alignment/sorting check), without reopening the already-satisfied fixed-angle/no-rotation requirement.\",\r\n    45\t      \"obligation_id\": \"INT-001\"\r\n    46\t    }\r\n    47\t  ],\r\n    48\t  \"gdd_evidence\": [\r\n    49\t    {\r\n    50\t      \"reference\": \"GDD - Executive Summary\",\r\n    51\t      \"requirement\": \"The camera is fixed, the world is viewed at an angle, and the visible environment is authored as isometric art rather than a free-rotation 3D space.\"\r\n    52\t    },\r\n    53\t    {\r\n    54\t      \"reference\": \"GDD - 2.5D Isometric Visual and World Representation\",\r\n    55\t      \"requirement\": \"The camera is fixed in an isometric presentation; the player does not rotate the world view freely.\"\r\n    56\t    }\r\n    57\t  ],\r\n    58\t  \"basis\": \"direct_gdd\",\r\n    59\t  \"source_scope\": \"required\",\r\n    60\t  \"confidence\": \"high\",\r\n    61\t  \"notes\": \"Per current provenance boundary: only the fixed-angle/no-free-rotation requirement is treated as GDD-backed acceptance criteria. The camera's player-follow translation (IsometricCameraFollow) is a valid current implementation detail and is recorded as repository evidence only, since the current GDD does not require player-follow camera behavior.\",\r\n    62\t  \"repository_state_at_bootstrap\": \"implemented\",\r\n    63\t  \"repository_evidence_at_bootstrap\": [\r\n    64\t    {\r\n    65\t      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Editor/DoorPrototypeSceneBuilder.cs\",\r\n    66\t      \"evidence_type\": \"code\",\r\n    67\t      \"observation\": \"BuildCamera sets camera.orthographic = true, camera.orthographicSize = 8f, and cameraObject.transform.rotation = Quaternion.Euler(30f, -45f, 0f) once; no later code path in the builder modifies camera rotation.\"\r\n    68\t    },\r\n    69\t    {\r\n    70\t      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scripts/IsometricCameraFollow.cs\",\r\n    71\t      \"evidence_type\": \"code\",\r\n    72\t      \"observation\": \"LateUpdate only writes transform.position = target.position + offset; rotation is never read or written after Initialize captures the position offset.\"\r\n    73\t    },\r\n    74\t    {\r\n    75\t      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\",\r\n    76\t      \"evidence_type\": \"scene\",\r\n    77\t      \"observation\": \"Serialized Main Camera has orthographic: 1, orthographic size: 8, and a wired IsometricCameraFollow component (target + offset {10,10,-10}); no rotation-modifying component is attached.\"\r\n    78\t    },\r\n    79\t    {\r\n    80\t      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Tests/Editor/DoorPrototypeSceneBuilderTests.cs\",\r\n    81\t      \"evidence_type\": \"test\",\r\n    82\t      \"observation\": \"Build_MainCamera_IsFixedOrthographicIsometric asserts orthographic mode and rotation equal to Quaternion.Euler(30,-45,0) within 0.01 degrees and absence of any Rotate/Orbit-named component; Build_MainCamera_TranslatesWithPlayerButRotationStaysFixed asserts rotation is unchanged after the player moves and LateUpdate runs.\"\r\n    83\t    }\r\n    84\t  ],\r\n    85\t  \"provenance\": {\r\n    86\t    \"origin\": \"verified_reconciliation_bootstrap\",\r\n    87\t    \"source_schema_version\": \"1.0\",\r\n    88\t    \"reconciliation_run_id\": \"20260821T193541Z-998ee7b5\",\r\n    89\t    \"verification_run_id\": \"20260821T195959Z-43dba5de\",\r\n    90\t    \"bootstrap_status_observation\": \"complete\",\r\n    91\t    \"migration_id\": \"task-contract-schema-v2-20260822-r2\"\r\n    92\t  }\r\n    93\t}\r\n     1\t# Task Contract Schema 2.0\r\n     2\t\r\n     3\t## Purpose\r\n     4\t\r\n     5\t`Tasks/*.yaml` defines approved work contracts. It does not store current execution, delivery, validation, or completion truth.\r\n     6\t\r\n     7\tSchema 2.0 removes the v1 top-level `status` field because a mutable YAML value could previously unlock downstream work without proving that implementation was integrated, validated, current against canon, or still valid after later changes.\r\n     8\t\r\n     9\tThe files remain in the deterministic JSON-compatible YAML 1.2 subset used by the existing TaskGraph tooling.\r\n    10\t\r\n    11\t## Authority boundary\r\n    12\t\r\n    13\tA v2 task contract may define:\r\n    14\t\r\n    15\t- stable `NSC-###` identity and `reconciliation_key`;\r\n    16\t- contract revision and disposition;\r\n    17\t- title, kind, type, parent, dependencies, and exclusive resources;\r\n    18\t- execution/decomposition scope as properties of the work itself;\r\n    19\t- acceptance criteria;\r\n    20\t- completion gates;\r\n    21\t- downstream integration obligations;\r\n    22\t- GDD and repository evidence captured when the contract was created;\r\n    23\t- per-contract provenance.\r\n    24\t\r\n    25\tA v2 task contract may not claim:\r\n    26\t\r\n    27\t- that work is currently ready;\r\n    28\t- that a worker owns or is running the task;\r\n    29\t- that implementation is currently complete;\r\n    30\t- that validation passed;\r\n    31\t- that a result is merged;\r\n    32\t- that later GDD or code changes did not invalidate prior evidence.\r\n    33\t\r\n    34\tThose states will be derived later from task contracts, current canon, attempt journals, integrated Git state, delivery/revalidation evidence, and human decisions.\r\n    35\t\r\n    36\t## Required top-level fields\r\n    37\t\r\n    38\t```json\r\n    39\t{\r\n    40\t  \"schema_version\": \"2.0\",\r\n    41\t  \"id\": \"NSC-003\",\r\n    42\t  \"contract_revision\": 1,\r\n    43\t  \"contract_disposition\": \"active\",\r\n    44\t  \"title\": \"...\",\r\n    45\t  \"reconciliation_key\": \"...\",\r\n    46\t  \"kind\": \"implementation\",\r\n    47\t  \"type\": \"...\",\r\n    48\t  \"execution_scope\": \"single_agent\",\r\n    49\t  \"execution_reason\": \"...\",\r\n    50\t  \"decomposition_state\": \"concrete\",\r\n    51\t  \"decomposition_reason\": \"...\",\r\n    52\t  \"parent\": \"NSC-002\",\r\n    53\t  \"depends_on\": [],\r\n    54\t  \"exclusive_resources\": [],\r\n    55\t  \"acceptance_criteria\": [],\r\n    56\t  \"completion_gates\": [],\r\n    57\t  \"downstream_integration_obligations\": [],\r\n    58\t  \"gdd_evidence\": [],\r\n    59\t  \"basis\": \"direct_gdd\",\r\n    60\t  \"source_scope\": \"required\",\r\n    61\t  \"confidence\": \"high\",\r\n    62\t  \"notes\": \"\",\r\n    63\t  \"repository_state_at_bootstrap\": \"missing\",\r\n    64\t  \"repository_evidence_at_bootstrap\": [],\r\n    65\t  \"provenance\": {}\r\n    66\t}\r\n    67\t```\r\n    68\t\r\n    69\t## Contract revision\r\n    70\t\r\n    71\t`contract_revision` is a positive integer. Increase it only when the approved meaning of the work contract changes. Delivery/conformance evidence must eventually bind to an exact contract revision and hash.\r\n    72\t\r\n    73\t## Contract disposition\r\n    74\t\r\n    75\tAllowed values:\r\n    76\t\r\n    77\t- `active` — the contract is still applicable;\r\n    78\t- `superseded` — a newer active task contract replaces it; `superseded_by` is required;\r\n    79\t- `cancelled` — human authority intentionally cancelled the contract.\r\n    80\t\r\n    81\tDisposition describes the applicability of the contract. It is not implementation status.\r\n    82\t\r\n    83\t## Numbered acceptance and validation entries\r\n    84\t\r\n    85\tAcceptance criteria use stable contract-local IDs:\r\n    86\t\r\n    87\t```json\r\n    88\t{\r\n    89\t  \"criterion_id\": \"AC-001\",\r\n    90\t  \"reference\": \"GDD section\",\r\n    91\t  \"requirement\": \"Required behavior\"\r\n    92\t}\r\n    93\t```\r\n    94\t\r\n    95\tCompletion gates use:\r\n    96\t\r\n    97\t```json\r\n    98\t{\r\n    99\t  \"gate_id\": \"VAL-001\",\r\n   100\t  \"reference\": \"Validation source\",\r\n   101\t  \"requirement\": \"Evidence required when this task is delivered\"\r\n   102\t}\r\n   103\t```\r\n   104\t\r\n   105\tDownstream integration obligations use:\r\n   106\t\r\n   107\t```json\r\n   108\t{\r\n   109\t  \"obligation_id\": \"INT-001\",\r\n   110\t  \"reference\": \"Future integration source\",\r\n   111\t  \"requirement\": \"Check owned by later integration work\"\r\n   112\t}\r\n   113\t```\r\n   114\t\r\n   115\tA completion gate must be achievable when the task is delivered. A check that can only occur after another future system exists belongs under `downstream_integration_obligations` and should later be assigned to the relevant integration task.\r\n   116\t\r\n   117\t## Provenance\r\n   118\t\r\n   119\tThe initial migration records bootstrap history like this:\r\n   120\t\r\n   121\t```json\r\n   122\t{\r\n   123\t  \"origin\": \"verified_reconciliation_bootstrap\",\r\n   124\t  \"source_schema_version\": \"1.0\",\r\n   125\t  \"reconciliation_run_id\": \"...\",\r\n   126\t  \"verification_run_id\": \"...\",\r\n   127\t  \"bootstrap_status_observation\": \"open\",\r\n   128\t  \"migration_id\": \"task-contract-schema-v2-20260822\"\r\n   129\t}\r\n   130\t```\r\n   131\t\r\n   132\t`bootstrap_status_observation` is historical context only. It is deliberately nested under provenance and cannot authorize execution or prove current conformance.\r\n   133\t\r\n   134\tFuture task contracts may have different provenance. Schema 2.0 no longer requires every task to come from one bootstrap run.\r\n   135\t\r\n   136\t## Forbidden v1 operational fields\r\n   137\t\r\n   138\tSchema-v2 tasks are invalid if they contain:\r\n   139\t\r\n   140\t```text\r\n   141\tstatus\r\n   142\tvalidation_requirements\r\n   143\tbootstrap_source\r\n   144\t```\r\n   145\t\r\n   146\tThe migration converts these fields instead of carrying them forward unchanged.\r\n   147\t\r\n   148\t## Camera migration correction\r\n   149\t\r\n   150\tThe v1 camera task mixed historical completion with contract scope:\r\n   151\t\r\n   152\t- `execution_scope: not_applicable`;\r\n   153\t- `decomposition_state: not_applicable`;\r\n   154\t- one validation requirement that could only be checked after a future visual foundation existed.\r\n   155\t\r\n   156\tThe v2 migration corrects this by:\r\n   157\t\r\n   158\t- restoring the bounded camera contract to `execution_scope: single_agent`;\r\n   159\t- restoring `decomposition_state: concrete`;\r\n   160\t- deriving its historical camera completion gates from the recorded Unity test evidence;\r\n   161\t- moving the future Tilemap/SpriteRenderer compatibility check to `downstream_integration_obligations`.\r\n   162\t\r\n   163\t## Migration commands\r\n   164\t\r\n   165\tCheck without writing:\r\n   166\t\r\n   167\t```powershell\r\n   168\tdocker compose run --rm codex-review python3 Pipeline/TaskGraph/migrate_task_contracts_v2.py --check\r\n   169\t```\r\n   170\t\r\n   171\tRun deterministic smoke tests:\r\n   172\t\r\n   173\t```powershell\r\n   174\tdocker compose run --rm codex-review python3 Pipeline/TaskGraph/migrate_task_contracts_v2_smoke_test.py\r\n   175\t```\r\n   176\t\r\n   177\tApply the migration:\r\n   178\t\r\n   179\t```powershell\r\n   180\tdocker compose run --rm codex-review python3 Pipeline/TaskGraph/migrate_task_contracts_v2.py --apply\r\n   181\t```\r\n   182\t\r\n   183\tThe apply is idempotent. It writes task files atomically one at a time and publishes `TASK_CONTRACT_V2_MIGRATION.json` last. If interrupted before the report is published, rerun the same command; mixed v1/v2 task sets are recoverable by the migrator but rejected by the normal live graph loader.\r\n   184\t\r\n   185\t## What schema 2.0 does not yet implement\r\n   186\t\r\n   187\tSchema 2.0 does not create execution authority. After migration:\r\n   188\t\r\n   189\t```text\r\n   190\ttaskcontrol ready\r\n   191\t```\r\n   192\t\r\n   193\treports readiness as unavailable, and:\r\n   194\t\r\n   195\t```text\r\n   196\ttaskcontrol authorize NSC-003\r\n   197\t```\r\n   198\t\r\n   199\tcontinues to deny execution.\r\n   200\t\r\n   201\tThe next phase must introduce delivery/revalidation records and derived current conformance before autonomous dispatch can be enabled.\r\n     1\tfrom __future__ import annotations\r\n     2\t\r\n     3\t\"\"\"Deterministic current-conformance evaluation against committed HEAD.\"\"\"\r\n     4\t\r\n     5\timport json\r\n     6\tfrom dataclasses import asdict, dataclass\r\n     7\tfrom pathlib import Path\r\n     8\tfrom typing import Any\r\n     9\t\r\n    10\tfrom conformance_records import (\r\n    11\t    CANON_PATH,\r\n    12\t    CommittedRecord,\r\n    13\t    ConformanceRecordError,\r\n    14\t    GitRepository,\r\n    15\t    canonical_text_sha256,\r\n    16\t    load_committed_records,\r\n    17\t    semantic_json_sha256,\r\n    18\t)\r\n    19\t\r\n    20\tROOT = Path(__file__).resolve().parents[2]\r\n    21\t\r\n    22\t\r\n    23\t@dataclass(frozen=True)\r\n    24\tclass Finding:\r\n    25\t    code: str\r\n    26\t    message: str\r\n    27\t    record_id: str | None = None\r\n    28\t\r\n    29\t\r\n    30\t@dataclass(frozen=True)\r\n    31\tclass ConformanceState:\r\n    32\t    task_id: str\r\n    33\t    title: str\r\n    34\t    state: str\r\n    35\t    head_commit: str\r\n    36\t    head_tree: str\r\n    37\t    selected_record_id: str | None\r\n    38\t    findings: tuple[Finding, ...]\r\n    39\t    dirty_worktree: bool\r\n    40\t\r\n    41\t    def to_dict(self) -> dict[str, Any]:\r\n    42\t        value = asdict(self)\r\n    43\t        value[\"findings\"] = [asdict(item) for item in self.findings]\r\n    44\t        return value\r\n    45\t\r\n    46\t\r\n    47\tdef _json(repo: GitRepository, commit: str, path: str, label: str) -> dict[str, Any]:\r\n    48\t    try:\r\n    49\t        value = json.loads(repo.read(commit, path).decode(\"utf-8-sig\"))\r\n    50\t    except (UnicodeDecodeError, json.JSONDecodeError, ConformanceRecordError) as exc:\r\n    51\t        raise ConformanceRecordError(f\"Unable to load {label} {path} at {commit}: {exc}\") from exc\r\n    52\t    if not isinstance(value, dict):\r\n    53\t        raise ConformanceRecordError(f\"{label} {path} must contain a JSON object.\")\r\n    54\t    return value\r\n    55\t\r\n    56\t\r\n    57\tdef resolve_committed_task(repo: GitRepository, head: str, selector: str) -> tuple[str, dict[str, Any]]:\r\n    58\t    raw = selector.strip()\r\n    59\t    if not raw:\r\n    60\t        raise ValueError(\"Task selector may not be blank.\")\r\n    61\t    direct = f\"Tasks/{raw.upper()}.yaml\"\r\n    62\t    if repo.exists(head, direct):\r\n    63\t        task = _json(repo, head, direct, \"task contract\")\r\n    64\t        return direct, task\r\n    65\t    matches: list[tuple[str, dict[str, Any]]] = []\r\n    66\t    for path in repo.files(head, \"Tasks\"):\r\n    67\t        if not path.endswith(\".yaml\"):\r\n    68\t            continue\r\n    69\t        task = _json(repo, head, path, \"task contract\")\r\n    70\t        if task.get(\"reconciliation_key\") == raw:\r\n    71\t            matches.append((path, task))\r\n    72\t    if len(matches) != 1:\r\n    73\t        raise ValueError(f\"Unknown task: {selector!r}. Use an NSC-* ID or reconciliation_key.\")\r\n    74\t    return matches[0]\r\n    75\t\r\n    76\t\r\n    77\tdef _finding(code: str, message: str, record: CommittedRecord | None = None) -> Finding:\r\n    78\t    return Finding(code, message, record.record_id if record else None)\r\n    79\t\r\n    80\t\r\n    81\tdef _validate_basis_graph(repo: GitRepository, records: list[CommittedRecord]) -> list[Finding]:\r\n    82\t    by_id = {record.record_id: record for record in records}\r\n    83\t    findings: list[Finding] = []\r\n    84\t    for record in records:\r\n    85\t        if record.data[\"record_type\"] != \"revalidation\":\r\n    86\t            continue\r\n    87\t        basis_id = record.data[\"revalidation\"][\"basis_record_id\"]\r\n    88\t        basis = by_id.get(basis_id)\r\n    89\t        if basis is None:\r\n    90\t            findings.append(_finding(\"basis_missing\", f\"Basis record {basis_id} does not exist.\", record))\r\n    91\t            continue\r\n    92\t        if basis.data[\"task_id\"] != record.data[\"task_id\"]:\r\n    93\t            findings.append(_finding(\"basis_task_mismatch\", \"Revalidation basis belongs to another task.\", record))\r\n    94\t        if not repo.is_ancestor(basis.validated_commit, record.validated_commit):\r\n    95\t            findings.append(_finding(\"basis_not_ancestor\", \"Basis validated commit is not an ancestor of revalidation commit.\", record))\r\n    96\t        seen = {record.record_id}\r\n    97\t        cursor = basis\r\n    98\t        while cursor.data[\"record_type\"] == \"revalidation\":\r\n    99\t            if cursor.record_id in seen:\r\n   100\t                findings.append(_finding(\"basis_cycle\", \"Revalidation basis chain contains a cycle.\", record))\r\n   101\t                break\r\n   102\t            seen.add(cursor.record_id)\r\n   103\t            next_id = cursor.data[\"revalidation\"][\"basis_record_id\"]\r\n   104\t            if next_id not in by_id:\r\n   105\t                break\r\n   106\t            cursor = by_id[next_id]\r\n   107\t    return findings\r\n   108\t\r\n   109\t\r\n   110\tdef _current_gate_ids(task: dict[str, Any]) -> list[str]:\r\n   111\t    gates = task.get(\"completion_gates\")\r\n   112\t    if not isinstance(gates, list):\r\n   113\t        raise ConformanceRecordError(\"Current task contract completion_gates must be a list.\")\r\n   114\t    result = [gate.get(\"gate_id\") if isinstance(gate, dict) else None for gate in gates]\r\n   115\t    if any(not isinstance(item, str) or not item for item in result) or len(set(result)) != len(result):\r\n   116\t        raise ConformanceRecordError(\"Current task contract has invalid or duplicate completion gate IDs.\")\r\n   117\t    return result  # type: ignore[return-value]\r\n   118\t\r\n   119\t\r\n   120\tdef _maximal(repo: GitRepository, records: list[CommittedRecord]) -> list[CommittedRecord]:\r\n   121\t    maximal: list[CommittedRecord] = []\r\n   122\t    for candidate in records:\r\n   123\t        if any(\r\n   124\t            other.record_id != candidate.record_id\r\n   125\t            and other.validated_commit != candidate.validated_commit\r\n   126\t            and repo.is_ancestor(candidate.validated_commit, other.validated_commit)\r\n   127\t            for other in records\r\n   128\t        ):\r\n   129\t            continue\r\n   130\t        maximal.append(candidate)\r\n   131\t    return sorted(maximal, key=lambda item: item.record_id)\r\n   132\t\r\n   133\t\r\n   134\tdef evaluate_current_conformance(root: Path | str = ROOT, selector: str = \"\") -> ConformanceState:\r\n   135\t    repo = GitRepository(root)\r\n   136\t    head = repo.head()\r\n   137\t    head_tree = repo.tree(head)\r\n   138\t    dirty = repo.dirty()\r\n   139\t    task_path, task = resolve_committed_task(repo, head, selector)\r\n   140\t    task_id = str(task.get(\"id\") or \"\")\r\n   141\t    title = str(task.get(\"title\") or \"\")\r\n   142\t\r\n   143\t    if task.get(\"schema_version\") != \"2.0\":\r\n   144\t        raise ValueError(f\"{task_id or task_path}: state requires a schema-v2 task contract at committed HEAD.\")\r\n   145\t\r\n   146\t    disposition = task.get(\"contract_disposition\")\r\n   147\t    if disposition in {\"cancelled\", \"superseded\"}:\r\n   148\t        return ConformanceState(task_id, title, disposition, head, head_tree, None,\r\n   149\t            (_finding(f\"contract_{disposition}\", f\"Contract disposition is {disposition}.\"),), dirty)\r\n   150\t    if task.get(\"kind\") == \"feature\" or task.get(\"execution_scope\") != \"single_agent\":\r\n   151\t        return ConformanceState(task_id, title, \"aggregate\", head, head_tree, None,\r\n   152\t            (_finding(\"non_executable_contract\", \"Feature or non-executable contract is aggregate.\"),), dirty)\r\n   153\t\r\n   154\t    try:\r\n   155\t        records = load_committed_records(repo, head, task_id)\r\n   156\t    except ConformanceRecordError as exc:\r\n   157\t        return ConformanceState(task_id, title, \"invalid_evidence\", head, head_tree, None,\r\n   158\t            (_finding(\"record_structure_invalid\", str(exc)),), dirty)\r\n   159\t    if not records:\r\n   160\t        return ConformanceState(task_id, title, \"not_delivered\", head, head_tree, None,\r\n   161\t            (_finding(\"no_committed_evidence\", \"No committed delivery, baseline, or revalidation record exists.\"),), dirty)\r\n   162\t\r\n   163\t    invalid = _validate_basis_graph(repo, records)\r\n   164\t    current_contract_hash = semantic_json_sha256(repo.read(head, task_path))\r\n   165\t    current_revision = task.get(\"contract_revision\")\r\n   166\t    current_canon_hash = canonical_text_sha256(repo.read(head, CANON_PATH))\r\n   167\t    current_gate_ids = _current_gate_ids(task)\r\n   168\t    conformant: list[CommittedRecord] = []\r\n   169\t    replan: list[CommittedRecord] = []\r\n   170\t    human: list[CommittedRecord] = []\r\n   171\t    stale: list[CommittedRecord] = []\r\n   172\t\r\n   173\t    for record in records:\r\n   174\t        data = record.data\r\n   175\t        state = data[\"validated_state\"]\r\n   176\t        try:\r\n   177\t            if repo.tree(state[\"commit\"]) != state[\"tree\"]:\r\n   178\t                invalid.append(_finding(\"validated_tree_mismatch\", \"Recorded tree does not match validated commit.\", record))\r\n   179\t                continue\r\n   180\t            contract = data[\"task_contract\"]\r\n   181\t            historical_task_raw = repo.read(state[\"commit\"], contract[\"path\"])\r\n   182\t            historical_task = json.loads(historical_task_raw.decode(\"utf-8-sig\"))\r\n   183\t            if semantic_json_sha256(historical_task) != contract[\"sha256\"] or historical_task.get(\"contract_revision\") != contract[\"revision\"] or historical_task.get(\"id\") != task_id:\r\n   184\t                invalid.append(_finding(\"recorded_contract_mismatch\", \"Recorded contract identity/hash is false at validated commit.\", record))\r\n   185\t                continue\r\n   186\t            canon = data[\"canon\"]\r\n   187\t            if canonical_text_sha256(repo.read(state[\"commit\"], canon[\"path\"])) != canon[\"sha256\"]:\r\n   188\t                invalid.append(_finding(\"recorded_canon_mismatch\", \"Recorded canon hash is false at validated commit.\", record))\r\n   189\t                continue\r\n   190\t            bad_surface = False\r\n   191\t            changed_surface = False\r\n   192\t            for surface in data[\"conformance_surfaces\"]:\r\n   193\t                if repo.blob(state[\"commit\"], surface[\"path\"]) != surface[\"blob_sha\"]:\r\n   194\t                    invalid.append(_finding(\"surface_validated_blob_mismatch\", f\"Surface {surface['path']} blob is false at validated commit.\", record))\r\n   195\t                    bad_surface = True\r\n   196\t                    break\r\n   197\t                if not repo.exists(head, surface[\"path\"]) or repo.blob(head, surface[\"path\"]) != surface[\"blob_sha\"]:\r\n   198\t                    changed_surface = True\r\n   199\t            if bad_surface:\r\n   200\t                continue\r\n   201\t            artifact_bad = False\r\n   202\t            for gate in data[\"gate_results\"]:\r\n   203\t                for evidence in gate[\"evidence\"]:\r\n   204\t                    artifact_prefix = f\"Pipeline/TaskGraph/evidence/{task_id}/artifacts/\"\r\n   205\t                    if not evidence[\"path\"].startswith(artifact_prefix):\r\n   206\t                        invalid.append(_finding(\"artifact_location_invalid\", f\"Gate artifact is outside {artifact_prefix}.\", record))\r\n   207\t                        artifact_bad = True\r\n   208\t                    elif not repo.exists(head, evidence[\"path\"]) or repo.blob(head, evidence[\"path\"]) != evidence[\"blob_sha\"]:\r\n   209\t                        invalid.append(_finding(\"artifact_blob_mismatch\", f\"Evidence artifact {evidence['path']} is absent or altered at HEAD.\", record))\r\n   210\t                        artifact_bad = True\r\n   211\t            if artifact_bad:\r\n   212\t                continue\r\n   213\t        except (ConformanceRecordError, json.JSONDecodeError, UnicodeDecodeError) as exc:\r\n   214\t            invalid.append(_finding(\"record_object_unavailable\", str(exc), record))\r\n   215\t            continue\r\n   216\t\r\n   217\t        if not repo.is_ancestor(state[\"commit\"], head):\r\n   218\t            stale.append(record)\r\n   219\t            continue\r\n   220\t\r\n   221\t        record_gate_ids = [gate[\"gate_id\"] for gate in data[\"gate_results\"]]\r\n   222\t        if record_gate_ids != current_gate_ids and set(record_gate_ids) != set(current_gate_ids):\r\n   223\t            invalid.append(_finding(\"completion_gate_set_mismatch\", \"Record does not contain exactly the current completion-gate set.\", record))\r\n   224\t            continue\r\n   225\t        contract_changed = contract[\"path\"] != task_path or contract[\"revision\"] != current_revision or contract[\"sha256\"] != current_contract_hash\r\n   226\t        if contract_changed:\r\n   227\t            replan.append(record)\r\n   228\t            continue\r\n   229\t        approval = data[\"human_approval\"]\r\n   230\t        if approval[\"required\"] and (approval[\"decision\"] != \"approved\" or not approval[\"approved_by\"].strip()):\r\n   231\t            human.append(record)\r\n   232\t            continue\r\n   233\t        if (not approval[\"required\"] and approval[\"decision\"] != \"not_required\"):\r\n   234\t            invalid.append(_finding(\"human_approval_contradictory\", \"Non-required approval must use not_required.\", record))\r\n   235\t            continue\r\n   236\t        if changed_surface or canon[\"path\"] != CANON_PATH or canon[\"sha256\"] != current_canon_hash:\r\n   237\t            stale.append(record)\r\n   238\t            continue\r\n   239\t        conformant.append(record)\r\n   240\t\r\n   241\t    if invalid:\r\n   242\t        return ConformanceState(task_id, title, \"invalid_evidence\", head, head_tree, None, tuple(invalid), dirty)\r\n   243\t    if conformant:\r\n   244\t        maximal = _maximal(repo, conformant)\r\n   245\t        if len(maximal) != 1:\r\n   246\t            ids = \", \".join(item.record_id for item in maximal)\r\n   247\t            return ConformanceState(task_id, title, \"ambiguous_evidence\", head, head_tree, None,\r\n   248\t                (_finding(\"multiple_maximal_current_records\", f\"Multiple maximal current-valid records: {ids}.\"),), dirty)\r\n   249\t        selected = maximal[0]\r\n   250\t        return ConformanceState(task_id, title, \"conformant\", head, head_tree, selected.record_id,\r\n   251\t            (_finding(\"current_record_selected\", \"Record is valid for current contract, canon, surfaces, gates, and artifacts.\", selected),), dirty)\r\n   252\t    for state_name, candidates, code, message in (\r\n   253\t        (\"needs_replan\", replan, \"contract_changed\", \"Current contract revision or semantic hash differs from prior evidence.\"),\r\n   254\t        (\"needs_human\", human, \"human_approval_missing\", \"Required human approval is missing.\"),\r\n   255\t        (\"needs_revalidation\", stale, \"evidence_stale\", \"Prior evidence exists but is not current for HEAD.\"),\r\n   256\t    ):\r\n   257\t        if candidates:\r\n   258\t            maximal = _maximal(repo, candidates)\r\n   259\t            selected = maximal[0] if len(maximal) == 1 else None\r\n   260\t            return ConformanceState(task_id, title, state_name, head, head_tree,\r\n   261\t                selected.record_id if selected else None, (_finding(code, message, selected),), dirty)\r\n   262\t    return ConformanceState(task_id, title, \"not_delivered\", head, head_tree, None,\r\n   263\t        (_finding(\"no_usable_evidence\", \"No usable committed evidence exists.\"),), dirty)\r\n     1\tfrom __future__ import annotations\r\n     2\t\r\n     3\tfrom dataclasses import dataclass\r\n     4\tfrom typing import Any\r\n     5\t\r\n     6\tCURRENT_REASON_CODE = \"evidence_derived_dispatch_policy_not_enabled\"\r\n     7\t# Compatibility alias retained for the Phase 1 regression harness.\r\n     8\tPHASE1_REASON_CODE = CURRENT_REASON_CODE\r\n     9\tDENIAL_MESSAGE = (\r\n    10\t    \"Evidence-derived current conformance has been proven on at least one real task, but a \"\r\n    11\t    \"conformant result does not establish dependency readiness. Dependency-readiness policy \"\r\n    12\t    \"and dispatch authorization policy have not been implemented or approved. State inspection \"\r\n    13\t    \"and a conformant result never authorize autonomous execution; \"\r\n    14\t    \"zero tasks may be autonomously dispatched.\"\r\n    15\t)\r\n    16\t\r\n    17\t\r\n    18\tclass UnsafeExecutionAuthorizationError(RuntimeError):\r\n    19\t    \"\"\"Raised when code attempts to dispatch without enabled dispatch authority.\"\"\"\r\n    20\t\r\n    21\t\r\n    22\t@dataclass(frozen=True)\r\n    23\tclass ExecutionAuthorization:\r\n    24\t    task_id: str\r\n    25\t    authorized: bool\r\n    26\t    reason_code: str\r\n    27\t    message: str\r\n    28\t\r\n    29\t\r\n    30\tdef assess_execution_authorization(task: dict[str, Any]) -> ExecutionAuthorization:\r\n    31\t    task_id = str(task.get(\"id\") or \"\").strip()\r\n    32\t    if not task_id:\r\n    33\t        raise ValueError(\"Execution authorization requires a task with a non-empty id.\")\r\n    34\t    return ExecutionAuthorization(\r\n    35\t        task_id=task_id,\r\n    36\t        authorized=False,\r\n    37\t        reason_code=CURRENT_REASON_CODE,\r\n    38\t        message=DENIAL_MESSAGE,\r\n    39\t    )\r\n    40\t\r\n    41\t\r\n    42\tdef require_execution_authorization(task: dict[str, Any]) -> None:\r\n    43\t    assessment = assess_execution_authorization(task)\r\n    44\t    if not assessment.authorized:\r\n    45\t        raise UnsafeExecutionAuthorizationError(\r\n    46\t            f\"{assessment.task_id}: {assessment.reason_code}: {assessment.message}\"\r\n    47\t        )\r\n     1\tfrom __future__ import annotations\r\n     2\t\r\n     3\timport argparse\r\n     4\timport json\r\n     5\timport sys\r\n     6\tfrom collections import defaultdict\r\n     7\tfrom typing import Any\r\n     8\t\r\n     9\tfrom execution_authority import (\r\n    10\t    UnsafeExecutionAuthorizationError,\r\n    11\t    assess_execution_authorization,\r\n    12\t)\r\n    13\tfrom persistent_work_graph import PersistentWorkGraphError, load_persistent_work_graph\r\n    14\tfrom task_contract_schema import TASK_CONTRACT_SCHEMA_VERSION\r\n    15\tfrom work_graph_validate import WorkGraphValidationError\r\n    16\tfrom current_conformance import evaluate_current_conformance\r\n    17\t\r\n    18\t\r\n    19\tdef _numeric_id(task: dict[str, Any]) -> int:\r\n    20\t    return int(str(task[\"id\"]).split(\"-\", 1)[1])\r\n    21\t\r\n    22\t\r\n    23\tdef _sorted_tasks(tasks):\r\n    24\t    return sorted(tasks, key=_numeric_id)\r\n    25\t\r\n    26\t\r\n    27\tdef _resolve_task(graph, selector: str) -> dict[str, Any]:\r\n    28\t    raw = selector.strip()\r\n    29\t    if not raw:\r\n    30\t        raise ValueError(\"Task selector may not be blank.\")\r\n    31\t    upper = raw.upper()\r\n    32\t    if upper in graph.tasks_by_id:\r\n    33\t        return graph.tasks_by_id[upper]\r\n    34\t    if raw in graph.tasks_by_key:\r\n    35\t        return graph.tasks_by_key[raw]\r\n    36\t    raise ValueError(f\"Unknown task: {selector!r}. Use an NSC-* ID or reconciliation_key.\")\r\n    37\t\r\n    38\t\r\n    39\tdef _is_v2(graph) -> bool:\r\n    40\t    return graph.validation.task_schema_version == TASK_CONTRACT_SCHEMA_VERSION\r\n    41\t\r\n    42\t\r\n    43\tdef command_validate(graph) -> int:\r\n    44\t    summary = graph.validation\r\n    45\t    print(\"taskcontrol validate: PASS\")\r\n    46\t    print(f\"Task contract schema:           {summary.task_schema_version}\")\r\n    47\t    print(f\"Tasks:                          {summary.task_count}\")\r\n    48\t    if _is_v2(graph):\r\n    49\t        counts = {name: 0 for name in (\"active\", \"superseded\", \"cancelled\")}\r\n    50\t        for task in graph.plan.tasks:\r\n    51\t            counts[task[\"contract_disposition\"]] += 1\r\n    52\t        print(f\"Active contracts:               {counts['active']}\")\r\n    53\t        print(f\"Superseded contracts:           {counts['superseded']}\")\r\n    54\t        print(f\"Cancelled contracts:            {counts['cancelled']}\")\r\n    55\t    else:\r\n    56\t        complete = sum(1 for task in graph.plan.tasks if task[\"status\"] == \"complete\")\r\n    57\t        print(f\"Legacy YAML open:               {len(graph.plan.tasks) - complete}\")\r\n    58\t        print(f\"Legacy YAML complete:           {complete}\")\r\n    59\t        print(\"Migration state:                schema v2 not yet applied\")\r\n    60\t    print(f\"Root:                           {summary.root_id} ({summary.root_key})\")\r\n    61\t    print(f\"Parent edges:                   {summary.parent_edge_count}\")\r\n    62\t    print(f\"Dependency edges:               {summary.dependency_edge_count}\")\r\n    63\t    print(f\"Resource groups:                {summary.resource_group_count}\")\r\n    64\t    print(f\"Project requirements:           {summary.project_requirement_count}\")\r\n    65\t    print(\"Parent hierarchy:               connected + acyclic\")\r\n    66\t    print(\"Dependency graph:               acyclic\")\r\n    67\t    print(\"Autonomous dispatch authority:  DISABLED\")\r\n    68\t    return 0\r\n    69\t\r\n    70\t\r\n    71\tdef _format_task_row_v1(task):\r\n    72\t    return (\r\n    73\t        f\"{task['id']:<8} {task['status']:<13} {task['kind']:<14} \"\r\n    74\t        f\"{task['execution_scope']:<29} {task['title']}\"\r\n    75\t    )\r\n    76\t\r\n    77\t\r\n    78\tdef _format_task_row_v2(task):\r\n    79\t    return (\r\n    80\t        f\"{task['id']:<8} {task['contract_disposition']:<13} {task['kind']:<14} \"\r\n    81\t        f\"{task['execution_scope']:<29} r{task['contract_revision']:<3} {task['title']}\"\r\n    82\t    )\r\n    83\t\r\n    84\t\r\n    85\tdef command_list(graph, status: str | None, disposition: str | None, kind: str | None) -> int:\r\n    86\t    tasks = _sorted_tasks(graph.plan.tasks)\r\n    87\t    if kind:\r\n    88\t        tasks = [task for task in tasks if task[\"kind\"] == kind]\r\n    89\t    if _is_v2(graph):\r\n    90\t        if status:\r\n    91\t            raise ValueError(\"--status is only valid before the schema-v2 migration.\")\r\n    92\t        if disposition:\r\n    93\t            tasks = [task for task in tasks if task[\"contract_disposition\"] == disposition]\r\n    94\t        print(\"ID       DISPOSITION   KIND           EXECUTION_SCOPE               REV  TITLE\")\r\n    95\t        print(\"-------- ------------- -------------- ----------------------------- ---- -----\")\r\n    96\t        for task in tasks:\r\n    97\t            print(_format_task_row_v2(task))\r\n    98\t    else:\r\n    99\t        if disposition:\r\n   100\t            raise ValueError(\"--disposition requires schema-v2 task contracts.\")\r\n   101\t        if status:\r\n   102\t            tasks = [task for task in tasks if task[\"status\"] == status]\r\n   103\t        print(\"ID       LEGACY_STATUS KIND           EXECUTION_SCOPE               TITLE\")\r\n   104\t        print(\"-------- ------------- -------------- ----------------------------- -----\")\r\n   105\t        for task in tasks:\r\n   106\t            print(_format_task_row_v1(task))\r\n   107\t    print(f\"\\n{len(tasks)} task contract(s). No row authorizes autonomous execution.\")\r\n   108\t    return 0\r\n   109\t\r\n   110\t\r\n   111\tdef _print_requirement_list(title: str, entries: Any, id_field: str | None = None) -> None:\r\n   112\t    print(f\"\\n{title}:\")\r\n   113\t    if not isinstance(entries, list) or not entries:\r\n   114\t        print(\"  (none)\")\r\n   115\t        return\r\n   116\t    for entry in entries:\r\n   117\t        if isinstance(entry, dict):\r\n   118\t            entry_id = str(entry.get(id_field) or \"\").strip() if id_field else \"\"\r\n   119\t            reference = str(entry.get(\"reference\") or \"\").strip()\r\n   120\t            requirement = str(entry.get(\"requirement\") or \"\").strip()\r\n   121\t            label = f\"{entry_id} \" if entry_id else \"\"\r\n   122\t            if reference:\r\n   123\t                print(f\"  - {label}[{reference}] {requirement}\")\r\n   124\t            else:\r\n   125\t                print(f\"  - {label}{requirement}\")\r\n   126\t        else:\r\n   127\t            print(f\"  - {entry}\")\r\n   128\t\r\n   129\t\r\n   130\tdef command_show(graph, selector: str) -> int:\r\n   131\t    task = _resolve_task(graph, selector)\r\n   132\t    print(f\"{task['id']} — {task['title']}\")\r\n   133\t    print(f\"schema_version:     {task['schema_version']}\")\r\n   134\t    print(f\"reconciliation_key: {task['reconciliation_key']}\")\r\n   135\t    print(f\"kind/type:          {task['kind']} / {task.get('type', '')}\")\r\n   136\t    if task[\"schema_version\"] == TASK_CONTRACT_SCHEMA_VERSION:\r\n   137\t        print(f\"contract_revision:  {task['contract_revision']}\")\r\n   138\t        print(f\"disposition:        {task['contract_disposition']}\")\r\n   139\t    else:\r\n   140\t        print(f\"legacy_status:      {task['status']} (historical/advisory only)\")\r\n   141\t    print(f\"execution_scope:    {task['execution_scope']}\")\r\n   142\t    if task.get(\"execution_reason\"):\r\n   143\t        print(f\"execution_reason:   {task['execution_reason']}\")\r\n   144\t    print(f\"decomposition:      {task.get('decomposition_state', '')}\")\r\n   145\t\r\n   146\t    parent = str(task.get(\"parent\") or \"\").strip()\r\n   147\t    print(f\"parent:             {parent or '(root)'}\")\r\n   148\t    print(\"\\nDependencies:\")\r\n   149\t    for dependency_id in task.get(\"depends_on\", []):\r\n   150\t        dependency = graph.tasks_by_id[dependency_id]\r\n   151\t        if dependency[\"schema_version\"] == TASK_CONTRACT_SCHEMA_VERSION:\r\n   152\t            state = f\"disposition={dependency['contract_disposition']}\"\r\n   153\t        else:\r\n   154\t            state = f\"legacy_status={dependency['status']}\"\r\n   155\t        print(f\"  - {dependency_id} [{state}] {dependency['title']}\")\r\n   156\t    if not task.get(\"depends_on\"):\r\n   157\t        print(\"  (none)\")\r\n   158\t\r\n   159\t    _print_requirement_list(\r\n   160\t        \"Acceptance criteria\",\r\n   161\t        task.get(\"acceptance_criteria\", []),\r\n   162\t        \"criterion_id\" if _is_v2(graph) else None,\r\n   163\t    )\r\n   164\t    if _is_v2(graph):\r\n   165\t        _print_requirement_list(\"Completion gates\", task.get(\"completion_gates\", []), \"gate_id\")\r\n   166\t        _print_requirement_list(\r\n   167\t            \"Downstream integration obligations\",\r\n   168\t            task.get(\"downstream_integration_obligations\", []),\r\n   169\t            \"obligation_id\",\r\n   170\t        )\r\n   171\t        print(f\"\\nProvenance:\\n  {task.get('provenance', {})}\")\r\n   172\t    else:\r\n   173\t        _print_requirement_list(\"Legacy validation requirements\", task.get(\"validation_requirements\", []))\r\n   174\t    print(\"\\nEvidence-derived current-state inspection: available via taskcontrol state\")\r\n   175\t    print(\"Execution authorization: denied — dispatch authorization policy is not enabled\")\r\n   176\t    print(\"State inspection alone never authorizes execution.\")\r\n   177\t    return 0\r\n   178\t\r\n   179\t\r\n   180\tdef advisory_ready_tasks(graph) -> list[dict[str, Any]]:\r\n   181\t    \"\"\"Return the old v1 planning frontier only while v1 files still exist.\r\n   182\t\r\n   183\t    Schema v2 deliberately has no completion status. Dependency readiness is not\r\n   184\t    derived because the dispatch policy that would define it is not enabled.\r\n   185\t    \"\"\"\r\n   186\t    if _is_v2(graph):\r\n   187\t        return []\r\n   188\t    by_id = graph.tasks_by_id\r\n   189\t    ready = []\r\n   190\t    for task in graph.plan.tasks:\r\n   191\t        if task[\"status\"] != \"open\":\r\n   192\t            continue\r\n   193\t        if task[\"kind\"] not in {\"implementation\", \"artifact\"}:\r\n   194\t            continue\r\n   195\t        if task[\"execution_scope\"] != \"single_agent\":\r\n   196\t            continue\r\n   197\t        if all(by_id[dep][\"status\"] == \"complete\" for dep in task[\"depends_on\"]):\r\n   198\t            ready.append(task)\r\n   199\t    return _sorted_tasks(ready)\r\n   200\t\r\n   201\t\r\n   202\tdef ready_tasks(graph):\r\n   203\t    _ = graph\r\n   204\t    raise UnsafeExecutionAuthorizationError(\r\n   205\t        \"ready_tasks() is disabled. Evidence-derived current-state inspection does not \"\r\n   206\t        \"provide execution authority, and dependency-readiness and dispatch policy are \"\r\n   207\t        \"not enabled.\"\r\n   208\t    )\r\n   209\t\r\n   210\t\r\n   211\tdef command_ready(graph) -> int:\r\n   212\t    if _is_v2(graph):\r\n   213\t        print(\"TASK READINESS: UNAVAILABLE — DISPATCH POLICY NOT ENABLED\")\r\n   214\t        print(\"Evidence-derived current-state inspection exists via taskcontrol state.\")\r\n   215\t        print(\"Evidence-derived current conformance has been proven on at least one real task.\")\r\n   216\t        print(\"A conformant result does not establish dependency readiness.\")\r\n   217\t        print(\"Dependency-readiness policy has not been implemented or approved.\")\r\n   218\t        print(\"Dispatch authorization policy has not been implemented or approved.\")\r\n   219\t        print(\"State inspection and a conformant result never authorize autonomous execution.\")\r\n   220\t        print(\"Zero tasks are authorized for autonomous dispatch.\")\r\n   221\t        return 0\r\n   222\t\r\n   223\t    tasks = advisory_ready_tasks(graph)\r\n   224\t    print(\"ADVISORY LEGACY READY WORK — NOT AUTHORIZED FOR AUTONOMOUS DISPATCH\")\r\n   225\t    print(\"This view exists only until schema-v2 migration removes legacy status.\\n\")\r\n   226\t    for task in tasks:\r\n   227\t        print(f\"{task['id']:<8} {task['kind']:<14} {task['title']}\")\r\n   228\t    print(f\"\\n{len(tasks)} advisory task(s). Zero authorized task(s).\")\r\n   229\t    return 0\r\n   230\t\r\n   231\t\r\n   232\tdef command_authorize(graph, selector: str) -> int:\r\n   233\t    task = _resolve_task(graph, selector)\r\n   234\t    assessment = assess_execution_authorization(task)\r\n   235\t    print(\"EXECUTION AUTHORIZATION: DENIED\")\r\n   236\t    print(f\"task:        {task['id']} — {task['title']}\")\r\n   237\t    print(f\"reason_code: {assessment.reason_code}\")\r\n   238\t    print(f\"reason:      {assessment.message}\")\r\n   239\t    return 2\r\n   240\t\r\n   241\t\r\n   242\tdef command_state(selector: str, as_json: bool = False) -> int:\r\n   243\t    result = evaluate_current_conformance(selector=selector)\r\n   244\t    if as_json:\r\n   245\t        print(json.dumps(result.to_dict(), indent=2, sort_keys=True))\r\n   246\t        return 0\r\n   247\t    print(f\"{result.task_id} — {result.title}\")\r\n   248\t    print(f\"derived_state:    {result.state}\")\r\n   249\t    print(f\"HEAD commit:      {result.head_commit}\")\r\n   250\t    print(f\"HEAD tree:        {result.head_tree}\")\r\n   251\t    print(f\"selected_record:  {result.selected_record_id or '(none)'}\")\r\n   252\t    print(\"findings:\")\r\n   253\t    for finding in result.findings:\r\n   254\t        suffix = f\" [{finding.record_id}]\" if finding.record_id else \"\"\r\n   255\t        print(f\"  - {finding.code}{suffix}: {finding.message}\")\r\n   256\t    if result.dirty_worktree:\r\n   257\t        print(\"WARNING: working tree is dirty; state above describes committed HEAD only.\")\r\n   258\t    return 0\r\n   259\t\r\n   260\t\r\n   261\tdef command_graph(graph) -> int:\r\n   262\t    children: dict[str, list[str]] = defaultdict(list)\r\n   263\t    for task in graph.plan.tasks:\r\n   264\t        parent = str(task.get(\"parent\") or \"\").strip()\r\n   265\t        if parent:\r\n   266\t            children[parent].append(task[\"id\"])\r\n   267\t    for values in children.values():\r\n   268\t        values.sort(key=lambda value: int(value.split(\"-\", 1)[1]))\r\n   269\t\r\n   270\t    def render(task_id: str, depth: int) -> None:\r\n   271\t        task = graph.tasks_by_id[task_id]\r\n   272\t        if _is_v2(graph):\r\n   273\t            state = f\"disposition={task['contract_disposition']}\"\r\n   274\t        else:\r\n   275\t            state = f\"legacy_status={task['status']}\"\r\n   276\t        deps = \"\"\r\n   277\t        if task[\"depends_on\"]:\r\n   278\t            deps = \" deps=\" + \",\".join(task[\"depends_on\"])\r\n   279\t        print(\r\n   280\t            f\"{'  ' * depth}{task_id} [{state}] [{task['kind']}] \"\r\n   281\t            f\"[{task['execution_scope']}] {task['title']}{deps}\"\r\n   282\t        )\r\n   283\t        for child_id in children.get(task_id, []):\r\n   284\t            render(child_id, depth + 1)\r\n   285\t\r\n   286\t    render(graph.validation.root_id, 0)\r\n   287\t    return 0\r\n   288\t\r\n   289\t\r\n   290\tdef build_parser() -> argparse.ArgumentParser:\r\n   291\t    parser = argparse.ArgumentParser(description=\"Deterministic task-contract inspection CLI.\")\r\n   292\t    subparsers = parser.add_subparsers(dest=\"command\", required=True)\r\n   293\t    subparsers.add_parser(\"validate\")\r\n   294\t    list_parser = subparsers.add_parser(\"list\")\r\n   295\t    list_parser.add_argument(\"--status\", choices=(\"open\", \"complete\"))\r\n   296\t    list_parser.add_argument(\"--disposition\", choices=(\"active\", \"superseded\", \"cancelled\"))\r\n   297\t    list_parser.add_argument(\"--kind\", choices=(\"feature\", \"artifact\", \"implementation\"))\r\n   298\t    show_parser = subparsers.add_parser(\"show\")\r\n   299\t    show_parser.add_argument(\"task\")\r\n   300\t    subparsers.add_parser(\"ready\")\r\n   301\t    authorize_parser = subparsers.add_parser(\"authorize\")\r\n   302\t    authorize_parser.add_argument(\"task\")\r\n   303\t    state_parser = subparsers.add_parser(\"state\")\r\n   304\t    state_parser.add_argument(\"task\")\r\n   305\t    state_parser.add_argument(\"--json\", action=\"store_true\")\r\n   306\t    subparsers.add_parser(\"graph\")\r\n   307\t    return parser\r\n   308\t\r\n   309\t\r\n   310\tdef main(argv: list[str] | None = None) -> int:\r\n   311\t    parser = build_parser()\r\n   312\t    args = parser.parse_args(argv)\r\n   313\t    try:\r\n   314\t        if args.command == \"state\":\r\n   315\t            return command_state(args.task, args.json)\r\n   316\t        graph = load_persistent_work_graph()\r\n   317\t        if args.command == \"validate\":\r\n   318\t            return command_validate(graph)\r\n   319\t        if args.command == \"list\":\r\n   320\t            return command_list(graph, args.status, args.disposition, args.kind)\r\n   321\t        if args.command == \"show\":\r\n   322\t            return command_show(graph, args.task)\r\n   323\t        if args.command == \"ready\":\r\n   324\t            return command_ready(graph)\r\n   325\t        if args.command == \"authorize\":\r\n   326\t            return command_authorize(graph, args.task)\r\n   327\t        if args.command == \"graph\":\r\n   328\t            return command_graph(graph)\r\n   329\t        parser.error(f\"Unknown command: {args.command}\")\r\n   330\t    except (\r\n   331\t        PersistentWorkGraphError,\r\n   332\t        UnsafeExecutionAuthorizationError,\r\n   333\t        WorkGraphValidationError,\r\n   334\t        ValueError,\r\n   335\t        KeyError,\r\n   336\t    ) as exc:\r\n   337\t        print(f\"taskcontrol {args.command}: FAIL\\n{exc}\", file=sys.stderr)\r\n   338\t        return 1\r\n   339\t    return 0\r\n   340\t\r\n   341\t\r\n   342\tif __name__ == \"__main__\":\r\n   343\t    raise SystemExit(main())\r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"nl -ba Pipeline/TaskGraph/current_conformance.py | sed -n '1,280p'; nl -ba Pipeline/TaskGraph/conformance_records.py | sed -n '1,340p'; nl -ba Pipeline/TaskGraph/evidence/NSC-023/records/BASE-NSC-023-86af98f41ab5.json | sed -n '1,300p'; rg -n \\\"gdd|canon|hash|surface|revalidation|needs_replan|needs_revalidation\\\" Pipeline/TaskGraph/current_conformance.py Pipeline/TaskGraph/conformance_records.py Pipeline/TaskGraph/conformance_evaluator_smoke_test.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"nl -ba Pipeline/TaskGraph/current_conformance.py | sed -n '1,280p'; nl -ba Pipeline/TaskGraph/conformance_records.py | sed -n '1,340p'; nl -ba Pipeline/TaskGraph/evidence/NSC-023/records/BASE-NSC-023-86af98f41ab5.json | sed -n '1,300p'; rg -n \\\"gdd|canon|hash|surface|revalidation|needs_replan|needs_revalidation\\\" Pipeline/TaskGraph/current_conformance.py Pipeline/TaskGraph/conformance_records.py Pipeline/TaskGraph/conformance_evaluator_smoke_test.py\"","aggregated_output":"     1\tfrom __future__ import annotations\r\n     2\t\r\n     3\t\"\"\"Deterministic current-conformance evaluation against committed HEAD.\"\"\"\r\n     4\t\r\n     5\timport json\r\n     6\tfrom dataclasses import asdict, dataclass\r\n     7\tfrom pathlib import Path\r\n     8\tfrom typing import Any\r\n     9\t\r\n    10\tfrom conformance_records import (\r\n    11\t    CANON_PATH,\r\n    12\t    CommittedRecord,\r\n    13\t    ConformanceRecordError,\r\n    14\t    GitRepository,\r\n    15\t    canonical_text_sha256,\r\n    16\t    load_committed_records,\r\n    17\t    semantic_json_sha256,\r\n    18\t)\r\n    19\t\r\n    20\tROOT = Path(__file__).resolve().parents[2]\r\n    21\t\r\n    22\t\r\n    23\t@dataclass(frozen=True)\r\n    24\tclass Finding:\r\n    25\t    code: str\r\n    26\t    message: str\r\n    27\t    record_id: str | None = None\r\n    28\t\r\n    29\t\r\n    30\t@dataclass(frozen=True)\r\n    31\tclass ConformanceState:\r\n    32\t    task_id: str\r\n    33\t    title: str\r\n    34\t    state: str\r\n    35\t    head_commit: str\r\n    36\t    head_tree: str\r\n    37\t    selected_record_id: str | None\r\n    38\t    findings: tuple[Finding, ...]\r\n    39\t    dirty_worktree: bool\r\n    40\t\r\n    41\t    def to_dict(self) -> dict[str, Any]:\r\n    42\t        value = asdict(self)\r\n    43\t        value[\"findings\"] = [asdict(item) for item in self.findings]\r\n    44\t        return value\r\n    45\t\r\n    46\t\r\n    47\tdef _json(repo: GitRepository, commit: str, path: str, label: str) -> dict[str, Any]:\r\n    48\t    try:\r\n    49\t        value = json.loads(repo.read(commit, path).decode(\"utf-8-sig\"))\r\n    50\t    except (UnicodeDecodeError, json.JSONDecodeError, ConformanceRecordError) as exc:\r\n    51\t        raise ConformanceRecordError(f\"Unable to load {label} {path} at {commit}: {exc}\") from exc\r\n    52\t    if not isinstance(value, dict):\r\n    53\t        raise ConformanceRecordError(f\"{label} {path} must contain a JSON object.\")\r\n    54\t    return value\r\n    55\t\r\n    56\t\r\n    57\tdef resolve_committed_task(repo: GitRepository, head: str, selector: str) -> tuple[str, dict[str, Any]]:\r\n    58\t    raw = selector.strip()\r\n    59\t    if not raw:\r\n    60\t        raise ValueError(\"Task selector may not be blank.\")\r\n    61\t    direct = f\"Tasks/{raw.upper()}.yaml\"\r\n    62\t    if repo.exists(head, direct):\r\n    63\t        task = _json(repo, head, direct, \"task contract\")\r\n    64\t        return direct, task\r\n    65\t    matches: list[tuple[str, dict[str, Any]]] = []\r\n    66\t    for path in repo.files(head, \"Tasks\"):\r\n    67\t        if not path.endswith(\".yaml\"):\r\n    68\t            continue\r\n    69\t        task = _json(repo, head, path, \"task contract\")\r\n    70\t        if task.get(\"reconciliation_key\") == raw:\r\n    71\t            matches.append((path, task))\r\n    72\t    if len(matches) != 1:\r\n    73\t        raise ValueError(f\"Unknown task: {selector!r}. Use an NSC-* ID or reconciliation_key.\")\r\n    74\t    return matches[0]\r\n    75\t\r\n    76\t\r\n    77\tdef _finding(code: str, message: str, record: CommittedRecord | None = None) -> Finding:\r\n    78\t    return Finding(code, message, record.record_id if record else None)\r\n    79\t\r\n    80\t\r\n    81\tdef _validate_basis_graph(repo: GitRepository, records: list[CommittedRecord]) -> list[Finding]:\r\n    82\t    by_id = {record.record_id: record for record in records}\r\n    83\t    findings: list[Finding] = []\r\n    84\t    for record in records:\r\n    85\t        if record.data[\"record_type\"] != \"revalidation\":\r\n    86\t            continue\r\n    87\t        basis_id = record.data[\"revalidation\"][\"basis_record_id\"]\r\n    88\t        basis = by_id.get(basis_id)\r\n    89\t        if basis is None:\r\n    90\t            findings.append(_finding(\"basis_missing\", f\"Basis record {basis_id} does not exist.\", record))\r\n    91\t            continue\r\n    92\t        if basis.data[\"task_id\"] != record.data[\"task_id\"]:\r\n    93\t            findings.append(_finding(\"basis_task_mismatch\", \"Revalidation basis belongs to another task.\", record))\r\n    94\t        if not repo.is_ancestor(basis.validated_commit, record.validated_commit):\r\n    95\t            findings.append(_finding(\"basis_not_ancestor\", \"Basis validated commit is not an ancestor of revalidation commit.\", record))\r\n    96\t        seen = {record.record_id}\r\n    97\t        cursor = basis\r\n    98\t        while cursor.data[\"record_type\"] == \"revalidation\":\r\n    99\t            if cursor.record_id in seen:\r\n   100\t                findings.append(_finding(\"basis_cycle\", \"Revalidation basis chain contains a cycle.\", record))\r\n   101\t                break\r\n   102\t            seen.add(cursor.record_id)\r\n   103\t            next_id = cursor.data[\"revalidation\"][\"basis_record_id\"]\r\n   104\t            if next_id not in by_id:\r\n   105\t                break\r\n   106\t            cursor = by_id[next_id]\r\n   107\t    return findings\r\n   108\t\r\n   109\t\r\n   110\tdef _current_gate_ids(task: dict[str, Any]) -> list[str]:\r\n   111\t    gates = task.get(\"completion_gates\")\r\n   112\t    if not isinstance(gates, list):\r\n   113\t        raise ConformanceRecordError(\"Current task contract completion_gates must be a list.\")\r\n   114\t    result = [gate.get(\"gate_id\") if isinstance(gate, dict) else None for gate in gates]\r\n   115\t    if any(not isinstance(item, str) or not item for item in result) or len(set(result)) != len(result):\r\n   116\t        raise ConformanceRecordError(\"Current task contract has invalid or duplicate completion gate IDs.\")\r\n   117\t    return result  # type: ignore[return-value]\r\n   118\t\r\n   119\t\r\n   120\tdef _maximal(repo: GitRepository, records: list[CommittedRecord]) -> list[CommittedRecord]:\r\n   121\t    maximal: list[CommittedRecord] = []\r\n   122\t    for candidate in records:\r\n   123\t        if any(\r\n   124\t            other.record_id != candidate.record_id\r\n   125\t            and other.validated_commit != candidate.validated_commit\r\n   126\t            and repo.is_ancestor(candidate.validated_commit, other.validated_commit)\r\n   127\t            for other in records\r\n   128\t        ):\r\n   129\t            continue\r\n   130\t        maximal.append(candidate)\r\n   131\t    return sorted(maximal, key=lambda item: item.record_id)\r\n   132\t\r\n   133\t\r\n   134\tdef evaluate_current_conformance(root: Path | str = ROOT, selector: str = \"\") -> ConformanceState:\r\n   135\t    repo = GitRepository(root)\r\n   136\t    head = repo.head()\r\n   137\t    head_tree = repo.tree(head)\r\n   138\t    dirty = repo.dirty()\r\n   139\t    task_path, task = resolve_committed_task(repo, head, selector)\r\n   140\t    task_id = str(task.get(\"id\") or \"\")\r\n   141\t    title = str(task.get(\"title\") or \"\")\r\n   142\t\r\n   143\t    if task.get(\"schema_version\") != \"2.0\":\r\n   144\t        raise ValueError(f\"{task_id or task_path}: state requires a schema-v2 task contract at committed HEAD.\")\r\n   145\t\r\n   146\t    disposition = task.get(\"contract_disposition\")\r\n   147\t    if disposition in {\"cancelled\", \"superseded\"}:\r\n   148\t        return ConformanceState(task_id, title, disposition, head, head_tree, None,\r\n   149\t            (_finding(f\"contract_{disposition}\", f\"Contract disposition is {disposition}.\"),), dirty)\r\n   150\t    if task.get(\"kind\") == \"feature\" or task.get(\"execution_scope\") != \"single_agent\":\r\n   151\t        return ConformanceState(task_id, title, \"aggregate\", head, head_tree, None,\r\n   152\t            (_finding(\"non_executable_contract\", \"Feature or non-executable contract is aggregate.\"),), dirty)\r\n   153\t\r\n   154\t    try:\r\n   155\t        records = load_committed_records(repo, head, task_id)\r\n   156\t    except ConformanceRecordError as exc:\r\n   157\t        return ConformanceState(task_id, title, \"invalid_evidence\", head, head_tree, None,\r\n   158\t            (_finding(\"record_structure_invalid\", str(exc)),), dirty)\r\n   159\t    if not records:\r\n   160\t        return ConformanceState(task_id, title, \"not_delivered\", head, head_tree, None,\r\n   161\t            (_finding(\"no_committed_evidence\", \"No committed delivery, baseline, or revalidation record exists.\"),), dirty)\r\n   162\t\r\n   163\t    invalid = _validate_basis_graph(repo, records)\r\n   164\t    current_contract_hash = semantic_json_sha256(repo.read(head, task_path))\r\n   165\t    current_revision = task.get(\"contract_revision\")\r\n   166\t    current_canon_hash = canonical_text_sha256(repo.read(head, CANON_PATH))\r\n   167\t    current_gate_ids = _current_gate_ids(task)\r\n   168\t    conformant: list[CommittedRecord] = []\r\n   169\t    replan: list[CommittedRecord] = []\r\n   170\t    human: list[CommittedRecord] = []\r\n   171\t    stale: list[CommittedRecord] = []\r\n   172\t\r\n   173\t    for record in records:\r\n   174\t        data = record.data\r\n   175\t        state = data[\"validated_state\"]\r\n   176\t        try:\r\n   177\t            if repo.tree(state[\"commit\"]) != state[\"tree\"]:\r\n   178\t                invalid.append(_finding(\"validated_tree_mismatch\", \"Recorded tree does not match validated commit.\", record))\r\n   179\t                continue\r\n   180\t            contract = data[\"task_contract\"]\r\n   181\t            historical_task_raw = repo.read(state[\"commit\"], contract[\"path\"])\r\n   182\t            historical_task = json.loads(historical_task_raw.decode(\"utf-8-sig\"))\r\n   183\t            if semantic_json_sha256(historical_task) != contract[\"sha256\"] or historical_task.get(\"contract_revision\") != contract[\"revision\"] or historical_task.get(\"id\") != task_id:\r\n   184\t                invalid.append(_finding(\"recorded_contract_mismatch\", \"Recorded contract identity/hash is false at validated commit.\", record))\r\n   185\t                continue\r\n   186\t            canon = data[\"canon\"]\r\n   187\t            if canonical_text_sha256(repo.read(state[\"commit\"], canon[\"path\"])) != canon[\"sha256\"]:\r\n   188\t                invalid.append(_finding(\"recorded_canon_mismatch\", \"Recorded canon hash is false at validated commit.\", record))\r\n   189\t                continue\r\n   190\t            bad_surface = False\r\n   191\t            changed_surface = False\r\n   192\t            for surface in data[\"conformance_surfaces\"]:\r\n   193\t                if repo.blob(state[\"commit\"], surface[\"path\"]) != surface[\"blob_sha\"]:\r\n   194\t                    invalid.append(_finding(\"surface_validated_blob_mismatch\", f\"Surface {surface['path']} blob is false at validated commit.\", record))\r\n   195\t                    bad_surface = True\r\n   196\t                    break\r\n   197\t                if not repo.exists(head, surface[\"path\"]) or repo.blob(head, surface[\"path\"]) != surface[\"blob_sha\"]:\r\n   198\t                    changed_surface = True\r\n   199\t            if bad_surface:\r\n   200\t                continue\r\n   201\t            artifact_bad = False\r\n   202\t            for gate in data[\"gate_results\"]:\r\n   203\t                for evidence in gate[\"evidence\"]:\r\n   204\t                    artifact_prefix = f\"Pipeline/TaskGraph/evidence/{task_id}/artifacts/\"\r\n   205\t                    if not evidence[\"path\"].startswith(artifact_prefix):\r\n   206\t                        invalid.append(_finding(\"artifact_location_invalid\", f\"Gate artifact is outside {artifact_prefix}.\", record))\r\n   207\t                        artifact_bad = True\r\n   208\t                    elif not repo.exists(head, evidence[\"path\"]) or repo.blob(head, evidence[\"path\"]) != evidence[\"blob_sha\"]:\r\n   209\t                        invalid.append(_finding(\"artifact_blob_mismatch\", f\"Evidence artifact {evidence['path']} is absent or altered at HEAD.\", record))\r\n   210\t                        artifact_bad = True\r\n   211\t            if artifact_bad:\r\n   212\t                continue\r\n   213\t        except (ConformanceRecordError, json.JSONDecodeError, UnicodeDecodeError) as exc:\r\n   214\t            invalid.append(_finding(\"record_object_unavailable\", str(exc), record))\r\n   215\t            continue\r\n   216\t\r\n   217\t        if not repo.is_ancestor(state[\"commit\"], head):\r\n   218\t            stale.append(record)\r\n   219\t            continue\r\n   220\t\r\n   221\t        record_gate_ids = [gate[\"gate_id\"] for gate in data[\"gate_results\"]]\r\n   222\t        if record_gate_ids != current_gate_ids and set(record_gate_ids) != set(current_gate_ids):\r\n   223\t            invalid.append(_finding(\"completion_gate_set_mismatch\", \"Record does not contain exactly the current completion-gate set.\", record))\r\n   224\t            continue\r\n   225\t        contract_changed = contract[\"path\"] != task_path or contract[\"revision\"] != current_revision or contract[\"sha256\"] != current_contract_hash\r\n   226\t        if contract_changed:\r\n   227\t            replan.append(record)\r\n   228\t            continue\r\n   229\t        approval = data[\"human_approval\"]\r\n   230\t        if approval[\"required\"] and (approval[\"decision\"] != \"approved\" or not approval[\"approved_by\"].strip()):\r\n   231\t            human.append(record)\r\n   232\t            continue\r\n   233\t        if (not approval[\"required\"] and approval[\"decision\"] != \"not_required\"):\r\n   234\t            invalid.append(_finding(\"human_approval_contradictory\", \"Non-required approval must use not_required.\", record))\r\n   235\t            continue\r\n   236\t        if changed_surface or canon[\"path\"] != CANON_PATH or canon[\"sha256\"] != current_canon_hash:\r\n   237\t            stale.append(record)\r\n   238\t            continue\r\n   239\t        conformant.append(record)\r\n   240\t\r\n   241\t    if invalid:\r\n   242\t        return ConformanceState(task_id, title, \"invalid_evidence\", head, head_tree, None, tuple(invalid), dirty)\r\n   243\t    if conformant:\r\n   244\t        maximal = _maximal(repo, conformant)\r\n   245\t        if len(maximal) != 1:\r\n   246\t            ids = \", \".join(item.record_id for item in maximal)\r\n   247\t            return ConformanceState(task_id, title, \"ambiguous_evidence\", head, head_tree, None,\r\n   248\t                (_finding(\"multiple_maximal_current_records\", f\"Multiple maximal current-valid records: {ids}.\"),), dirty)\r\n   249\t        selected = maximal[0]\r\n   250\t        return ConformanceState(task_id, title, \"conformant\", head, head_tree, selected.record_id,\r\n   251\t            (_finding(\"current_record_selected\", \"Record is valid for current contract, canon, surfaces, gates, and artifacts.\", selected),), dirty)\r\n   252\t    for state_name, candidates, code, message in (\r\n   253\t        (\"needs_replan\", replan, \"contract_changed\", \"Current contract revision or semantic hash differs from prior evidence.\"),\r\n   254\t        (\"needs_human\", human, \"human_approval_missing\", \"Required human approval is missing.\"),\r\n   255\t        (\"needs_revalidation\", stale, \"evidence_stale\", \"Prior evidence exists but is not current for HEAD.\"),\r\n   256\t    ):\r\n   257\t        if candidates:\r\n   258\t            maximal = _maximal(repo, candidates)\r\n   259\t            selected = maximal[0] if len(maximal) == 1 else None\r\n   260\t            return ConformanceState(task_id, title, state_name, head, head_tree,\r\n   261\t                selected.record_id if selected else None, (_finding(code, message, selected),), dirty)\r\n   262\t    return ConformanceState(task_id, title, \"not_delivered\", head, head_tree, None,\r\n   263\t        (_finding(\"no_usable_evidence\", \"No usable committed evidence exists.\"),), dirty)\r\n     1\tfrom __future__ import annotations\r\n     2\t\r\n     3\t\"\"\"Schema and Git-object helpers for immutable conformance records.\"\"\"\r\n     4\t\r\n     5\timport hashlib\r\n     6\timport json\r\n     7\timport posixpath\r\n     8\timport re\r\n     9\timport subprocess\r\n    10\tfrom dataclasses import dataclass\r\n    11\tfrom pathlib import Path\r\n    12\tfrom typing import Any\r\n    13\t\r\n    14\tSCHEMA_VERSION = \"1.0\"\r\n    15\tCANON_PATH = \"Docs/GDD/No_Safe_Circle_GDD.md\"\r\n    16\tEVIDENCE_ROOT = \"Pipeline/TaskGraph/evidence\"\r\n    17\tTASK_ID_RE = re.compile(r\"NSC-\\d{3,}\")\r\n    18\tHEX_RE = re.compile(r\"[0-9a-f]{40}\")\r\n    19\tFORBIDDEN_AUTHORITY_FIELDS = {\"status\", \"complete\", \"current\", \"ready\", \"authorized\"}\r\n    20\t\r\n    21\t\r\n    22\tclass ConformanceRecordError(RuntimeError):\r\n    23\t    pass\r\n    24\t\r\n    25\t\r\n    26\t@dataclass(frozen=True)\r\n    27\tclass CommittedRecord:\r\n    28\t    path: str\r\n    29\t    data: dict[str, Any]\r\n    30\t\r\n    31\t    @property\r\n    32\t    def record_id(self) -> str:\r\n    33\t        return self.data[\"record_id\"]\r\n    34\t\r\n    35\t    @property\r\n    36\t    def validated_commit(self) -> str:\r\n    37\t        return self.data[\"validated_state\"][\"commit\"]\r\n    38\t\r\n    39\t\r\n    40\tclass GitRepository:\r\n    41\t    def __init__(self, root: Path | str) -> None:\r\n    42\t        self.root = Path(root).resolve()\r\n    43\t\r\n    44\t    def _run(self, *args: str, check: bool = True) -> bytes:\r\n    45\t        result = subprocess.run(\r\n    46\t            [\"git\", *args], cwd=self.root, stdout=subprocess.PIPE,\r\n    47\t            stderr=subprocess.PIPE, check=False,\r\n    48\t        )\r\n    49\t        if check and result.returncode:\r\n    50\t            detail = result.stderr.decode(\"utf-8\", \"replace\").strip()\r\n    51\t            raise ConformanceRecordError(f\"git {' '.join(args)} failed: {detail}\")\r\n    52\t        return result.stdout\r\n    53\t\r\n    54\t    def head(self) -> str:\r\n    55\t        return self._run(\"rev-parse\", \"HEAD\").decode().strip()\r\n    56\t\r\n    57\t    def tree(self, commit: str) -> str:\r\n    58\t        return self._run(\"rev-parse\", f\"{commit}^{{tree}}\").decode().strip()\r\n    59\t\r\n    60\t    def read(self, commit: str, path: str) -> bytes:\r\n    61\t        safe_repository_path(path, \"Git object path\")\r\n    62\t        return self._run(\"show\", f\"{commit}:{path}\")\r\n    63\t\r\n    64\t    def blob(self, commit: str, path: str) -> str:\r\n    65\t        safe_repository_path(path, \"Git blob path\")\r\n    66\t        value = self._run(\"rev-parse\", f\"{commit}:{path}\").decode().strip()\r\n    67\t        if not HEX_RE.fullmatch(value):\r\n    68\t            raise ConformanceRecordError(f\"{path!r} is not a committed blob at {commit}.\")\r\n    69\t        return value\r\n    70\t\r\n    71\t    def exists(self, commit: str, path: str) -> bool:\r\n    72\t        safe_repository_path(path, \"Git object path\")\r\n    73\t        result = subprocess.run(\r\n    74\t            [\"git\", \"cat-file\", \"-e\", f\"{commit}:{path}\"], cwd=self.root,\r\n    75\t            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,\r\n    76\t        )\r\n    77\t        return result.returncode == 0\r\n    78\t\r\n    79\t    def files(self, commit: str, prefix: str) -> list[str]:\r\n    80\t        safe_repository_path(prefix, \"Git tree prefix\")\r\n    81\t        output = self._run(\"ls-tree\", \"-r\", \"--name-only\", commit, \"--\", prefix)\r\n    82\t        return [line for line in output.decode(\"utf-8\").splitlines() if line]\r\n    83\t\r\n    84\t    def is_ancestor(self, older: str, newer: str) -> bool:\r\n    85\t        result = subprocess.run(\r\n    86\t            [\"git\", \"merge-base\", \"--is-ancestor\", older, newer], cwd=self.root,\r\n    87\t            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,\r\n    88\t        )\r\n    89\t        return result.returncode == 0\r\n    90\t\r\n    91\t    def dirty(self) -> bool:\r\n    92\t        return bool(self._run(\"status\", \"--porcelain\"))\r\n    93\t\r\n    94\t    def path_history(self, commit: str, path: str) -> list[str]:\r\n    95\t        safe_repository_path(path, \"Git history path\")\r\n    96\t        output = self._run(\"log\", \"--format=%H\", commit, \"--\", path)\r\n    97\t        return [line for line in output.decode(\"utf-8\").splitlines() if line]\r\n    98\t\r\n    99\t\r\n   100\tdef safe_repository_path(value: Any, label: str) -> str:\r\n   101\t    if not isinstance(value, str) or not value:\r\n   102\t        raise ConformanceRecordError(f\"{label} must be a non-empty repository path.\")\r\n   103\t    if any(ord(character) < 32 for character in value):\r\n   104\t        raise ConformanceRecordError(f\"{label} contains a control character.\")\r\n   105\t    if value.startswith((\"/\", \"\\\\\")) or re.match(r\"^[A-Za-z]:\", value):\r\n   106\t        raise ConformanceRecordError(f\"{label} must be relative: {value!r}.\")\r\n   107\t    if \"\\\\\" in value or posixpath.normpath(value) != value or value in {\".\", \"..\"}:\r\n   108\t        raise ConformanceRecordError(f\"{label} is not a canonical repository path: {value!r}.\")\r\n   109\t    if any(part in {\"\", \".\", \"..\"} for part in value.split(\"/\")):\r\n   110\t        raise ConformanceRecordError(f\"{label} contains path traversal: {value!r}.\")\r\n   111\t    return value\r\n   112\t\r\n   113\t\r\n   114\tdef semantic_json_sha256(raw: bytes | str | Any) -> str:\r\n   115\t    if isinstance(raw, bytes):\r\n   116\t        value = json.loads(raw.decode(\"utf-8-sig\"))\r\n   117\t    elif isinstance(raw, str):\r\n   118\t        value = json.loads(raw.lstrip(\"\\ufeff\"))\r\n   119\t    else:\r\n   120\t        value = raw\r\n   121\t    canonical = json.dumps(\r\n   122\t        value, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), allow_nan=False\r\n   123\t    )\r\n   124\t    return hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()\r\n   125\t\r\n   126\t\r\n   127\tdef canonical_text_sha256(raw: bytes | str) -> str:\r\n   128\t    text = raw.decode(\"utf-8-sig\") if isinstance(raw, bytes) else raw.lstrip(\"\\ufeff\")\r\n   129\t    text = text.replace(\"\\r\\n\", \"\\n\").replace(\"\\r\", \"\\n\")\r\n   130\t    return hashlib.sha256(text.encode(\"utf-8\")).hexdigest()\r\n   131\t\r\n   132\t\r\n   133\tdef _object(value: Any, label: str, fields: set[str]) -> dict[str, Any]:\r\n   134\t    if not isinstance(value, dict):\r\n   135\t        raise ConformanceRecordError(f\"{label} must be an object.\")\r\n   136\t    extra = set(value) - fields\r\n   137\t    missing = fields - set(value)\r\n   138\t    if extra or missing:\r\n   139\t        raise ConformanceRecordError(\r\n   140\t            f\"{label} fields differ from schema (missing={sorted(missing)}, extra={sorted(extra)}).\"\r\n   141\t        )\r\n   142\t    return value\r\n   143\t\r\n   144\t\r\n   145\tdef _text(value: Any, label: str, *, allow_empty: bool = False) -> str:\r\n   146\t    if not isinstance(value, str) or (not allow_empty and not value.strip()):\r\n   147\t        raise ConformanceRecordError(f\"{label} must be a {'string' if allow_empty else 'non-empty string'}.\")\r\n   148\t    return value\r\n   149\t\r\n   150\t\r\n   151\tdef _sha(value: Any, label: str) -> str:\r\n   152\t    value = _text(value, label)\r\n   153\t    if not HEX_RE.fullmatch(value):\r\n   154\t        raise ConformanceRecordError(f\"{label} must be a lowercase 40-character Git SHA.\")\r\n   155\t    return value\r\n   156\t\r\n   157\t\r\n   158\tdef validate_record_shape(record: Any, path: str) -> dict[str, Any]:\r\n   159\t    common = {\r\n   160\t        \"schema_version\", \"record_type\", \"record_id\", \"task_id\", \"task_contract\",\r\n   161\t        \"canon\", \"validated_state\", \"conformance_surfaces\", \"gate_results\",\r\n   162\t        \"human_approval\", \"recorded_at\",\r\n   163\t    }\r\n   164\t    if not isinstance(record, dict):\r\n   165\t        raise ConformanceRecordError(f\"{path}: record must be an object.\")\r\n   166\t    forbidden = FORBIDDEN_AUTHORITY_FIELDS.intersection(record)\r\n   167\t    if forbidden:\r\n   168\t        raise ConformanceRecordError(f\"{path}: mutable authority fields are forbidden: {sorted(forbidden)}.\")\r\n   169\t    record_type = record.get(\"record_type\")\r\n   170\t    specific = (\r\n   171\t        \"delivery\" if record_type == \"delivery\"\r\n   172\t        else \"baseline\" if record_type == \"baseline\"\r\n   173\t        else \"revalidation\" if record_type == \"revalidation\"\r\n   174\t        else None\r\n   175\t    )\r\n   176\t    if specific is None:\r\n   177\t        raise ConformanceRecordError(f\"{path}: record_type must be delivery, baseline, or revalidation.\")\r\n   178\t    _object(record, path, common | {specific})\r\n   179\t    if record[\"schema_version\"] != SCHEMA_VERSION:\r\n   180\t        raise ConformanceRecordError(f\"{path}: unsupported schema_version {record['schema_version']!r}.\")\r\n   181\t\r\n   182\t    task_id = _text(record[\"task_id\"], f\"{path}.task_id\")\r\n   183\t    if not TASK_ID_RE.fullmatch(task_id):\r\n   184\t        raise ConformanceRecordError(f\"{path}: invalid task_id {task_id!r}.\")\r\n   185\t    record_id = _text(record[\"record_id\"], f\"{path}.record_id\")\r\n   186\t    prefix = {\"delivery\": \"DEL-\", \"baseline\": \"BASE-\", \"revalidation\": \"REV-\"}[record_type]\r\n   187\t    if not record_id.startswith(f\"{prefix}{task_id}-\"):\r\n   188\t        raise ConformanceRecordError(f\"{path}: record_id prefix/task identity mismatch.\")\r\n   189\t    expected_prefix = f\"{EVIDENCE_ROOT}/{task_id}/records/\"\r\n   190\t    if not path.startswith(expected_prefix) or path != f\"{expected_prefix}{record_id}.json\":\r\n   191\t        raise ConformanceRecordError(f\"{path}: record path, task_id, filename, and record_id disagree.\")\r\n   192\t\r\n   193\t    contract = _object(record[\"task_contract\"], f\"{path}.task_contract\", {\"path\", \"revision\", \"sha256\"})\r\n   194\t    safe_repository_path(contract[\"path\"], f\"{path}.task_contract.path\")\r\n   195\t    if isinstance(contract[\"revision\"], bool) or not isinstance(contract[\"revision\"], int) or contract[\"revision\"] < 1:\r\n   196\t        raise ConformanceRecordError(f\"{path}.task_contract.revision must be a positive integer.\")\r\n   197\t    if not re.fullmatch(r\"[0-9a-f]{64}\", _text(contract[\"sha256\"], f\"{path}.task_contract.sha256\")):\r\n   198\t        raise ConformanceRecordError(f\"{path}.task_contract.sha256 must be lowercase SHA-256.\")\r\n   199\t    canon = _object(record[\"canon\"], f\"{path}.canon\", {\"path\", \"sha256\"})\r\n   200\t    safe_repository_path(canon[\"path\"], f\"{path}.canon.path\")\r\n   201\t    if not re.fullmatch(r\"[0-9a-f]{64}\", _text(canon[\"sha256\"], f\"{path}.canon.sha256\")):\r\n   202\t        raise ConformanceRecordError(f\"{path}.canon.sha256 must be lowercase SHA-256.\")\r\n   203\t    state = _object(record[\"validated_state\"], f\"{path}.validated_state\", {\"commit