        if not isinstance(gate[\"evidence\"], list):\r\n   233\t            raise ConformanceRecordError(f\"{path}.gate_results[{index}].evidence must be a list.\")\r\n   234\t        for evidence_index, raw_evidence in enumerate(gate[\"evidence\"]):\r\n   235\t            evidence = _object(raw_evidence, f\"{path}.gate_results[{index}].evidence[{evidence_index}]\", {\"path\", \"blob_sha\"})\r\n   236\t            safe_repository_path(evidence[\"path\"], f\"{path}.gate_results[{index}].evidence[{evidence_index}].path\")\r\n   237\t            _sha(evidence[\"blob_sha\"], f\"{path}.gate_results[{index}].evidence[{evidence_index}].blob_sha\")\r\n   238\t        _text(gate[\"notes\"], f\"{path}.gate_results[{index}].notes\", allow_empty=True)\r\n   239\t\r\n   240\t    approval = _object(record[\"human_approval\"], f\"{path}.human_approval\", {\"required\", \"decision\", \"approved_by\", \"notes\"})\r\n   241\t    if not isinstance(approval[\"required\"], bool):\r\n   242\t        raise ConformanceRecordError(f\"{path}.human_approval.required must be boolean.\")\r\n   243\t    if approval[\"decision\"] not in {\"approved\", \"not_required\"}:\r\n   244\t        raise ConformanceRecordError(f\"{path}.human_approval.decision is unsupported.\")\r\n   245\t    _text(approval[\"approved_by\"], f\"{path}.human_approval.approved_by\", allow_empty=True)\r\n   246\t    _text(approval[\"notes\"], f\"{path}.human_approval.notes\", allow_empty=True)\r\n   247\t    _text(record[\"recorded_at\"], f\"{path}.recorded_at\")\r\n   248\t\r\n   249\t    if record_type == \"delivery\":\r\n   250\t        delivery = _object(record[\"delivery\"], f\"{path}.delivery\", {\"base_commit\", \"candidate_commit\", \"integrated_commit\", \"integrated_tree\"})\r\n   251\t        for field in delivery:\r\n   252\t            _sha(delivery[field], f\"{path}.delivery.{field}\")\r\n   253\t        if state[\"commit\"] != delivery[\"integrated_commit\"] or state[\"tree\"] != delivery[\"integrated_tree\"]:\r\n   254\t            raise ConformanceRecordError(f\"{path}: delivery integrated and validated states must match.\")\r\n   255\t    elif record_type == \"baseline\":\r\n   256\t        baseline = _object(record[\"baseline\"], f\"{path}.baseline\", {\"reason_type\", \"summary\"})\r\n   257\t        if baseline[\"reason_type\"] != \"pre_evidence_existing_implementation\":\r\n   258\t            raise ConformanceRecordError(f\"{path}.baseline.reason_type is unsupported.\")\r\n   259\t        _text(baseline[\"summary\"], f\"{path}.baseline.summary\")\r\n   260\t    else:\r\n   261\t        revalidation = _object(record[\"revalidation\"], f\"{path}.revalidation\", {\"basis_record_id\", \"reason_type\", \"summary\"})\r\n   262\t        _text(revalidation[\"basis_record_id\"], f\"{path}.revalidation.basis_record_id\")\r\n   263\t        if revalidation[\"reason_type\"] not in {\"code_change\", \"gdd_change\", \"contract_change\", \"periodic\", \"manual\"}:\r\n   264\t            raise ConformanceRecordError(f\"{path}.revalidation.reason_type is unsupported.\")\r\n   265\t        _text(revalidation[\"summary\"], f\"{path}.revalidation.summary\")\r\n   266\t    return record\r\n   267\t\r\n   268\t\r\n   269\tdef load_committed_records(repo: GitRepository, head: str, task_id: str) -> list[CommittedRecord]:\r\n   270\t    prefix = f\"{EVIDENCE_ROOT}/{task_id}/records\"\r\n   271\t    records: list[CommittedRecord] = []\r\n   272\t    ids: set[str] = set()\r\n   273\t    for path in repo.files(head, prefix):\r\n   274\t        if not path.endswith(\".json\"):\r\n   275\t            raise ConformanceRecordError(f\"Unsupported committed record file: {path}.\")\r\n   276\t        if len(repo.path_history(head, path)) != 1:\r\n   277\t            raise ConformanceRecordError(\r\n   278\t                f\"Immutable record {path} was modified, deleted/recreated, or has ambiguous history.\"\r\n   279\t            )\r\n   280\t        try:\r\n   281\t            value = json.loads