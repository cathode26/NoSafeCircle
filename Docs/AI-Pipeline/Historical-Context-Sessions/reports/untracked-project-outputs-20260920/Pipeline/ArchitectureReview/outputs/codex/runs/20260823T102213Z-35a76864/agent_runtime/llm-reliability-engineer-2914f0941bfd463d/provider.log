 \"path\": \"Assets/NoSafeCircle/DoorPrototype/Tests/Editor/CommittedSceneCameraConformanceTests.cs\",\r\n      \"blob_sha\": \"998ee74f2e50e88ac841714dbe81a402aefbc9f3\",\r\n      \"role\": \"completion_gate_test\"\r\n    },\r\n    {\r\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Tests/Editor/DoorPrototypeSceneBuilderTests.cs\",\r\n      \"blob_sha\": \"9400822723d7b44ef7a6cf80ab257ba2bdb9c3e1\",\r\n      \"role\": \"builder_regression_test\"\r\n    },\r\n    {\r\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Tests/Editor/NoSafeCircle.DoorPrototype.Tests.Editor.asmdef\",\r\n      \"blob_sha\": \"8050fe85f86e911e58e7a0ebb9edac46e6c4ef55\",\r\n      \"role\": \"test_assembly\"\r\n    },\r\n    {\r\n      \"path\": \"ProjectSettings/ProjectVersion.txt\",\r\n      \"blob_sha\": \"93366d537cbb7326567cbbf55872a00d336c5c99\",\r\n      \"role\": \"unity_toolchain\"\r\n    }\r\n  ],\r\n  \"gate_results\": [\r\n    {\r\n      \"gate_id\": \"VAL-001\",\r\n      \"result\": \"pass\",\r\n      \"evidence\": [\r\n        {\r\n          \"path\": \"Pipeline/TaskGraph/evidence/NSC-023/artifacts/CommittedSceneCameraConformanceTests-86af98f41ab5.xml\",\r\n          \"blob_sha\": \"0fc2a56bbd79aaab567cade3554ad2a8a0d34a93\"\r\n        },\r\n        {\r\n          \"path\": \"Pipeline/TaskGraph/evidence/NSC-023/artifacts/DoorPrototypeSceneBuilderTests-86af98f41ab5.xml\",\r\n          \"blob_sha\": \"ffdca75975f7e6e17cd3b968eec39ec97cf1b6f8\"\r\n        }\r\n      ],\r\n      \"notes\": \"Clean EditMode validation passed the in-memory builder camera checks and direct inspection of the authoritative Assets/Scenes/DoorPrototype.unity fixed orthographic isometric camera.\"\r\n    },\r\n    {\r\n      \"gate_id\": \"VAL-002\",\r\n      \"result\": \"pass\",\r\n      \"evidence\": [\r\n        {\r\n          \"path\": \"Pipeline/TaskGraph/evidence/NSC-023/artifacts/CommittedSceneCameraConformanceTests-86af98f41ab5.xml\",\r\n          \"blob_sha\": \"0fc2a56bbd79aaab567cade3554