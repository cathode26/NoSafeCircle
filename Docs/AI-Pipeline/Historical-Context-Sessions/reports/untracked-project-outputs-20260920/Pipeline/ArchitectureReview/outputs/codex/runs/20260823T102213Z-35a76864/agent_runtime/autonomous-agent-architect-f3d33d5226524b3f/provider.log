{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"rg -n 'exclusive_resources|resource_key|repository_evidence|path.*exist|is_file|exists\\\\(' Pipeline/TaskGraph/work_graph_validate.py | sed -n '1,280p'; sed -n '480,760p' Pipeline/TaskGraph/work_graph_validate.py; nl -ba Pipeline/TaskGraph/current_conformance.py | sed -n '150,265p'; nl -ba Tasks/NSC-003.yaml | sed -n '1,125p'; nl -ba Docs/GDD/No_Safe_Circle_GDD.md | sed -n '225,280p'\"","aggregated_output":"258:        for field in (\"depends_on\", \"exclusive_resources\", \"acceptance_criteria\"):\r\n365:        resources = task[\"exclusive_resources\"]\r\n371:            resource_key = _require_non_empty_text(\r\n372:                resource, f\"{task_id}.exclusive_resources entry\"\r\n374:            claimed_by[resource_key].add(task_id)\r\n380:        resource_key = _require_non_empty_text(\r\n381:            group.get(\"resource_key\"), f\"resource_groups[{index}].resource_key\"\r\n383:        if resource_key in groups_by_resource:\r\n384:            raise WorkGraphValidationError(f\"Duplicate resource group: {resource_key}\")\r\n385:        work_ids = _require_list(group.get(\"work_ids\"), f\"resource group {resource_key}.work_ids\")\r\n388:            f\"resource group {resource_key}.reconciliation_keys\",\r\n392:                f\"Resource group {resource_key} has mismatched ID/key membership lengths.\"\r\n396:            work_id = _require_non_empty_text(work_id, f\"resource group {resource_key}.work_id\")\r\n398:                reconciliation_key, f\"resource group {resource_key}.reconciliation_key\"\r\n402:                    f\"Resource group {resource_key} references missing task {work_id}.\"\r\n407:                    f\"Resource group {resource_key} maps {work_id} to {reconciliation_key!r}, \"\r\n410:            if resource_key not in task[\"exclusive_resources\"]:\r\n412:                    f\"Resource group {resource_key} includes {work_id}, but task does not claim it.\"\r\n415:        groups_by_resource[resource_key] = members\r\n417:    for resource_key, owners in claimed_by.items():\r\n420:        grouped = groups_by_resource.get(resource_key)\r\n423:                f\"Shared exclusive resource {resource_key!r} has {len(owners)} owners but no resource group.\"\r\n427:                f\"Resource group {resource_key!r} does not exactly match task claims: \"\r\n430:    for resource_key, members in groups_by_resource.items():\r\n431:        owners = claimed_by.get(resource_key, set())\r\n434:                f\"Resource group {resource_key!r} differs from task claims: \"\r\n   150\t    if task.get(\"kind\") == \"feature\" or task.get(\"execution_scope\") != \"single_agent\":\r\n   151\t        return ConformanceState(task_id, title, \"aggregate\", head, head_tree, None,\r\n   152\t            (_finding(\"non_executable_contract\", \"Feature or non-executable contract is aggregate.\"),), dirty)\r\n   153\t\r\n   154\t    try:\r\n   155\t        records = load_committed_records(repo, head, task_id)\r\n   156\t    except ConformanceRecordError as exc:\r\n   157\t        return ConformanceState(task_id, title, \"invalid_evidence\", head, head_tree, None,\r\n   158\t            (_finding(\"record_structure_invalid\", str(exc)),), dirty)\r\n   159\t    if not records:\r\n   160\t        return ConformanceState(task_id, title, \"not_delivered\", head, head_tree, None,\r\n   161\t            (_finding(\"no_committed_evidence\", \"No committed delivery, baseline, or revalidation record exists.\"),), dirty)\r\n   162\t\r\n   163\t    invalid = _validate_basis_graph(repo, records)\r\n   164\t    current_contract_hash = semantic_json_sha256(repo.read(head, task_path))\r\n   165\t    current_revision = task.get(\"contract_revision\")\r\n   166\t    current_canon_hash = canonical_text_sha256(repo.read(head, CANON_PATH))\r\n   167\t    current_gate_ids = _current_gate_ids(task)\r\n   168\t    conformant: list[CommittedRecord] = []\r\n   169\t    replan: list[CommittedRecord] = []\r\n   170\t    human: list[CommittedRecord] = []\r\n   171\t    stale: list[CommittedRecord] = []\r\n   172\t\r\n   173\t    for record in records:\r\n   174\t        data = record.data\r\n   175\t        state = data[\"validated_state\"]\r\n   176\t        try:\r\n   177\t            if repo.tree(state[\"commit\"]) != state[\"tree\"]:\r\n   178\t                invalid.append(_finding(\"validated_tree_mismatch\", \"Recorded tree does not match validated commit.\", record))\r\n   179\t                continue\r\n   180\t            contract = data[\"task_contract\"]\r\n   181\t            historical_task_raw = repo.read(state[\"commit\"], contract[\"path\"])\r\n   182\t            historical_task = json.loads(historical_task_raw.decode(\"utf-8-sig\"))\r\n   183\t            if semantic_json_sha256(historical_task) != contract[\"sha256\"] or historical_task.get(\"contract_revision\") != contract[\"revision\"] or historical_task.get(\"id\") != task_id:\r\n   184\t                invalid.append(_finding(\"recorded_contract_mismatch\", \"Recorded contract identity/hash is false at validated commit.\", record))\r\n   185\t                continue\r\n   186\t            canon = data[\"canon\"]\r\n   187\t            if canonical_text_sha256(repo.read(state[\"commit\"], canon[\"path\"])) != canon[\"sha256\"]:\r\n   188\t                invalid.append(_finding(\"recorded_canon_mismatch\", \"Recorded canon hash is false at validated commit.\", record))\r\n   189\t                continue\r\n   190\t            bad_surface = False\r\n   191\t            changed_surface = False\r\n   192\t            for surface in data[\"conformance_surfaces\"]:\r\n   193\t                if repo.blob(state[\"commit\"], surface[\"path\"]) != surface[\"blob_sha\"]:\r\n   194\t                    invalid.append(_finding(\"surface_validated_blob_mismatch\", f\"Surface {surface['path']} blob is false at validated commit.\", record))\r\n   195\t                    bad_surface = True\r\n   196\t                    break\r\n   197\t                if not repo.exists(head, surface[\"path\"]) or repo.blob(head, surface[\"path\"]) != surface[\"blob_sha\"]:\r\n   198\t                    changed_surface = True\r\n   199\t            if bad_surface:\r\n   200\t                continue\r\n   201\t            artifact_bad = False\r\n   202\t            for gate in data[\"gate_results\"]:\r\n   203\t                for evidence in gate[\"evidence\"]:\r\n   204\t                    artifact_prefix = f\"Pipeline/TaskGraph/evidence/{task_id}/artifacts/\"\r\n   205\t                    if not evidence[\"path\"].startswith(artifact_prefix):\r\n   206\t                        invalid.append(_finding(\"artifact_location_invalid\", f\"Gate artifact is outside {artifact_prefix}.\", record))\r\n   207\t                        artifact_bad = True\r\n   208\t                    elif not repo.exists(head, evidence[\"path\"]) or repo.blob(head, evidence[\"path\"]) != evidence[\"blob_sha\"]:\r\n   209\t                        invalid.append(_finding(\"artifact_blob_mismatch\", f\"Evidence artifact {evidence['path']} is absent or altered at HEAD.\", record))\r\n   210\t                        artifact_bad = True\r\n   211\t            if artifact_bad:\r\n   212\t                continue\r\n   213\t        except (ConformanceRecordError, json.JSONDecodeError, UnicodeDecodeError) as exc:\r\n   214\t            invalid.append(_finding(\"record_object_unavailable\", str(exc), record))\r\n   215\t            continue\r\n   216\t\r\n   217\t        if not repo.is_ancestor(state[\"commit\"], head):\r\n   218\t            stale.append(record)\r\n   219\t            continue\r\n   220\t\r\n   221\t        record_gate_ids = [gate[\"gate_id\"] for gate in data[\"gate_results\"]]\r\n   222\t        if record_gate_ids != current_gate_ids and set(record_gate_ids) != set(current_gate_ids):\r\n   223\t            invalid.append(_finding(\"completion_gate_set_mismatch\", \"Record does not contain exactly the current completion-gate set.\", record))\r\n   224\t            continue\r\n   225\t        contract_changed = contract[\"path\"] != task_path or contract[\"revision\"] != current_revision or contract[\"sha256\"] != current_contract_hash\r\n   226\t        if contract_changed:\r\n   227\t            replan.append(record)\r\n   228\t            continue\r\n   229\t        approval = data[\"human_approval\"]\r\n   230\t        if approval[\"required\"] and (approval[\"decision\"] != \"approved\" or not approval[\"approved_by\"].strip()):\r\n   231\t            human.append(record)\r\n   232\t            continue\r\n   233\t        if (not approval[\"required\"] and approval[\"decision\"] != \"not_required\"):\r\n   234\t            invalid.append(_finding(\"human_approval_contradictory\", \"Non-required approval must use not_required.\", record))\r\n   235\t            continue\r\n   236\t        if changed_surface or canon[\"path\"] != CANON_PATH or canon[\"sha256\"] != current_canon_hash:\r\n   237\t            stale.append(record)\r\n   238\t            continue\r\n   239\t        conformant.append(record)\r\n   240\t\r\n   241\t    if invalid:\r\n   242\t        return ConformanceState(task_id, title, \"invalid_evidence\", head, head_tree, None, tuple(invalid), dirty)\r\n   243\t    if conformant:\r\n   244\t        maximal = _maximal(repo, conformant)\r\n   245\t        if len(maximal) != 1:\r\n   246\t            ids = \", \".join(item.record_id for item in maximal)\r\n   247\t            return ConformanceState(task_id, title, \"ambiguous_evidence\", head, head_tree, None,\r\n   248\t                (_finding(\"multiple_maximal_current_records\", f\"Multiple maximal current-valid records: {ids}.\"),), dirty)\r\n   249\t        selected = maximal[0]\r\n   250\t        return ConformanceState(task_id, title, \"conformant\", head, head_tree, selected.record_id,\r\n   251\t            (_finding(\"current_record_selected\", \"Record is valid for current contract, canon, surfaces, gates, and artifacts.\", selected),), dirty)\r\n   252\t    for state_name, candidates, code, message in (\r\n   253\t        (\"needs_replan\", replan, \"contract_changed\", \"Current contract revision or semantic hash differs from prior evidence.\"),\r\n   254\t        (\"needs_human\", human, \"human_approval_missing\", \"Required human approval is missing.\"),\r\n   255\t        (\"needs_revalidation\", stale, \"evidence_stale\", \"Prior evidence exists but is not current for HEAD.\"),\r\n   256\t    ):\r\n   257\t        if candidates:\r\n   258\t            maximal = _maximal(repo, candidates)\r\n   259\t            selected = maximal[0] if len(maximal) == 1 else None\r\n   260\t            return ConformanceState(task_id, title, state_name, head, head_tree,\r\n   261\t                selected.record_id if selected else None, (_finding(code, message, selected),), dirty)\r\n   262\t    return ConformanceState(task_id, title, \"not_delivered\", head, head_tree, None,\r\n   263\t        (_finding(\"no_usable_evidence\", \"No usable committed evidence exists.\"),), dirty)\r\n     1\t{\r\n     2\t  \"schema_version\": \"2.0\",\r\n     3\t  \"id\": \"NSC-003\",\r\n     4\t  \"contract_revision\": 1,\r\n     5\t  \"contract_disposition\": \"active\",\r\n     6\t  \"title\": \"Mouse-Directed Player Movement, Shared Pointer Projection, and Movement Restriction\",\r\n     7\t  \"reconciliation_key\": \"player-movement\",\r\n     8\t  \"kind\": \"implementation\",\r\n     9\t  \"type\": \"implementation\",\r\n    10\t  \"execution_scope\": \"single_agent\",\r\n    11\t  \"execution_reason\": \"All required responsibilities are cohesively owned by one system (PlayerMovement.cs) plus its Input Actions and builder/scene wiring; it is a bounded rewrite of one component's input/locomotion model rather than a multi-system integration.\",\r\n    12\t  \"decomposition_state\": \"concrete\",\r\n    13\t  \"decomposition_reason\": \"The required behavior (mouse-directed movement via Input System, shared pointer projection, movement-restriction interface, reset entry point) is fully specified by current GDD text without inventing new design.\",\r\n    14\t  \"parent\": \"NSC-002\",\r\n    15\t  \"depends_on\": [],\r\n    16\t  \"exclusive_resources\": [\r\n    17\t    \"repo-file:Assets/InputSystem_Actions.inputactions\",\r\n    18\t    \"repo-file:Assets/NoSafeCircle/DoorPrototype/Editor/DoorPrototypeSceneBuilder.cs\",\r\n    19\t    \"unity-scene:Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\"\r\n    20\t  ],\r\n    21\t  \"acceptance_criteria\": [\r\n    22\t    {\r\n    23\t      \"reference\": \"GDD §2 Move and Aim\",\r\n    24\t      \"requirement\": \"Movement is mouse-directed: a click sets a destination the wizard walks toward, and holding continues steering toward the current cursor position, consumed through Unity Input System/Input Actions rather than direct hardware polling.\",\r\n    25\t      \"criterion_id\": \"AC-001\"\r\n    26\t    },\r\n    27\t    {\r\n    28\t      \"reference\": \"GDD §2 Player Movement ownership\",\r\n    29\t      \"requirement\": \"Exposes a shared world-space pointer target produced by projecting the cursor onto the gameplay plane, consumable by cursor-aimed spells and Door/Interaction without those systems independently projecting screen coordinates.\",\r\n    30\t      \"criterion_id\": \"AC-002\"\r\n    31\t    },\r\n    32\t    {\r\n    33\t      \"reference\": \"GDD §2 Player Movement ownership; §4 Development Agent Ownership Invariants\",\r\n    34\t      \"requirement\": \"Exposes an owner-controlled movement-restriction request/release interface that Charged Fireball can use to restrict movement while charging without Fireball mutating movement internals directly.\",\r\n    35\t      \"criterion_id\": \"AC-003\"\r\n    36\t    },\r\n    37\t    {\r\n    38\t      \"reference\": \"GDD §2 Floor-run restart ownership\",\r\n    39\t      \"requirement\": \"Exposes an owner-controlled reset entry point that restores player position/movement state to the floor's initial state, consumed by the Floor Run/Restart Orchestrator rather than having position mutated externally.\",\r\n    40\t      \"criterion_id\": \"AC-004\"\r\n    41\t    },\r\n    42\t    {\r\n    43\t      \"reference\": \"GDD §2 Victory/input-shutdown ownership; §4 Development Agent Ownership Invariants and final escape/victory coordination\",\r\n    44\t      \"requirement\": \"Exposes an owner-controlled gameplay-enable/suspend interface, consumed by the Game Flow/Victory capability, that immediately stops or cancels any in-progress input-driven movement (including an active click-to-destination approach), rejects new movement commands while suspended, and can be re-enabled only through an authorized reset/test flow rather than external mutation of movement internals.\",\r\n    45\t      \"criterion_id\": \"AC-005\"\r\n    46\t    }\r\n    47\t  ],\r\n    48\t  \"completion_gates\": [\r\n    49\t    {\r\n    50\t      \"reference\": \"GDD §2 Move and Aim\",\r\n    51\t      \"requirement\": \"Play Mode validation that clicking a location moves the wizard toward it and that holding steers continuously toward the live cursor position.\",\r\n    52\t      \"gate_id\": \"VAL-001\"\r\n    53\t    },\r\n    54\t    {\r\n    55\t      \"reference\": \"Victory/input-shutdown ownership\",\r\n    56\t      \"requirement\": \"Play Mode check: invoking the suspend interface while movement is active immediately halts the wizard's in-progress movement (including an active click-to-destination approach), and further movement input has no effect until an authorized re-enable/reset flow runs.\",\r\n    57\t      \"gate_id\": \"VAL-002\"\r\n    58\t    }\r\n    59\t  ],\r\n    60\t  \"downstream_integration_obligations\": [\r\n    61\t    {\r\n    62\t      \"reference\": \"GDD §2 Player Movement ownership\",\r\n    63\t      \"requirement\": \"Validate that the exposed world-space pointer target is correctly consumable by a cursor-aimed spell or Door/Interaction integration once those systems exist.\",\r\n    64\t      \"obligation_id\": \"INT-001\"\r\n    65\t    }\r\n    66\t  ],\r\n    67\t  \"gdd_evidence\": [\r\n    68\t    {\r\n    69\t      \"reference\": \"GDD §2 Player Actions and Systems — Move and Aim\",\r\n    70\t      \"requirement\": \"Mouse-directed movement through the shared Unity Input System/Input Actions layer: click to set a destination or hold to keep steering toward the cursor; Player Movement owns the shared cursor-to-gameplay-plane projection and exposes the resulting world-space pointer target consumed by movement, cursor-aimed spells, and cursor-targeted interactions (Force Wave is the exception).\"\r\n    71\t    },\r\n    72\t    {\r\n    73\t      \"reference\": \"GDD §2 Resources, Feedback, and Failure — Player Movement ownership\",\r\n    74\t      \"requirement\": \"Player Movement owns position, locomotion, movement-restriction state, and the shared cursor-to-gameplay-plane projection; runtime input is routed through Input System/Input Actions rather than direct hardware polling; Charged Fireball requests/releases its movement restriction through an owner-controlled Player Movement interface without mutating movement internals.\"\r\n    75\t    },\r\n    76\t    {\r\n    77\t      \"reference\": \"GDD §2 Loss — Floor-run restart ownership\",\r\n    78\t      \"requirement\": \"Player Movement/player position is a required reset participant invoked by the Floor Run/Restart Orchestrator through an owner-controlled reset entry point.\"\r\n    79\t    },\r\n    80\t    {\r\n    81\t      \"reference\": \"Section 2 — Victory/input-shutdown ownership bullet\",\r\n    82\t      \"requirement\": \"Player Movement, Door/Interaction, Fireball, Frost Field, and Force Wave each expose an owner-controlled gameplay-enable/suspend interface that can immediately stop or cancel their current input-driven activity, reject new gameplay commands while suspended, and be re-enabled by an authorized reset/test flow.\"\r\n    83\t    }\r\n    84\t  ],\r\n    85\t  \"basis\": \"direct_gdd\",\r\n    86\t  \"source_scope\": \"required\",\r\n    87\t  \"confidence\": \"high\",\r\n    88\t  \"notes\": \"Exact movement speed/feel tuning is left to playtesting per GDD and is not part of this item's required acceptance surface.\",\r\n    89\t  \"repository_state_at_bootstrap\": \"partial\",\r\n    90\t  \"repository_evidence_at_bootstrap\": [\r\n    91\t    {\r\n    92\t      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerMovement.cs\",\r\n    93\t      \"evidence_type\": \"code\",\r\n    94\t      \"observation\": \"Implements only CharacterController-driven WASD movement via direct Keyboard.current polling; no mouse-directed movement, cursor projection, movement-restriction interface, or reset entry point exist.\"\r\n    95\t    },\r\n    96\t    {\r\n    97\t      \"path\": \"Assets/InputSystem_Actions.inputactions\",\r\n    98\t      \"evidence_type\": \"project_setting\",\r\n    99\t      \"observation\": \"Unmodified stock Unity template action asset; Player map has only WASD/Dpad Move and button actions (Attack/Interact/Crouch/Jump/etc.), no cursor-to-gameplay-plane or click-to-move action, and PlayerMovement.cs does not reference it.\"\r\n   100\t    },\r\n   101\t    {\r\n   102\t      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\",\r\n   103\t      \"evidence_type\": \"scene\",\r\n   104\t      \"observation\": \"PlayerMovement.cs (guid 356044e6782dd0641a7e69b0abfa5c4a) is serialized on the Player GameObject, confirming current WASD movement is the integrated state, not merely available via the builder.\"\r\n   105\t    }\r\n   106\t  ],\r\n   107\t  \"provenance\": {\r\n   108\t    \"origin\": \"verified_reconciliation_bootstrap\",\r\n   109\t    \"source_schema_version\": \"1.0\",\r\n   110\t    \"reconciliation_run_id\": \"20260821T193541Z-998ee7b5\",\r\n   111\t    \"verification_run_id\": \"20260821T195959Z-43dba5de\",\r\n   112\t    \"bootstrap_status_observation\": \"open\",\r\n   113\t    \"migration_id\": \"task-contract-schema-v2-20260822-r2\"\r\n   114\t  }\r\n   115\t}\r\n   225\t3. The orchestration pipeline may assign independent tasks to multiple agents at the same time. For example, the Wizard Combat Agent can implement a spell while the Enemy Pursuit Agent works on enemy movement and the Dungeon Encounter Agent prepares an encounter layout.\r\n   226\t4. Tasks that depend on unfinished work, or that require changes to the same scripts, scenes, or prefabs, are completed sequentially. Agents do not modify the same Unity assets concurrently.\r\n   227\t5. Each implementation is reviewed by the Unity Validation Agent. The developer then tests the feature in Play Mode and merges the accepted change into the main project.\r\n   228\t\r\n   229\t### Shared Context and Coordination Rules\r\n   230\t\r\n   231\t- **Minimal-context dispatch is a required pipeline constraint:** agents receive only the approved feature brief, its acceptance criteria, the relevant GDD rules, and the files plus scene/prefab information required for the active task. Unrelated project files or broad project context are not included unless the task genuinely requires them.\r\n   232\t- Independent agents work in isolated branches or workspaces so their changes can be reviewed before integration.\r\n   233\t- **Current prototype scene-builder lock:** scene-authoring work that changes objects generated or maintained through `Assets/NoSafeCircle/DoorPrototype/Editor/DoorPrototypeSceneBuilder.cs` must take exclusive-write locks on both that builder and `Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity`. This specifically applies to doorway-crossing work that creates/configures the forward-side crossing trigger and, under the current scene-built UI approach, to final-victory work that creates/configures the **You Escaped** overlay. If a later approved architecture moves the overlay or another scene object into a separately owned runtime prefab/asset, the task may lock that actual asset instead; the task graph must reflect the implementation that exists when it is dispatched.\r\n   234\t- Each task produces changed files, an implementation summary, known risks, and a Play Mode test checklist.\r\n   235\t- Source control commits serve as the handoff between implementation, validation, and integration.\r\n   236\t- Agents may report a risk or recommend a scope cut, but they cannot redesign the game or add features without developer approval.\r\n   237\t- The human developer remains responsible for architecture, merging changes, inspecting Unity scenes and prefabs, playtesting, balance, and final integration.\r\n   238\t\r\n   239\t### Example Game-Specific Agent Task\r\n   240\t\r\n   241\tWhile the Door and Interaction Agent implements click-to-approach door opening, automatic five-second timing on arrival, and automatic locking after crossing, the Enemy Pursuit Agent can independently implement melee enemies following the wizard through open doors. At the same time, the Dungeon Encounter Agent can define the enemy placement for the first encounter space.\r\n   242\t\r\n   243\tAfter those tasks are complete, the Unity Validation Agent checks that enemies can cross an open doorway without automatically losing the player, that distance-based target loss leads through last-known-position search before target clearing, that damage or moving away interrupts opening after arrival while cursor drift after selection does not, and that crossing automatically closes and locks the door with no second input. The developer then combines and tests the features inside Unity.\r\n   244\t\r\n   245\t## 5. Technical Strategy\r\n   246\t\r\n   247\tNo Safe Circle will be developed by one developer in Unity using C#. A raw Python orchestration pipeline using Claude Code agents will coordinate specialized development agents that assist with planning, implementation, review, debugging, and test design. Independent tasks may run at the same time, but tasks that modify the same scripts, scenes, or prefabs will be completed sequentially.\r\n   248\t\r\n   249\tSection 4 defines the six development-agent roles and their effects on the game. This section explains how those agents will be coordinated, constrained, budgeted, and validated during development.\r\n   250\t\r\n   251\tThe finished Windows game will not use generative AI at runtime. Enemy behavior, spell effects, doors, damage, and pursuit will run locally through standard Unity systems. The game will require no external AI service, API key, token usage, or network connection after it is built. Development-time generative tools may be used to create isometric tiles, props, and directional sprites, but once imported they behave as ordinary Unity assets.\r\n   252\t\r\n   253\tThe developer approves feature briefs, resolves architecture decisions, inspects scenes and prefabs, tests game feel, balances encounters, merges changes, and decides which stretch features are accepted.\r\n   254\t\r\n   255\t### Agent Coordination\r\n   256\t\r\n   257\tThe orchestration pipeline may run independent tasks in parallel. For example, the Wizard Combat Agent may implement Fireball and Force Wave while the Enemy Pursuit Agent independently implements melee chasing and Ranged Enemy targeting, and the Dungeon Encounter Agent plans an encounter layout. The **Development Agent Ownership Invariants** in Section 4 are mandatory pipeline constraints, not advisory prose; planning and reconciliation must preserve them as explicit process requirements and must not collapse cross-system ownership merely to simplify a task graph.\r\n   258\t\r\n   259\tAgents will work in isolated branches or workspaces. Two agents will not modify the same gameplay files or Unity assets at the same time. Each completed task will produce:\r\n   260\t\r\n   261\t- Changed files\r\n   262\t- An implementation summary\r\n   263\t- Known risks or limitations\r\n   264\t- A Play Mode test checklist\r\n   265\t- A source-control commit for review\r\n   266\t\r\n   267\tSource control will serve as the handoff between implementation, validation, and final integration.\r\n   268\t\r\n   269\t### Current Prototype Scene Evidence\r\n   270\t\r\n   271\tAs of the August 20, 2026 repository state, the project contains three committed `.unity` scene files. Reconciliation and planning must describe them accurately rather than treating every scene file as an equivalent gameplay scene:\r\n   272\t\r\n   273\t- `Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity` is the current canonical gameplay prototype scene and is the scene maintained by `Assets/NoSafeCircle/DoorPrototype/Editor/DoorPrototypeSceneBuilder.cs`.\r\n   274\t- `Assets/Scenes/DoorPrototype.unity` is a small non-canonical stub containing the default-style Main Camera and Directional Light; its camera is perspective, not the orthographic isometric gameplay camera. It must not be cited as an alternative implemented gameplay prototype.\r\n   275\t- `Assets/Scenes/SampleScene.unity` is also a non-canonical stub/sample scene and must not be described as the only or primary gameplay scene.\r\n   276\t- The presence of these stubs is repository evidence, not a design requirement. Their deletion, retention, or repurposing is a **human decision**; agents and reconciliation steps must not delete or reinterpret them merely to make scene inventory evidence cleaner.\r\n   277\t\r\n   278\t### 2.5D Isometric Visual and World Representation\r\n   279\t\r\n   280\t- The project targets a **hybrid isometric architecture**. Unity **2D Tilemap Editor** (`com.unity.2d.tilemap`) is the approved authoring package for Isometric Tilemaps used for floors, walls, and repeatable architecture. **SpriteRenderer prefabs** are used for doors, props, obstacles, the wizard, enemies, and other independently sorted or interactive objects.\r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"nl -ba Docs/AI-Pipeline/CURRENT_STATE.md | sed -n '1,125p'; nl -ba Docs/AI-Pipeline/CURRENT_STATE.md | sed -n '540,745p'; nl -ba Docs/AI-Pipeline/01_MILESTONE_TASK_GRAPH.md | sed -n '240,330p'; nl -ba Pipeline/TaskGraph/RESOURCE_GROUPS.yaml | sed -n '90,125p'; nl -ba Pipeline/TaskGraph/evidence/NSC-023/records/BASE-NSC-023-86af98f41ab5.json | sed -n '15,80p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"nl -ba Docs/AI-Pipeline/CURRENT_STATE.md | sed -n '1,125p'; nl -ba Docs/AI-Pipeline/CURRENT_STATE.md | sed -n '540,745p'; nl -ba Docs/AI-Pipeline/01_MILESTONE_TASK_GRAPH.md | sed -n '240,330p'; nl -ba Pipeline/TaskGraph/RESOURCE_GROUPS.yaml | sed -n '90,125p'; nl -ba Pipeline/TaskGraph/evidence/NSC-023/records/BASE-NSC-023-86af98f41ab5.json | sed -n '15,80p'\"","aggregated_output":"     1\t# CURRENT STATE — No Safe Circle AI Pipeline\n     2\t\n     3\t> Update this file whenever a milestone or important implementation slice changes.\n     4\t\n     5\tLast updated: 2026-08-23, for Stage 4C OpenAI/Codex AgentRuntime and ArchitectureReview migration on `provider-adapters`.\n     6\t\n     7\t## Current Phase\n     8\t\n     9\t**Architecture Correction Phase 3 — COMPLETE AND MERGED.**\n    10\t\n    11\tPhase 3A — Evidence-Derived Current Conformance Evaluator — is complete.\n    12\t\n    13\tPhase 3B — First Real Production Baseline — is complete.\n    14\t\n    15\tPhase 3 was fast-forward merged into `main` at:\n    16\t\n    17\t```text\n    18\t43fdf0a163e281204906abd43a241db211587a0f\n    19\t```\n    20\t\n    21\t**Provider-Neutral Execution Crew Plan — Stage 4A: MAPPING, ENFORCEMENT, AND TRANSPORT-EVALUATION DECISIONS COMPLETE.**\n    22\t\n    23\tThe current development branch is:\n    24\t\n    25\t```text\n    26\tprovider-adapters\n    27\t```\n    28\t\n    29\tThe Stage 3 foundation now implements:\n    30\t\n    31\t- provider-neutral immutable `AgentInvocationRequest` and `AgentResult` contracts;\n    32\t- semantic capability and write-boundary contracts;\n    33\t- `low_cost`, `standard`, and `high_reasoning` model capability classes;\n    34\t- strict provider configuration loading and validation;\n    35\t- bounded request budgets and normalized failure classifications;\n    36\t- strict JSON value and supported-schema validation;\n    37\t- atomic, no-overwrite immutable run artifacts;\n    38\t- provider-neutral base interfaces;\n    39\t- a deterministic, side-effect-free `FakeProvider`;\n    40\t- an adversarial regression suite covering provider trust boundaries, path safety, schema failures, immutable artifacts, malformed provider values, and historical-directory protection.\n    41\t\n    42\tThe Stage 3 implementation is integrated; Stage 4A changes are documentation and decision work only.\n    43\t\n    44\tLive CLI discovery is complete. Non-production-write structured-output success probes completed for Claude Code and OpenAI/Codex. The provider-transport adopt-versus-build spike is also complete: `agent-mux` and `agent-shell` were evaluated and are not being adopted as production dependencies. ADR-035 was amended on 2026-08-23 to keep `AgentRequest` schema 1.0 and its required integer `turn_limit`, with explicit provider-specific enforcement mappings.\n    45\t\n    46\t**Stage 4B.2 — Practical Repository Read/Search** extends the existing Claude adapter for this trusted single-user local environment. `repository_read` maps to Claude `Read`; `repository_search` maps to Claude `Glob` and `Grep`; their combination exposes all three. Repository-capable calls use the actual source repository root (`/workspace` in Docker), while empty-capability calls retain their fresh empty temporary workspace and no-tool behavior. Validated `context_paths` are accepted only with repository capability and become prompt guidance rather than a hardened sandbox boundary.\n    47\t\n    48\t**Stage 4C — OpenAI/Codex Provider and ArchitectureReview Migration** adds `OpenAICodexProvider` behind generic AgentRuntime. The active OpenAI ArchitectureReview path now constructs task-neutral `AgentInvocationRequest` values and calls `AgentRunner`; provider subprocess, JSONL/final-output parsing, usage normalization, timeout translation, and failure normalization live in AgentRuntime. Invocation audit artifacts are nested under each ArchitectureReview run. TaskExecution is not involved.\n    49\t\n    50\tAgentRuntime `approved_command_execution`, repository writing, web access, non-null token limits, provider fallback, and production orchestration remain unsupported. The Codex ArchitectureReview repository read/search implementation uses Codex's ordinary read-only shell/file inspection inside the externally read-only `codex-review` Docker environment; that is not approved command execution. Stage 4C remains the OpenAI/Codex Provider stage.\n    51\t\n    52\tArchitectureReview generated runs and provider-latest views are separated under `outputs/claude/` and `outputs/codex/`; those provider-specific latest views retain convenience copies. Global `outputs/latest/` contains only one atomic `LATEST.json` pointer identifying the most recently completed provider-scoped run across providers. Manifests record the explicit provider namespace, resume cannot cross it, and failed/partial runs do not publish latest. Each provider retains eight independent reviewer roles. New independent reviewers ignore prior review opinions even when summarized in architecture/current-state documentation, while still using implemented architecture, accepted decisions, and current documented facts as evidence to judge independently. This preserves review provenance and supports a later Claude-versus-Codex comparison without implementing that comparison pipeline.\n    53\t\n    54\t**Provider-Neutral Execution Crew Plan — Stage 4: Implement Claude Code and OpenAI/Codex adapters against the same AgentRuntime fixtures.**\n    55\t\n    56\tThe accepted Stage 4 turn-budget mapping is:\n    57\t\n    58\t- Claude: `turn_limit=N` -> native `--max-turns N`, also bounded by external `timeout_seconds`;\n    59\t- OpenAI/Codex: no observed native turn limit, so use temporary `OPENAI_SECONDS_PER_TURN = 30` and `effective_timeout_seconds = min(timeout_seconds, turn_limit * 30)`;\n    60\t- these mappings are bounded-execution controls, not cross-provider-equivalent units of model work;\n    61\t- any non-null `token_limit` remains unsupported and fails closed.\n    62\t\n    63\tNo production `ExecutionCrew` role orchestration, Unity execution by an agent, GER integration, task selection, dependency readiness, autonomous dispatch, automatic Git commit/merge behavior, or live provider fallback has been enabled.\n    64\t\n    65\tArchitecture Correction Phase 3 remains intentionally fail-closed for execution:\n    66\t\n    67\t```text\n    68\tTASK READINESS: UNAVAILABLE — DISPATCH POLICY NOT ENABLED\n    69\t```\n    70\t\n    71\tand:\n    72\t\n    73\t```text\n    74\tEXECUTION AUTHORIZATION: DENIED\n    75\t```\n    76\t\n    77\tEvidence-derived conformance has been proven for `NSC-023`, but a conformant task does not establish dependency readiness or execution authority.\n    78\t\n    79\t## Architecture Review Result\n    80\t\n    81\tThe post-Milestone-1 architecture review evaluated one frozen repository commit through eight independent specialist reviews, a synthesis, and an adversarial critique of that synthesis.\n    82\t\n    83\tResult:\n    84\t\n    85\t- eight of eight independent reviewers: `partially_unsound`;\n    86\t- synthesis: `partially_unsound`;\n    87\t- adversarial critique: `synthesis_needs_revision`.\n    88\t\n    89\tAccepted correction direction:\n    90\t\n    91\t- preserve bounded workers, deterministic validation, GER repair, runtime evidence, human authority, and persistent task contracts;\n    92\t- stop treating mutable task metadata as completion truth;\n    93\t- distinguish historical delivery evidence from current conformance;\n    94\t- use reconciliation for bootstrap, broad audits, and reviewed change-impact proposals rather than routine global truth regeneration;\n    95\t- avoid implementing the entire original Milestone 2 bundle before proving smaller real delivery loops;\n    96\t- keep one worker and human merge/design authority until the one-ticket process is trustworthy;\n    97\t- do not treat reviewer consensus or task-graph ordering as automatic product priority.\n    98\t\n    99\tAccepted immutable review evidence is preserved under:\n   100\t\n   101\t`Pipeline/ArchitectureReview/evidence/20260821T222222Z-40fdf9ce/`\n   102\t\n   103\tThat directory contains the frozen manifest, model assignments, all eight independent reviews, synthesis, and adversarial critique.\n   104\t\n   105\tGenerated `Pipeline/ArchitectureReview/outputs/` remains transient and ignored by default.\n   106\t\n   107\t## Architecture Correction Phase 1 — COMPLETE\n   108\t\n   109\tPhase 1 prevented the legacy task model from authorizing autonomous work before the task-contract migration and evidence model existed.\n   110\t\n   111\tKey invariant retained:\n   112\t\n   113\t> Mutable task metadata cannot authorize execution.\n   114\t\n   115\tImplemented safeguards include:\n   116\t\n   117\t- `Pipeline/TaskGraph/execution_authority.py`;\n   118\t- `Pipeline/TaskGraph/phase1_execution_authority_smoke_test.py`;\n   119\t- fail-closed authorization behavior in `taskcontrol`.\n   120\t\n   121\tPhase 2 removed operational completion status from the contracts themselves. Phase 3A now provides current-state inspection, but execution authority intentionally remains disabled.\n   122\t\n   123\t## Architecture Correction Phase 2 — COMPLETE\n   124\t\n   125\tAll 37 persistent task records were migrated from schema 1.0 to **task-contract schema 2.0**.\n   540\t```powershell\n   541\tdocker compose run --rm codex-review python3 Pipeline/TaskGraph/taskcontrol.py ready\n   542\t```\n   543\t\n   544\tExpected output begins:\n   545\t\n   546\t```text\n   547\tTASK READINESS: UNAVAILABLE — DISPATCH POLICY NOT ENABLED\n   548\t```\n   549\t\n   550\tand explicitly states:\n   551\t\n   552\t- evidence-derived current-state inspection exists through `taskcontrol state`;\n   553\t- evidence-derived current conformance has been proven on at least one real task;\n   554\t- a conformant result does not establish dependency readiness;\n   555\t- dependency-readiness policy has not been implemented or approved;\n   556\t- dispatch authorization policy has not been implemented or approved;\n   557\t- state inspection and a conformant result never authorize autonomous execution;\n   558\t- zero tasks are authorized for autonomous dispatch.\n   559\t\n   560\tAuthorization command:\n   561\t\n   562\t```powershell\n   563\tdocker compose run --rm codex-review python3 Pipeline/TaskGraph/taskcontrol.py authorize NSC-023\n   564\t```\n   565\t\n   566\tExpected result:\n   567\t\n   568\t```text\n   569\tEXECUTION AUTHORIZATION: DENIED\n   570\treason_code: evidence_derived_dispatch_policy_not_enabled\n   571\t```\n   572\t\n   573\tA nonzero exit from `authorize` is an intentional policy denial, not a Docker failure.\n   574\t\n   575\t## Source-of-Truth Boundaries\n   576\t\n   577\t### Game-design canon\n   578\t\n   579\tThe current human-approved GDD and explicit approved design decisions define intended behavior.\n   580\t\n   581\t### Production GDD retrieval\n   582\t\n   583\t`Pipeline/GDDRAG` provides current, hash-bound, integrity-validated retrieval over the canonical GDD. It is not a substitute for complete canon when retrieval coverage has not been proven.\n   584\t\n   585\t### Task contracts\n   586\t\n   587\t`Tasks/*.yaml` defines approved work identity, scope, dependencies, acceptance criteria, completion gates, downstream obligations, exclusive resources, contract revision/disposition, and provenance.\n   588\t\n   589\tTask contracts do not contain current execution or completion truth.\n   590\t\n   591\t### Integrated implementation\n   592\t\n   593\tThe integrated Git tree is the authority for what code and assets are present.\n   594\t\n   595\tPresence alone is not completion proof.\n   596\t\n   597\t### Delivery/revalidation records\n   598\t\n   599\tPhase 3 records are immutable evidence claims tied to exact task, canon, Git, gate, artifact, and approval identities.\n   600\t\n   601\tA record does not contain mutable current-completion authority.\n   602\t\n   603\t### Current conformance\n   604\t\n   605\t`Pipeline/TaskGraph/current_conformance.py` deterministically evaluates committed evidence against current committed HEAD.\n   606\t\n   607\tState inspection is now implemented.\n   608\t\n   609\tProduction proof now exists for NSC-023 through committed baseline `BASE-NSC-023-86af98f41ab5`. No real production revalidation record exists yet.\n   610\t\n   611\t### AgentRuntime requests/results\n   612\t\n   613\t`Pipeline/AgentRuntime` is the provider-neutral execution boundary for future model invocations.\n   614\t\n   615\tIts immutable request, result, configuration, and provider-log artifacts are execution records and audit data. They are **not** game-design authority, deterministic validation evidence, current conformance, readiness, dispatch authorization, or human approval.\n   616\t\n   617\tProvider-reported changed paths, executed commands, tests, usage, and structured output remain claims until independently checked by the appropriate deterministic Git, Unity, schema, TaskGraph, or human process.\n   618\t\n   619\t### Reconciliation\n   620\t\n   621\tReconciliation outputs remain immutable point-in-time observations. They may propose graph changes but do not directly mutate living task contracts or current conformance state.\n   622\t\n   623\tRoutine GDD iteration should eventually use reviewed, scoped impact analysis rather than global reconciliation after every edit.\n   624\t\n   625\t### Architecture review evidence\n   626\t\n   627\tThe preserved architecture review is primary evidence for the accepted correction direction, but reviewer recommendations do not automatically become project decisions.\n   628\t\n   629\t## Immediate Next Goal\n   630\t\n   631\t### Migrate ArchitectureReview through generic AgentRuntime using Claude\n   632\t\n   633\tStage 4B.2 repository read/search and Stage 4B.3 responsibility separation are complete. `AgentInvocationRequest` schema 1.0 is generic; `TaskExecutionRequest` schema 1.0 separately owns NSC identity; `AgentResult` remains schema 1.0. `ProviderOutputInvalid` normalization is already implemented.\n   634\t\n   635\tThe next useful production proof is to migrate ArchitectureReview through AgentRuntime using the existing Claude adapter. That later slice should retain ArchitectureReview workflow identity above AgentRuntime and should not invent a task identity. The OpenAI/Codex provider remains unimplemented.\n   636\t\n   637\tCurrent provider budget policy remains:\n   638\t\n   639\t- Claude Code: native `--max-turns N` plus external `timeout_seconds`;\n   640\t- OpenAI/Codex: `effective_timeout_seconds = min(timeout_seconds, turn_limit * 30)` using the temporary 30-seconds-per-turn-budget-unit policy;\n   641\t- non-null `token_limit`: fail closed;\n   642\t- no automatic model/provider fallback.\n   643\t\n   644\tStage 4 must remain bounded:\n   645\t\n   646\t- no provider-specific task contracts or role schemas;\n   647\t- no automatic provider fallback that changes task meaning;\n   648\t- no production `ExecutionCrew` role orchestration yet;\n   649\t- no real gameplay task execution yet;\n   650\t- no Unity validation delegated to a model;\n   651\t- no Phase 3 evidence publication by an adapter;\n   652\t- no dependency readiness;\n   653\t- no dispatch authorization;\n   654\t- no automatic merge.\n   655\t\n   656\tArchitecture Correction Phase 3 authority remains active:\n   657\t\n   658\t- `NSC-023` derives as `conformant`;\n   659\t- readiness remains unavailable;\n   660\t- authorization remains denied;\n   661\t- no worker, provider, runtime, or future adapter result establishes completion, readiness, or dispatch authority.\n   662\t\n   663\tNo real production revalidation record exists yet. Do not fabricate a gameplay, contract, GDD, scene, implementation, or test change merely to produce one. The first legitimate relevant change will exercise the production revalidation path.\n   664\t\n   665\t## Real Gameplay Task Selection After the Evidence Proof\n   666\t\n   667\tThe first gameplay implementation task is **not automatically selected** by this document, the graph, or reviewer consensus.\n   668\t\n   669\t`NSC-037` was discussed during architecture review as a possible delivery-lane experiment. It is not the committed gameplay priority.\n   670\t\n   671\t`NSC-003` remains a possible high-leverage gameplay anchor, but it should not be handed to a worker unchanged merely because its task contract currently says `single_agent`.\n   672\t\n   673\tBefore implementing NSC-003, human review should resolve:\n   674\t\n   675\t- which Input Action owns click-to-move/select;\n   676\t- arbitration among UI click, movement, Fireball, Frost Field, Force Wave, and door selection;\n   677\t- click versus held-pointer steering;\n   678\t- destination replacement and cancellation;\n   679\t- approach/arrival semantics;\n   680\t- movement pathing expectations;\n   681\t- movement-restriction ownership/release semantics.\n   682\t\n   683\tHuman review should also decide whether NSC-003 should be superseded by smaller contracts, for example:\n   684\t\n   685\t- runtime input and shared pointer-projection foundation;\n   686\t- mouse-directed movement, restriction, reset, and suspension.\n   687\t\n   688\t## Deferred Until Evidence Justifies It\n   689\t\n   690\tDo not enable or build these merely because Phase 3 exists:\n   691\t\n   692\t- dependency-derived `taskcontrol ready`;\n   693\t- autonomous execution authorization;\n   694\t- autonomous task claiming or continuous dispatch;\n   695\t- parallel workers or broad worktree orchestration;\n   696\t- automatic merge/merge queues;\n   697\t- broad GitHub Issues/Projects synchronization;\n   698\t- automatic backlog replenishment;\n   699\t- full-game speculative decomposition;\n   700\t- Progressive Decomposer as a bundled platform;\n   701\t- Artifact Authority without a real blocking design need;\n   702\t- top-k-only task context presented as complete canon;\n   703\t- automatic GDD impact analysis without a reviewed causal model;\n   704\t- a general supervisor before repeated delivery bottlenecks justify one.\n   705\t\n   706\tThese remain later candidates driven by observed production needs rather than roadmap momentum.\n   707\t\n   708\t## Obsolete Branch/Plan Warning\n   709\t\n   710\tDo not resume `milestone-2a-nsc-003-context` unchanged.\n   711\t\n   712\tThat branch predates the accepted architecture corrections, task-contract schema 2.0, reviewed migration corrections, production GDD RAG integrity boundary, and Phase 3 conformance model.\n   713\t\n   714\tUseful ideas should be recreated from the corrected current repository state rather than continuing the obsolete plan as written.\n   715\t\n   716\t## Next Window Instructions\n   717\t\n   718\tRead, in order:\n   719\t\n   720\t1. `Docs/AI-Pipeline/START_HERE.md`;\n   721\t2. this file;\n   722\t3. `Docs/AI-Pipeline/00_MASTER_CONTEXT.md`;\n   723\t4. `Docs/AI-Pipeline/DECISIONS.md`;\n   724\t5. `Docs/AI-Pipeline/06_PROVIDER_NEUTRAL_EXECUTION_CREW_PLAN.md`;\n   725\t6. `Docs/AI-Pipeline/ADR-034_PROVIDER_NEUTRAL_AGENT_RUNTIME.md`;\n   726\t7. `Docs/AI-Pipeline/07_PROVIDER_ADAPTER_CAPABILITY_MAPPING.md`;\n   727\t8. `Docs/AI-Pipeline/ADR-035_PROVIDER_ADAPTER_ENFORCEMENT.md`;\n   728\t9. `Pipeline/AgentRuntime/README.md`;\n   729\t10. `Pipeline/AgentRuntime/contracts.py`;\n   730\t11. `Pipeline/AgentRuntime/agent_runner.py`;\n   731\t12. `Pipeline/AgentRuntime/providers/base.py`;\n   732\t13. `Pipeline/AgentRuntime/tests/agent_runtime_smoke_test.py`;\n   733\t14. inspect the actual repository and branch state.\n   734\t\n   735\tThen:\n   736\t\n   737\t1. confirm the intended `provider-adapters` branch and inspect the working tree without discarding existing changes;\n   738\t2. confirm ADR-035 remains recorded as accepted/amended and ADR-036 records the transport ownership decision;\n   739\t3. read ADR-039 and inspect `Pipeline/TaskExecution` before adding any task-associated consumer;\n   740\t4. migrate ArchitectureReview through generic AgentRuntime using Claude in the next reviewed slice; do not implement the OpenAI/Codex provider as part of that migration;\n   741\t5. use only opt-in, non-production-write live smoke tests during Stage 4;\n   742\t6. do not implement production `ExecutionCrew` roles until both adapters pass the shared fixture suite;\n   743\t7. keep `taskcontrol ready` unavailable and `taskcontrol authorize` denied.\n   744\t\n   745\tA new window should be able to resume from repository state without the prior chat transcript.\n   240\t```\r\n   241\t\r\n   242\t### `validate`\r\n   243\t\r\n   244\tThe live loader and graph validator check the current persistent state rather than blindly trusting that the initial seed was valid forever.\r\n   245\t\r\n   246\tValidation covers, among other things:\r\n   247\t\r\n   248\t- duplicate IDs/reconciliation keys;\r\n   249\t- filename/ID consistency;\r\n   250\t- valid ID format;\r\n   251\t- ID-map/task consistency;\r\n   252\t- valid kind/status/execution-scope enums;\r\n   253\t- malformed required fields;\r\n   254\t- one correct project root;\r\n   255\t- valid parent references;\r\n   256\t- connected/acyclic parent hierarchy;\r\n   257\t- valid dependencies;\r\n   258\t- dependency acyclicity;\r\n   259\t- bootstrap provenance consistency;\r\n   260\t- exclusive-resource group consistency;\r\n   261\t- project-requirement structure;\r\n   262\t- open executable work incorrectly marked `not_applicable`.\r\n   263\t\r\n   264\t### `ready`\r\n   265\t\r\n   266\tA work item is executable-ready when:\r\n   267\t\r\n   268\t1. `status == open`;\r\n   269\t2. `kind` is `artifact` or `implementation`;\r\n   270\t3. `execution_scope == single_agent`;\r\n   271\t4. every `depends_on` item is complete.\r\n   272\t\r\n   273\tFeature nodes, decomposition-needed work, human-integration work, and unknown-scope work are not returned as executable-ready.\r\n   274\t\r\n   275\tThe first real ready frontier contained seven tasks:\r\n   276\t\r\n   277\t```text\r\n   278\tNSC-003  Mouse-Directed Player Movement, Shared Pointer Projection, and Movement Restriction\r\n   279\tNSC-004  Player Health Ownership, Restore, Death Transition, and Feedback\r\n   280\tNSC-005  Player Mana Ownership, Restart Reset, and Denied-Cast Feedback\r\n   281\tNSC-011  Active Enemy Registry\r\n   282\tNSC-020  Shared Doorway-Crossing State (Forward-Side Crossing Detection)\r\n   283\tNSC-024  Tilemap and AI Navigation Package Configuration\r\n   284\tNSC-037  Windows Build Scene Registration\r\n   285\t```\r\n   286\t\r\n   287\tThis was the key Milestone 1 proof: the repository can now answer **what can safely execute now** without rebuilding a roadmap in an LLM context.\r\n   288\t\r\n   289\t### `list`, `show`, and `graph`\r\n   290\t\r\n   291\t`list` provides the compact full backlog with status/kind/execution scope.\r\n   292\t\r\n   293\t`show <ID>` exposes the bounded task contract including dependencies, exclusive resources, acceptance criteria, validation requirements, notes, and bootstrap repository state.\r\n   294\t\r\n   295\t`graph` reconstructs the feature hierarchy and dependency edges in human-readable text.\r\n   296\t\r\n   297\t## Real First-Task Example\r\n   298\t\r\n   299\t`NSC-003` is a concrete `single_agent` task with no dependencies and is a strong anchor for the next pipeline slice.\r\n   300\t\r\n   301\tIts contract includes:\r\n   302\t\r\n   303\t- mouse-directed click/hold movement through Unity Input System/Input Actions;\r\n   304\t- shared cursor-to-gameplay-plane projection;\r\n   305\t- owner-controlled movement restriction for Charged Fireball;\r\n   306\t- owner-controlled reset entry point;\r\n   307\t- owner-controlled gameplay suspend/re-enable behavior;\r\n   308\t- Unity integration through the relevant Input Actions, builder, and canonical scene resources.\r\n   309\t\r\n   310\tMilestone 2 should use real near-term gameplay work like this when testing compact context generation rather than building generic infrastructure in isolation.\r\n   311\t\r\n   312\t## Resource-Conflict Semantics\r\n   313\t\r\n   314\tExclusive resource claims describe integration/conflict surfaces; they do not automatically imply dependency edges.\r\n   315\t\r\n   316\tInitial shared resource groups include logical ownership surfaces plus concrete Unity assets such as:\r\n   317\t\r\n   318\t- `Assets/InputSystem_Actions.inputactions`\r\n   319\t- `Assets/NoSafeCircle/DoorPrototype/Editor/DoorPrototypeSceneBuilder.cs`\r\n   320\t- `Assets/NoSafeCircle/DoorPrototype/Scripts/DoorInteractable.cs`\r\n   321\t- `Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity`\r\n   322\t\r\n   323\tThese become especially important later when the supervisor introduces claims/worktrees and eventually parallel workers.\r\n   324\t\r\n   325\t## Lessons Preserved from Milestone 1\r\n   326\t\r\n   327\t1. **Repository state beats conversation memory.**\r\n   328\t2. **Reconciliation is observation, not mutable project state.**\r\n   329\t3. **Human approval is a real authority boundary.**\r\n   330\t4. **The graph should be coarse and truthful rather than exhaustively speculative.**\r\n    90\t        \"player-movement\",\r\n    91\t        \"world-visual-foundation\"\r\n    92\t      ]\r\n    93\t    },\r\n    94\t    {\r\n    95\t      \"resource_key\": \"repo-file:Assets/NoSafeCircle/DoorPrototype/Scripts/DoorInteractable.cs\",\r\n    96\t      \"work_ids\": [\r\n    97\t        \"NSC-021\",\r\n    98\t        \"NSC-019\",\r\n    99\t        \"NSC-020\"\r\n   100\t      ],\r\n   101\t      \"reconciliation_keys\": [\r\n   102\t        \"door-close-lock-break-lifecycle\",\r\n   103\t        \"door-open-interaction\",\r\n   104\t        \"doorway-crossing-state\"\r\n   105\t      ]\r\n   106\t    },\r\n   107\t    {\r\n   108\t      \"resource_key\": \"unity-scene:Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\",\r\n   109\t      \"work_ids\": [\r\n   110\t        \"NSC-021\",\r\n   111\t        \"NSC-019\",\r\n   112\t        \"NSC-020\",\r\n   113\t        \"NSC-035\",\r\n   114\t        \"NSC-007\",\r\n   115\t        \"NSC-032\",\r\n   116\t        \"NSC-033\",\r\n   117\t        \"NSC-009\",\r\n   118\t        \"NSC-008\",\r\n   119\t        \"NSC-025\",\r\n   120\t        \"NSC-004\",\r\n   121\t        \"NSC-003\",\r\n   122\t        \"NSC-026\"\r\n   123\t      ],\r\n   124\t      \"reconciliation_keys\": [\r\n   125\t        \"door-close-lock-break-lifecycle\",\r\n    15\t  \"validated_state\": {\r\n    16\t    \"commit\": \"86af98f41ab53016ef55eca9516cc339a1e4f5d1\",\r\n    17\t    \"tree\": \"3e89c4a4879d1bf4179ae48f95b85dee1abc0d4d\"\r\n    18\t  },\r\n    19\t  \"conformance_surfaces\": [\r\n    20\t    {\r\n    21\t      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Editor/DoorPrototypeSceneBuilder.cs\",\r\n    22\t      \"blob_sha\": \"5aed87d28ed649fd861c0e35e9d046ec99ce78a2\",\r\n    23\t      \"role\": \"camera_authoring\"\r\n    24\t    },\r\n    25\t    {\r\n    26\t      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scripts/IsometricCameraFollow.cs\",\r\n    27\t      \"blob_sha\": \"b0b4e7826d97339532771ddc8a63509fd2eb6c0f\",\r\n    28\t      \"role\": \"runtime_camera_follow\"\r\n    29\t    },\r\n    30\t    {\r\n    31\t      \"path\": \"Assets/Scenes/DoorPrototype.unity\",\r\n    32\t      \"blob_sha\": \"d3ac44eaf6b8c12e02db7bd0e5652bb8d7b19c55\",\r\n    33\t      \"role\": \"committed_scene\"\r\n    34\t    },\r\n    35\t    {\r\n    36\t      \"path\": \"Assets/Scenes/DoorPrototype.unity.meta\",\r\n    37\t      \"blob_sha\": \"4e3c78726f7091c0ef0f77460