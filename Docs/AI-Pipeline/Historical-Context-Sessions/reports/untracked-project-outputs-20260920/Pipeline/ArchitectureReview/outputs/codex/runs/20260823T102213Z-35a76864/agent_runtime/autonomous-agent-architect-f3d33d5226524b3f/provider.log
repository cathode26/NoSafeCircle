{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,300p' Tasks/NSC-003.yaml && sed -n '1,280p' Tasks/NSC-023.yaml && sed -n '1,240p' Tasks/NSC-001.yaml && sed -n '1,240p' Pipeline/TaskGraph/evidence/NSC-023/records/BASE-NSC-023-86af98f41ab5.json\"","aggregated_output":"{\r\n  \"schema_version\": \"2.0\",\r\n  \"id\": \"NSC-003\",\r\n  \"contract_revision\": 1,\r\n  \"contract_disposition\": \"active\",\r\n  \"title\": \"Mouse-Directed Player Movement, Shared Pointer Projection, and Movement Restriction\",\r\n  \"reconciliation_key\": \"player-movement\",\r\n  \"kind\": \"implementation\",\r\n  \"type\": \"implementation\",\r\n  \"execution_scope\": \"single_agent\",\r\n  \"execution_reason\": \"All required responsibilities are cohesively owned by one system (PlayerMovement.cs) plus its Input Actions and builder/scene wiring; it is a bounded rewrite of one component's input/locomotion model rather than a multi-system integration.\",\r\n  \"decomposition_state\": \"concrete\",\r\n  \"decomposition_reason\": \"The required behavior (mouse-directed movement via Input System, shared pointer projection, movement-restriction interface, reset entry point) is fully specified by current GDD text without inventing new design.\",\r\n  \"parent\": \"NSC-002\",\r\n  \"depends_on\": [],\r\n  \"exclusive_resources\": [\r\n    \"repo-file:Assets/InputSystem_Actions.inputactions\",\r\n    \"repo-file:Assets/NoSafeCircle/DoorPrototype/Editor/DoorPrototypeSceneBuilder.cs\",\r\n    \"unity-scene:Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\"\r\n  ],\r\n  \"acceptance_criteria\": [\r\n    {\r\n      \"reference\": \"GDD §2 Move and Aim\",\r\n      \"requirement\": \"Movement is mouse-directed: a click sets a destination the wizard walks toward, and holding continues steering toward the current cursor position, consumed through Unity Input System/Input Actions rather than direct hardware polling.\",\r\n      \"criterion_id\": \"AC-001\"\r\n    },\r\n    {\r\n      \"reference\": \"GDD §2 Player Movement ownership\",\r\n      \"requirement\": \"Exposes a shared world-space pointer target produced by projecting the cursor onto the gameplay plane, consumable by cursor-aimed spells and Door/Interaction without those systems independently projecting screen coordinates.\",\r\n      \"criterion_id\": \"AC-002\"\r\n    },\r\n    {\r\n      \"reference\": \"GDD §2 Player Movement ownership; §4 Development Agent Ownership Invariants\",\r\n      \"requirement\": \"Exposes an owner-controlled movement-restriction request/release interface that Charged Fireball can use to restrict movement while charging without Fireball mutating movement internals directly.\",\r\n      \"criterion_id\": \"AC-003\"\r\n    },\r\n    {\r\n      \"reference\": \"GDD §2 Floor-run restart ownership\",\r\n      \"requirement\": \"Exposes an owner-controlled reset entry point that restores player position/movement state to the floor's initial state, consumed by the Floor Run/Restart Orchestrator rather than having position mutated externally.\",\r\n      \"criterion_id\": \"AC-004\"\r\n    },\r\n    {\r\n      \"reference\": \"GDD §2 Victory/input-shutdown ownership; §4 Development Agent Ownership Invariants and final escape/victory coordination\",\r\n      \"requirement\": \"Exposes an owner-controlled gameplay-enable/suspend interface, consumed by the Game Flow/Victory capability, that immediately stops or cancels any in-progress input-driven movement (including an active click-to-destination approach), rejects new movement commands while suspended, and can be re-enabled only through an authorized reset/test flow rather than external mutation of movement internals.\",\r\n      \"criterion_id\": \"AC-005\"\r\n    }\r\n  ],\r\n  \"completion_gates\": [\r\n    {\r\n      \"reference\": \"GDD §2 Move and Aim\",\r\n      \"requirement\": \"Play Mode validation that clicking a location moves the wizard toward it and that holding steers continuously toward the live cursor position.\",\r\n      \"gate_id\": \"VAL-001\"\r\n    },\r\n    {\r\n      \"reference\": \"Victory/input-shutdown ownership\",\r\n      \"requirement\": \"Play Mode check: invoking the suspend interface while movement is active immediately halts the wizard's in-progress movement (including an active click-to-destination approach), and further movement input has no effect until an authorized re-enable/reset flow runs.\",\r\n      \"gate_id\": \"VAL-002\"\r\n    }\r\n  ],\r\n  \"downstream_integration_obligations\": [\r\n    {\r\n      \"reference\": \"GDD §2 Player Movement ownership\",\r\n      \"requirement\": \"Validate that the exposed world-space pointer target is correctly consumable by a cursor-aimed spell or Door/Interaction integration once those systems exist.\",\r\n      \"obligation_id\": \"INT-001\"\r\n    }\r\n  ],\r\n  \"gdd_evidence\": [\r\n    {\r\n      \"reference\": \"GDD §2 Player Actions and Systems — Move and Aim\",\r\n      \"requirement\": \"Mouse-directed movement through the shared Unity Input System/Input Actions layer: click to set a destination or hold to keep steering toward the cursor; Player Movement owns the shared cursor-to-gameplay-plane projection and exposes the resulting world-space pointer target consumed by movement, cursor-aimed spells, and cursor-targeted interactions (Force Wave is the exception).\"\r\n    },\r\n    {\r\n      \"reference\": \"GDD §2 Resources, Feedback, and Failure — Player Movement ownership\",\r\n      \"requirement\": \"Player Movement owns position, locomotion, movement-restriction state, and the shared cursor-to-gameplay-plane projection; runtime input is routed through Input System/Input Actions rather than direct hardware polling; Charged Fireball requests/releases its movement restriction through an owner-controlled Player Movement interface without mutating movement internals.\"\r\n    },\r\n    {\r\n      \"reference\": \"GDD §2 Loss — Floor-run restart ownership\",\r\n      \"requirement\": \"Player Movement/player position is a required reset participant invoked by the Floor Run/Restart Orchestrator through an owner-controlled reset entry point.\"\r\n    },\r\n    {\r\n      \"reference\": \"Section 2 — Victory/input-shutdown ownership bullet\",\r\n      \"requirement\": \"Player Movement, Door/Interaction, Fireball, Frost Field, and Force Wave each expose an owner-controlled gameplay-enable/suspend interface that can immediately stop or cancel their current input-driven activity, reject new gameplay commands while suspended, and be re-enabled by an authorized reset/test flow.\"\r\n    }\r\n  ],\r\n  \"basis\": \"direct_gdd\",\r\n  \"source_scope\": \"required\",\r\n  \"confidence\": \"high\",\r\n  \"notes\": \"Exact movement speed/feel tuning is left to playtesting per GDD and is not part of this item's required acceptance surface.\",\r\n  \"repository_state_at_bootstrap\": \"partial\",\r\n  \"repository_evidence_at_bootstrap\": [\r\n    {\r\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerMovement.cs\",\r\n      \"evidence_type\": \"code\",\r\n      \"observation\": \"Implements only CharacterController-driven WASD movement via direct Keyboard.current polling; no mouse-directed movement, cursor projection, movement-restriction interface, or reset entry point exist.\"\r\n    },\r\n    {\r\n      \"path\": \"Assets/InputSystem_Actions.inputactions\",\r\n      \"evidence_type\": \"project_setting\",\r\n      \"observation\": \"Unmodified stock Unity template action asset; Player map has only WASD/Dpad Move and button actions (Attack/Interact/Crouch/Jump/etc.), no cursor-to-gameplay-plane or click-to-move action, and PlayerMovement.cs does not reference it.\"\r\n    },\r\n    {\r\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\",\r\n      \"evidence_type\": \"scene\",\r\n      \"observation\": \"PlayerMovement.cs (guid 356044e6782dd0641a7e69b0abfa5c4a) is serialized on the Player GameObject, confirming current WASD movement is the integrated state, not merely available via the builder.\"\r\n    }\r\n  ],\r\n  \"provenance\": {\r\n    \"origin\": \"verified_reconciliation_bootstrap\",\r\n    \"source_schema_version\": \"1.0\",\r\n    \"reconciliation_run_id\": \"20260821T193541Z-998ee7b5\",\r\n    \"verification_run_id\": \"20260821T195959Z-43dba5de\",\r\n    \"bootstrap_status_observation\": \"open\",\r\n    \"migration_id\": \"task-contract-schema-v2-20260822-r2\"\r\n  }\r\n}\r\n{\r\n  \"schema_version\": \"2.0\",\r\n  \"id\": \"NSC-023\",\r\n  \"contract_revision\": 1,\r\n  \"contract_disposition\": \"active\",\r\n  \"title\": \"Fixed Isometric Camera\",\r\n  \"reconciliation_key\": \"fixed-isometric-camera\",\r\n  \"kind\": \"implementation\",\r\n  \"type\": \"world-foundation\",\r\n  \"execution_scope\": \"single_agent\",\r\n  \"execution_reason\": \"The fixed-camera behavior is a bounded implementation contract. Historical delivery does not make its execution scope not-applicable; current completion is derived elsewhere.\",\r\n  \"decomposition_state\": \"concrete\",\r\n  \"decomposition_reason\": \"The fixed projection/no-free-rotation behavior is a concrete bounded contract. Delivery state is intentionally separate from decomposition state.\",\r\n  \"parent\": \"NSC-022\",\r\n  \"depends_on\": [],\r\n  \"exclusive_resources\": [],\r\n  \"acceptance_criteria\": [\r\n    {\r\n      \"reference\": \"GDD - Executive Summary / 2.5D Isometric Visual and World Representation\",\r\n      \"requirement\": \"Camera renders the gameplay world using a fixed orthographic 2.5D isometric projection at a consistent dimetric angle.\",\r\n      \"criterion_id\": \"AC-001\"\r\n    },\r\n    {\r\n      \"reference\": \"GDD - 2.5D Isometric Visual and World Representation\",\r\n      \"requirement\": \"No player-controllable free rotation of the world view is exposed; the camera's rotation never changes at runtime.\",\r\n      \"criterion_id\": \"AC-002\"\r\n    }\r\n  ],\r\n  \"completion_gates\": [\r\n    {\r\n      \"reference\": \"Bootstrap repository evidence — DoorPrototypeSceneBuilderTests\",\r\n      \"requirement\": \"Unity validation confirms the canonical camera is orthographic and uses the fixed approved isometric rotation without a runtime rotation controller.\",\r\n      \"gate_id\": \"VAL-001\"\r\n    },\r\n    {\r\n      \"reference\": \"Bootstrap repository evidence — IsometricCameraFollow validation\",\r\n      \"requirement\": \"Unity validation confirms target-follow translation does not change the camera's fixed rotation.\",\r\n      \"gate_id\": \"VAL-002\"\r\n    }\r\n  ],\r\n  \"downstream_integration_obligations\": [\r\n    {\r\n      \"reference\": \"GDD - Camera completion and future integration\",\r\n      \"requirement\": \"Once the Tilemap/SpriteRenderer world-visual foundation exists, validate that the fixed isometric camera framing remains visually compatible with the new visual layer (alignment/sorting check), without reopening the already-satisfied fixed-angle/no-rotation requirement.\",\r\n      \"obligation_id\": \"INT-001\"\r\n    }\r\n  ],\r\n  \"gdd_evidence\": [\r\n    {\r\n      \"reference\": \"GDD - Executive Summary\",\r\n      \"requirement\": \"The camera is fixed, the world is viewed at an angle, and the visible environment is authored as isometric art rather than a free-rotation 3D space.\"\r\n    },\r\n    {\r\n      \"reference\": \"GDD - 2.5D Isometric Visual and World Representation\",\r\n      \"requirement\": \"The camera is fixed in an isometric presentation; the player does not rotate the world view freely.\"\r\n    }\r\n  ],\r\n  \"basis\": \"direct_gdd\",\r\n  \"source_scope\": \"required\",\r\n  \"confidence\": \"high\",\r\n  \"notes\": \"Per current provenance boundary: only the fixed-angle/no-free-rotation requirement is treated as GDD-backed acceptance criteria. The camera's player-follow translation (IsometricCameraFollow) is a valid current implementation detail and is recorded as repository evidence only, since the current GDD does not require player-follow camera behavior.\",\r\n  \"repository_state_at_bootstrap\": \"implemented\",\r\n  \"repository_evidence_at_bootstrap\": [\r\n    {\r\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Editor/DoorPrototypeSceneBuilder.cs\",\r\n      \"evidence_type\": \"code\",\r\n      \"observation\": \"BuildCamera sets camera.orthographic = true, camera.orthographicSize = 8f, and cameraObject.transform.rotation = Quaternion.Euler(30f, -45f, 0f) once; no later code path in the builder modifies camera rotation.\"\r\n    },\r\n    {\r\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scripts/IsometricCameraFollow.cs\",\r\n      \"evidence_type\": \"code\",\r\n      \"observation\": \"LateUpdate only writes transform.position = target.position + offset; rotation is never read or written after Initialize captures the position offset.\"\r\n    },\r\n    {\r\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\",\r\n      \"evidence_type\": \"scene\",\r\n      \"observation\": \"Serialized Main Camera has orthographic: 1, orthographic size: 8, and a wired IsometricCameraFollow component (target + offset {10,10,-10}); no rotation-modifying component is attached.\"\r\n    },\r\n    {\r\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Tests/Editor/DoorPrototypeSceneBuilderTests.cs\",\r\n      \"evidence_type\": \"test\",\r\n      \"observation\": \"Build_MainCamera_IsFixedOrthographicIsometric asserts orthographic mode and rotation equal to Quaternion.Euler(30,-45,0) within 0.01 degrees and absence of any Rotate/Orbit-named component; Build_MainCamera_TranslatesWithPlayerButRotationStaysFixed asserts rotation is unchanged after the player moves and LateUpdate runs.\"\r\n    }\r\n  ],\r\n  \"provenance\": {\r\n    \"origin\": \"verified_reconciliation_bootstrap\",\r\n    \"source_schema_version\": \"1.0\",\r\n    \"reconciliation_run_id\": \"20260821T193541Z-998ee7b5\",\r\n    \"verification_run_id\": \"20260821T195959Z-43dba5de\",\r\n    \"bootstrap_status_observation\": \"complete\",\r\n    \"migration_id\": \"task-contract-schema-v2-20260822-r2\"\r\n  }\r\n}\r\n{\r\n  \"schema_version\": \"2.0\",\r\n  \"id\": \"NSC-001\",\r\n  \"contract_revision\": 1,\r\n  \"contract_disposition\": \"active\",\r\n  \"title\": \"No Safe Circle\",\r\n  \"reconciliation_key\": \"no-safe-circle\",\r\n  \"kind\": \"feature\",\r\n  \"type\": \"root\",\r\n  \"execution_scope\": \"not_applicable\",\r\n  \"execution_reason\": \"Root feature is not directly executable; it exists purely to aggregate the complete work graph.\",\r\n  \"decomposition_state\": \"coarse\",\r\n  \"decomposition_reason\": \"Root organizational feature; all concrete decomposition is represented by domain-specific descendant features/implementations produced across the full set of reconciliation workers.\",\r\n  \"parent\": \"\",\r\n  \"depends_on\": [],\r\n  \"exclusive_resources\": [],\r\n  \"acceptance_criteria\": [\r\n    {\r\n      \"reference\": \"Section 3 - Required Scope, Exclusions, and Stretch Goals\",\r\n      \"requirement\": \"The completed game satisfies the stated Required Scope: one wizard, one handcrafted 2.5D isometric floor with five connected spaces, three spells, two enemy archetypes, mana regeneration, sealed doors, cross-room pursuit, death and restart, essential feedback, and a Windows build.\",\r\n      \"criterion_id\": \"AC-001\"\r\n    }\r\n  ],\r\n  \"completion_gates\": [],\r\n  \"downstream_integration_obligations\": [],\r\n  \"gdd_evidence\": [\r\n    {\r\n      \"reference\": \"Section 1 - Executive Summary\",\r\n      \"requirement\": \"No Safe Circle is a single-player, 2.5D isometric survival action game set on one handcrafted dungeon floor; the player wins by escaping through the final door and loses at zero health.\"\r\n    }\r\n  ],\r\n  \"basis\": \"direct_gdd\",\r\n  \"source_scope\": \"required\",\r\n  \"confidence\": \"medium\",\r\n  \"notes\": \"This worker only directly inspected the global_pipeline domain (delivery/build and non-code/process requirements). Aggregate repository_state of 'partial' reflects that the GDD's own Current Prototype Scene Evidence section confirms a working DoorPrototype scene/script set exists, while the confirmed zero-scene Windows build registration (see windows-build-scene-registration) and the broad required scope described in Section 3 indicate most required systems remain open. Per the feature-aggregate rule, no child repository_evidence is duplicated here; other domain workers' own root-adjacent findings should be reconciled against this at merge time.\",\r\n  \"repository_state_at_bootstrap\": \"partial\",\r\n  \"repository_evidence_at_bootstrap\": [],\r\n  \"provenance\": {\r\n    \"origin\": \"verified_reconciliation_bootstrap\",\r\n    \"source_schema_version\": \"1.0\",\r\n    \"reconciliation_run_id\": \"20260821T193541Z-998ee7b5\",\r\n    \"verification_run_id\": \"20260821T195959Z-43dba5de\",\r\n    \"bootstrap_status_observation\": \"open\",\r\n    \"migration_id\": \"task-contract-schema-v2-20260822-r2\"\r\n  }\r\n}\r\n{\r\n  \"schema_version\": \"1.0\",\r\n  \"record_type\": \"baseline\",\r\n  \"record_id\": \"BASE-NSC-023-86af98f41ab5\",\r\n  \"task_id\": \"NSC-023\",\r\n  \"task_contract\": {\r\n    \"path\": \"Tasks/NSC-023.yaml\",\r\n    \"revision\": 1,\r\n    \"sha256\": \"49d6ef99fab8a4a405d1ef16abaf5f84810fe45f511c618437978579957df88c\"\r\n  },\r\n  \"canon\": {\r\n    \"path\": \"Docs/GDD/No_Safe_Circle_GDD.md\",\r\n    \"sha256\": \"ee2eebd911e92feffc00f7c443873dde31f54e4188244832b2ea018bacba958c\"\r\n  },\r\n  \"validated_state\": {\r\n    \"commit\": \"86af98f41ab53016ef55eca9516cc339a1e4f5d1\",\r\n    \"tree\": \"3e89c4a4879d1bf4179ae48f95b85dee1abc0d4d\"\r\n  },\r\n  \"conformance_surfaces\": [\r\n    {\r\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Editor/DoorPrototypeSceneBui