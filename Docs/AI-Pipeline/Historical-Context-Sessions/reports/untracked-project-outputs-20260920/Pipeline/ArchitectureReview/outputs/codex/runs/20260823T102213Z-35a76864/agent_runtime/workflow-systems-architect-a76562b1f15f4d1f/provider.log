{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,520p' Tasks/NSC-003.yaml\"","aggregated_output":"{\r\n  \"schema_version\": \"2.0\",\r\n  \"id\": \"NSC-003\",\r\n  \"contract_revision\": 1,\r\n  \"contract_disposition\": \"active\",\r\n  \"title\": \"Mouse-Directed Player Movement, Shared Pointer Projection, and Movement Restriction\",\r\n  \"reconciliation_key\": \"player-movement\",\r\n  \"kind\": \"implementation\",\r\n  \"type\": \"implementation\",\r\n  \"execution_scope\": \"single_agent\",\r\n  \"execution_reason\": \"All required responsibilities are cohesively owned by one system (PlayerMovement.cs) plus its Input Actions and builder/scene wiring; it is a bounded rewrite of one component's input/locomotion model rather than a multi-system integration.\",\r\n  \"decomposition_state\": \"concrete\",\r\n  \"decomposition_reason\": \"The required behavior (mouse-directed movement via Input System, shared pointer projection, movement-restriction interface, reset entry point) is fully specified by current GDD text without inventing new design.\",\r\n  \"parent\": \"NSC-002\",\r\n  \"depends_on\": [],\r\n  \"exclusive_resources\": [\r\n    \"repo-file:Assets/InputSystem_Actions.inputactions\",\r\n    \"repo-file:Assets/NoSafeCircle/DoorPrototype/Editor/DoorPrototypeSceneBuilder.cs\",\r\n    \"unity-scene:Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\"\r\n  ],\r\n  \"acceptance_criteria\": [\r\n    {\r\n      \"reference\": \"GDD §2 Move and Aim\",\r\n      \"requirement\": \"Movement is mouse-directed: a click sets a destination the wizard walks toward, and holding continues steering toward the current cursor position, consumed through Unity Input System/Input Actions rather than direct hardware polling.\",\r\n      \"criterion_id\": \"AC-001\"\r\n    },\r\n    {\r\n      \"reference\": \"GDD §2 Player Movement ownership\",\r\n      \"requirement\": \"Exposes a shared world-space pointer target produced by projecting the cursor onto the gameplay plane, consumable by cursor-aimed spells and Door/Interaction without those systems independently projecting screen coordinates.\",\r\n      \"criterion_id\": \"AC-002\"\r\n    },\r\n    {\r\n      \"reference\": \"GDD §2 Player Movement ownership; §4 Development Agent Ownership Invariants\",\r\n      \"requirement\": \"Exposes an owner-controlled movement-restriction request/release interface that Charged Fireball can use to restrict movement while charging without Fireball mutating movement internals directly.\",\r\n      \"criterion_id\": \"AC-003\"\r\n    },\r\n    {\r\n      \"reference\": \"GDD §2 Floor-run restart ownership\",\r\n      \"requirement\": \"Exposes an owner-controlled reset entry point that restores player position/movement state to the floor's initial state, consumed by the Floor Run/Restart Orchestrator rather than having position mutated externally.\",\r\n      \"criterion_id\": \"AC-004\"\r\n    },\r\n    {\r\n      \"reference\": \"GDD §2 Victory/input-shutdown ownership; §4 Development Agent Ownership Invariants and final escape/victory coordination\",\r\n      \"requirement\": \"Exposes an owner-controlled gameplay-enable/suspend interface, consumed by the Game Flow/Victory capability, that immediately stops or cancels any in-progress input-driven movement (including an active click-to-destination approach), rejects new movement commands while suspended, and can be re-enabled only through an authorized reset/test flow rather than external mutation of movement internals.\",\r\n      \"criterion_id\": \"AC-005\"\r\n    }\r\n  ],\r\n  \"completion_gates\": [\r\n    {\r\n      \"reference\": \"GDD §2 Move and Aim\",\r\n      \"requirement\": \"Play Mode validation that clicking a location moves the wizard toward it and that holding steers continuously toward the live cursor position.\",\r\n      \"gate_id\": \"VAL-001\"\r\n    },\r\n    {\r\n      \"reference\": \"Victory/input-shutdown ownership\",\r\n      \"requirement\": \"Play Mode check: invoking the suspend interface while movement is active immediately halts the wizard's in-progress movement (including an active click-to-destination approach), and further movement input has no effect until an authorized re-enable/reset flow runs.\",\r\n      \"gate_id\": \"VAL-002\"\r\n    }\r\n  ],\r\n  \"downstream_integration_obligations\": [\r\n    {\r\n      \"reference\": \"GDD §2 Player Movement ownership\",\r\n      \"requirement\": \"Validate that the exposed world-space pointer target is correctly consumable by a cursor-aimed spell or Door/Interaction integration once those systems exist.\",\r\n      \"obligation_id\": \"INT-001\"\r\n    }\r\n  ],\r\n  \"gdd_evidence\": [\r\n    {\r\n      \"reference\": \"GDD §2 Player Actions and Systems — Move and Aim\",\r\n      \"requirement\": \"Mouse-directed movement through the shared Unity Input System/Input Actions layer: click to set a destination or hold to keep steering toward the cursor; Player Movement owns the shared cursor-to-gameplay-plane projection and exposes the resulting world-space pointer target consumed by movement, cursor-aimed spells, and cursor-targeted interactions (Force Wave is the exception).\"\r\n    },\r\n    {\r\n      \"reference\": \"GDD §2 Resources, Feedback, and Failure — Player Movement ownership\",\r\n      \"requirement\": \"Player Movement owns position, locomotion, movement-restriction state, and the shared cursor-to-gameplay-plane projection; runtime input is routed through Input System/Input Actions rather than direct hardware polling; Charged Fireball requests/releases its movement restriction through an owner-controlled Player Movement interface without mutating movement internals.\"\r\n    },\r\n    {\r\n      \"reference\": \"GDD §2 Loss — Floor-run restart ownership\",\r\n      \"requirement\": \"Player Movement/player position is a required reset participant invoked by the Floor Run/Restart Orchestrator through an owner-controlled reset entry point.\"\r\n    },\r\n    {\r\n      \"reference\": \"Section 2 — Victory/input-shutdown ownership bullet\",\r\n      \"requirement\": \"Player Movement, Door/Interaction, Fireball, Frost Field, and Force Wave each expose an owner-controlled gameplay-enable/suspend interface that can immediately stop or cancel their current input-driven activity, reject new gameplay commands while suspended, and be re-enabled by an authorized reset/test flow.\"\r\n    }\r\n  ],\r\n  \"basis\": \"direct_gdd\",\r\n  \"source_scope\": \"required\",\r\n  \"confidence\": \"high\",\r\n  \"notes\": \"Exact movement speed/feel tuning is left to playtesting per GDD and is not part of this item's required acceptance surface.\",\r\n  \"repository_state_at_bootstrap\": \"partial\",\r\n  \"repository_evidence_at_bootstrap\": [\r\n    {\r\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerMovement.cs\",\r\n      \"evidence_type\": \"code\",\r\n      \"observation\": \"Implements only CharacterController-driven WASD movement via direct Keyboard.current polling; no mouse-directed movement, cursor projection, movement-restriction interface, or reset entry point exist.\"\r\n    },\r\n    {\r\n      \"path\": \"Assets/InputSystem_Actions.inputactions\",\r\n      \"evidence_type\": \"project_setting\",\r\n      \"observation\": \"Unmodified stock Unity template action asset; Player map has only WASD/Dpad Move and button actions (Attack/Interact/Crouch/Jump/etc.), no cursor-to-gameplay-plane or click-to-move action, and PlayerMovement.cs does not reference it.\"\r\n    },\r\n    {\r\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\",\r\n      \"evidence_type\": \"scene\",\r\n      \"observation\": \"PlayerMovement.cs (guid 356044e6782dd0641a7e69b0abfa5c4a) is serialized on the Player GameObject, confirming current WASD movement is the integrated state, not merely available via the builder.\"\r\n    }\r\n  ],\r\n  \"provenance\": {\r\n    \"origin\": \"verified_reconciliation_bootstrap\",\r\n    \"source_schema_version\": \"1.0\",\r\n    \"reconciliation_run_id\": \"20260821T193541Z-998ee7b5\",\r\n    \"verification_run_id\": \"20260821T195959Z-43dba5de\",\r\n    \"bootstrap_status_observation\": \"open\",\r\n    \"migration_id\": \"task-contract-schema-v2-20260822-r2\"\r\n  }\r\n}\r\n","exit_code":0,"status":"completed"}}
