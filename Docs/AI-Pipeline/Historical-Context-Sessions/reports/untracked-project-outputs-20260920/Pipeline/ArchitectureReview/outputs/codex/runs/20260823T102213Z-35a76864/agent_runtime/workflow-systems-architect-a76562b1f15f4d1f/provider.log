{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,glob,os\nrefs=[]\nfor p in glob.glob('Tasks/*.yaml'):\n    d=json.load(open(p,encoding='utf-8-sig'))\n    for r in d.get('exclusive_resources',[]):\n        if r.startswith(('repo-file:','unity-scene:','unity-prefab:')):\n            path=r.split(':',1)[1]\n            refs.append((p,path,os.path.exists(path)))\nfor p,path,exists in refs:\n    if not exists: print(f'{p}: MISSING {path}')\nprint('resource_path_refs',len(refs),'missing',sum(not x[2] for x in refs))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,glob,os\nrefs=[]\nfor p in glob.glob('Tasks/*.yaml'):\n    d=json.load(open(p,encoding='utf-8-sig'))\n    for r in d.get('exclusive_resources',[]):\n        if r.startswith(('repo-file:','unity-scene:','unity-prefab:')):\n            path=r.split(':',1)[1]\n            refs.append((p,path,os.path.exists(path)))\nfor p,path,exists in refs:\n    if not exists: print(f'{p}: MISSING {path}')\nprint('resource_path_refs',len(refs),'missing',sum(not x[2] for x in refs))\nPY\"","aggregated_output":"Tasks/NSC-003.yaml: MISSING Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\nTasks/NSC-004.yaml: MISSING Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\nTasks/NSC-007.yaml: MISSING Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\nTasks/NSC-008.yaml: MISSING Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\nTasks/NSC-009.yaml: MISSING Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\nTasks/NSC-019.yaml: MISSING Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\nTasks/NSC-020.yaml: MISSING Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\nTasks/NSC-021.yaml: MISSING Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\nTasks/NSC-025.yaml: MISSING Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\nTasks/NSC-026.yaml: MISSING Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\nTasks/NSC-032.yaml: MISSING Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\nTasks/NSC-033.yaml: MISSING Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\nTasks/NSC-035.yaml: MISSING Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\nresource_path_refs 36 missing 13\n","exit_code":0,"status":"completed"}}
