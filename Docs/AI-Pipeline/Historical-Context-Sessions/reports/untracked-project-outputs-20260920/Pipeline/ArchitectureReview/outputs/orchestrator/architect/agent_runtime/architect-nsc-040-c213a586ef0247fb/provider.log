{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HjzRuix7wtv56q3HNuoKLw","type":"tool_result","content":"1\tusing System.Linq;\n2\tusing NUnit.Framework;\n3\tusing UnityEditor;\n4\t\n5\tnamespace NoSafeCircle.DoorPrototype.Tests.Editor\n6\t{\n7\t    // Contract mapping: NSC-037 AC-001, AC-002, AC-003.\n8\t    // Reads only live EditorBuildSettings/EditorUserBuildSettings Editor API state; performs no writes or scene loads,\n9\t    // so it cannot dirty ProjectSettings/EditorBuildSettings.asset or any tracked asset.\n10\t    public class WindowsBuildSceneRegistrationTests\n11\t    {\n12\t        private const string CanonicalScenePath = \"Assets/Scenes/DoorPrototype.unity\";\n13\t        private const string NonCanonicalScenePath = \"Assets/Scenes/SampleScene.unity\";\n14\t\n15\t        [Test]\n16\t        public void CanonicalGameplayScene_IsRegisteredAndEnabledInBuildSettings()\n17\t        {\n18\t            var scenes = EditorBuildSettings.scenes;\n19\t            var canonicalEntry = scenes.FirstOrDefault(scene => scene.path == CanonicalScenePath);\n20\t\n21\t            Assert.IsNotNull(canonicalEntry,\n22\t                $\"Expected {CanonicalScenePath} to be registered in Unity Build Settings (AC-001).\");\n23\t            Assert.IsTrue(canonicalEntry.enabled,\n24\t                $\"Expected {CanonicalScenePath} to be enabled in Unity Build Settings (AC-001).\");\n25\t        }\n26\t\n27\t        [Test]\n28\t        public void CanonicalGameplayScene_BuildSettingsGuidMatchesSceneAssetGuid()\n29\t        {\n30\t            var scenes = EditorBuildSettings.scenes;\n31\t            var canonicalEntry = scenes.FirstOrDefault(scene => scene.path == CanonicalScenePath);\n32\t            Assert.IsNotNull(canonicalEntry,\n33\t                $\"Expected {CanonicalScenePath} to be registered in Unity Build Settings (AC-001).\");\n34\t\n35\t            var assetGuid = AssetDatabase.AssetPathToGUID(CanonicalScenePath);\n36\t            Assert.AreEqual(assetGuid, canonicalEntry.guid.ToString(),\n37\t                \"The registered Build Settings scene GUID must match the canonical scene asset's own GUID, \" +\n38\t                \"so the entry does not silently drift from the actual scene asset (AC-001).\");\n39\t        }\n40\t\n41\t        [Test]\n42\t        public void NonCanonicalSampleScene_IsNotRegisteredInBuildSettings()\n43\t        {\n44\t            var scenes = EditorBuildSettings.scenes;\n45\t            var sampleSceneEntry = scenes.FirstOrDefault(scene => scene.path == NonCanonicalScenePath);\n46\t\n47\t            Assert.IsNull(sampleSceneEntry,\n48\t                $\"{NonCanonicalScenePath} is non-canonical and must not be registered as a substitute for the \" +\n49\t                \"canonical gameplay scene (AC-003).\");\n50\t        }\n51\t\n52\t        [Test]\n53\t        public void ActiveBuildTarget_IsWindowsStandalone()\n54\t        {\n55\t            var activeTarget = EditorUserBuildSettings.activeBuildTarget;\n56\t\n57\t            Assert.That(activeTarget,\n58\t                Is.EqualTo(BuildTarget.StandaloneWindows64).Or.EqualTo(BuildTarget.StandaloneWindows),\n59\t                \"Windows Standalone must be configured as the active/target build platform (AC-002). \" +\n60\t                \"Unity's active build target is local Editor/UserSettings state that is intentionally excluded \" +\n61\t                \"from version control (see .gitignore), so this validation run must itself be invoked against an \" +\n62\t                \"Editor session already targeting Windows Standalone (for example via `-buildTarget \" +\n63\t                \"StandaloneWindows64`) for this assertion to be meaningful.\");\n64\t        }\n65\t    }\n66\t}\n67\t"}]},"parent_tool_use_id":null,"session_id":"fea62c35-9f6f-442a-af18-7c3971bc0dbc","uuid":"5c545113-e9a3-4d34-85cb-9815f5c10d21","timestamp":"2026-09-01T22:03:28.483Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/Assets/NoSafeCircle/DoorPrototype/Tests/Editor/WindowsBuildSceneRegistrationTests.cs","content":"using System.Linq;\nusing NUnit.Framework;\nusing UnityEditor;\n\nnamespace NoSafeCircle.DoorPrototype.Tests.Editor\n{\n    // Contract mapping: NSC-037 AC-001, AC-002, AC-003.\n    // Reads only live EditorBuildSettings/EditorUserBuildSettings Editor API state; performs no writes or scene loads,\n    // so it cannot dirty ProjectSettings/EditorBuildSettings.asset or any tracked asset.\n    public class WindowsBuildSceneRegistrationTests\n    {\n        private const string CanonicalScenePath = \"Assets/Scenes/DoorPrototype.unity\";\n        private const string NonCanonicalScenePath = \"Assets/Scenes/SampleScene.unity\";\n\n        [Test]\n        public void CanonicalGameplayScene_IsRegisteredAndEnabledInBuildSettings()\n        {\n            var scenes = EditorBuildSettings.scenes;\n            var canonicalEntry = scenes.FirstOrDefault(scene => scene.path == CanonicalScenePath);\n\n            Assert.IsNotNull(canonicalEntry,\n                $\"Expected {CanonicalScenePath} to be registered in Unity Build Settings (AC-001).\");\n            Assert.IsTrue(canonicalEntry.enabled,\n                $\"Expected {CanonicalScenePath} to be enabled in Unity Build Settings (AC-001).\");\n        }\n\n        [Test]\n        public void CanonicalGameplayScene_BuildSettingsGuidMatchesSceneAssetGuid()\n        {\n            var scenes = EditorBuildSettings.scenes;\n            var canonicalEntry = scenes.FirstOrDefault(scene => scene.path == CanonicalScenePath);\n            Assert.IsNotNull(canonicalEntry,\n                $\"Expected {CanonicalScenePath} to be registered in Unity Build Settings (AC-001).\");\n\n            var assetGuid = AssetDatabase.AssetPathToGUID(CanonicalScenePath);\n            Assert.AreEqual(assetGuid, canonicalEntry.guid.ToString(),\n                \"The registered Build Settings scene GUID must match the canonical scene asset's own GUID, \" +\n                \"so the entry does not silently drift from the actual scene asset (AC-001).\");\n        }\n\n        [Test]\n        public void NonCanonicalSampleScene_IsNotRegisteredInBuildSettings()\n        {\n            var scenes = EditorBuildSettings.scenes;\n            var sampleSceneEntry = scenes.FirstOrDefault(scene => scene.path == NonCanonicalScenePath);\n\n            Assert.IsNull(sampleSceneEntry,\n                $\"{NonCanonicalScenePath} is non-canonical and must not be registered as a substitute for the \" +\n                \"canonical gameplay scene (AC-003).\");\n        }\n\n        [Test]\n        public void ActiveBuildTarget_IsWindowsStandalone()\n        {\n            var activeTarget = EditorUserBuildSettings.activeBuildTarget;\n\n            Assert.That(activeTarget,\n                Is.EqualTo(BuildTarget.StandaloneWindows64).Or.EqualTo(BuildTarget.StandaloneWindows),\n                \"Windows Standalone must be configured as the active/target build platform (AC-002). \" +\n                \"Unity's active build target is local Editor/UserSettings state that is intentionally excluded \" +\n                \"from version control (see .gitignore), so this validation run must itself be invoked against an \" +\n                \"Editor session already targeting Windows Standalone (for example via `-buildTarget \" +\n                \"StandaloneWindows64`) for this assertion to be meaningful.\");\n        }\n    }\n}\n","numLines":67,"startLine":1,"totalLines":67}}}
