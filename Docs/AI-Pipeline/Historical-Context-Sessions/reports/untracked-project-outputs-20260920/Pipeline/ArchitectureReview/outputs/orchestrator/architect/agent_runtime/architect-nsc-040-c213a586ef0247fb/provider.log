{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KAJyEPsph92iKbPGm4FHkJ","type":"tool_result","content":"1\tusing System.IO;\n2\tusing System.Reflection;\n3\tusing NUnit.Framework;\n4\tusing UnityEditor;\n5\tusing UnityEditor.SceneManagement;\n6\tusing UnityEngine;\n7\tusing UnityEngine.SceneManagement;\n8\t\n9\tnamespace NoSafeCircle.DoorPrototype.Tests.Editor\n10\t{\n11\t    public class CommittedSceneCameraConformanceTests\n12\t    {\n13\t        private const string CanonicalScenePath = \"Assets/Scenes/DoorPrototype.unity\";\n14\t\n15\t        [SetUp]\n16\t        public void SetUp()\n17\t        {\n18\t            EditorSceneManager.NewScene(NewSceneSetup.EmptyScene, NewSceneMode.Single);\n19\t        }\n20\t\n21\t        [TearDown]\n22\t        public void TearDown()\n23\t        {\n24\t            EditorSceneManager.NewScene(NewSceneSetup.EmptyScene, NewSceneMode.Single);\n25\t        }\n26\t\n27\t        [Test]\n28\t        public void CommittedScene_MainCamera_IsFixedOrthographicIsometric()\n29\t        {\n30\t            var bytesBefore = File.ReadAllBytes(CanonicalScenePath);\n31\t            Scene openedScene = default;\n32\t\n33\t            try\n34\t            {\n35\t                openedScene = EditorSceneManager.OpenScene(CanonicalScenePath, OpenSceneMode.Additive);\n36\t                var cameraObject = FindInSceneRoots(openedScene, \"Main Camera\");\n37\t                var player = FindInSceneRoots(openedScene, \"Player\");\n38\t\n39\t                Assert.IsNotNull(cameraObject, \"Expected Main Camera in the committed scene.\");\n40\t                Assert.IsNotNull(player, \"Expected Player in the committed scene.\");\n41\t\n42\t                var camera = cameraObject.GetComponent<Camera>();\n43\t                Assert.IsNotNull(camera, \"Expected a Camera component on Main Camera.\");\n44\t                Assert.IsTrue(camera.orthographic, \"The committed camera must be orthographic.\");\n45\t                Assert.Less(Quaternion.Angle(Quaternion.Euler(30f, -45f, 0f), camera.transform.rotation), 0.01f,\n46\t                    \"The committed camera must use the approved fixed isometric rotation.\");\n47\t\n48\t                var follow = cameraObject.GetComponent<IsometricCameraFollow>();\n49\t                Assert.IsNotNull(follow, \"Expected IsometricCameraFollow on the committed Main Camera.\");\n50\t                var target = new SerializedObject(follow).FindProperty(\"target\").objectReferenceValue as Transform;\n51\t                Assert.AreSame(player.transform, target,\n52\t                    \"The follow target must be the Player from the same committed scene.\");\n53\t\n54\t                foreach (var behaviour in cameraObject.GetComponents<Behaviour>())\n55\t                {\n56\t                    var componentName = behaviour.GetType().Name;\n57\t                    Assert.IsFalse(componentName.Contains(\"Rotate\") || componentName.Contains(\"Orbit\"),\n58\t                        $\"Main Camera must not have a free-rotation component; found {componentName}.\");\n59\t                }\n60\t            }\n61\t            finally\n62\t            {\n63\t                if (openedScene.IsValid() && openedScene.isLoaded)\n64\t                {\n65\t                    EditorSceneManager.CloseScene(openedScene, true);\n66\t                }\n67\t\n68\t                CollectionAssert.AreEqual(bytesBefore, File.ReadAllBytes(CanonicalScenePath),\n69\t                    \"Committed-scene conformance inspection must not change canonical scene bytes.\");\n70\t            }\n71\t        }\n72\t\n73\t        [Test]\n74\t        public void CommittedScene_MainCamera_TranslatesWithPlayerWithoutRotating()\n75\t        {\n76\t            var bytesBefore = File.ReadAllBytes(CanonicalScenePath);\n77\t            Scene openedScene = default;\n78\t\n79\t            try\n80\t            {\n81\t                openedScene = EditorSceneManager.OpenScene(CanonicalScenePath, OpenSceneMode.Additive);\n82\t                var cameraObject = FindInSceneRoots(openedScene, \"Main Camera\");\n83\t                var player = FindInSceneRoots(openedScene, \"Player\");\n84\t\n85\t                Assert.IsNotNull(cameraObject, \"Expected Main Camera in the committed scene.\");\n86\t                Assert.IsNotNull(player, \"Expected Player in the committed scene.\");\n87\t                var follow = cameraObject.GetComponent<IsometricCameraFollow>();\n88\t                Assert.IsNotNull(follow, \"Expected IsometricCameraFollow on the committed Main Camera.\");\n89\t\n90\t                var rotationBefore = cameraObject.transform.rotation;\n91\t                var offsetBefore = cameraObject.transform.position - player.transform.position;\n92\t                player.transform.position += new Vector3(5f, 0f, 3f);\n93\t\n94\t                var lateUpdate = typeof(IsometricCameraFollow).GetMethod(\"LateUpdate\",\n95\t                    BindingFlags.NonPublic | BindingFlags.Instance);\n96\t                Assert.IsNotNull(lateUpdate, \"Expected the established private LateUpdate follow hook.\");\n97\t                lateUpdate.Invoke(follow, null);\n98\t\n99\t                Assert.AreEqual(offsetBefore, cameraObject.transform.position - player.transform.position,\n100\t                    \"Camera must preserve its camera-to-player offset while following.\");\n101\t                Assert.AreEqual(rotationBefore, cameraObject.transform.rotation,\n102\t                    \"Camera rotation must remain fixed while following the Player.\");\n103\t            }\n104\t            finally\n105\t            {\n106\t                if (openedScene.IsValid() && openedScene.isLoaded)\n107\t                {\n108\t                    EditorSceneManager.CloseScene(openedScene, true);\n109\t                }\n110\t\n111\t                CollectionAssert.AreEqual(bytesBefore, File.ReadAllBytes(CanonicalScenePath),\n112\t                    \"Committed-scene conformance inspection must not change canonical scene bytes.\");\n113\t            }\n114\t        }\n115\t\n116\t        private static GameObject FindInSceneRoots(Scene scene, string objectName)\n117\t        {\n118\t            foreach (var root in scene.GetRootGameObjects())\n119\t            {\n120\t                if (root.name == objectName) return root;\n121\t\n122\t                var transforms = root.GetComponentsInChildren<Transform>(true);\n123\t                foreach (var candidate in transforms)\n124\t                {\n125\t                    if (candidate.name == objectName) return candidate.gameObject;\n126\t                }\n127\t            }\n128\t\n129\t            return null;\n130\t        }\n131\t    }\n132\t}\n133\t"}]},"parent_tool_use_id":null,"session_id":"fea62c35-9f6f-442a-af18-7c3971bc0dbc","uuid":"72b655e6-22fb-4897-a800-19df6e2dc3db","timestamp":"2026-09-01T22:03:29.034Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/Assets/NoSafeCircle/DoorPrototype/Tests/Editor/CommittedSceneCameraConformanceTests.cs","content":"using System.IO;\nusing System.Reflection;\nusing NUnit.Framework;\nusing UnityEditor;\nusing UnityEditor.SceneManagement;\nusing UnityEngine;\nusing UnityEngine.SceneManagement;\n\nnamespace NoSafeCircle.DoorPrototype.Tests.Editor\n{\n    public class CommittedSceneCameraConformanceTests\n    {\n        private const string CanonicalScenePath = \"Assets/Scenes/DoorPrototype.unity\";\n\n        [SetUp]\n        public void SetUp()\n        {\n            EditorSceneManager.NewScene(NewSceneSetup.EmptyScene, NewSceneMode.Single);\n        }\n\n        [TearDown]\n        public void TearDown()\n        {\n            EditorSceneManager.NewScene(NewSceneSetup.EmptyScene, NewSceneMode.Single);\n        }\n\n        [Test]\n        public void CommittedScene_MainCamera_IsFixedOrthographicIsometric()\n        {\n            var bytesBefore = File.ReadAllBytes(CanonicalScenePath);\n            Scene openedScene = default;\n\n            try\n            {\n                openedScene = EditorSceneManager.OpenScene(CanonicalScenePath, OpenSceneMode.Additive);\n                var cameraObject = FindInSceneRoots(openedScene, \"Main Camera\");\n                var player = FindInSceneRoots(openedScene, \"Player\");\n\n                Assert.IsNotNull(cameraObject, \"Expected Main Camera in the committed scene.\");\n                Assert.IsNotNull(player, \"Expected Player in the committed scene.\");\n\n                var camera = cameraObject.GetComponent<Camera>();\n                Assert.IsNotNull(camera, \"Expected a Camera component on Main Camera.\");\n                Assert.IsTrue(camera.orthographic, \"The committed camera must be orthographic.\");\n                Assert.Less(Quaternion.Angle(Quaternion.Euler(30f, -45f, 0f), camera.transform.rotation), 0.01f,\n                    \"The committed camera must use the approved fixed isometric rotation.\");\n\n                var follow = cameraObject.GetComponent<IsometricCameraFollow>();\n                Assert.IsNotNull(follow, \"Expected IsometricCameraFollow on the committed Main Camera.\");\n                var target = new SerializedObject(follow).FindProperty(\"target\").objectReferenceValue as Transform;\n                Assert.AreSame(player.transform, target,\n                    \"The follow target must be the Player from the same committed scene.\");\n\n                foreach (var behaviour in cameraObject.GetComponents<Behaviour>())\n                {\n                    var componentName = behaviour.GetType().Name;\n                    Assert.IsFalse(componentName.Contains(\"Rotate\") || componentName.Contains(\"Orbit\"),\n                        $\"Main Camera must not have a free-rotation component; found {componentName}.\");\n                }\n            }\n            finally\n            {\n                if (openedScene.IsValid() && openedScene.isLoaded)\n                {\n                    EditorSceneManager.CloseScene(openedScene, true);\n                }\n\n                CollectionAssert.AreEqual(bytesBefore, File.ReadAllBytes(CanonicalScenePath),\n                    \"Committed-scene conformance inspection must not change canonical scene bytes.\");\n            }\n        }\n\n        [Test]\n        public void CommittedScene_MainCamera_TranslatesWithPlayerWithoutRotating()\n        {\n            var bytesBefore = File.ReadAllBytes(CanonicalScenePath);\n            Scene openedScene = default;\n\n            try\n            {\n                openedScene = EditorSceneManager.OpenScene(CanonicalScenePath, OpenSceneMode.Additive);\n                var cameraObject = FindInSceneRoots(openedScene, \"Main Camera\");\n                var player = FindInSceneRoots(openedScene, \"Player\");\n\n                Assert.IsNotNull(cameraObject, \"Expected Main Camera in the committed scene.\");\n                Assert.IsNotNull(player, \"Expected Player in the committed scene.\");\n                var follow = cameraObject.GetComponent<IsometricCameraFollow>();\n                Assert.IsNotNull(follow, \"Expected IsometricCameraFollow on the committed Main Camera.\");\n\n                var rotationBefore = cameraObject.transform.rotation;\n                var offsetBefore = cameraObject.transform.position - player.transform.position;\n                player.transform.position += new Vector3(5f, 0f, 3f);\n\n                var lateUpdate = typeof(IsometricCameraFollow).GetMethod(\"LateUpdate\",\n                    BindingFlags.NonPublic | BindingFlags.Instance);\n                Assert.IsNotNull(lateUpdate, \"Expected the established private LateUpdate follow hook.\");\n                lateUpdate.Invoke(follow, null);\n\n                Assert.AreEqual(offsetBefore, cameraObject.transform.position - player.transform.position,\n                    \"Camera must preserve its camera-to-player offset while following.\");\n                Assert.AreEqual(rotationBefore, cameraObject.transform.rotation,\n                    \"Camera rotation must remain fixed while following the Player.\");\n            }\n            finally\n            {\n                if (openedScene.IsValid() && openedScene.isLoaded)\n                {\n                    EditorSceneManager.CloseScene(openedScene, true);\n                }\n\n                CollectionAssert.AreEqual(bytesBefore, File.ReadAllBytes(CanonicalScenePath),\n                    \"Committed-scene conformance inspection must not change canonical scene bytes.\");\n            }\n        }\n\n        private static GameObject FindInSceneRoots(Scene scene, string objectName)\n        {\n            foreach (var root in scene.GetRootGameObjects())\n            {\n                if (root.name == objectName) return root;\n\n                var transforms = root.GetComponentsInChildren<Transform>(true);\n                foreach (var candidate in transforms)\n                {\n                    if (candidate.name == objectName) return candidate.gameObject;\n                }\n            }\n\n            return null;\n        }\n    }\n}\n","numLines":133,"startLine":1,"totalLines":133}}}
