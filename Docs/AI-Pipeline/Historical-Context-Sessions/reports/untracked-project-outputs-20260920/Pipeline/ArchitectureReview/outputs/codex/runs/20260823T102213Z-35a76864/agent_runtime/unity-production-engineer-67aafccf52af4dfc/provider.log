{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"git ls-files | rg '(__pycache__|\\\\.pyc\"'$|ArchitectureReview/(outputs|evidence))'\"' | sed -n '1,160p'; sed -n '1,300p' Tasks/NSC-003.yaml; sed -n '1,280p' Pipeline/TaskGraph/TASK_CONTRACT_SCHEMA_V2.md; sed -n '1,300p' Pipeline/TaskGraph/README.md; sed -n '1,240p' Pipeline/TaskExecution/README.md; sed -n '1,260p' Pipeline/AgentRuntime/README.md\"","aggregated_output":"Pipeline/ArchitectureReview/evidence/20260821T222222Z-40fdf9ce/adversarial_critique.json\nPipeline/ArchitectureReview/evidence/20260821T222222Z-40fdf9ce/manifest.json\nPipeline/ArchitectureReview/evidence/20260821T222222Z-40fdf9ce/model_assignments.json\nPipeline/ArchitectureReview/evidence/20260821T222222Z-40fdf9ce/reviews/adversarial_qa.json\nPipeline/ArchitectureReview/evidence/20260821T222222Z-40fdf9ce/reviews/autonomous_agent_architect.json\nPipeline/ArchitectureReview/evidence/20260821T222222Z-40fdf9ce/reviews/game_producer.json\nPipeline/ArchitectureReview/evidence/20260821T222222Z-40fdf9ce/reviews/game_technical_director.json\nPipeline/ArchitectureReview/evidence/20260821T222222Z-40fdf9ce/reviews/llm_reliability_engineer.json\nPipeline/ArchitectureReview/evidence/20260821T222222Z-40fdf9ce/reviews/unity_production_engineer.json\nPipeline/ArchitectureReview/evidence/20260821T222222Z-40fdf9ce/reviews/workflow_systems_architect.json\nPipeline/ArchitectureReview/evidence/20260821T222222Z-40fdf9ce/reviews/yagni_complexity_critic.json\nPipeline/ArchitectureReview/evidence/20260821T222222Z-40fdf9ce/synthesis.json\nPipeline/ArchitectureReview/outputs/.gitignore\n{\r\n  \"schema_version\": \"2.0\",\r\n  \"id\": \"NSC-003\",\r\n  \"contract_revision\": 1,\r\n  \"contract_disposition\": \"active\",\r\n  \"title\": \"Mouse-Directed Player Movement, Shared Pointer Projection, and Movement Restriction\",\r\n  \"reconciliation_key\": \"player-movement\",\r\n  \"kind\": \"implementation\",\r\n  \"type\": \"implementation\",\r\n  \"execution_scope\": \"single_agent\",\r\n  \"execution_reason\": \"All required responsibilities are cohesively owned by one system (PlayerMovement.cs) plus its Input Actions and builder/scene wiring; it is a bounded rewrite of one component's input/locomotion model rather than a multi-system integration.\",\r\n  \"decomposition_state\": \"concrete\",\r\n  \"decomposition_reason\": \"The required behavior (mouse-directed movement via Input System, shared pointer projection, movement-restriction interface, reset entry point) is fully specified by current GDD text without inventing new design.\",\r\n  \"parent\": \"NSC-002\",\r\n  \"depends_on\": [],\r\n  \"exclusive_resources\": [\r\n    \"repo-file:Assets/InputSystem_Actions.inputactions\",\r\n    \"repo-file:Assets/NoSafeCircle/DoorPrototype/Editor/DoorPrototypeSceneBuilder.cs\",\r\n    \"unity-scene:Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\"\r\n  ],\r\n  \"acceptance_criteria\": [\r\n    {\r\n      \"reference\": \"GDD §2 Move and Aim\",\r\n      \"requirement\": \"Movement is mouse-directed: a click sets a destination the wizard walks toward, and holding continues steering toward the current cursor position, consumed through Unity Input System/Input Actions rather than direct hardware polling.\",\r\n      \"criterion_id\": \"AC-001\"\r\n    },\r\n    {\r\n      \"reference\": \"GDD §2 Player Movement ownership\",\r\n      \"requirement\": \"Exposes a shared world-space pointer target produced by projecting the cursor onto the gameplay plane, consumable by cursor-aimed spells and Door/Interaction without those systems independently projecting screen coordinates.\",\r\n      \"criterion_id\": \"AC-002\"\r\n    },\r\n    {\r\n      \"reference\": \"GDD §2 Player Movement ownership; §4 Development Agent Ownership Invariants\",\r\n      \"requirement\": \"Exposes an owner-controlled movement-restriction request/release interface that Charged Fireball can use to restrict movement while charging without Fireball mutating movement internals directly.\",\r\n      \"criterion_id\": \"AC-003\"\r\n    },\r\n    {\r\n      \"reference\": \"GDD §2 Floor-run restart ownership\",\r\n      \"requirement\": \"Exposes an owner-controlled reset entry point that restores player position/movement state to the floor's initial state, consumed by the Floor Run/Restart Orchestrator rather than having position mutated externally.\",\r\n      \"criterion_id\": \"AC-004\"\r\n    },\r\n    {\r\n      \"reference\": \"GDD §2 Victory/input-shutdown ownership; §4 Development Agent Ownership Invariants and final escape/victory coordination\",\r\n      \"requirement\": \"Exposes an owner-controlled gameplay-enable/suspend interface, consumed by the Game Flow/Victory capability, that immediately stops or cancels any in-progress input-driven movement (including an active click-to-destination approach), rejects new movement commands while suspended, and can be re-enabled only through an authorized reset/test flow rather than external mutation of movement internals.\",\r\n      \"criterion_id\": \"AC-005\"\r\n    }\r\n  ],\r\n  \"completion_gates\": [\r\n    {\r\n      \"reference\": \"GDD §2 Move and Aim\",\r\n      \"requirement\": \"Play Mode validation that clicking a location moves the wizard toward it and that holding steers continuously toward the live cursor position.\",\r\n      \"gate_id\": \"VAL-001\"\r\n    },\r\n    {\r\n      \"reference\": \"Victory/input-shutdown ownership\",\r\n      \"requirement\": \"Play Mode check: invoking the suspend interface while movement is active immediately halts the wizard's in-progress movement (including an active click-to-destination approach), and further movement input has no effect until an authorized re-enable/reset flow runs.\",\r\n      \"gate_id\": \"VAL-002\"\r\n    }\r\n  ],\r\n  \"downstream_integration_obligations\": [\r\n    {\r\n      \"reference\": \"GDD §2 Player Movement ownership\",\r\n      \"requirement\": \"Validate that the exposed world-space pointer target is correctly consumable by a cursor-aimed spell or Door/Interaction integration once those systems exist.\",\r\n      \"obligation_id\": \"INT-001\"\r\n    }\r\n  ],\r\n  \"gdd_evidence\": [\r\n    {\r\n      \"reference\": \"GDD §2 Player Actions and Systems — Move and Aim\",\r\n      \"requirement\": \"Mouse-directed movement through the shared Unity Input System/Input Actions layer: click to set a destination or hold to keep steering toward the cursor; Player Movement owns the shared cursor-to-gameplay-plane projection and exposes the resulting world-space pointer target consumed by movement, cursor-aimed spells, and cursor-targeted interactions (Force Wave is the exception).\"\r\n    },\r\n    {\r\n      \"reference\": \"GDD §2 Resources, Feedback, and Failure — Player Movement ownership\",\r\n      \"requirement\": \"Player Movement owns position, locomotion, movement-restriction state, and the shared cursor-to-gameplay-plane projection; runtime input is routed through Input System/Input Actions rather than direct hardware polling; Charged Fireball requests/releases its movement restriction through an owner-controlled Player Movement interface without mutating movement internals.\"\r\n    },\r\n    {\r\n      \"reference\": \"GDD §2 Loss — Floor-run restart ownership\",\r\n      \"requirement\": \"Player Movement/player position is a required reset participant invoked by the Floor Run/Restart Orchestrator through an owner-controlled reset entry point.\"\r\n    },\r\n    {\r\n      \"reference\": \"Section 2 — Victory/input-shutdown ownership bullet\",\r\n      \"requirement\": \"Player Movement, Door/Interaction, Fireball, Frost Field, and Force Wave each expose an owner-controlled gameplay-enable/suspend interface that can immediately stop or cancel their current input-driven activity, reject new gameplay commands while suspended, and be re-enabled by an authorized reset/test flow.\"\r\n    }\r\n  ],\r\n  \"basis\": \"direct_gdd\",\r\n  \"source_scope\": \"required\",\r\n  \"confidence\": \"high\",\r\n  \"notes\": \"Exact movement speed/feel tuning is left to playtesting per GDD and is not part of this item's required acceptance surface.\",\r\n  \"repository_state_at_bootstrap\": \"partial\",\r\n  \"repository_evidence_at_bootstrap\": [\r\n    {\r\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerMovement.cs\",\r\n      \"evidence_type\": \"code\",\r\n      \"observation\": \"Implements only CharacterController-driven WASD movement via direct Keyboard.current polling; no mouse-directed movement, cursor projection, movement-restriction interface, or reset entry point exist.\"\r\n    },\r\n    {\r\n      \"path\": \"Assets/InputSystem_Actions.inputactions\",\r\n      \"evidence_type\": \"project_setting\",\r\n      \"observation\": \"Unmodified stock Unity template action asset; Player map has only WASD/Dpad Move and button actions (Attack/Interact/Crouch/Jump/etc.), no cursor-to-gameplay-plane or click-to-move action, and PlayerMovement.cs does not reference it.\"\r\n    },\r\n    {\r\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\",\r\n      \"evidence_type\": \"scene\",\r\n      \"observation\": \"PlayerMovement.cs (guid 356044e6782dd0641a7e69b0abfa5c4a) is serialized on the Player GameObject, confirming current WASD movement is the integrated state, not merely available via the builder.\"\r\n    }\r\n  ],\r\n  \"provenance\": {\r\n    \"origin\": \"verified_reconciliation_bootstrap\",\r\n    \"source_schema_version\": \"1.0\",\r\n    \"reconciliation_run_id\": \"20260821T193541Z-998ee7b5\",\r\n    \"verification_run_id\": \"20260821T195959Z-43dba5de\",\r\n    \"bootstrap_status_observation\": \"open\",\r\n    \"migration_id\": \"task-contract-schema-v2-20260822-r2\"\r\n  }\r\n}\r\n# Task Contract Schema 2.0\r\n\r\n## Purpose\r\n\r\n`Tasks/*.yaml` defines approved work contracts. It does not store current execution, delivery, validation, or completion truth.\r\n\r\nSchema 2.0 removes the v1 top-level `status` field because a mutable YAML value could previously unlock downstream work without proving that implementation was integrated, validated, current against canon, or still valid after later changes.\r\n\r\nThe files remain in the deterministic JSON-compatible YAML 1.2 subset used by the existing TaskGraph tooling.\r\n\r\n## Authority boundary\r\n\r\nA v2 task contract may define:\r\n\r\n- stable `NSC-###` identity and `reconciliation_key`;\r\n- contract revision and disposition;\r\n- title, kind, type, parent, dependencies, and exclusive resources;\r\n- execution/decomposition scope as properties of the work itself;\r\n- acceptance criteria;\r\n- completion gates;\r\n- downstream integration obligations;\r\n- GDD and repository evidence captured when the contract was created;\r\n- per-contract provenance.\r\n\r\nA v2 task contract may not claim:\r\n\r\n- that work is currently ready;\r\n- that a worker owns or is running the task;\r\n- that implementation is currently complete;\r\n- that validation passed;\r\n- that a result is merged;\r\n- that later GDD or code changes did not invalidate prior evidence.\r\n\r\nThose states will be derived later from task contracts, current canon, attempt journals, integrated Git state, delivery/revalidation evidence, and human decisions.\r\n\r\n## Required top-level fields\r\n\r\n```json\r\n{\r\n  \"schema_version\": \"2.0\",\r\n  \"id\": \"NSC-003\",\r\n  \"contract_revision\": 1,\r\n  \"contract_disposition\": \"active\",\r\n  \"title\": \"...\",\r\n  \"reconciliation_key\": \"...\",\r\n  \"kind\": \"implementation\",\r\n  \"type\": \"...\",\r\n  \"execution_scope\": \"single_agent\",\r\n  \"execution_reason\": \"...\",\r\n  \"decomposition_state\": \"concrete\",\r\n  \"decomposition_reason\": \"...\",\r\n  \"parent\": \"NSC-002\",\r\n  \"depends_on\": [],\r\n  \"exclusive_resources\": [],\r\n  \"acceptance_criteria\": [],\r\n  \"completion_gates\": [],\r\n  \"downstream_integration_obligations\": [],\r\n  \"gdd_evidence\": [],\r\n  \"basis\": \"direct_gdd\",\r\n  \"source_scope\": \"required\",\r\n  \"confidence\": \"high\",\r\n  \"notes\": \"\",\r\n  \"repository_state_at_bootstrap\": \"missing\",\r\n  \"repository_evidence_at_bootstrap\": [],\r\n  \"provenance\": {}\r\n}\r\n```\r\n\r\n## Contract revision\r\n\r\n`contract_revision` is a positive integer. Increase it only when the approved meaning of the work contract changes. Delivery/conformance evidence must eventually bind to an exact contract revision and hash.\r\n\r\n## Contract disposition\r\n\r\nAllowed values:\r\n\r\n- `active` — the contract is still applicable;\r\n- `superseded` — a newer active task contract replaces it; `superseded_by` is required;\r\n- `cancelled` — human authority intentionally cancelled the contract.\r\n\r\nDisposition describes the applicability of the contract. It is not implementation status.\r\n\r\n## Numbered acceptance and validation entries\r\n\r\nAcceptance criteria use stable contract-local IDs:\r\n\r\n```json\r\n{\r\n  \"criterion_id\": \"AC-001\",\r\n  \"reference\": \"GDD section\",\r\n  \"requirement\": \"Required behavior\"\r\n}\r\n```\r\n\r\nCompletion gates use:\r\n\r\n```json\r\n{\r\n  \"gate_id\": \"VAL-001\",\r\n  \"reference\": \"Validation source\",\r\n  \"requirement\": \"Evidence required when this task is delivered\"\r\n}\r\n```\r\n\r\nDownstream integration obligations use:\r\n\r\n```json\r\n{\r\n  \"obligation_id\": \"INT-001\",\r\n  \"reference\": \"Future integration source\",\r\n  \"requirement\": \"Check owned by later integration work\"\r\n}\r\n```\r\n\r\nA completion gate must be achievable when the task is delivered. A check that can only occur after another future system exists belongs under `downstream_integration_obligations` and should later be assigned to the relevant integration task.\r\n\r\n## Provenance\r\n\r\nThe initial migration records bootstrap history like this:\r\n\r\n```json\r\n{\r\n  \"origin\": \"verified_reconciliation_bootstrap\",\r\n  \"source_schema_version\": \"1.0\",\r\n  \"reconciliation_run_id\": \"...\",\r\n  \"verification_run_id\": \"...\",\r\n  \"bootstrap_status_observation\": \"open\",\r\n  \"migration_id\": \"task-contract-schema-v2-20260822\"\r\n}\r\n```\r\n\r\n`bootstrap_status_observation` is historical context only. It is deliberately nested under provenance and cannot authorize execution or prove current conformance.\r\n\r\nFuture task contracts may have different provenance. Schema 2.0 no longer requires every task to come from one bootstrap run.\r\n\r\n## Forbidden v1 operational fields\r\n\r\nSchema-v2 tasks are invalid if they contain:\r\n\r\n```text\r\nstatus\r\nvalidation_requirements\r\nbootstrap_source\r\n```\r\n\r\nThe migration converts these fields instead of carrying them forward unchanged.\r\n\r\n## Camera migration correction\r\n\r\nThe v1 camera task mixed historical completion with contract scope:\r\n\r\n- `execution_scope: not_applicable`;\r\n- `decomposition_state: not_applicable`;\r\n- one validation requirement that could only be checked after a future visual foundation existed.\r\n\r\nThe v2 migration corrects this by:\r\n\r\n- restoring the bounded camera contract to `execution_scope: single_agent`;\r\n- restoring `decomposition_state: concrete`;\r\n- deriving its historical camera completion gates from the recorded Unity test evidence;\r\n- moving the future Tilemap/SpriteRenderer compatibility check to `downstream_integration_obligations`.\r\n\r\n## Migration commands\r\n\r\nCheck without writing:\r\n\r\n```powershell\r\ndocker compose run --rm codex-review python3 Pipeline/TaskGraph/migrate_task_contracts_v2.py --check\r\n```\r\n\r\nRun deterministic smoke tests:\r\n\r\n```powershell\r\ndocker compose run --rm codex-review python3 Pipeline/TaskGraph/migrate_task_contracts_v2_smoke_test.py\r\n```\r\n\r\nApply the migration:\r\n\r\n```powershell\r\ndocker compose run --rm codex-review python3 Pipeline/TaskGraph/migrate_task_contracts_v2.py --apply\r\n```\r\n\r\nThe apply is idempotent. It writes task files atomically one at a time and publishes `TASK_CONTRACT_V2_MIGRATION.json` last. If interrupted before the report is published, rerun the same command; mixed v1/v2 task sets are recoverable by the migrator but rejected by the normal live graph loader.\r\n\r\n## What schema 2.0 does not yet implement\r\n\r\nSchema 2.0 does not create execution authority. After migration:\r\n\r\n```text\r\ntaskcontrol ready\r\n```\r\n\r\nreports readiness as unavailable, and:\r\n\r\n```text\r\ntaskcontrol authorize NSC-003\r\n```\r\n\r\ncontinues to deny execution.\r\n\r\nThe next phase must introduce delivery/revalidation records and derived current conformance before autonomous dispatch can be enabled.\r\n# Persistent Task Graph and Task Contracts\r\n\r\nThis directory contains deterministic tooling for the No Safe Circle persistent work graph.\r\n\r\n## Current architecture correction\r\n\r\nThe initial bootstrap successfully established stable `NSC-###` identities, dependencies, parent hierarchy, and exclusive-resource coordination. The adversarial architecture review then found that schema-v1 task files incorrectly combined work definitions with mutable completion claims.\r\n\r\nPhase 1 disabled autonomous execution authority.\r\n\r\nPhase 2 introduces **task-contract schema 2.0**:\r\n\r\n```text\r\nTasks/*.yaml = approved definition of work\r\n```\r\n\r\nnot:\r\n\r\n```text\r\nTasks/*.yaml = definition + running state + validation state + completion truth\r\n```\r\n\r\nSee:\r\n\r\n- `TASK_CONTRACT_SCHEMA_V2.md`\r\n- `TASK_CONTRACT_V2_QUALITY_REVIEW.md`\r\n- `Docs/AI-Pipeline/ADR-031_TASK_STATUS_ADVISORY.md`\r\n- `Docs/AI-Pipeline/ADR-032_TASK_CONTRACT_SCHEMA_V2.md`\r\n\r\nPhase 3A adds committed delivery, historical-adoption baseline, and revalidation records plus a deterministic current-conformance evaluator. Phase 3B has now proven evidence-derived current conformance on the first real task: committed baseline `BASE-NSC-023-86af98f41ab5` selects as current for NSC-023 and derives `conformant`. No real production revalidation record exists yet.\r\n\r\nA conformant result does not establish dependency readiness. Dependency-readiness policy and dispatch authorization policy have not been implemented or approved. `taskcontrol ready` remains unavailable, `taskcontrol authorize` remains denied, and state inspection and a conformant result never authorize autonomous execution. Zero tasks may be autonomously dispatched. See `CONFORMANCE_RECORDS.md` and `Docs/AI-Pipeline/ADR-033_EVIDENCE_DERIVED_CONFORMANCE.md`.\r\n\r\nInspect committed-HEAD conformance for one schema-v2 task:\r\n\r\n```powershell\r\npython3 Pipeline/TaskGraph/taskcontrol.py state NSC-003\r\n```\r\n\r\n```powershell\r\npython3 Pipeline/TaskGraph/taskcontrol.py state NSC-003 --json\r\n```\r\n\r\nRun the synthetic Phase 3A Git-object regression suite:\r\n\r\n```powershell\r\npython3 Pipeline/TaskGraph/conformance_evaluator_smoke_test.py\r\n```\r\n\r\n## Phase 2 files\r\n\r\n- `task_contract_schema.py` — shared schema constants and deterministic entry normalization.\r\n- `task_contract_migration.py` — idempotent v1-to-v2 task conversion plus explicit human-reviewed migration rules.\r\n- `migrate_task_contracts_v2.py` — repository migration planner/checker/applicator.\r\n- `migrate_task_contracts_v2_smoke_test.py` — end-to-end synthetic migration, validation, quality-audit, recovery, and idempotence test.\r\n- `task_contract_quality_audit.py` — heuristic post-migration review for duplicate acceptance criteria and completion gates that may actually be downstream obligations.\r\n- `task_contract_quality_audit_smoke_test.py` — deterministic audit regression test.\r\n- `work_graph_validate.py` — validates a uniform v1 graph during transition or the final v2 graph; mixed live graphs fail closed.\r\n- `persistent_work_graph.py` — loads one uniform live schema and rejects interrupted mixed state.\r\n- `taskcontrol.py` — inspection CLI; readiness and execution authority remain disabled.\r\n\r\n## Reviewed migration corrections\r\n\r\nThe first real migration quality audit found two candidates, and manual inspection found two additional duplicate pairs that the heuristic did not flag.\r\n\r\nThe final migration rules therefore:\r\n\r\n- merge NSC-003's duplicate gameplay-suspend acceptance criteria;\r\n- move NSC-003's future pointer-consumer validation from a completion gate to a downstream integration obligation;\r\n- merge NSC-019's duplicate gameplay-suspend acceptance criteria;\r\n- merge NSC-019's duplicate reset acceptance criteria;\r\n- preserve NSC-023's future visual-foundation compatibility check as a downstream integration obligation.\r\n\r\nThe reviewed migration identity is:\r\n\r\n```text\r\ntask-contract-schema-v2-20260822-r2\r\n```\r\n\r\n## Run the Phase 2 checks\r\n\r\nFrom the repository root:\r\n\r\n```powershell\r\ndocker compose run --rm codex-review python3 Pipeline/TaskGraph/work_graph_transform_smoke_test.py\r\n```\r\n\r\n```powershell\r\ndocker compose run --rm codex-review python3 Pipeline/TaskGraph/work_graph_validate_smoke_test.py\r\n```\r\n\r\n```powershell\r\ndocker compose run --rm codex-review python3 Pipeline/TaskGraph/work_graph_persist_smoke_test.py\r\n```\r\n\r\n```powershell\r\ndocker compose run --rm codex-review python3 Pipeline/TaskGraph/taskcontrol_smoke_test.py\r\n```\r\n\r\n```powershell\r\ndocker compose run --rm codex-review python3 Pipeline/TaskGraph/phase1_execution_authority_smoke_test.py\r\n```\r\n\r\n```powershell\r\ndocker compose run --rm codex-review python3 Pipeline/TaskGraph/task_contract_quality_audit_smoke_test.py\r\n```\r\n\r\n```powershell\r\ndocker compose run --rm codex-review python3 Pipeline/TaskGraph/migrate_task_contracts_v2_smoke_test.py\r\n```\r\n\r\n## Check the real migration\r\n\r\nThis validates all real tasks and prints the exact migration summary without writing:\r\n\r\n```powershell\r\ndocker compose run --rm codex-review python3 Pipeline/TaskGraph/migrate_task_contracts_v2.py --check\r\n```\r\n\r\nReview the task count, historical status-observation counts, completion-gate count, and downstream-obligation count.\r\n\r\n## Apply the real migration\r\n\r\nThe `codex-review` service mounts the repository read-only. Use the writable `codex` service for `--apply`:\r\n\r\n```powershell\r\ndocker compose run --rm codex python3 Pipeline/TaskGraph/migrate_task_contracts_v2.py --apply\r\n```\r\n\r\nThe migrator:\r\n\r\n1. reads every `Tasks/NSC-*.yaml` file;\r\n2. converts v1 or preserves already-valid v2 contracts;\r\n3. validates the complete target graph before writing;\r\n4. checks source hashes immediately before publication;\r\n5. atomically replaces each task file;\r\n6. publishes `TASK_CONTRACT_V2_MIGRATION.json` last;\r\n7. supports safe rerun after interruption.\r\n\r\nThen run:\r\n\r\n```powershell\r\ndocker compose run --rm codex-review python3 Pipeline/TaskGraph/taskcontrol.py validate\r\n```\r\n\r\nExpected task schema:\r\n\r\n```text\r\n2.0\r\n```\r\n\r\nRun the quality audit after migration:\r\n\r\n```powershell\r\ndocker compose run --rm codex-review python3 Pipeline/TaskGraph/task_contract_quality_audit.py --strict\r\n```\r\n\r\nExpected result:\r\n\r\n```text\r\nTotal review findings:                  0\r\n```\r\n\r\nReadiness intentionally remains unavailable:\r\n\r\n```powershell\r\ndocker compose run --rm codex-review python3 Pipeline/TaskGraph/taskcontrol.py ready\r\n```\r\n\r\nThis command does not derive a dependency-ready frontier. Evidence-derived current conformance has been proven on NSC-023, but a conformant result does not establish dependency readiness. Dependency-readiness and dispatch authorization policies have not been implemented or approved.\r\n\r\nAuthorization intentionally remains denied:\r\n\r\n```powershell\r\ndocker compose run --rm codex-review python3 Pipeline/TaskGraph/taskcontrol.py authorize NSC-003\r\n```\r\n\r\nThe authorization command intentionally returns exit code `2`; Docker Desktop may offer Gordon because the process is nonzero, but the denial is expected.\r\nIts reason code is `evidence_derived_dispatch_policy_not_enabled`. A derived state, including `conformant`, is inspection output only and never grants execution authority.\r\n\r\n## Replacing an uncommitted first migration\r\n\r\nIf the earlier migration identity `task-contract-schema-v2-20260822` was applied locally but not committed, discard only those generated outputs before running the reviewed migration:\r\n\r\n```powershell\r\ngit restore -- Tasks\r\n```\r\n\r\n```powershell\r\nRemove-Item Pipeline/TaskGraph/TASK_CONTRACT_V2_MIGRATION.json\r\n```\r\n\r\nThen pull the reviewed migration tooling, run `--check`, and apply again.\r\n\r\n## Historical bootstrap boundary\r\n\r\nDo not rerun the one-time bootstrap on this repository.\r\n\r\nThe old reconciliation, verification, approval, and bootstrap records remain immutable history. Schema 2.0 migrates the living task contracts; it does not rewrite the evidence that originally produced them.\r\n\r\n## Next phase\r\n\r\nThe first real production baseline has proven NSC-023 conformant. Do not fabricate a gameplay, contract, GDD, or implementation change merely to create a revalidation record. The first legitimate relevant change will exercise production revalidation. Dependency readiness and dispatch authority remain disabled until their policies are explicitly designed and approved.\r\n# TaskExecution\n\n`TaskExecution` owns No Safe Circle task identity while delegating one bounded provider-neutral invocation to `AgentRuntime`. `TaskExecutionRequest` composes an exact `AgentInvocationRequest` with `task_id` and `TaskContractIdentity`; it validates the `NSC-###` form, positive contract revision, lowercase SHA-256, and exact `Tasks/<task_id>.yaml` path.\n\n`TaskExecutionRunner` publishes immutable `task_request.json` audit data under its caller-supplied task-run root before delegating the exact contained invocation to `AgentRunner`. The generic runtime independently publishes task-neutral `request.json`, `provider.log`, and `result.json` under its configured invocation root.\n\nThese artifacts bind task identity to an invocation for audit. They do not establish delivery, readiness, conformance, authorization, approval, integration, evidence publication, or completion. ExecutionCrew orchestration, task selection, Unity execution, GER, and Git operations remain outside this layer.\n# Provider-neutral AgentRuntime\n\nThis runtime foundation extracts the reusable orchestration ideas demonstrated by Assignment 3: fresh bounded invocations, explicit request/result handoffs, semantic capability limits, structured output, normalized failures, and immutable run artifacts. `AgentCrew/` and `Assignment6GER/` remain unchanged historical coursework evidence; this package neither imports nor retrofits them.\n\n`AgentInvocationRequest` describes one generic bounded invocation: run identity, role, prompt, repository context, semantic capabilities, write policy, output shape, capability-class selection, budgets, and provider configuration. It has no No Safe Circle task identity and no dependency on `Tasks/*.yaml`. `AgentResult` describes only an invocation outcome and provider/agent claims. Task identity belongs to `Pipeline/TaskExecution`; delivery, conformance, readiness, authorization, integration, repository changes, command execution, and test success remain decisions for higher deterministic repository, test, and evidence systems.\n\nAll retained request, result, and runtime-configuration JSON values are recursively validated and frozen. Runtime configuration invariants apply equally to direct construction, dictionaries, and strict JSON loading. Only exact built-in JSON null, booleans, integers, finite numbers, valid UTF-8 strings, lists/tuples, dictionaries, and the runtime's own frozen mapping proxies are accepted. Polymorphic container and text subclasses are rejected so provider callbacks cannot run during validation or make publication disagree with the validated snapshot. Cycles and nesting deeper than the conservative 64-container limit are rejected deterministically. `to_dict()` methods return detached mutable copies. The runner accepts only the exact `AgentInvocationRequest`, `RuntimeConfiguration`, and `ProviderInvocationResponse` types; requests additionally require exact `WriteBoundaries` and `Budgets`, while results require exact `Usage`. Base serializers are called non-polymorphically, preventing subclass serialization or response-container overrides at these trust boundaries.\n\nIdentifiers use conservative lowercase ASCII forms: run IDs are 1–64 character lowercase alphanumeric/hyphen slugs, while roles and configuration keys begin with a lowercase letter and use lowercase letters, digits, underscores, and separated hyphens. Every serialized operational string must be UTF-8 encodable. Repository paths are already-normalized, relative POSIX paths and additionally reject surrogates, NUL, ASCII controls, DEL, line breaks, tabs, Windows-forbidden characters, alternate-data-stream colons, trailing dots/spaces, and reserved Windows device names. Write-boundary components are compared conservatively and case-insensitively while remaining component-aware; denied boundaries override allowed ones. Budget maxima are 1,000 turns, 86,400 seconds, and 10,000,000 tokens.\n\nProvider adapters expose an identifier, accept the common request plus a configured concrete model, return structured output and raw log text separately, and normalize provider failures. They translate invocation mechanics only. They may never write task/evidence/readiness state or declare delivery, conformance, readiness, or authorization. Live-provider adapters must pass the same contract suite.\n\n`ProviderOutputInvalid` represents provider output from which an adapter could not produce a structured-output candidate. `AgentRunner` normalizes it to `schema_error`. This is distinct from a successfully parsed candidate that the runner later rejects through central schema validation, although both outcomes normalize to `schema_error`. `ProviderRequestRejected` represents a provider that cannot safely honor a selected request policy and normalizes to `invalid_request` after provider/model selection. Exact provider raw output is retained in `provider.log` when it is valid. Neither exception establishes deterministic correctness, delivery, conformance, readiness, authorization, approval, integration, or test-success authority.\n\n`FakeProvider` is deterministic and performs no network, command, version-control, engine, or repository access. It exercises success, provider failure, invalid provider output, timeout, permission denial, budget exhaustion, and centrally detected schema failure.\n\n`ClaudeCodeProvider` now includes **Stage 4B.2 — Practical Repository Read/Search**. It supports the empty capability set, `repository_read`, `repository_search`, and their combination. Empty-capability invocations retain the Stage 4B behavior: a new empty temporary directory outside the repository with no tools. Repository-capable invocations run against the actual source repository root (`/workspace` in Docker): `repository_read` exposes native `Read`, while `repository_search` exposes native `Glob` and `Grep`. Repository write, approved command execution, and every non-null token limit remain rejected before launch.\n\nNonempty `context_paths` remain invalid without a repository capability. With a repository capability they are accepted as validated repository-relative invocation hints and added to a generated repository-context section in the effective provider prompt without mutating the `AgentInvocationRequest`. They are guidance, not a hardened read allowlist. This trusted single-user boundary intentionally prioritizes useful access to the current working tree; ADR-038 records the accepted limited risk.\n\nClaude receives the exact concrete configured model with no alias or fallback, native `--max-turns` equal to the request's required positive `turn_limit`, and the independent external hard `timeout_seconds` enforced by the shared subprocess transport. The prompt travels through stdin, while the compact output schema, exact `--tools` value, and explicit `Bash`, `Edit`, `Write`, `NotebookEdit`, `WebSearch`, and `WebFetch` denial travel as direct argv elements with `shell=False`; no `--allowedTools` argument is emitted. The shared standard-library transport captures stdout and stderr concurrently through `communicate`, creates a new process group/session, terminates the group on timeout with bounded cleanup, and preserves available partial output. Deterministic adapter and AgentRunner integration tests inject a fake process runner and never launch Claude. The opt-in `tests/claude_repository_read_search_live_smoke.py` requires `NSC_RUN_CLAUDE_REPOSITORY_SMOKE=1`; normal deterministic runs skip live Claude access.\n\nClaude stdout is decoded strictly as UTF-8 and retained exactly as `provider.log`. A successful response must be one JSON result envelope with exact built-in status metadata: `type=result`, `is_error=false`, `subtype=success`, `terminal_reason=completed`, and a present `structured_output`; `stop_reason=tool_use` is acceptable. Missing or malformed status or permission-denial metadata is `ProviderOutputInvalid`. A nonempty, exact-list `permission_denials`, other well-formed unsuccessful result envelopes, and nonzero exits are provider failures. `ProviderTransportError` covers local process/transcript failures, invalid usage metadata, and unexpected stderr on a zero exit, and `AgentRunner` normalizes it to `internal_error` while retaining any valid exact raw log. Timeouts remain `timeout` and retain valid partial stdout.\n\nNormalized Claude usage prefers all `modelUsage` entries, including cache-read and cache-creation input tokens, and otherwise falls back conservatively to top-level `usage`. An explicitly present empty `modelUsage` object and malformed, negative, boolean, non-finite, or inconsistent usage fail closed as transport errors.\n\nEach caller-supplied run root receives a uniquely and atomically created `<run_id>/` containing canonical `request.json`, `provider.log`, and `result.json`. JSON artifacts use strict finite JSON, deterministic key ordering, UTF-8 bytes, LF line endings, and one trailing LF. `provider.log` is the provider's exact raw text and is not decorated with runtime diagnostics. Each file is written and fsynced as a temporary file, then atomically hard-linked into place only if its destination does not exist; failed publication cleans its temporary file and cannot overwrite existing bytes. Existing run directories are never reused. A run directory is an audit artifact, not evidence of correctness.\n\nAfter a valid request exists, the runner creates the run directory and publishes `request.json` before resolving provider configuration. Unknown configurations, unavailable configured providers, and missing capability mappings therefore produce a preserved failed `result.json` classified as `invalid_request` without invoking a provider. Provider and model are null only when this pre-invocation selection did not succeed; post-selection failures retain the selected values.\n\nEvery failed `AgentResult` has a non-whitespace, non-authoritative `failure_message` and must keep `structured_output` null so rejected output cannot appear accepted; successful results leave the diagnostic null or empty. This diagnostic preserves configuration, provider-exception, schema-validation, and rejected-metadata details. It never establishes delivery, conformance, readiness, authorization, test success, or approval. Provider invocation failures and structured-output validation are normalized separately: unexpected ordinary provider exceptions are `internal_error`, while invalid structured JSON or schema mismatch is `schema_error`. Provider responses are field-snapshotted exactly once after their exact-type check. Structured output is immediately detached and frozen, and that same snapshot is both schema-validated and retained. Valid usage and execution/change/test claims survive a post-invocation `schema_error`, while rejected structured output remains null. Invalid raw logs are replaced by an empty log and a safe diagnostic; malformed exception text cannot block artifact publication. Process-control exceptions are not swallowed.\n\nStructured output supports only these JSON Schema features: the object, array, string, integer, number, boolean, and null types; `properties`; `required`; boolean `additionalProperties`; `items`; `enum`; and finite numeric `minimum`/`maximum` on integer or number schemas. Unknown keywords fail closed. The runner—not an adapter—validates successful output.\n\n`OpenAICodexProvider` supports empty capability, repository read, repository search, and combined read/search requests. Repository access requires an explicit externally enforced read-only construction profile; empty-capability requests use a temporary directory outside the repository. It forwards the selected concrete model, sends prompts by stdin, preserves exact JSONL stdout, parses the final-output file, uses the last completed-turn usage event, and enforces `min(timeout_seconds, turn_limit * 30)`. ArchitectureReview supplies the external Docker read-only profile. Repository writes, approved command execution, non-null token limits, fallback, and production role orchestration remain unsupported.\n\nThe runtime still has no crew roles/prompts, engine execution, GER integration, task selection, version-control workflow, TaskGraph evidence creation, conformance/readiness derivation, or dispatch authorization.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"agent_message","text":"{\"alternative_architecture\":{\"description\":\"\",\"needed\":false,\"why_better\":\"\"},\"architecture_summary\":\"The implementation has a sound separation between task definition, committed conformance evidence, provider invocation, and task-bound invocation audit. However, a Unity-specific drift defect is already visible: NSC-003 claims the authoritative scene at `Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity`, while the repository’s actual scene is `Assets/Scenes/DoorPrototype.unity`. This is exactly the kind of serialized-asset/state mismatch the planned scanner was meant to prevent, yet the living contract/resource surfaces can still retain it.\",\"biggest_uncertainty\":\"How widespread stale asset-path and integration assumptions are across the 37 contracts.\",\"confidence\":0.4,\"do_not_build_yet\":[],\"evidence\":[{\"observation\":\"NSC-003 is labeled `single_agent` but bundles Input Actions, runtime movement, pointer projection, movement-restriction/reset/suspend APIs, builder wiring, canonical-scene serialization, and PlayMode behavior.\",\"path\":\"Tasks/NSC-003.yaml\"},{\"observation\":\"The NSC-003 exclusive-resource scene path does not exist; the committed canonical scene is under `Assets/Scenes/`.\",\"path\":\"Tasks/NSC-003.yaml\"},{\"observation\":\"TaskExecution only binds task identity to one invocation; it explicitly does not implement orchestration, Git, Unity, GER, selection, or evidence publication.\",\"path\":\"Pipeline/TaskExecution/README.md\"},{\"observation\":\"AgentRuntime has robust fail-closed request/result publication, but explicitly has no execution crew, engine execution, Git workflow, validation, or dispatch authority.\",\"path\":\"Pipeline/AgentRuntime/README.md\"}],\"gdd_iteration_concerns\":[\"Contract revision and GDD hashes can invalidate prior conformance, but no implemented impact-to-replan/apply workflow is yet evident.\"],\"human_intervention_points\":[],\"hypothetical_failure_solutions\":[],\"missing_components\":[\"A deterministic Unity asset/path/GUID preflight connected to task contracts and execution.\",\"A real one-ticket implementation-to-Unity-evidence lane.\"],\"next_slice\":{\"deliverables\":[],\"proof_of_value\":\"\",\"title\":\"\",\"why\":\"\"},\"observed_failure_solutions\":[],\"overall_verdict\":\"insufficient_evidence\",\"overengineering\":[],\"state_and_authority_concerns\":[\"Contracts correctly do not own completion truth, but stale contract integration surfaces can still misdirect a worker.\"],\"strong_decisions\":[\"Committed Git objects, not worker claims or dirty working-copy state, own conformance evaluation.\",\"Single-worker-first and human merge/design authority are appropriate for Unity shared assets.\"],\"structural_flaws\":[],\"throughput_assessment\":\"So far, the machinery improves auditability more than feature throughput. The decisive test is whether it can deliver and validate a real movement slice without new platform construction.\",\"verdict_reason\":\"Unity implementation and historical failure evidence are still being traced.\"}"}}
