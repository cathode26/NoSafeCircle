y\": \"DEL-\", \"baseline\": \"BASE-\", \"revalidation\": \"REV-\"}[record_type]\n187-    if not record_id.startswith(f\"{prefix}{task_id}-\"):\n188-        raise ConformanceRecordError(f\"{path}: record_id prefix/task identity mismatch.\")\n189-    expected_prefix = f\"{EVIDENCE_ROOT}/{task_id}/records/\"\n190-    if not path.startswith(expected_prefix) or path != f\"{expected_prefix}{record_id}.json\":\n191-        raise ConformanceRecordError(f\"{path}: record path, task_id, filename, and record_id disagree.\")\n--\n202-        raise ConformanceRecordError(f\"{path}.canon.sha256 must be lowercase SHA-256.\")\n203-    state = _object(record[\"validated_state\"], f\"{path}.validated_state\", {\"commit\", \"tree\"})\n204-    _sha(state[\"commit\"], f\"{path}.validated_state.commit\")\n205-    _sha(state[\"tree\"], f\"{path}.validated_state.tree\")\n206-\n207:    surfaces = record[\"conformance_surfaces\"]\n208:    if not isinstance(surfaces, list):\n209:        raise ConformanceRecordError(f\"{path}.conformance_surfaces must be a list.\")\n210:    surface_paths: set[str] = set()\n211:    for index, raw in enumerate(surfaces):\n212:        surface = _object(raw, f\"{path}.conformance_surfaces[{index}]\", {\"path\", \"blob_sha\", \"role\"})\n213:        item_path = safe_repository_path(surface[\"path\"], f\"{path}.conformance_surfaces[{index}].path\")\n214:        if item_path in surface_paths:\n215:            raise ConformanceRecordError(f\"{path}: duplicate conformance surface path {item_path!r}.\")\n216:        surface_paths.add(item_path)\n217:        _sha(surface[\"blob_sha\"], f\"{path}.conformance_surfaces[{index}].blob_sha\")\n218:        _text(surface[\"role\"], f\"{path}.conformance_surfaces[{index}].role\")\n219-\n220:    gates = record[\"gate_results\"]\n221-    if not isinstance(gates, list):\n222:        raise ConformanceRecordError(f\"{path}.gate_results must be a list.\")\n223-    gate_ids: set[str] = set()\n224-    for index, raw in enumerate(gates):\n225:        gate = _object(raw, f\"{path}.gate_results[{index}]\", {\"gate_id\", \"result\", \"evidence\", \"notes\"})\n226:        gate_id = _text(gate[\"gate_id\"], f\"{path}.gate_results[{index}].gate_id\")\n227-        if gate_id in gate_ids:\n228-            raise ConformanceRecordError(f\"{path}: duplicate gate_id {gate_id!r}.\")\n229-        gate_ids.add(gate_id)\n230-        if gate[\"result\"] != \"pass\":\n231-            raise ConformanceRecordError(f\"{path}: only a pass gate result can establish conformance.\")\n232-        if not isinstance(gate[\"evidence\"], list):\n233:            raise ConformanceRecordError(f\"{path}.gate_results[{index}].evidence must be a list.\")\n234-        for evidence_index, raw_evidence in enumerate(gate[\"evidence\"]):\n235:            evidence = _object(raw_evidence, f\"{path}.gate_results[{index}].evidence[{evidence_index}]\", {\"path\", \"blob_sha\"})\n236:            safe_repository_path(evidence[\"path\"], f\"{path}.gate_results[{index}].evidence[{evidence_index}].path\")\n237:            _sha(evidence[\"blob_sha\"], f\"{path}.gate_results[{index}].evidence[{evidence_index}].blob_sha\")\n238:        _text(gate[\"notes\"], f\"{path}.gate_results[{index}].notes\", allow_empty=True)\n239-\n240:    approval = _object(record[\"human_approval\"], f\"{path}.human_approval\", {\"required\", \"decision\", \"approved_by\", \"notes\"})\n241-    if not isinstance(approval[\"required\"], bool):\n242:        raise ConformanceRecordError(f\"{path}.human_approval.required must be boolean.\")\n243-    if approval[\"decision\"] not in {\"approved\", \"not_required\"}:\n244:        raise ConformanceRecordError(f\"{path}.human_approval.decision is unsupported.\")\n245:    _text(approval[\"approved_by\"], f\"{path}.human_approval.approved_by\", allow_empty=True)\n246:    _text(approval[\"notes\"], f\"{path}.human_approval.notes\", allow_empty=True)\n247-    _text(record[\"recorded_at\"], f\"{path}.recorded_at\")\n248-\n249:    if record_type == \"delivery\":\n250-        delivery = _object(record[\"delivery\"], f\"{path}.delivery\", {\"base_commit\", \"candidate_commit\", \"integrated_commit\", \"integrated_tree\"})\n251-        for field in delivery:\n252-            _sha(delivery[field], f\"{path}.delivery.{field}\")\n253-        if state[\"commit\"] != delivery[\"integrated_commit\"] or state[\"tree\"] != delivery[\"integrated_tree\"]:\n254-            raise ConformanceRecordError(f\"{path}: delivery integrated and validated states must match.\")\n255:    elif record_type == \"baseline\":\n256-        baseline = _object(record[\"baseline\"], f\"{path}.baseline\", {\"reason_type\", \"summary\"})\n257-        if baseline[\"reason_type\"] != \"pre_evidence_existing_implementation\":\n258-            raise ConformanceRecordError(f\"{path}.baseline.reason_type is unsupported.\")\n259-        _text(baseline[\"summary\"], f\"{path}.baseline.summary\")\n260-    else:\n","exit_code":0,"status":"completed"}}
