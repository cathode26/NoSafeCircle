t[\"contract_disposition\"] != \"active\":\n281:        raise WorkGraphValidationError(\"Project root contract must remain active.\")\n282-\n283-    parent_edges: dict[str, list[str]] = {task_id: [] for task_id in tasks_by_id}\n284-    parent_edge_count = 0\n285-    for task_id, task in tasks_by_id.items():\n286-        parent = str(task.get(\"parent\") or \"\").strip()\n--\n317-            cursor = parent\n318-\n319-    dependency_edges: dict[str, list[str]] = {task_id: [] for task_id in tasks_by_id}\n320-    dependency_edge_count = 0\n321-    for task_id, task in tasks_by_id.items():\n322:        dependencies = task[\"depends_on\"]\n323-        if len(dependencies) != len(set(dependencies)):\n324-            raise WorkGraphValidationError(f\"Task {task_id} contains duplicate dependencies.\")\n325-        for dependency_id in dependencies:\n326-            dependency_id = _require_non_empty_text(\n327:                dependency_id, f\"{task_id}.depends_on entry\"\n328-            )\n329-            if dependency_id == task_id:\n330-                raise WorkGraphValidationError(f\"Task {task_id} may not depend on itself.\")\n331-            if dependency_id not in tasks_by_id:\n332-                raise WorkGraphValidationError(\n333-                    f\"Task {task_id} references missing dependency {dependency_id!r}.\"\n334-                )\n335-            if schema_version == TASK_CONTRACT_SCHEMA_VERSION:\n336-                if (\n337:                    task[\"contract_disposition\"] == \"active\"\n338:                    and tasks_by_id[dependency_id][\"contract_disposition\"] != \"active\"\n339-                ):\n340-                    raise WorkGraphValidationError(\n341:                        f\"Active task {task_id} may not depend on non-active task {dependency_id}.\"\n342-                    )\n343-            dependency_edges[task_id].append(dependency_id)\n344-            dependency_edge_count += 1\n345-    _detect_cycle(dependency_edges, \"Depend