n\", value)\n148-    expect(root, \"not_delivered\")\n149-\n150-\n151-def scenario_invalid_baseline(root: Path, corruption: str) -> None:\n152-    validated, tree = initialize(root)\n153-    value = record(root, f\"BASE-{TASK_ID}-001\", validated, tree, record_type=\"baseline\")\n154-    if corruption == \"missing_gate\":\n155-        value[\"gate_results\"] = []\n156-    elif corruption == \"wrong_gate_evidence\":\n157-        value[\"gate_results\"][0][\"evidence\"][0][\"blob_sha\"] = \"0\" * 40\n158-    elif corruption == \"delivery_field\":\n159-        value[\"delivery\"] = {\"base_commit\": validated}\n160:    elif corruption == \"revalidation_field\":\n161:        value[\"revalidation\"] = {\"basis_record_id\": \"anything\"}\n162-    elif corruption == \"mutable_authority\":\n163-        value[\"ready\"] = True\n164-    add_record(root, value)\n165-    expect(root, \"invalid_evidence\")\n166-\n167-\n168-def scenario_stale_and_replan(root: Path, change: str) -> None:\n169-    validated, tree = initialize(root)\n170-    add_record(root, record(root, f\"DEL-{TASK_ID}-001\", validated, tree))\n171:    if change == \"gdd\":\n172:        write(root, CANON_PATH, \"# Changed canon\\n\")\n173:        expected = \"needs_revalidation\"\n174-    else:\n175-        changed_task = task(revision=2)\n176-        changed_task[\"title\"] = \"Changed contract\"\n177-        write_json(root, TASK_PATH, changed_task)\n178-        expected = \"needs_replan\"\n179-    commit(root, f\"{change} change\")\n180-    expect(root, expected)\n181-\n182-\n183-def scenario_human(root: Path) -> None:\n184-    validated, tree = initialize(root)\n185-    value = record(root, f\"DEL-{TASK_ID}-001\", validated, tree, human_required=True, human_decision=\"not_required\")\n--\n212-def scenario_non_ancestral(root: Path) -> None:\n213-    validated, tree = initialize(root)\n214-    run(root, \"git\", \"branch\", \"other\")\n215-    write(root, \"main-only.txt\", \"main\\n\")\n216-    commit(root, \"main lineage\")\n217-    run(root, \"git\", \"checkout\", \"other\")\n218-    write(root, \"other-only.txt\", \"other\\n\")\n219-    other = commit(root, \"other lineage\")\n220-    other_tree = run(root, \"git\", \"rev-parse\", \"HEAD^{tree}\")\n221-    value = record(root, f\"DEL-{TASK_ID}-001\", other, other_tree)\n222-    run(root, \"git\", \"checkout\", \"main\")\n223-    add_record(root, value)\n224:    expect(root, \"needs_revalidation\")\n225-\n226-\n227-def scenario_ambiguous(root: Path) -> None:\n228-    base, _ = initialize(root)\n229-    run(root, \"git\", \"checkout\", \"-b\", \"left\")\n230-    write(root, \"left.txt\", \"left\\n\")\n231-    left = commit(root, \"left validated\")\n232-    left_tree = run(root, \"git\", \"rev-parse\", \"HEAD^{tree}\")\n233-    left_record = record(root, f\"DEL-{TASK_ID}-LEFT\", left, left_tree)\n234-    run(root, \"git\", \"checkout\", \"-b\", \"right\", base)\n235-    write(root, \"right.txt\", \"right\\n\")\n236-    right = commit(root, \"right validated\")\n--\n244-    expect(root, \"ambiguous_evidence\")\n245-\n246-\n247-def fresh(callback, *args) -> None:\n248-    with tempfile.TemporaryDirectory(prefix=\"phase3a-conformance-\") as temp:\n249-        callback(Path(temp), *args)\n250-\n251-\n252-def main() -> int:\n253-    fresh(scenario_progression)\n254-    fresh(scenario_baseline_progression)\n255-    fresh(scenario_uncommitted_baseline)\n256:    for corruption in (\"missing_gate\", \"wrong_gate_evidence\", \"delivery_field\", \"revalidation_field\", \"mutable_authority\"):\n257-        fresh(scenario_invalid_baseline, corruption)\n258:    fresh(scenario_stale_and_replan, \"gdd\")\n259-    fresh(scenario_stale_and_replan, \"contract\")\n260-    fresh(scenario_human)\n261-    for corruption in (\"missing_gate\", \"wrong_tree\", \"wrong_blob\", \"altered_artifact\", \"modified_record\"):\n262-        fresh(scenario_invalid, corruption)\n263-    fresh(scenario_non_ancestral)\n264-    fresh(scenario_ambiguous)\n265-    print(\"conformance_evaluator_smoke_test: PASS\")\n266-    return 0\n267-\n268-\n269-if __name__ == \"__main__\":\n270-    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
