{"type":"item.completed","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -lc \"git show 9f2485dca1b61360e6d02810adc71e021346496e:Tasks/NSC-011.yaml | sed -n '1,260p'\"","aggregated_output":"{\n  \"schema_version\": \"2.0\",\n  \"id\": \"NSC-011\",\n  \"contract_revision\": 1,\n  \"contract_disposition\": \"active\",\n  \"title\": \"Active Enemy Registry\",\n  \"reconciliation_key\": \"active-enemy-registry\",\n  \"kind\": \"implementation\",\n  \"type\": \"implementation\",\n  \"execution_scope\": \"single_agent\",\n  \"execution_reason\": \"Self-contained bookkeeping component (count/capacity tracking with register/unregister and a reset entry point) with no other current-repository system to integrate against; a single agent can implement and validate it in isolation.\",\n  \"decomposition_state\": \"concrete\",\n  \"decomposition_reason\": \"The GDD fully specifies this capability's contract: what it tracks, the hard cap, register/unregister semantics, what does NOT remove an enemy, and reset participation. No missing design blocks turning this into a bounded implementation item.\",\n  \"parent\": \"NSC-010\",\n  \"depends_on\": [],\n  \"exclusive_resources\": [],\n  \"acceptance_criteria\": [\n    {\n      \"reference\": \"Section 3 — Active Enemy Registry and Encounter Admission\",\n      \"requirement\": \"Registry exposes the current active enemy count and remaining capacity under the hard cap of fifteen active enemies.\",\n      \"criterion_id\": \"AC-001\"\n    },\n    {\n      \"reference\": \"Section 3 — Active Enemy Registry and Encounter Admission\",\n      \"requirement\": \"Enemy activation registers an enemy; only a defeat-driven unregister call (consumed by Enemy Health/Defeat) removes an enemy from the active count.\",\n      \"criterion_id\": \"AC-002\"\n    },\n    {\n      \"reference\": \"Section 3 — Active Enemy Registry and Encounter Admission\",\n      \"requirement\": \"Target loss, entering search state, crossing between rooms, and waiting behind a locked door do not remove a surviving persistent enemy from the registry.\",\n      \"criterion_id\": \"AC-003\"\n    },\n    {\n      \"reference\": \"Section 2 — Floor-run restart ownership\",\n      \"requirement\": \"Registry exposes an owner-controlled reset entry point that returns bookkeeping to the floor's initial state; the Floor Run/Restart Orchestrator invokes this rather than mutating registry internals directly.\",\n      \"criterion_id\": \"AC-004\"\n    },\n    {\n      \"reference\": \"Section 2 — Win and Loss Conditions (Loss); Section 3 — Active Enemy Registry and Encounter Admission\",\n      \"requirement\": \"After a floor restart, the registry's reported active count and remaining capacity agree with the set of live persistent enemies restored by the enemy-owned resets: an enemy restored to an active state is represented through the normal activation-registration path rather than being independently counted or omitted by restart-side adjustment, so admission gating resumes from accurate bookkeeping.\",\n      \"criterion_id\": \"AC-005\"\n    }\n  ],\n  \"completion_gates\": [\n    {\n      \"reference\": \"Section 3 — Active Enemy Registry and Encounter Admission\",\n      \"requirement\": \"Verify the registry's reported active count and remaining capacity stay accurate as enemies are registered and unregistered, including at the fifteen-enemy hard cap boundary.\",\n      \"gate_id\": \"VAL-001\"\n    },\n    {\n      \"reference\": \"Section 3 — Active Enemy Registry and Encounter Admission\",\n      \"requirement\": \"Verify target loss, search-state transition, room crossing, and waiting behind a locked door do not remove a surviving enemy from the registry's active count.\",\n      \"gate_id\": \"VAL-002\"\n    },\n    {\n      \"reference\": \"Section 2 — Floor-run restart ownership\",\n      \"requirement\": \"Verify floor restart returns registry bookkeeping to the floor's initial state through its owner-controlled reset entry point, and that the post-restart active count matches the live set of persistent enemies restored to their initial AI state rather than assuming an empty registry.\",\n      \"gate_id\": \"VAL-003\"\n    }\n  ],\n  \"downstream_integration_obligations\": [],\n  \"gdd_evidence\": [\n    {\n      \"reference\": \"Section 3 — Active Enemy Registry and Encounter Admission\",\n      \"requirement\": \"A shared Active Enemy Registry tracks the persistent enemy objects currently active in the run and exposes the current active count and remaining capacity under the hard limit of fifteen.\"\n    },\n    {\n      \"reference\": \"Section 3 — Active Enemy Registry and Encounter Admission\",\n      \"requirement\": \"Enemy activation registers an enemy with the registry; defeat removes that enemy from the active count. Target loss, searching, crossing rooms, or waiting behind a locked door does not remove a surviving persistent enemy from the registry.\"\n    },\n    {\n      \"reference\": \"Section 3 — Active Enemy Registry and Encounter Admission\",\n      \"requirement\": \"The registry/bookkeeping responsibility is a reusable runtime foundation and does not require the exact five-room encounter layouts, placements, or trigger authoring to be known first.\"\n    },\n    {\n      \"reference\": \"Section 2 — Floor-run restart ownership\",\n      \"requirement\": \"Active Enemy Registry bookkeeping is a required reset participant invoked through the registry's own owner-controlled reset entry point during floor restart.\"\n    },\n    {\n      \"reference\": \"Section 4 — Enemy Pursuit Agent role\",\n      \"requirement\": \"Enemy Pursuit Agent owns the shared Active Enemy Registry bookkeeping for persistent active enemy objects; encounter activation consumes that registry rather than maintaining a separate count.\"\n    }\n  ],\n  \"basis\": \"direct_gdd\",\n  \"source_scope\": \"required\",\n  \"confidence\": \"high\",\n  \"notes\": \"A repository-wide grep across Assets/ for 'Registry' found no matches; this component does not exist in any form, including as builder-capability scaffolding.\",\n  \"repository_state_at_bootstrap\": \"missing\",\n  \"repository_evidence_at_bootstrap\": [],\n  \"provenance\": {\n    \"origin\": \"verified_reconciliation_bootstrap\",\n    \"source_schema_version\": \"1.0\",\n    \"reconciliation_run_id\": \"20260821T193541Z-998ee7b5\",\n    \"verification_run_id\": \"20260821T195959Z-43dba5de\",\n    \"bootstrap_status_observation\": \"open\",\n    \"migration_id\": \"task-contract-schema-v2-20260822-r2\"\n  }\n}\n","exit_code":0,"status":"completed"}}
