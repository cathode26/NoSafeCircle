{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"git show 9f2485dca1b61360e6d02810adc71e021346496e:Tasks/NSC-020.yaml | sed -n '1,260p'\"","aggregated_output":"{\n  \"schema_version\": \"2.0\",\n  \"id\": \"NSC-020\",\n  \"contract_revision\": 1,\n  \"contract_disposition\": \"active\",\n  \"title\": \"Shared Doorway-Crossing State (Forward-Side Crossing Detection)\",\n  \"reconciliation_key\": \"doorway-crossing-state\",\n  \"kind\": \"implementation\",\n  \"type\": \"gameplay_system\",\n  \"execution_scope\": \"single_agent\",\n  \"execution_reason\": \"Bounded to adding one detection/state capability to the existing door object and exposing it through a small interface; touches a known, small set of files.\",\n  \"decomposition_state\": \"concrete\",\n  \"decomposition_reason\": \"The GDD specifies the exact required behavior (detect actual forward-side crossing after open, expose to consumers, participate in reset); the underlying Unity mechanism is an explicit implementation choice, not missing design.\",\n  \"parent\": \"NSC-018\",\n  \"depends_on\": [],\n  \"exclusive_resources\": [\n    \"repo-file:Assets/NoSafeCircle/DoorPrototype/Scripts/DoorInteractable.cs\",\n    \"repo-file:Assets/NoSafeCircle/DoorPrototype/Editor/DoorPrototypeSceneBuilder.cs\",\n    \"unity-scene:Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\"\n  ],\n  \"acceptance_criteria\": [\n    {\n      \"reference\": \"Section 3 — Door and Pursuit Rules\",\n      \"requirement\": \"Detects, for an open door, when the wizard has actually crossed to that door's forward side; opening the door alone does not set crossing state.\",\n      \"criterion_id\": \"AC-001\"\n    },\n    {\n      \"reference\": \"Section 4 — Door and Interaction Agent row\",\n      \"requirement\": \"Exposes the crossing state/event through a stable owner-side interface consumed by door close/lock and final-escape victory, so those consumers do not implement their own crossing detector.\",\n      \"criterion_id\": \"AC-002\"\n    },\n    {\n      \"reference\": \"Section 2 — Floor-run restart ownership\",\n      \"requirement\": \"Exposes an owner-controlled reset entry point for its crossing state, consumed by the Floor Run/Restart Orchestrator.\",\n      \"criterion_id\": \"AC-003\"\n    }\n  ],\n  \"completion_gates\": [\n    {\n      \"reference\": \"Section 4 — Example Game-Specific Agent Task\",\n      \"requirement\": \"Validate that crossing is detected only after the door is open and the wizard has reached the forward side, not merely on interaction completion.\",\n      \"gate_id\": \"VAL-001\"\n    }\n  ],\n  \"downstream_integration_obligations\": [],\n  \"gdd_evidence\": [\n    {\n      \"reference\": \"Section 3 — Door and Pursuit Rules\",\n      \"requirement\": \"Door and Interaction owns doorway-crossing state; after a door is open it detects when the wizard has actually crossed to that door's forward side and exposes that state to consumers; opening does not by itself count as crossing.\"\n    },\n    {\n      \"reference\": \"Section 2 — Win and Loss Conditions\",\n      \"requirement\": \"Victory occurs when the shared doorway-crossing state confirms the wizard has crossed to the forward side of the final door; the win condition does not implement a separate crossing detector.\"\n    },\n    {\n      \"reference\": \"Section 4 — Door and Interaction Agent row\",\n      \"requirement\": \"It is the single owner of detecting when the wizard crosses to the forward side of an opened door; locking and final escape consume that state.\"\n    },\n    {\n      \"reference\": \"Section 2 — Floor-run restart ownership\",\n      \"requirement\": \"Door lifecycle/crossing/durability state is a required reset participant for the Floor Run/Restart Orchestrator.\"\n    }\n  ],\n  \"basis\": \"direct_gdd\",\n  \"source_scope\": \"required\",\n  \"confidence\": \"high\",\n  \"notes\": \"No dependency on door-open-interaction was added because the existing DoorInteractable.IsOpen property this work consumes already exists and is usable independent of that item's still-open click-to-approach/Input-System rework.\",\n  \"repository_state_at_bootstrap\": \"missing\",\n  \"repository_evidence_at_bootstrap\": [\n    {\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scripts/DoorInteractable.cs\",\n      \"evidence_type\": \"code\",\n      \"observation\": \"Complete() only sets IsOpen=true, disables doorVisual and doorwayBlocker, and resets Progress; there is no forward-side crossing trigger, event, property, or any related state anywhere in this file or elsewhere in the DoorPrototype scripts.\"\n    }\n  ],\n  \"provenance\": {\n    \"origin\": \"verified_reconciliation_bootstrap\",\n    \"source_schema_version\": \"1.0\",\n    \"reconciliation_run_id\": \"20260821T193541Z-998ee7b5\",\n    \"verification_run_id\": \"20260821T195959Z-43dba5de\",\n    \"bootstrap_status_observation\": \"open\",\n    \"migration_id\": \"task-contract-schema-v2-20260822-r2\"\n  }\n}\n","exit_code":0,"status":"completed"}}
