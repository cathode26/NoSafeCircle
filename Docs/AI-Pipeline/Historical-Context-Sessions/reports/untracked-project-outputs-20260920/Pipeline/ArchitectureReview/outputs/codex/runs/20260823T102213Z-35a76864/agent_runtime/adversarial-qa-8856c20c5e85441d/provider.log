{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc 'git show 9f2485dca1b61360e6d02810adc71e021346496e:Tasks/NSC-003.yaml'","aggregated_output":"{\n  \"schema_version\": \"2.0\",\n  \"id\": \"NSC-003\",\n  \"contract_revision\": 1,\n  \"contract_disposition\": \"active\",\n  \"title\": \"Mouse-Directed Player Movement, Shared Pointer Projection, and Movement Restriction\",\n  \"reconciliation_key\": \"player-movement\",\n  \"kind\": \"implementation\",\n  \"type\": \"implementation\",\n  \"execution_scope\": \"single_agent\",\n  \"execution_reason\": \"All required responsibilities are cohesively owned by one system (PlayerMovement.cs) plus its Input Actions and builder/scene wiring; it is a bounded rewrite of one component's input/locomotion model rather than a multi-system integration.\",\n  \"decomposition_state\": \"concrete\",\n  \"decomposition_reason\": \"The required behavior (mouse-directed movement via Input System, shared pointer projection, movement-restriction interface, reset entry point) is fully specified by current GDD text without inventing new design.\",\n  \"parent\": \"NSC-002\",\n  \"depends_on\": [],\n  \"exclusive_resources\": [\n    \"repo-file:Assets/InputSystem_Actions.inputactions\",\n    \"repo-file:Assets/NoSafeCircle/DoorPrototype/Editor/DoorPrototypeSceneBuilder.cs\",\n    \"unity-scene:Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\"\n  ],\n  \"acceptance_criteria\": [\n    {\n      \"reference\": \"GDD §2 Move and Aim\",\n      \"requirement\": \"Movement is mouse-directed: a click sets a destination the wizard walks toward, and holding continues steering toward the current cursor position, consumed through Unity Input System/Input Actions rather than direct hardware polling.\",\n      \"criterion_id\": \"AC-001\"\n    },\n    {\n      \"reference\": \"GDD §2 Player Movement ownership\",\n      \"requirement\": \"Exposes a shared world-space pointer target produced by projecting the cursor onto the gameplay plane, consumable by cursor-aimed spells and Door/Interaction without those systems independently projecting screen coordinates.\",\n      \"criterion_id\": \"AC-002\"\n    },\n    {\n      \"reference\": \"GDD §2 Player Movement ownership; §4 Development Agent Ownership Invariants\",\n      \"requirement\": \"Exposes an owner-controlled movement-restriction request/release interface that Charged Fireball can use to restrict movement while charging without Fireball mutating movement internals directly.\",\n      \"criterion_id\": \"AC-003\"\n    },\n    {\n      \"reference\": \"GDD §2 Floor-run restart ownership\",\n      \"requirement\": \"Exposes an owner-controlled reset entry point that restores player position/movement state to the floor's initial state, consumed by the Floor Run/Restart Orchestrator rather than having position mutated externally.\",\n      \"criterion_id\": \"AC-004\"\n    },\n    {\n      \"reference\": \"GDD §2 Victory/input-shutdown ownership; §4 Development Agent Ownership Invariants and final escape/victory coordination\",\n      \"requirement\": \"Exposes an owner-controlled gameplay-enable/suspend interface, consumed by the Game Flow/Victory capability, that immediately stops or cancels any in-progress input-driven movement (including an active click-to-destination approach), rejects new movement commands while suspended, and can be re-enabled only through an authorized reset/test flow rather than external mutation of movement internals.\",\n      \"criterion_id\": \"AC-005\"\n    }\n  ],\n  \"completion_gates\": [\n    {\n      \"reference\": \"GDD §2 Move and Aim\",\n      \"requirement\": \"Play Mode validation that clicking a location moves the wizard toward it and that holding steers continuously toward the live cursor position.\",\n      \"gate_id\": \"VAL-001\"\n    },\n    {\n      \"reference\": \"Victory/input-shutdown ownership\",\n      \"requirement\": \"Play Mode check: invoking the suspend interface while movement is active immediately halts the wizard's in-progress movement (including an active click-to-destination approach), and further movement input has no effect until an authorized re-enable/reset flow runs.\",\n      \"gate_id\": \"VAL-002\"\n    }\n  ],\n  \"downstream_integration_obligations\": [\n    {\n      \"reference\": \"GDD §2 Player Movement ownership\",\n      \"requirement\": \"Validate that the exposed world-space pointer target is correctly consumable by a cursor-aimed spell or Door/Interaction integration once those systems exist.\",\n      \"obligation_id\": \"INT-001\"\n    }\n  ],\n  \"gdd_evidence\": [\n    {\n      \"reference\": \"GDD §2 Player Actions and Systems — Move and Aim\",\n      \"requirement\": \"Mouse-directed movement through the shared Unity Input System/Input Actions layer: click to set a destination or hold to keep steering toward the cursor; Player Movement owns the shared cursor-to-gameplay-plane projection and exposes the resulting world-space pointer target consumed by movement, cursor-aimed spells, and cursor-targeted interactions (Force Wave is the exception).\"\n    },\n    {\n      \"reference\": \"GDD §2 Resources, Feedback, and Failure — Player Movement ownership\",\n      \"requirement\": \"Player Movement owns position, locomotion, movement-restriction state, and the shared cursor-to-gameplay-plane projection; runtime input is routed through Input System/Input Actions rather than direct hardware polling; Charged Fireball requests/releases its movement restriction through an owner-controlled Player Movement interface without mutating movement internals.\"\n    },\n    {\n      \"reference\": \"GDD §2 Loss — Floor-run restart ownership\",\n      \"requirement\": \"Player Movement/player position is a required reset participant invoked by the Floor Run/Restart Orchestrator through an owner-controlled reset entry point.\"\n    },\n    {\n      \"reference\": \"Section 2 — Victory/input-shutdown ownership bullet\",\n      \"requirement\": \"Player Movement, Door/Interaction, Fireball, Frost Field, and Force Wave each expose an owner-controlled gameplay-enable/suspend interface that can immediately stop or cancel their current input-driven activity, reject new gameplay commands while suspended, and be re-enabled by an authorized reset/test flow.\"\n    }\n  ],\n  \"basis\": \"direct_gdd\",\n  \"source_scope\": \"required\",\n  \"confidence\": \"high\",\n  \"notes\": \"Exact movement speed/feel tuning is left to playtesting per GDD and is not part of this item's required acceptance surface.\",\n  \"repository_state_at_bootstrap\": \"partial\",\n  \"repository_evidence_at_bootstrap\": [\n    {\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerMovement.cs\",\n      \"evidence_type\": \"code\",\n      \"observation\": \"Implements only CharacterController-driven WASD movement via direct Keyboard.current polling; no mouse-directed movement, cursor projection, movement-restriction interface, or reset entry point exist.\"\n    },\n    {\n      \"path\": \"Assets/InputSystem_Actions.inputactions\",\n      \"evidence_type\": \"project_setting\",\n      \"observation\": \"Unmodified stock Unity template action asset; Player map has only WASD/Dpad Move and button actions (Attack/Interact/Crouch/Jump/etc.), no cursor-to-gameplay-plane or click-to-move action, and PlayerMovement.cs does not reference it.\"\n    },\n    {\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\",\n      \"evidence_type\": \"scene\",\n      \"observation\": \"PlayerMovement.cs (guid 356044e6782dd0641a7e69b0abfa5c4a) is serialized on the Player GameObject, confirming current WASD movement is the integrated state, not merely available via the builder.\"\n    }\n  ],\n  \"provenance\": {\n    \"origin\": \"verified_reconciliation_bootstrap\",\n    \"source_schema_version\": \"1.0\",\n    \"reconciliation_run_id\": \"20260821T193541Z-998ee7b5\",\n    \"verification_run_id\": \"20260821T195959Z-43dba5de\",\n    \"bootstrap_status_observation\": \"open\",\n    \"migration_id\": \"task-contract-schema-v2-20260822-r2\"\n  }\n}\n","exit_code":0,"status":"completed"}}
