       invalid.append(_finding(\"surface_validated_blob_mismatch\", f\"Surface {surface['path']} blob is false at validated commit.\", record))\n195:                    bad_surface = True\n196-                    break\n197:                if not repo.exists(head, surface[\"path\"]) or repo.blob(head, surface[\"path\"]) != surface[\"blob_sha\"]:\n198:                    changed_surface = True\n199:            if bad_surface:\n200-                continue\n201-            artifact_bad = False\n202-            for gate in data[\"gate_results\"]:\n203-                for evidence in gate[\"evidence\"]:\n204-                    artifact_prefix = f\"Pipeline/TaskGraph/evidence/{task_id}/artifacts/\"\n205-                    if not evidence[\"path\"].startswith(artifact_prefix):\n--\n219-            continue\n220-\n221-        record_gate_ids = [gate[\"gate_id\"] for gate in data[\"gate_results\"]]\n222-        if record_gate_ids != current_gate_ids and set(record_gate_ids) != set(current_gate_ids):\n223-            invalid.append(_finding(\"completion_gate_set_mismatch\", \"Record does not contain exactly the current completion-gate set.\", record))\n224-            continue\n225:        contract_changed = contract[\"path\"] != task_path or contract[\"revision\"] != current_revision or contract[\"sha256\"] != current_contract_hash\n226:        if contract_changed:\n227-            replan.append(record)\n228-            continue\n229-        approval = data[\"human_approval\"]\n230-        if approval[\"required\"] and (approval[\"decision\"] != \"approved\" or not approval[\"approved_by\"].strip()):\n231-            human.append(record)\n232-            continue\n233-        if (not approval[\"required\"] and approval[\"decision\"] != \"not_required\"):\n234-            invalid.append(_finding(\"human_approval_contradictory\", \"Non-required approval must use not_required.\", record))\n235-            continue\n236:        if changed_surface or canon[\"path\"] != CANON_PATH or canon[\"sha256\"] != current_canon_hash:\n237-            stale.append(record)\n238-            continue\n239-        conformant.append(record)\n240-\n241-    if invalid:\n242-        return ConformanceState(task_id, title, \"invalid_evidence\", head, head_tree, None, tuple(invalid), dirty)\n--\n245-        if len(maximal) != 1:\n246-            ids = \", \".join(item.record_id for item in maximal)\n247-            return ConformanceState(task_id, title, \"ambiguous_evidence\", head, head_tree, None,\n248-                (_finding(\"multiple_maximal_current_records\", f\"Multiple maximal current-valid records: {ids}.\"),), dirty)\n249-        selected = maximal[0]\n250-        return ConformanceState(task_id, title, \"conformant\", head, head_tree, selected.record_id,\n251:            (_finding(\"current_record_selected\", \"Record is valid for current contract, canon, surfaces, gates, and artifacts.\", selected),), dirty)\n252-    for state_name, candidates, code, message in (\n253:        (\"needs_replan\", replan, \"contract_changed\", \"Current contract revision or semantic hash differs from prior evidence.\"),\n254-        (\"needs_human\", human, \"human_approval_missing\", \"Required human approval is missing.\"),\n255:        (\"needs_revalidation\", stale, \"evidence_stale\", \"Prior evidence exists but is not current for HEAD.\"),\n256-    ):\n257-        if candidates:\n258-            maximal = _maximal(repo, candidates)\n259-            selected = maximal[0] if len(maximal) == 1 else None\n260-            return ConformanceState(task_id, title, state_name, head, head_tree,\n261-                selected.record_id if selected else None, (_finding(code, message, selected),), dirty)\n","exit_code":0,"status":"completed"}}
