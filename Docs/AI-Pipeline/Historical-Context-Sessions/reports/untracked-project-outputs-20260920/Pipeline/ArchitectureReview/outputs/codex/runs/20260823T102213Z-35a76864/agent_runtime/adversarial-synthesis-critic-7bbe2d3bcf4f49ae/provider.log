{"type":"item.completed","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -lc \"nl -ba Pipeline/TaskExecution/task_runner.py | sed -n '1,300p'\"","aggregated_output":"     1\t\"\"\"Thin task-identity wrapper around one generic AgentRuntime invocation.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\tfrom pathlib import Path\n     6\t\n     7\tfrom Pipeline.AgentRuntime.agent_runner import AgentRunner, _json, _publish\n     8\tfrom Pipeline.AgentRuntime.contracts import AgentResult, ContractValidationError\n     9\t\n    10\tfrom .contracts import TaskExecutionRequest\n    11\t\n    12\t\n    13\tclass TaskExecutionRunner:\n    14\t    def __init__(self, task_run_root: Path, agent_runner: AgentRunner) -> None:\n    15\t        self.task_run_root = Path(task_run_root)\n    16\t        if type(agent_runner) is not AgentRunner:\n    17\t            raise ContractValidationError(\"agent_runner must be an exact AgentRunner\")\n    18\t        self.agent_runner = agent_runner\n    19\t\n    20\t    def run(self, request: TaskExecutionRequest) -> AgentResult:\n    21\t        if type(request) is not TaskExecutionRequest:\n    22\t            raise ContractValidationError(\n    23\t                \"request must be an exact TaskExecutionRequest\"\n    24\t            )\n    25\t        task_run_dir = self.task_run_root / request.invocation.run_id\n    26\t        task_run_dir.mkdir(parents=True, exist_ok=False)\n    27\t        try:\n    28\t            _publish(\n    29\t                task_run_dir / \"task_request.json\",\n    30\t                _json(TaskExecutionRequest.to_dict(request)),\n    31\t            )\n    32\t        except BaseException:\n    33\t            try:\n    34\t                task_run_dir.rmdir()\n    35\t            except OSError:\n    36\t                pass\n    37\t            raise\n    38\t        return self.agent_runner.run(request.invocation)\n","exit_code":0,"status":"completed"}}
