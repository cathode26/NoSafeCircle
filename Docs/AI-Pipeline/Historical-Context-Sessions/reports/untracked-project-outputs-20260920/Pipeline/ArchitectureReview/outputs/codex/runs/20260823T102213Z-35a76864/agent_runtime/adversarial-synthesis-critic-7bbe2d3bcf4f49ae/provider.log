{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"nl -ba 'Pipeline/AgentRuntime/providers/openai_codex.py'\"","aggregated_output":"     1\t\"\"\"Fail-closed OpenAI Codex CLI adapter for generic AgentRuntime invocations.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport json\n     6\timport math\n     7\tfrom pathlib import Path\n     8\timport tempfile\n     9\tfrom typing import Any, Mapping\n    10\t\n    11\tfrom ..contracts import AgentInvocationRequest, Usage\n    12\tfrom ..json_values import thaw_json\n    13\tfrom ..process_runner import ProcessResult, ProcessRunner, ProcessTimeoutError, StandardProcessRunner\n    14\tfrom .base import (\n    15\t    ProviderFailure, ProviderInvocationResponse, ProviderOutputInvalid,\n    16\t    ProviderRequestRejected, ProviderTimeout, ProviderTransportError,\n    17\t)\n    18\t\n    19\tOPENAI_SECONDS_PER_TURN = 30\n    20\t_REPOSITORY_CAPABILITIES = frozenset({\"repository_read\", \"repository_search\"})\n    21\t_FORBIDDEN_CAPABILITIES = frozenset({\"repository_write\", \"approved_command_execution\"})\n    22\t_VALID_REASONING_EFFORTS = frozenset(\n    23\t    {\"none\", \"minimal\", \"low\", \"medium\", \"high\", \"xhigh\", \"max\"}\n    24\t)\n    25\t_SOURCE_REPOSITORY_ROOT = Path(__file__).resolve().parents[3]\n    26\t_MISSING = object()\n    27\t\n    28\t\n    29\tclass OpenAICodexProvider:\n    30\t    def __init__(\n    31\t        self,\n    32\t        *,\n    33\t        reasoning_effort: str = \"high\",\n    34\t        externally_enforced_read_only_repository: bool = False,\n    35\t        executable: str = \"codex\",\n    36\t        process_runner: ProcessRunner | None = None,\n    37\t        temporary_directory_parent: Path | None = None,\n    38\t        repository_root: Path | None = None,\n    39\t    ) -> None:\n    40\t        if type(executable) is not str or not executable:\n    41\t            raise ValueError(\"executable must be a non-empty string\")\n    42\t        if reasoning_effort not in _VALID_REASONING_EFFORTS:\n    43\t            raise ValueError(\"unsupported Codex reasoning effort\")\n    44\t        if type(externally_enforced_read_only_repository) is not bool:\n    45\t            raise ValueError(\"read-only repository profile must be boolean\")\n    46\t        self.executable = executable\n    47\t        self.reasoning_effort = reasoning_effort\n    48\t        self.externally_enforced_read_only_repository = externally_enforced_read_only_repository\n    49\t        self.process_runner = StandardProcessRunner() if process_runner is None else process_runner\n    50\t        self.temporary_directory_parent = temporary_directory_parent\n    51\t        self.repository_root = (\n    52\t            _SOURCE_REPOSITORY_ROOT if repository_root is None else Path(repository_root)\n    53\t        ).resolve()\n    54\t\n    55\t    @property\n    56\t    def provider_identifier(self) -> str:\n    57\t        return \"openai-codex\"\n    58\t\n    59\t    def invoke(self, request: AgentInvocationRequest, model: str) -> ProviderInvocationResponse:\n    60\t        self._validate_request_policy(request)\n    61\t        self._validate_model(model)\n    62\t        parent = self._temporary_parent()\n    63\t        try:\n    64\t            with tempfile.TemporaryDirectory(prefix=\"agent-runtime-codex-\", dir=parent) as text:\n    65\t                temporary = Path(text)\n    66\t                schema_path = temporary / \"output-schema.json\"\n    67\t                final_path = temporary / \"final-output.json\"\n    68\t                schema_path.write_text(\n    69\t                    json.dumps(thaw_json(request.output_schema), allow_nan=False,\n    70\t                               ensure_ascii=False, separators=(\",\", \":\"), sort_keys=True),\n    71\t                    encoding=\"utf-8\",\n    72\t                )\n    73\t                cwd = self.repository_root if request.allowed_capabilities else temporary\n    74\t                argv = self._argv(model, schema_path, final_path)\n    75\t                result = self._run(\n    76\t                    argv, self._prompt(request), cwd,\n    77\t                    min(request.budgets.timeout_seconds,\n    78\t                        request.budgets.turn_limit * OPENAI_SECONDS_PER_TURN),\n    79\t                )\n    80\t                return self._response(result, final_path)\n    81\t        except (ProviderFailure, ProviderOutputInvalid, ProviderTimeout,\n    82\t                ProviderRequestRejected, ProviderTransportError):\n    83\t            raise\n    84\t        except Exception as exc:\n    85\t            raise ProviderTransportError(\n    86\t                f\"Codex local temporary-file transport failed: {type(exc).__name__}\"\n    87\t            ) from exc\n    88\t\n    89\t    def _validate_request_policy(self, request: AgentInvocationRequest) -> None:\n    90\t        capabilities = frozenset(request.allowed_capabilities)\n    91\t        if capabilities & _FORBIDDEN_CAPABILITIES:\n    92\t            raise ProviderRequestRejected(\n    93\t                \"Codex does not support repository writing or approved command execution\"\n    94\t            )\n    95\t        if not capabilities <= _REPOSITORY_CAPABILITIES:\n    96\t            raise ProviderRequestRejected(\"Codex capability set is unsupported\")\n    97\t        if request.context_paths and not capabilities:\n    98\t            raise ProviderRequestRejected(\"Codex requires repository capability for context_paths\")\n    99\t        if capabilities and not self.externally_enforced_read_only_repository:\n   100\t            raise ProviderRequestRejected(\n   101\t                \"Codex repository access requires an explicit externally read-only profile\"\n   102\t            )\n   103\t        if request.budgets.token_limit is not None:\n   104\t            raise ProviderRequestRejected(\"Codex currently requires token_limit to be null\")\n   105\t\n   106\t    @staticmethod\n   107\t    def _validate_model(model: str) -> None:\n   108\t        if type(model) is not str or not model or model != model.strip():\n   109\t            raise ProviderTransportError(\"Codex requires a concrete configured model identifier\")\n   110\t\n   111\t    def _argv(self, model: str, schema_path: Path, final_path: Path) -> tuple[str, ...]:\n   112\t        return (\n   113\t            self.executable, \"exec\", \"--ephemeral\", \"--ignore-user-config\",\n   114\t            \"--ignore-rules\", \"--strict-config\", \"--skip-git-repo-check\",\n   115\t            \"--sandbox\", \"danger-full-access\", \"--model\", model,\n   116\t            \"-c\", f\"model_reasoning_effort={self.reasoning_effort}\",\n   117\t            \"--output-schema\", str(schema_path), \"--json\",\n   118\t            \"--output-last-message\", str(final_path), \"--color\", \"never\", \"-\",\n   119\t        )\n   120\t\n   121\t    def _prompt(self, request: AgentInvocationRequest) -> bytes:\n   122\t        prompt = request.prompt\n   123\t        if request.allowed_capabilities:\n   124\t            hints = \"\"\n   125\t            if request.context_paths:\n   126\t                hints = \"\\nRelevant repository paths:\\n\" + \"\\n\".join(\n   127\t                    f\"- {path}\" for path in request.context_paths\n   128\t                )\n   129\t            prompt += (\n   130\t                \"\\n\\nRepository context:\\n\"\n   131\t                f\"Repository root: {self.repository_root.as_posix()}\\n\"\n   132\t                \"The surrounding environment mounts this repository read-only. \"\n   133\t                \"Inspect it with ordinary read-only file and search commands. \"\n   134\t                \"Context paths are guidance, not an access allowlist.\"\n   135\t                f\"{hints}\"\n   136\t            )\n   137\t        try:\n   138\t            return prompt.encode(\"utf-8\")\n   139\t        except UnicodeError as exc:\n   140\t            raise ProviderTransportError(\"Codex prompt could not be encoded as UTF-8\") from exc\n   141\t\n   142\t    def _temporary_parent(self) -> str:\n   143\t        parent = Path(tempfile.gettempdir()) if self.temporary_directory_parent is None else Path(self.temporary_directory_parent)\n   144\t        try:\n   145\t            resolved = parent.resolve(strict=True)\n   146\t            if not resolved.is_dir() or resolved == self.repository_root or resolved.is_relative_to(self.repository_root):\n   147\t                raise ProviderTransportError(\"temporary directory parent must be outside the repository\")\n   148\t        except ProviderTransportError:\n   149\t            raise\n   150\t        except (OSError, RuntimeError) as exc:\n   151\t            raise ProviderTransportError(\"temporary directory parent could not be inspected\") from exc\n   152\t        return str(resolved)\n   153\t\n   154\t    def _run(self, argv: tuple[str, ...], stdin: bytes, cwd: Path, timeout: float) -> ProcessResult:\n   155\t        try:\n   156\t            result = self.process_runner.run(argv, stdin=stdin, cwd=cwd, timeout_seconds=timeout)\n   157\t        except ProcessTimeoutError as exc:\n   158\t            if type(exc.result) is not ProcessResult or exc.result.argv != argv:\n   159\t                raise ProviderTransportError(\"Codex timeout returned invalid local metadata\") from exc\n   160\t            raise ProviderTimeout(\n   161\t                \"Codex invocation exceeded its external timeout\",\n   162\t                raw_log=_decode_stdout(exc.result.stdout),\n   163\t            ) from exc\n   164\t        except (KeyboardInterrupt, SystemExit, GeneratorExit):\n   165\t            raise\n   166\t        except Exception as exc:\n   167\t            raise ProviderTransportError(f\"Codex process transport failed: {type(exc).__name__}\") from exc\n   168\t        if type(result) is not ProcessResult or result.argv != argv:\n   169\t            raise ProviderTransportError(\"Codex process transport returned invalid local metadata\")\n   170\t        return result\n   171\t\n   172\t    @staticmethod\n   173\t    def _response(result: ProcessResult, final_path: Path) -> ProviderInvocationResponse:\n   174\t        raw_log = _decode_stdout(result.stdout)\n   175\t        stderr = result.stderr.decode(\"utf-8\", errors=\"replace\").strip()\n   176\t        if result.returncode != 0:\n   177\t            raise ProviderFailure(\n   178\t                f\"Codex exited with status {result.returncode}\" + (f\": {stderr}\" if stderr else \"\"),\n   179\t                raw_log=raw_log,\n   180\t            )\n   181\t        if result.stderr:\n   182\t            raise ProviderTransportError(\n   183\t                f\"Codex exited successfully with unexpected stderr: {stderr or 'non-empty stderr'}\",\n   184\t                raw_log=raw_log,\n   185\t            )\n   186\t        events = _parse_jsonl(raw_log)\n   187\t        completed = [event for event in events if event.get(\"type\") == \"turn.completed\"]\n   188\t        if not completed:\n   189\t            raise ProviderOutputInvalid(\"Codex transcript has no completed turn\", raw_log=raw_log)\n   190\t        usage = _normalize_usage(completed[-1], raw_log)\n   191\t        if not final_path.is_file():\n   192\t            raise ProviderOutputInvalid(\"Codex final structured output file is missing\", raw_log=raw_log)\n   193\t        try:\n   194\t            candidate = _strict_json(final_path.read_text(encoding=\"utf-8\"))\n   195\t        except (OSError, UnicodeError, json.JSONDecodeError, ValueError, RecursionError) as exc:\n   196\t            raise ProviderOutputInvalid(\"Codex final structured output is invalid JSON\", raw_log=raw_log) from exc\n   197\t        return ProviderInvocationResponse(candidate, raw_log, (), usage, False, ())\n   198\t\n   199\t\n   200\tdef _decode_stdout(stdout: bytes) -> str:\n   201\t    try:\n   202\t        return stdout.decode(\"utf-8\", errors=\"strict\")\n   203\t    except UnicodeDecodeError as exc:\n   204\t        raise ProviderTransportError(\"Codex stdout was not valid UTF-8\") from exc\n   205\t\n   206\t\n   207\tdef _strict_json(text: str) -> Any:\n   208\t    def reject_constant(value: str) -> None:\n   209\t        raise ValueError(f\"invalid JSON constant: {value}\")\n   210\t    def reject_duplicates(pairs: list[tuple[str, Any]]) -> dict[str, Any]:\n   211\t        result: dict[str, Any] = {}\n   212\t        for key, value in pairs:\n   213\t            if key in result:\n   214\t                raise ValueError(f\"duplicate JSON key: {key}\")\n   215\t            result[key] = value\n   216\t        return result\n   217\t    return json.loads(text, parse_constant=reject_constant, object_pairs_hook=reject_duplicates)\n   218\t\n   219\t\n   220\tdef _parse_jsonl(raw_log: str) -> list[dict[str, Any]]:\n   221\t    events: list[dict[str, Any]] = []\n   222\t    try:\n   223\t        for line in raw_log.splitlines():\n   224\t            if not line.strip():\n   225\t                raise ValueError(\"blank JSONL record\")\n   226\t            event = _strict_json(line)\n   227\t            if type(event) is not dict or type(event.get(\"type\")) is not str:\n   228\t                raise ValueError(\"event must be an object with a string type\")\n   229\t            events.append(event)\n   230\t    except (json.JSONDecodeError, ValueError, RecursionError) as exc:\n   231\t        raise ProviderOutputInvalid(\"Codex stdout was malformed JSONL\", raw_log=raw_log) from exc\n   232\t    if not events:\n   233\t        raise ProviderOutputInvalid(\"Codex stdout was empty\", raw_log=raw_log)\n   234\t    return events\n   235\t\n   236\t\n   237\tdef _normalize_usage(event: Mapping[str, Any], raw_log: str) -> Usage | None:\n   238\t    usage = event.get(\"usage\", _MISSING)\n   239\t    if usage is _MISSING:\n   240\t        return None\n   241\t    if type(usage) is not dict:\n   242\t        raise ProviderTransportError(\"Codex completed-turn usage must be an object\", raw_log=raw_log)\n   243\t    def token(name: str) -> int:\n   244\t        value = usage.get(name, 0)\n   245\t        if isinstance(value, bool) or not isinstance(value, int) or value < 0:\n   246\t            raise ProviderTransportError(f\"Codex usage.{name} must be a non-negative integer\", raw_log=raw_log)\n   247\t        return value\n   248\t    input_tokens = token(\"input_tokens\")\n   249\t    output_tokens = token(\"output_tokens\") + token(\"reasoning_output_tokens\")\n   250\t    total = input_tokens + output_tokens\n   251\t    reported_total = usage.get(\"total_tokens\", total)\n   252\t    if isinstance(reported_total, bool) or not isinstance(reported_total, int) or reported_total < 0:\n   253\t        raise ProviderTransportError(\"Codex usage.total_tokens is invalid\", raw_log=raw_log)\n   254\t    return Usage(input_tokens, output_tokens, total, None)\n","exit_code":0,"status":"completed"}}
