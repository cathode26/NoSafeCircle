progressRect.sizeDelta = new Vector2(300f, 20f);\r\n   281\t            var progressBackgroundImage = progressObject.AddComponent<Image>();\r\n   282\t            progressBackgroundImage.sprite = AssetDatabase.GetBuiltinExtraResource<Sprite>(\"UI/Skin/Background.psd\");\r\n   283\t            progressBackgroundImage.type = Image.Type.Sliced;\r\n   284\t            progressBackgroundImage.color = new Color(0.15f, 0.15f, 0.15f, 0.85f);\r\n   285\t\r\n   286\t            var progressFillObject = new GameObject(\"Fill\");\r\n   287\t            progressFillObject.transform.SetParent(progressObject.transform, false);\r\n   288\t            var progressFillRect = progressFillObject.AddComponent<RectTransform>();\r\n   289\t            progressFillRect.anchorMin = Vector2.zero;\r\n   290\t            progressFillRect.anchorMax = Vector2.one;\r\n   291\t            progressFillRect.offsetMin = Vector2.zero;\r\n   292\t            progressFillRect.offsetMax = Vector2.zero;\r\n   293\t            var progressFill = progressFillObject.AddComponent<Image>();\r\n   294\t            // A Filled Image with no sprite bypasses fill geometry and always renders as a full\r\n   295\t            // solid rect, so fillAmount visibly does nothing without a sprite assigned here.\r\n   296\t            progressFill.sprite = AssetDatabase.GetBuiltinExtraResource<Sprite>(\"UI/Skin/UISprite.psd\");\r\n   297\t            progressFill.type = Image.Type.Filled;\r\n   298\t            progressFill.fillMethod = Image.FillMethod.Horizontal;\r\n   299\t            progressFill.fillOrigin = (int)Image.OriginHorizontal.Left;\r\n   300\t            progressFill.fillAmount = 0f;\r\n   301\t            progressFill.color = Color.green;\r\n   302\t\r\n   303\t            var uiBinding = canvasObject.AddComponent<DoorInteractionUI>();\r\n   304\t            SetPrivateField(uiBinding, \"door\", door);\r\n   305\t            SetPrivateField(uiBinding, \"promptRoot\", promptRoot);\r\n   306\t            SetPrivateField(uiBinding, \"progressFillImage\", progressFill);\r\n   307\t\r\n   308\t            var buttonObject = new GameObject(\"DebugDamageButton\");\r\n   309\t            buttonObject.transform.SetParent(canvasObject.transform, false);\r\n   310\t            var buttonRect = buttonObject.AddComponent<RectTransform>();\r\n   311\t            buttonRect.anchorMin = new Vector2(0.02f, 0.02f);\r\n   312\t            buttonRect.anchorMax = new Vector2(0.02f, 0.02f);\r\n   313\t            buttonRect.pivot = Vector2.zero;\r\n   314\t            buttonRect.sizeDelta = new Vector2(260f, 40f);\r\n   315\t            var buttonImage = buttonObject.AddComponent<Image>();\r\n   316\t            buttonImage.color = new Color(0.6f, 0.1f, 0.1f);\r\n   317\t            var damageButton = buttonObject.AddComponent<Button>();\r\n   318\t            damageButton.targetGraphic = buttonImage;\r\n   319\t\r\n   320\t            var buttonTextObject = new GameObject(\"Text\");\r\n   321\t            buttonTextObject.transform.SetParent(buttonObject.transform, false);\r\n   322\t            var buttonTextRect = buttonTextObject.AddComponent<RectTransform>();\r\n   323\t            buttonTextRect.anchorMin = Vector2.zero;\r\n   324\t            buttonTextRect.anchorMax = Vector2.one;\r\n   325\t            buttonTextRect.sizeDelta = Vector2.zero;\r\n   326\t            var buttonText = buttonTextObject.AddComponent<Text>();\r\n   327\t            buttonText.text = \"DEBUG: Take Damage (K)\";\r\n   328\t            buttonText.alignment = TextAnchor.MiddleCenter;\r\n   329\t            buttonText.font = Resources.GetBuiltinResource<Font>(\"LegacyRuntime.ttf\");\r\n   330\t            buttonText.color = Color.white;\r\n   331\t            buttonText.fontSize = 14;\r\n   332\t\r\n   333\t            UnityEventTools.AddPersistentListener(damageButton.onClick, debugControl.TriggerDebugDamage);\r\n   334\t\r\n   335\t            BuildManaUI(canvasObject, mana, debugManaControl);\r\n   336\t\r