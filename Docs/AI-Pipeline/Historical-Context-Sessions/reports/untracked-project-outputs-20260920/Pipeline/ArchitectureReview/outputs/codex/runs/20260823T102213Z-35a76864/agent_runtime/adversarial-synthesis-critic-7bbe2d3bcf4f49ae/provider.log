{"type":"item.completed","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -lc \"nl -ba Pipeline/TaskGraph/current_conformance.py | sed -n '115,270p'\"","aggregated_output":"   115\t    if any(not isinstance(item, str) or not item for item in result) or len(set(result)) != len(result):\r\n   116\t        raise ConformanceRecordError(\"Current task contract has invalid or duplicate completion gate IDs.\")\r\n   117\t    return result  # type: ignore[return-value]\r\n   118\t\r\n   119\t\r\n   120\tdef _maximal(repo: GitRepository, records: list[CommittedRecord]) -> list[CommittedRecord]:\r\n   121\t    maximal: list[CommittedRecord] = []\r\n   122\t    for candidate in records:\r\n   123\t        if any(\r\n   124\t            other.record_id != candidate.record_id\r\n   125\t            and other.validated_commit != candidate.validated_commit\r\n   126\t            and repo.is_ancestor(candidate.validated_commit, other.validated_commit)\r\n   127\t            for other in records\r\n   128\t        ):\r\n   129\t            continue\r\n   130\t        maximal.append(candidate)\r\n   131\t    return sorted(maximal, key=lambda item: item.record_id)\r\n   132\t\r\n   133\t\r\n   134\tdef evaluate_current_conformance(root: Path | str = ROOT, selector: str = \"\") -> ConformanceState:\r\n   135\t    repo = GitRepository(root)\r\n   136\t    head = repo.head()\r\n   137\t    head_tree = repo.tree(head)\r\n   138\t    dirty = repo.dirty()\r\n   139\t    task_path, task = resolve_committed_task(repo, head, selector)\r\n   140\t    task_id = str(task.get(\"id\") or \"\")\r\n   141\t    title = str(task.get(\"title\") or \"\")\r\n   142\t\r\n   143\t    if task.get(\"schema_version\") != \"2.0\":\r\n   144\t        raise ValueError(f\"{task_id or task_path}: state requires a schema-v2 task contract at committed HEAD.\")\r\n   145\t\r\n   146\t    disposition = task.get(\"contract_disposition\")\r\n   147\t    if disposition in {\"cancelled\", \"superseded\"}:\r\n   148\t        return ConformanceState(task_id, title, disposition, head, head_tree, None,\r\n   149\t            (_finding(f\"contract_{disposition}\", f\"Contract disposition is {disposition}.\"),), dirty)\r\n   150\t    if task.get(\"kind\") == \"feature\" or task.get(\"execution_scope\") != \"single_agent\":\r\n   151\t        return ConformanceState(task_id, title, \"aggregate\", head, head_tree, None,\r\n   152\t            (_finding(\"non_executable_contract\", \"Feature or non-executable contract is aggregate.\"),), dirty)\r\n   153\t\r\n   154\t    try:\r\n   155\t        records = load_committed_records(repo, head, task_id)\r\n   156\t    except ConformanceRecordError as exc:\r\n   157\t        return ConformanceState(task_id, title, \"invalid_evidence\", head, head_tree, None,\r\n   158\t            (_finding(\"record_structure_invalid\", str(exc)),), dirty)\r\n   159\t    if not records:\r\n   160\t        return ConformanceState(task_id, title, \"not_delivered\", head, head_tree, None,\r\n   161\t            (_finding(\"no_committed_evidence\", \"No committed delivery, baseline, or revalidation record exists.\"),), dirty)\r\n   162\t\r\n   163\t    invalid = _validate_basis_graph(repo, records)\r\n   164\t    current_contract_hash = semantic_json_sha256(repo.read(head, task_path))\r\n   165\t    current_revision = task.get(\"contract_revision\")\r\n   166\t    current_canon_hash = canonical_text_sha256(repo.read(head, CANON_PATH))\r\n   167\t    current_gate_ids = _current_gate_ids(task)\r\n   168\t    conformant: list[CommittedRecord] = []\r\n   169\t    replan: list[CommittedRecord] = []\r\n   170\t    human: list[CommittedRecord] = []\r\n   171\t    stale: list[CommittedRecord] = []\r\n   172\t\r\n   173\t    for record in records:\r\n   174\t        data = record.data\r\n   175\t        state = data[\"validated_state\"]\r\n   176\t        try:\r\n   177\t            if repo.tree(state[\"commit\"]) != state[\"tree\"]:\r\n   178\t                invalid.append(_finding(\"validated_tree_mismatch\", \"Recorded tree does not match validated commit.\", record))\r\n   179\t                continue\r\n   180\t            contract = data[\"task_contract\"]\r\n   181\t            historical_task_raw = repo.read(state[\"commit\"], contract[\"path\"])\r\n   182\t            historical_task = json.loads(historical_task_raw.decode(\"utf-8-sig\"))\r\n   183\t            if semantic_json_sha256(historical_task) != contract[\"sha256\"] or historical_task.get(\"contract_revision\") != contract[\"revision\"] or historical_task.get(\"id\") != task_id:\r\n   184\t                invalid.append(_finding(\"recorded_contract_mismatch\", \"Recorded contract identity/hash is false at validated commit.\", record))\r\n   185\t                continue\r\n   186\t            canon = data[\"canon\"]\r\n   187\t            if canonical_text_sha256(repo.read(state[\"commit\"], canon[\"path\"])) != canon[\"sha256\"]:\r\n   188\t                invalid.append(_finding(\"recorded_canon_mismatch\", \"Recorded canon hash is false at validated commit.\", record))\r\n   189\t                continue\r\n   190\t            bad_surface = False\r\n   191\t            changed_surface = False\r\n   192\t            for surface in data[\"conformance_surfaces\"]:\r\n   193\t                if repo.blob(state[\"commit\"], surface[\"path\"]) != surface[\"blob_sha\"]:\r\n   194\t                    invalid.append(_finding(\"surface_validated_blob_mismatch\", f\"Surface {surface['path']} blob is false at validated commit.\", record))\r\n   195\t                    bad_surface = True\r\n   196\t                    break\r\n   197\t                if not repo.exists(head, surface[\"path\"]) or repo.blob(head, surface[\"path\"]) != surface[\"blob_sha\"]:\r\n   198\t                    changed_surface = True\r\n   199\t            if bad_surface:\r\n   200\t                continue\r\n   201\t            artifact_bad = False\r\n   202\t            for gate in data[\"gate_results\"]:\r\n   203\t                for evidence in gate[\"evidence\"]:\r\n   204\t                    artifact_prefix = f\"Pipeline/TaskGraph/evidence/{task_id}/artifacts/\"\r\n   205\t                    if not evidence[\"path\"].startswith(artifact_prefix):\r\n   206\t                        invalid.append(_finding(\"artifact_location_invalid\", f\"Gate artifact is outside {artifact_prefix}.\", record))\r\n   207\t                        artifact_bad = True\r\n   208\t                    elif not repo.exists(head, evidence[\"path\"]) or repo.blob(head, evidence[\"path\"]) != evidence[\"blob_sha\"]:\r\n   209\t                        invalid.append(_finding(\"artifact_blob_mismatch\", f\"Evidence artifact {evidence['path']} is absent or altered at HEAD.\", record))\r\n   210\t                        artifact_bad = True\r\n   211\t            if artifact_bad:\r\n   212\t                continue\r\n   213\t        except (ConformanceRecordError, json.JSONDecodeError, UnicodeDecodeError) as exc:\r\n   214\t            invalid.append(_finding(\"record_object_unavailable\", str(exc), record))\r\n   215\t            continue\r\n   216\t\r\n   217\t        if not repo.is_ancestor(state[\"commit\"], head):\r\n   218\t            stale.append(record)\r\n   219\t            continue\r\n   220\t\r\n   221\t        record_gate_ids = [gate[\"gate_id\"] for gate in data[\"gate_results\"]]\r\n   222\t        if record_gate_ids != current_gate_ids and set(record_gate_ids) != set(current_gate_ids):\r\n   223\t            invalid.append(_finding(\"completion_gate_set_mismatch\", \"Record does not contain exactly the current completion-gate set.\", record))\r\n   224\t            continue\r\n   225\t        contract_changed = contract[\"path\"] != task_path or contract[\"revision\"] != current_revision or contract[\"sha256\"] != current_contract_hash\r\n   226\t        if contract_changed:\r\n   227\t            replan.append(record)\r\n   228\t            continue\r\n   229\t        approval = data[\"human_approval\"]\r\n   230\t        if approval[\"required\"] and (approval[\"decision\"] != \"approved\" or not approval[\"approved_by\"].strip()):\r\n   231\t            human.append(record)\r\n   232\t            continue\r\n   233\t        if (not approval[\"required\"] and approval[\"decision\"] != \"not_required\"):\r\n   234\t            invalid.append(_finding(\"human_approval_contradictory\", \"Non-required approval must use not_required.\", record))\r\n   235\t            continue\r\n   236\t        if changed_surface or canon[\"path\"] != CANON_PATH or canon[\"sha256\"] != current_canon_hash:\r\n   237\t            stale.append(record)\r\n   238\t            continue\r\n   239\t        conformant.append(record)\r\n   240\t\r\n   241\t    if invalid:\r\n   242\t        return ConformanceState(task_id, title, \"invalid_evidence\", head, head_tree, None, tuple(invalid), dirty)\r\n   243\t    if conformant:\r\n   244\t        maximal = _maximal(repo, conformant)\r\n   245\t        if len(maximal) != 1:\r\n   246\t            ids = \", \".join(item.record_id for item in maximal)\r\n   247\t            return ConformanceState(task_id, title, \"ambiguous_evidence\", head, head_tree, None,\r\n   248\t                (_finding(\"multiple_maximal_current_records\", f\"Multiple maximal current-valid records: {ids}.\"),), dirty)\r\n   249\t        selected = maximal[0]\r\n   250\t        return ConformanceState(task_id, title, \"conformant\", head, head_tree, selected.record_id,\r\n   251\t            (_finding(\"current_record_selected\", \"Record is valid for current contract, canon, surfaces, gates, and artifacts.\", selected),), dirty)\r\n   252\t    for state_name, candidates, code, message in (\r\n   253\t        (\"needs_replan\", replan, \"contract_changed\", \"Current contract revision or semantic hash differs from prior evidence.\"),\r\n   254\t        (\"needs_human\", human, \"human_approval_missing\", \"Required human approval is missing.\"),\r\n   255\t        (\"needs_revalidation\", stale, \"evidence_stale\", \"Prior evidence exists but is not current for HEAD.\"),\r\n   256\t    ):\r\n   257\t        if candidates:\r\n   258\t            maximal = _maximal(repo, candidates)\r\n   259\t            selected = maximal[0] if len(maximal) == 1 else None\r\n   260\t            return ConformanceState(task_id, title, state_name, head, head_tree,\r\n   261\t                selected.record_id if selected else None, (_finding(code, message, selected),), dirty)\r\n   262\t    return ConformanceState(task_id, title, \"not_delivered\", head, head_tree, None,\r\n   263\t        (_finding(\"no_usable_evidence\", \"No usable committed evidence exists.\"),), dirty)\r\n","exit_code":0,"status":"completed"}}
