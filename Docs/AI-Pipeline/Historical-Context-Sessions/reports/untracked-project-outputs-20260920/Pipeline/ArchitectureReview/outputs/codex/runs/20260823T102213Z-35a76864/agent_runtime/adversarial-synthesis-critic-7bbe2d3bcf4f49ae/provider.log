{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"nl -ba 'Pipeline/Testing/run_unity_tests_clean.ps1'\"","aggregated_output":"     1\t[CmdletBinding()]\r\n     2\tparam(\r\n     3\t    [Parameter(Mandatory = $true)]\r\n     4\t    [ValidateSet(\"EditMode\", \"PlayMode\")]\r\n     5\t    [string]$TestPlatform,\r\n     6\t\r\n     7\t    [Parameter(Mandatory = $true)]\r\n     8\t    [ValidateNotNullOrEmpty()]\r\n     9\t    [string]$TestFilter,\r\n    10\t\r\n    11\t    [string]$UnityExecutable,\r\n    12\t\r\n    13\t    [string]$ProjectPath\r\n    14\t)\r\n    15\t\r\n    16\t$ErrorActionPreference = \"Stop\"\r\n    17\t$ExitPrecondition = 10\r\n    18\t$ExitUnity = 20\r\n    19\t$ExitResult = 30\r\n    20\t$ExitMutation = 40\r\n    21\t\r\n    22\tfunction Invoke-Git {\r\n    23\t    param([string]$RepositoryRoot, [string[]]$Arguments)\r\n    24\t\r\n    25\t    $output = & git -C $RepositoryRoot @Arguments 2>&1\r\n    26\t    if ($LASTEXITCODE -ne 0) {\r\n    27\t        throw \"Git command failed: git -C `\"$RepositoryRoot`\" $($Arguments -join ' ')`n$($output -join [Environment]::NewLine)\"\r\n    28\t    }\r\n    29\t    return ($output | Out-String).Trim()\r\n    30\t}\r\n    31\t\r\n    32\tfunction Get-WorkingTreeStatus {\r\n    33\t    param([string]$RepositoryRoot)\r\n    34\t    return Invoke-Git $RepositoryRoot @(\"status\", \"--porcelain=v1\", \"--untracked-files=all\")\r\n    35\t}\r\n    36\t\r\n    37\tfunction Stop-WithCode {\r\n    38\t    param([int]$Code, [string]$Message)\r\n    39\t    [Console]::Error.WriteLine($Message)\r\n    40\t    exit $Code\r\n    41\t}\r\n    42\t\r\n    43\tfunction ConvertTo-WindowsCommandLineArgument {\r\n    44\t    param([AllowEmptyString()][string]$Argument)\r\n    45\t\r\n    46\t    # Start-Process in Windows PowerShell 5.1 joins ArgumentList into one command\r\n    47\t    # line. Quote each value using the CommandLineToArgvW escaping rules.\r\n    48\t    $quoted = New-Object System.Text.StringBuilder\r\n    49\t    [void]$quoted.Append('\"')\r\n    50\t    $backslashes = 0\r\n    51\t    foreach ($character in $Argument.ToCharArray()) {\r\n    52\t        if ($character -eq '\\') {\r\n    53\t            $backslashes++\r\n    54\t            continue\r\n    55\t        }\r\n    56\t        if ($character -eq '\"') {\r\n    57\t            [void]$quoted.Append(('\\' * (($backslashes * 2) + 1)))\r\n    58\t            [void]$quoted.Append('\"')\r\n    59\t            $backslashes = 0\r\n    60\t            continue\r\n    61\t        }\r\n    62\t        if ($backslashes -gt 0) {\r\n    63\t            [void]$quoted.Append(('\\' * $backslashes))\r\n    64\t            $backslashes = 0\r\n    65\t        }\r\n    66\t        [void]$quoted.Append($character)\r\n    67\t    }\r\n    68\t    if ($backslashes -gt 0) {\r\n    69\t        [void]$quoted.Append(('\\' * ($backslashes * 2)))\r\n    70\t    }\r\n    71\t    [void]$quoted.Append('\"')\r\n    72\t    return $quoted.ToString()\r\n    73\t}\r\n    74\t\r\n    75\ttry {\r\n    76\t    if ([string]::IsNullOrWhiteSpace($ProjectPath)) {\r\n    77\t        $ProjectPath = Join-Path $PSScriptRoot \"..\\..\"\r\n    78\t    }\r\n    79\t    $resolvedProjectPath = (Resolve-Path -LiteralPath $ProjectPath).Path\r\n    80\t    $repositoryRoot = (& git -C $resolvedProjectPath rev-parse --show-toplevel 2>$null | Out-String).Trim()\r\n    81\t    if ($LASTEXITCODE -ne 0 -or [string]::IsNullOrWhiteSpace($repositoryRoot)) {\r\n    82\t        Stop-WithCode $ExitPrecondition \"PRECONDITION FAILURE: ProjectPath is not inside a Git repository: $resolvedProjectPath\"\r\n    83\t    }\r\n    84\t    $repositoryRoot = (Resolve-Path -LiteralPath $repositoryRoot).Path\r\n    85\t\r\n    86\t    $projectSettings = Join-Path $resolvedProjectPath \"ProjectSettings\\ProjectVersion.txt\"\r\n    87\t    if (-not (Test-Path -LiteralPath $projectSettings -PathType Leaf)) {\r\n    88\t        Stop-WithCode $ExitPrecondition \"PRECONDITION FAILURE: ProjectPath is not a Unity project: $resolvedProjectPath\"\r\n    89\t    }\r\n    90\t\r\n    91\t    $preStatus = Get-WorkingTreeStatus $repositoryRoot\r\n    92\t    if (-not [string]::IsNullOrWhiteSpace($preStatus)) {\r\n    93\t        Write-Host \"Working tree paths present before test run:\"\r\n    94\t        Write-Host $preStatus\r\n    95\t        Stop-WithCode $ExitPrecondition \"PRECONDITION FAILURE: Git working tree must be completely clean, including untracked files.\"\r\n    96\t    }\r\n    97\t\r\n    98\t    $preHead = Invoke-Git $repositoryRoot @(\"rev-parse\", \"HEAD\")\r\n    99\t    $preTree = Invoke-Git $repositoryRoot @(\"rev-parse\", \"HEAD^{tree}\")\r\n   100\t    $versionLine = Get-Content -LiteralPath $projectSettings | Where-Object { $_ -match '^m_EditorVersion:\\s*(.+)$' } | Select-Object -First 1\r\n   101\t    if (-not $versionLine -or $versionLine -notmatch '^m_EditorVersion:\\s*(.+)$') {\r\n   102\t        Stop-WithCode $ExitPrecondition \"PRECONDITION FAILURE: Could not read m_EditorVersion from $projectSettings\"\r\n   103\t    }\r\n   104\t    $unityVersion = $Matches[1].Trim()\r\n   105\t\r\n   106\t    if ([string]::IsNullOrWhiteSpace($UnityExecutable)) {\r\n   107\t        $UnityExecutable = Join-Path ${env:ProgramFiles} \"Unity\\Hub\\Editor\\$unityVersion\\Editor\\Unity.exe\"\r\n   108\t    }\r\n   109\t    if (-not (Test-Path -LiteralPath $UnityExecutable -PathType Leaf)) {\r\n   110\t        Stop-WithCode $ExitPrecondition \"PRECONDITION FAILURE: Unity executable does not exist: $UnityExecutable\"\r\n   111\t    }\r\n   112\t\r\n   113\t    $artifactDirectory = Join-Path ([System.IO.Path]::GetTempPath()) (\"NoSafeCircle-UnityTests-\" + [Guid]::NewGuid().ToString(\"N\"))\r\n   114\t    New-Item -ItemType Directory -Path $artifactDirectory | Out-Null\r\n   115\t    $xmlPath = Join-Path $artifactDirectory \"test-results.xml\"\r\n   116\t    $logPath = Join-Path $artifactDirectory \"unity.log\"\r\n   117\t    Write-Host \"Temporary artifacts will be preserved at: $artifactDirectory\"\r\n   118\t\r\n   119\t    $unityExitCode = $null\r\n   120\t    $invocationFailure = $null\r\n   121\t    $xmlPublished = $false\r\n   122\t    try {\r\n   123\t        $unityArguments = @(\r\n   124\t            \"-batchmode\",\r\n   125\t            \"-projectPath\", (ConvertTo-WindowsCommandLineArgument $resolvedProjectPath),\r\n   126\t            \"-runTests\",\r\n   127\t            \"-testPlatform\", (ConvertTo-WindowsCommandLineArgument $TestPlatform),\r\n   128\t            \"-testFilter\", (ConvertTo-WindowsCommandLineArgument $TestFilter),\r\n   129\t            \"-testResults\", (ConvertTo-WindowsCommandLineArgument $xmlPath),\r\n   130\t            \"-logFile\", (ConvertTo-WindowsCommandLineArgument $logPath)\r\n   131\t        )\r\n   132\t        $unityProcess = Start-Process -FilePath $UnityExecutable -ArgumentList $unityArguments -Wait -PassThru\r\n   133\t        $unityExitCode = $unityProcess.ExitCode\r\n   134\t\r\n   135\t        $xmlPublicationDeadline = [DateTime]::UtcNow.AddSeconds(5)\r\n   136\t        do {\r\n   137\t            $xmlPublished = Test-Path -LiteralPath $xmlPath -PathType Leaf\r\n   138\t            if (-not $xmlPublished -and [DateTime]::UtcNow -lt $xmlPublicationDeadline) {\r\n   139\t                Start-Sleep -Milliseconds 100\r\n   140\t            }\r\n   141\t        } while (-not $xmlPublished -and [DateTime]::UtcNow -lt $xmlPublicationDeadline)\r\n   142\t    }\r\n   143\t    catch {\r\n   144\t        $invocationFailure = $_.Exception.Message\r\n   145\t        $unityExitCode = -1\r\n   146\t    }\r\n   147\t    finally {\r\n   148\t        $postCheckFailure = $null\r\n   149\t        try {\r\n   150\t            $postHead = Invoke-Git $repositoryRoot @(\"rev-parse\", \"HEAD\")\r\n   151\t            $postTree = Invoke-Git $repositoryRoot @(\"rev-parse\", \"HEAD^{tree}\")\r\n   152\t            $postStatus = Get-WorkingTreeStatus $repositoryRoot\r\n   153\t        }\r\n   154\t        catch {\r\n   155\t            $postCheckFailure = $_.Exception.Message\r\n   156\t        }\r\n   157\t    }\r\n   158\t\r\n   159\t    if ($postCheckFailure) {\r\n   160\t        Stop-WithCode $ExitMutation \"REPOSITORY CHECK FAILURE: Post-run Git checks could not complete: $postCheckFailure\"\r\n   161\t    }\r\n   162\t    if ($postHead -ne $preHead) {\r\n   163\t        Stop-WithCode $ExitMutation \"REPOSITORY MUTATION FAILURE: HEAD changed from $preHead to $postHead. No changes were restored.\"\r\n   164\t    }\r\n   165\t    if ($postTree -ne $preTree) {\r\n   166\t        Stop-WithCode $ExitMutation \"REPOSITORY MUTATION FAILURE: Git tree changed from $preTree to $postTree. No changes were restored.\"\r\n   167\t    }\r\n   168\t    if (-not [string]::IsNullOrWhiteSpace($postStatus)) {\r\n   169\t        Write-Host \"Working tree paths changed or created during the test run:\"\r\n   170\t        Write-Host $postStatus\r\n   171\t        Stop-WithCode $ExitMutation \"REPOSITORY MUTATION FAILURE: Passing assertions plus a dirty repository is failure. No changes were restored.\"\r\n   172\t    }\r\n   173\t\r\n   174\t    if ($invocationFailure) {\r\n   175\t        Stop-WithCode $ExitUnity \"UNITY FAILURE: Unity could not be invoked: $invocationFailure`nXML: $xmlPath`nLog: $logPath\"\r\n   176\t    }\r\n   177\t    if ($unityExitCode -ne 0) {\r\n   178\t        Stop-WithCode $ExitUnity \"UNITY FAILURE: Unity exited with code $unityExitCode.`nXML: $xmlPath`nLog: $logPath\"\r\n   179\t    }\r\n   180\t    if (-not $xmlPublished) {\r\n   181\t        Stop-WithCode $ExitResult \"RESULT FAILURE: Unity did not create the required XML result file: $xmlPath\"\r\n   182\t    }\r\n   183\t\r\n   184\t    try {\r\n   185\t        [xml]$resultDocument = Get-Content -LiteralPath $xmlPath -Raw\r\n   186\t        $testRun = $resultDocument.SelectSingleNode(\"/test-run\")\r\n   187\t        if ($null -eq $testRun) {\r\n   188\t            throw \"Missing test-run root element.\"\r\n   189\t        }\r\n   190\t        $countValues = @{}\r\n   191\t        foreach ($attributeName in @(\"total\", \"passed\", \"failed\", \"skipped\")) {\r\n   192\t            $attributeValue = $testRun.GetAttribute($attributeName)\r\n   193\t            $parsedValue = 0\r\n   194\t            if (-not [int]::TryParse($attributeValue, [ref]$parsedValue) -or $parsedValue -lt 0) {\r\n   195\t                throw \"The test-run $attributeName attribute is missing or invalid.\"\r\n   196\t            }\r\n   197\t            $countValues[$attributeName] = $parsedValue\r\n   198\t        }\r\n   199\t        $total = $countValues[\"total\"]\r\n   200\t        $passed = $countValues[\"passed\"]\r\n   201\t        $failed = $countValues[\"failed\"]\r\n   202\t        $skipped = $countValues[\"skipped\"]\r\n   203\t        $result = $testRun.GetAttribute(\"result\")\r\n   204\t        if ([string]::IsNullOrWhiteSpace($result)) {\r\n   205\t            throw \"The test-run result attribute is missing.\"\r\n   206\t        }\r\n   207\t    }\r\n   208\t    catch {\r\n   209\t        Stop-WithCode $ExitResult \"RESULT FAILURE: XML is missing required test-run data or is malformed: $($_.Exception.Message)\"\r\n   210\t    }\r\n   211\t\r\n   212\t    Write-Host \"Git HEAD: $preHead\"\r\n   213\t    Write-Host \"Git tree: $preTree\"\r\n   214\t    Write-Host \"Post-run tree: $postTree\"\r\n   215\t    Write-Host \"Unity version: $unityVersion\"\r\n   216\t    Write-Host \"Unity executable: $UnityExecutable\"\r\n   217\t    Write-Host \"Unity exit code: $unityExitCode\"\r\n   218\t    Write-Host \"Result: $result (total=$total passed=$passed failed=$failed skipped=$skipped)\"\r\n   219\t    Write-Host \"XML: $xmlPath\"\r\n   220\t    Write-Host \"Log: $logPath\"\r\n   221\t\r\n   222\t    if ($failed -ne 0) {\r\n   223\t        Stop-WithCode $ExitResult \"RESULT FAILURE: Test result reports $failed failed test(s).\"\r\n   224\t    }\r\n   225\t    if ($result -ne \"Passed\") {\r\n   226\t        Stop-WithCode $ExitResult \"RESULT FAILURE: Test-run result is '$result', expected 'Passed'.\"\r\n   227\t    }\r\n   228\t\r\n   229\t    Write-Host \"VALIDATION PASSED: assertions passed and the repository remained clean.\"\r\n   230\t    exit 0\r\n   231\t}\r\n   232\tcatch {\r\n   233\t    Stop-WithCode $ExitPrecondition \"PRECONDITION FAILURE: $($_.Exception.Message)\"\r\n   234\t}\r\n","exit_code":0,"status":"completed"}}
