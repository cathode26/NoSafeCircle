{"type":"item.completed","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -lc \"nl -ba Pipeline/TaskGraph/work_graph_validate.py | sed -n '1,330p'\"","aggregated_output":"     1\tfrom __future__ import annotations\r\n     2\t\r\n     3\timport re\r\n     4\tfrom collections import defaultdict\r\n     5\tfrom dataclasses import dataclass\r\n     6\tfrom typing import Any\r\n     7\t\r\n     8\tfrom task_contract_schema import (\r\n     9\t    ALLOWED_CONTRACT_DISPOSITIONS,\r\n    10\t    FORBIDDEN_V2_OPERATIONAL_FIELDS,\r\n    11\t    LEGACY_BOOTSTRAP_STATUSES,\r\n    12\t    TASK_CONTRACT_SCHEMA_VERSION,\r\n    13\t)\r\n    14\t\r\n    15\tPROJECT_ROOT_KEY = \"no-safe-circle\"\r\n    16\tWORK_ID_PATTERN = re.compile(r\"^NSC-(\\d{3,})$\")\r\n    17\tENTRY_ID_PATTERNS = {\r\n    18\t    \"acceptance_criteria\": (\"criterion_id\", re.compile(r\"^AC-\\d{3,}$\")),\r\n    19\t    \"completion_gates\": (\"gate_id\", re.compile(r\"^VAL-\\d{3,}$\")),\r\n    20\t    \"downstream_integration_obligations\": (\r\n    21\t        \"obligation_id\",\r\n    22\t        re.compile(r\"^INT-\\d{3,}$\"),\r\n    23\t    ),\r\n    24\t}\r\n    25\tALLOWED_KINDS = {\"feature\", \"artifact\", \"implementation\"}\r\n    26\tALLOWED_EXECUTION_SCOPES = {\r\n    27\t    \"single_agent\",\r\n    28\t    \"needs_execution_decomposition\",\r\n    29\t    \"human_integration_required\",\r\n    30\t    \"not_applicable\",\r\n    31\t    \"unknown\",\r\n    32\t}\r\n    33\t\r\n    34\t\r\n    35\tclass WorkGraphValidationError(RuntimeError):\r\n    36\t    \"\"\"Raised when an in-memory work graph violates deterministic graph invariants.\"\"\"\r\n    37\t\r\n    38\t\r\n    39\t@dataclass(frozen=True)\r\n    40\tclass WorkGraphValidationSummary:\r\n    41\t    task_count: int\r\n    42\t    parent_edge_count: int\r\n    43\t    dependency_edge_count: int\r\n    44\t    root_id: str\r\n    45\t    root_key: str\r\n    46\t    resource_group_count: int\r\n    47\t    project_requirement_count: int\r\n    48\t    task_schema_version: str\r\n    49\t\r\n    50\t\r\n    51\tdef _require_non_empty_text(value: Any, label: str) -> str:\r\n    52\t    if not isinstance(value, str) or not value.strip():\r\n    53\t        raise WorkGraphValidationError(f\"{label} must be a non-empty string.\")\r\n    54\t    return value.strip()\r\n    55\t\r\n    56\t\r\n    57\tdef _require_list(value: Any, label: str) -> list[Any]:\r\n    58\t    if not isinstance(value, list):\r\n    59\t        raise WorkGraphValidationError(f\"{label} must be a list.\")\r\n    60\t    return value\r\n    61\t\r\n    62\t\r\n    63\tdef _require_positive_int(value: Any, label: str) -> int:\r\n    64\t    if isinstance(value, bool) or not isinstance(value, int) or value < 1:\r\n    65\t        raise WorkGraphValidationError(f\"{label} must be a positive integer.\")\r\n    66\t    return value\r\n    67\t\r\n    68\t\r\n    69\tdef _detect_cycle(edges: dict[str, list[str]], label: str) -> None:\r\n    70\t    visiting: set[str] = set()\r\n    71\t    visited: set[str] = set()\r\n    72\t    stack: list[str] = []\r\n    73\t\r\n    74\t    def visit(node: str) -> None:\r\n    75\t        if node in visited:\r\n    76\t            return\r\n    77\t        if node in visiting:\r\n    78\t            try:\r\n    79\t                start = stack.index(node)\r\n    80\t                cycle = stack[start:] + [node]\r\n    81\t            except ValueError:\r\n    82\t                cycle = [node, node]\r\n    83\t            raise WorkGraphValidationError(\r\n    84\t                f\"{label} contains a cycle: \" + \" -> \".join(cycle)\r\n    85\t            )\r\n    86\t\r\n    87\t        visiting.add(node)\r\n    88\t        stack.append(node)\r\n    89\t        for target in edges.get(node, []):\r\n    90\t            visit(target)\r\n    91\t        stack.pop()\r\n    92\t        visiting.remove(node)\r\n    93\t        visited.add(node)\r\n    94\t\r\n    95\t    for node in edges:\r\n    96\t        visit(node)\r\n    97\t\r\n    98\t\r\n    99\tdef _task_schema_version(tasks: tuple[dict[str, Any], ...]) -> str:\r\n   100\t    versions = {\r\n   101\t        task.get(\"schema_version\")\r\n   102\t        for task in tasks\r\n   103\t        if isinstance(task, dict)\r\n   104\t    }\r\n   105\t    if len(versions) != 1:\r\n   106\t        raise WorkGraphValidationError(\r\n   107\t            f\"Live task graph must use one uniform schema version; found {sorted(map(str, versions))}.\"\r\n   108\t        )\r\n   109\t    version = next(iter(versions))\r\n   110\t    if version not in {\"1.0\", TASK_CONTRACT_SCHEMA_VERSION}:\r\n   111\t        raise WorkGraphValidationError(f\"Unsupported task schema_version: {version!r}\")\r\n   112\t    return str(version)\r\n   113\t\r\n   114\t\r\n   115\tdef _validate_numbered_entries(task_id: str, task: dict[str, Any], field: str) -> None:\r\n   116\t    id_field, pattern = ENTRY_ID_PATTERNS[field]\r\n   117\t    entries = _require_list(task.get(field), f\"{task_id}.{field}\")\r\n   118\t    seen: set[str] = set()\r\n   119\t    for index, entry in enumerate(entries):\r\n   120\t        if not isinstance(entry, dict):\r\n   121\t            raise WorkGraphValidationError(f\"{task_id}.{field}[{index}] must be an object.\")\r\n   122\t        entry_id = _require_non_empty_text(\r\n   123\t            entry.get(id_field), f\"{task_id}.{field}[{index}].{id_field}\"\r\n   124\t        )\r\n   125\t        if not pattern.fullmatch(entry_id):\r\n   126\t            raise WorkGraphValidationError(\r\n   127\t                f\"{task_id}.{field}[{index}].{id_field} has invalid format: {entry_id!r}\"\r\n   128\t            )\r\n   129\t        if entry_id in seen:\r\n   130\t            raise WorkGraphValidationError(\r\n   131\t                f\"{task_id}.{field} contains duplicate {id_field} {entry_id!r}.\"\r\n   132\t            )\r\n   133\t        seen.add(entry_id)\r\n   134\t        _require_non_empty_text(\r\n   135\t            entry.get(\"requirement\"), f\"{task_id}.{field}[{index}].requirement\"\r\n   136\t        )\r\n   137\t        reference = entry.get(\"reference\", \"\")\r\n   138\t        if not isinstance(reference, str):\r\n   139\t            raise WorkGraphValidationError(\r\n   140\t                f\"{task_id}.{field}[{index}].reference must be a string.\"\r\n   141\t            )\r\n   142\t\r\n   143\t\r\n   144\tdef _validate_v1_task(task_id: str, task: dict[str, Any]) -> None:\r\n   145\t    status = _require_non_empty_text(task.get(\"status\"), f\"{task_id}.status\")\r\n   146\t    if status not in LEGACY_BOOTSTRAP_STATUSES:\r\n   147\t        raise WorkGraphValidationError(f\"{task_id} has invalid legacy status: {status!r}\")\r\n   148\t    _require_list(task.get(\"validation_requirements\"), f\"{task_id}.validation_requirements\")\r\n   149\t    source = task.get(\"bootstrap_source\")\r\n   150\t    if not isinstance(source, dict):\r\n   151\t        raise WorkGraphValidationError(f\"{task_id}.bootstrap_source must be an object.\")\r\n   152\t    _require_non_empty_text(\r\n   153\t        source.get(\"reconciliation_run_id\"),\r\n   154\t        f\"{task_id}.bootstrap_source.reconciliation_run_id\",\r\n   155\t    )\r\n   156\t    _require_non_empty_text(\r\n   157\t        source.get(\"verification_run_id\"),\r\n   158\t        f\"{task_id}.bootstrap_source.verification_run_id\",\r\n   159\t    )\r\n   160\t\r\n   161\t\r\n   162\tdef _validate_v2_task(task_id: str, task: dict[str, Any]) -> None:\r\n   163\t    for field in FORBIDDEN_V2_OPERATIONAL_FIELDS:\r\n   164\t        if field in task:\r\n   165\t            raise WorkGraphValidationError(\r\n   166\t                f\"{task_id} schema v2 contract may not contain legacy field {field!r}.\"\r\n   167\t            )\r\n   168\t\r\n   169\t    _require_positive_int(task.get(\"contract_revision\"), f\"{task_id}.contract_revision\")\r\n   170\t    disposition = _require_non_empty_text(\r\n   171\t        task.get(\"contract_disposition\"), f\"{task_id}.contract_disposition\"\r\n   172\t    )\r\n   173\t    if disposition not in ALLOWED_CONTRACT_DISPOSITIONS:\r\n   174\t        raise WorkGraphValidationError(\r\n   175\t            f\"{task_id} has invalid contract_disposition: {disposition!r}\"\r\n   176\t        )\r\n   177\t\r\n   178\t    superseded_by = str(task.get(\"superseded_by\") or \"\").strip()\r\n   179\t    if disposition == \"superseded\" and not superseded_by:\r\n   180\t        raise WorkGraphValidationError(\r\n   181\t            f\"Superseded task {task_id} must identify superseded_by.\"\r\n   182\t        )\r\n   183\t    if disposition != \"superseded\" and superseded_by:\r\n   184\t        raise WorkGraphValidationError(\r\n   185\t            f\"{task_id}.superseded_by is only valid when contract_disposition='superseded'.\"\r\n   186\t        )\r\n   187\t\r\n   188\t    for field in ENTRY_ID_PATTERNS:\r\n   189\t        _validate_numbered_entries(task_id, task, field)\r\n   190\t\r\n   191\t    provenance = task.get(\"provenance\")\r\n   192\t    if not isinstance(provenance, dict):\r\n   193\t        raise WorkGraphValidationError(f\"{task_id}.provenance must be an object.\")\r\n   194\t    origin = _require_non_empty_text(provenance.get(\"origin\"), f\"{task_id}.provenance.origin\")\r\n   195\t    if origin == \"verified_reconciliation_bootstrap\":\r\n   196\t        _require_non_empty_text(\r\n   197\t            provenance.get(\"reconciliation_run_id\"),\r\n   198\t            f\"{task_id}.provenance.reconciliation_run_id\",\r\n   199\t        )\r\n   200\t        _require_non_empty_text(\r\n   201\t            provenance.get(\"verification_run_id\"),\r\n   202\t            f\"{task_id}.provenance.verification_run_id\",\r\n   203\t        )\r\n   204\t    observed_status = provenance.get(\"bootstrap_status_observation\")\r\n   205\t    if observed_status is not None and observed_status not in LEGACY_BOOTSTRAP_STATUSES:\r\n   206\t        raise WorkGraphValidationError(\r\n   207\t            f\"{task_id}.provenance.bootstrap_status_observation is invalid: {observed_status!r}\"\r\n   208\t        )\r\n   209\t\r\n   210\t\r\n   211\tdef validate_work_graph_plan(plan: Any) -> WorkGraphValidationSummary:\r\n   212\t    if not plan.tasks:\r\n   213\t        raise WorkGraphValidationError(\"Work graph contains no tasks.\")\r\n   214\t    if len(plan.id_map) != len(plan.tasks):\r\n   215\t        raise WorkGraphValidationError(\r\n   216\t            f\"ID map/task count mismatch: id_map={len(plan.id_map)}, tasks={len(plan.tasks)}\"\r\n   217\t        )\r\n   218\t\r\n   219\t    schema_version = _task_schema_version(plan.tasks)\r\n   220\t    tasks_by_id: dict[str, dict[str, Any]] = {}\r\n   221\t    tasks_by_key: dict[str, dict[str, Any]] = {}\r\n   222\t\r\n   223\t    for index, task in enumerate(plan.tasks):\r\n   224\t        if not isinstance(task, dict):\r\n   225\t            raise WorkGraphValidationError(f\"tasks[{index}] is not an object.\")\r\n   226\t\r\n   227\t        task_id = _require_non_empty_text(task.get(\"id\"), f\"tasks[{index}].id\")\r\n   228\t        key = _require_non_empty_text(\r\n   229\t            task.get(\"reconciliation_key\"), f\"tasks[{index}].reconciliation_key\"\r\n   230\t        )\r\n   231\t        title = _require_non_empty_text(task.get(\"title\"), f\"{task_id}.title\")\r\n   232\t        kind = _require_non_empty_text(task.get(\"kind\"), f\"{task_id}.kind\")\r\n   233\t        scope = _require_non_empty_text(task.get(\"execution_scope\"), f\"{task_id}.execution_scope\")\r\n   234\t\r\n   235\t        if task_id in tasks_by_id:\r\n   236\t            raise WorkGraphValidationError(f\"Duplicate task id: {task_id}\")\r\n   237\t        if key in tasks_by_key:\r\n   238\t            raise WorkGraphValidationError(f\"Duplicate reconciliation_key: {key}\")\r\n   239\t        if not WORK_ID_PATTERN.fullmatch(task_id):\r\n   240\t            raise WorkGraphValidationError(f\"Invalid persistent task id: {task_id!r}\")\r\n   241\t        if plan.id_map.get(key) != task_id:\r\n   242\t            raise WorkGraphValidationError(\r\n   243\t                f\"ID map mismatch for {key}: expected {plan.id_map.get(key)!r}, task has {task_id!r}\"\r\n   244\t            )\r\n   245\t        if kind not in ALLOWED_KINDS:\r\n   246\t            raise WorkGraphValidationError(f\"{task_id} has invalid kind: {kind!r}\")\r\n   247\t        if scope not in ALLOWED_EXECUTION_SCOPES:\r\n   248\t            raise WorkGraphValidationError(f\"{task_id} has invalid execution_scope: {scope!r}\")\r\n   249\t        if kind == \"feature\" and scope == \"single_agent\":\r\n   250\t            raise WorkGraphValidationError(\r\n   251\t                f\"Feature node {task_id} ({title}) may not be directly single-agent executable.\"\r\n   252\t            )\r\n   253\t        if scope == \"single_agent\" and kind not in {\"implementation\", \"artifact\"}:\r\n   254\t            raise WorkGraphValidationError(\r\n   255\t                f\"Single-agent work {task_id} must be implementation/artifact, not {kind!r}.\"\r\n   256\t            )\r\n   257\t\r\n   258\t        for field in (\"depends_on\", \"exclusive_resources\", \"acceptance_criteria\"):\r\n   259\t            _require_list(task.get(field), f\"{task_id}.{field}\")\r\n   260\t\r\n   261\t        if schema_version == \"1.0\":\r\n   262\t            _validate_v1_task(task_id, task)\r\n   263\t        else:\r\n   264\t            _validate_v2_task(task_id, task)\r\n   265\t\r\n   266\t        tasks_by_id[task_id] = task\r\n   267\t        tasks_by_key[key] = task\r\n   268\t\r\n   269\t    root_tasks = [task for task in plan.tasks if not str(task.get(\"parent\") or \"\").strip()]\r\n   270\t    if len(root_tasks) != 1:\r\n   271\t        raise WorkGraphValidationError(\r\n   272\t            f\"Work graph must contain exactly one root task; found {len(root_tasks)}.\"\r\n   273\t        )\r\n   274\t    root = root_tasks[0]\r\n   275\t    if root[\"id\"] != \"NSC-001\" or root[\"reconciliation_key\"] != PROJECT_ROOT_KEY:\r\n   276\t        raise WorkGraphValidationError(\r\n   277\t            \"Work graph root must be NSC-001 / no-safe-circle; \"\r\n   278\t            f\"got {root['id']} / {root['reconciliation_key']}\"\r\n   279\t        )\r\n   280\t    if schema_version == TASK_CONTRACT_SCHEMA_VERSION and root[\"contract_disposition\"] != \"active\":\r\n   281\t        raise WorkGraphValidationError(\"Project root contract must remain active.\")\r\n   282\t\r\n   283\t    parent_edges: dict[str, list[str]] = {task_id: [] for task_id in tasks_by_id}\r\n   284\t    parent_edge_count = 0\r\n   285\t    for task_id, task in tasks_by_id.items():\r\n   286\t        parent = str(task.get(\"parent\") or \"\").strip()\r\n   287\t        if task_id == root[\"id\"]:\r\n   288\t            if parent:\r\n   289\t                raise WorkGraphValidationError(\"Project root may not have a parent.\")\r\n   290\t            continue\r\n   291\t        if not parent:\r\n   292\t            raise WorkGraphValidationError(f\"Non-root task {task_id} is missing its parent.\")\r\n   293\t        if parent == task_id:\r\n   294\t            raise WorkGraphValidationError(f\"Task {task_id} may not parent itself.\")\r\n   295\t        if parent not in tasks_by_id:\r\n   296\t            raise WorkGraphValidationError(\r\n   297\t                f\"Task {task_id} references missing parent {parent!r}.\"\r\n   298\t            )\r\n   299\t        parent_edges[task_id].append(parent)\r\n   300\t        parent_edge_count += 1\r\n   301\t    _detect_cycle(parent_edges, \"Parent hierarchy\")\r\n   302\t\r\n   303\t    for task_id in tasks_by_id:\r\n   304\t        cursor = task_id\r\n   305\t        seen: set[str] = set()\r\n   306\t        while cursor != root[\"id\"]:\r\n   307\t            if cursor in seen:\r\n   308\t                raise WorkGraphValidationError(\r\n   309\t                    f\"Parent hierarchy does not terminate at the project root for {task_id}.\"\r\n   310\t                )\r\n   311\t            seen.add(cursor)\r\n   312\t            parent = str(tasks_by_id[cursor].get(\"parent\") or \"\").strip()\r\n   313\t            if not parent:\r\n   314\t                raise WorkGraphValidationError(\r\n   315\t                    f\"Task {task_id} is disconnected from project root {root['id']}.\"\r\n   316\t                )\r\n   317\t            cursor = parent\r\n   318\t\r\n   319\t    dependency_edges: dict[str, list[str]] = {task_id: [] for task_id in tasks_by_id}\r\n   320\t    dependency_edge_count = 0\r\n   321\t    for task_id, task in tasks_by_id.items():\r\n   322\t        dependencies = task[\"depends_on\"]\r\n   323\t        if len(dependencies) != len(set(dependencies)):\r\n   324\t            raise WorkGraphValidationError(f\"Task {task_id} contains duplicate dependencies.\")\r\n   325\t        for dependency_id in dependencies:\r\n   326\t            dependency_id = _require_non_empty_text(\r\n   327\t                dependency_id, f\"{task_id}.depends_on entry\"\r\n   328\t            )\r\n   329\t            if dependency_id == task_id:\r\n   330\t                raise WorkGraphValidationError(f\"Task {task_id} may not depend on itself.\")\r\n","exit_code":0,"status":"completed"}}
