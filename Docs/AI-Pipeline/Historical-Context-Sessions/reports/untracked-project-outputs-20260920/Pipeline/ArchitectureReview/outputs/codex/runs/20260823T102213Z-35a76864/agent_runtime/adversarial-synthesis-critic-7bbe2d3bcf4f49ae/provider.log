ly while v1 files still exist.\r\n   182\t\r\n   183\t    Schema v2 deliberately has no completion status. Dependency readiness is not\r\n   184\t    derived because the dispatch policy that would define it is not enabled.\r\n   185\t    \"\"\"\r\n   186\t    if _is_v2(graph):\r\n   187\t        return []\r\n   188\t    by_id = graph.tasks_by_id\r\n   189\t    ready = []\r\n   190\t    for task in graph.plan.tasks:\r\n   191\t        if task[\"status\"] != \"open\":\r\n   192\t            continue\r\n   193\t        if task[\"kind\"] not in {\"implementation\", \"artifact\"}:\r\n   194\t            continue\r\n   195\t        if task[\"execution_scope\"] != \"single_agent\":\r\n   196\t            continue\r\n   197\t        if all(by_id[dep][\"status\"] == \"complete\" for dep in task[\"depends_on\"]):\r\n   198\t            ready.append(task)\r\n   199\t    return _sorted_tasks(ready)\r\n   200\t\r\n   201\t\r\n   202\tdef ready_tasks(graph):\r\n   203\t    _ = graph\r\n   204\t    raise UnsafeExecutionAuthorizationError(\r\n   205\t        \"ready_tasks() is disabled. Evidence-derived current-state inspection does not \"\r\n   206\t        \"provide execution authority, and dependency-readiness and dispatch policy are \"\r\n   207\t        \"not enabled.\"\r\n   208\t    )\r\n   209\t\r\n   210\t\r\n   211\tdef command_ready(graph) -> int:\r\n   212\t    if _is_v2(graph):\r\n   213\t        print(\"TASK READINESS: UNAVAILABLE — DISPATCH POLICY NOT ENABLED\")\r\n   214\t        print(\"Evidence-derived current-state inspection exists via taskcontrol state.\")\r\n   215\t        print(\"Evidence-derived current conformance has been proven on at least one real task.\")\r\n   216\t        print(\"A conformant result does not establish dependency readiness.\")\r\n   217\t        print(\"Dependency-readiness policy has not been implemented or approved.\")\r\n   218\t        print(\"Dispatch authorization policy has not been implemented or approved.\")\r\n   219\t        print(\"State inspection and a conformant result never authorize autonomous execution.\")\r\n   220\t        print(\"Zero tasks are authorized for autonomous dispatch.\")\r\n   221\t        return 0\r\n   222\t\r\n   223\t    tasks = advisory_ready_tasks(graph)\r\n   224\t    print(\"ADVISORY LEGACY READY WORK — NOT AUTHORIZED FOR AUTONOMOUS DISPATCH\")\r\n   225\t    print(\"This view exists only until schema-v2 migration removes legacy status.\\n\")\r\n   226\t    for task in tasks:\r\n   227\t        print(f\"{task['id']:<8} {task['kind']:<14} {task['title']}\")\r\n   228\t    print(f\"\\n{len(tasks)} advisory task(s). Zero authorized task(s).\")\r\n   229\t    return 0\r\n   230\t\r\n   231\t\r\n   232\tdef command_authorize(graph, selector: str) -> int:\r\n   233\t    task = _resolve_task(graph, selector)\r\n   234\t    assessment = assess_execution_authorization(task)\r\n   235\t    print(\"EXECUTION AUTHORIZATION: DENIED\")\r\n   236\t    print(f\"task:        {task['id']} — {task['title']}\")\r\n   237\t    print(f\"reason_code: {assessment.reason_code}\")\r\n   238\t    print(f\"reason:      {assessment.message}\")\r\n   239\t    return 2\r\n   240\t\r\n   241\t\r\n   242\tdef command_state(selector: str, as_json: bool = False) -> int:\r\n   243\t    result = evaluate_current_conformance(selector=selector)\r\n   244\t    if as_json:\r\n   245\t        print(json.dumps(result.to_dict(), indent=2, sort_keys=True))\r\n   246\t        return 0\r\n   247\t    print(f\"{result.task_id} — {result.title}\")\r\n   248\t    print(f\"derived_state:    {result.state}\")\r\n   249\t    print(f\"HEAD commit:      {result.head_commit}\")\r\n   250\t    print(f\"HEAD tree:        {result.head_tree}\")\r\n   251\t    print(f\"selected_record:  {result.selected_record_id or '(none)'}\")\r\n   252\t    print(\"findings:\")\r\n   253\t    for finding in result.findings:\r\n   254\t        suffix = f\" [{finding.record_id}]\" if finding.record_id else \"\"\r\n   255\t        print(f\"  - {finding.code}{suffix}: {finding.message}\")\r\n   256\t    if result.dirty_worktree:\r\n   257\t        print(\"WARNING: working tree is dirty; state above describes committed HEAD only.\")\r\n   258\t    return 0\r\n   259\t\r\n   260\t\r\n   261\tdef command_graph(graph) -> int:\r\n   262\t    children: dict[str, list[str]] = defaultdict(list)\r\n   263\t    for task in graph.plan.tasks:\r\n   264\t        parent = str(task.get(\"parent\") or \"\").strip()\r\n   265\t        if parent:\r\n   266\t            children[parent].append(task[\"id\"])\r\n   267\t    for values in children.values():\r\n   268\t        values.sort(key=lambda value: int(value.split(\"-\", 1)[1]))\r\n   269\t\r\n   270\t    def render(task_id: str, depth: int) -> None:\r\n   271\t        task = graph.tasks_by_id[task_id]\r\n   272\t        if _is_v2(graph):\r\n   273\t            state = f\"disposition={task['contract_disposition']}\"\r\n   274\t        else:\r\n   275\t            state = f\"legacy_status={task['status']}\"\r\n   276\t        deps = \"\"\r\n   277\t        if task[\"depends_on\"]:\r\n   278\t            deps = \" deps=\" + \",\".join(task[\"depends_on\"])\r\n   279\t        print(\r\n   280\t            f\"{'  ' * depth}{task_id} [{state}] [{task['kind']}] \"\r\n","exit_code":0,"status":"completed"}}
