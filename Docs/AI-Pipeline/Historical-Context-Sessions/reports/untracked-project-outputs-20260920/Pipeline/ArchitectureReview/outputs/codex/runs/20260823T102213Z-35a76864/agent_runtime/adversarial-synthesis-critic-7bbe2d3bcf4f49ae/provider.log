{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"nl -ba 'Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerMana.cs'\"","aggregated_output":"     1\tusing System;\r\n     2\tusing UnityEngine;\r\n     3\t\r\n     4\tnamespace NoSafeCircle.DoorPrototype\r\n     5\t{\r\n     6\t    public class PlayerMana : MonoBehaviour\r\n     7\t    {\r\n     8\t        [SerializeField] private float maxMana = 100f;\r\n     9\t        [SerializeField] private float regenPerSecond = 10f;\r\n    10\t        [SerializeField] private float postCastRegenDelay = 2f;\r\n    11\t\r\n    12\t        private float timeSinceLastSpend;\r\n    13\t\r\n    14\t        public float MaxMana => maxMana;\r\n    15\t        public float PostCastRegenDelay => postCastRegenDelay;\r\n    16\t        public float CurrentMana { get; private set; }\r\n    17\t        public event Action<float> ManaSpent;\r\n    18\t\r\n    19\t        private void Awake()\r\n    20\t        {\r\n    21\t            CurrentMana = maxMana;\r\n    22\t            timeSinceLastSpend = postCastRegenDelay;\r\n    23\t        }\r\n    24\t\r\n    25\t        private void Update()\r\n    26\t        {\r\n    27\t            Tick(Time.deltaTime);\r\n    28\t        }\r\n    29\t\r\n    30\t        /// Advances the regen timer by deltaTime. Public so Play Mode tests can drive\r\n    31\t        /// it deterministically without waiting on real frames, mirroring DoorInteractable.Tick.\r\n    32\t        public void Tick(float deltaTime)\r\n    33\t        {\r\n    34\t            if (CurrentMana >= maxMana) return;\r\n    35\t\r\n    36\t            timeSinceLastSpend += deltaTime;\r\n    37\t            if (timeSinceLastSpend < postCastRegenDelay) return;\r\n    38\t\r\n    39\t            CurrentMana = Mathf.Min(maxMana, CurrentMana + regenPerSecond * deltaTime);\r\n    40\t        }\r\n    41\t\r\n    42\t        /// Attempts to spend mana. Returns false and leaves CurrentMana unchanged when\r\n    43\t        /// the pool doesn't have enough, so callers (spells) know the cast was refused.\r\n    44\t        public bool Spend(float amount)\r\n    45\t        {\r\n    46\t            if (amount <= 0f || amount > CurrentMana) return false;\r\n    47\t\r\n    48\t            CurrentMana -= amount;\r\n    49\t            timeSinceLastSpend = 0f;\r\n    50\t            ManaSpent?.Invoke(amount);\r\n    51\t            return true;\r\n    52\t        }\r\n    53\t    }\r\n    54\t}\r\n","exit_code":0,"status":"completed"}}
