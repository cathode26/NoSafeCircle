     [UnityTest]\r\n    53\t        public IEnumerator Mana_DoesNotRegenerate_DuringPostCastDelay()\r\n    54\t        {\r\n    55\t            mana.Spend(30f);\r\n    56\t            var afterSpend = mana.CurrentMana;\r\n    57\t\r\n    58\t            AdvanceManaTime(mana, mana.PostCastRegenDelay * 0.5f);\r\n    59\t\r\n    60\t            yield return null;\r\n    61\t\r\n    62\t            Assert.AreEqual(afterSpend, mana.CurrentMana, 0.001f);\r\n    63\t        }\r\n    64\t\r\n    65\t        [UnityTest]\r\n    66\t        public IEnumerator Mana_Regenerates_AfterPostCastDelayElapses()\r\n    67\t        {\r\n    68\t            mana.Spend(30f);\r\n    69\t            var afterSpend = mana.CurrentMana;\r\n    70\t\r\n    71\t            AdvanceManaTime(mana, mana.PostCastRegenDelay + 0.5f);\r\n    72\t\r\n    73\t            yield return null;\r\n    74\t\r\n    75\t            Assert.Greater(mana.CurrentMana, afterSpend);\r\n    76\t        }\r\n    77\t\r\n    78\t        [UnityTest]\r\n    79\t        public IEnumerator Spend_DuringRegen_ResetsPostCastDelay()\r\n    80\t        {\r\n    81\t            mana.Spend(10f);\r\n    82\t            AdvanceManaTime(mana, mana.PostCastRegenDelay + 0.5f);\r\n    83\t            var regeneratedMana = mana.CurrentMana;\r\n    84\t\r\n    85\t            mana.Spend(10f);\r\n    86\t            var afterSecondSpend = mana.CurrentMana;\r\n    87\t            AdvanceManaTime(mana, mana.PostCastRegenDelay * 0.5f);\r\n    88\t\r\n    89\t            yield return null;\r\n    90\t\r\n    91\t            Assert.Less(afterSecondSpend, regeneratedMana);\r\n    92\t            Assert.AreEqual(afterSecondSpend, mana.CurrentMana, 0.001f);\r\n    93\t        }\r\n    94\t\r\n    95\t        private static void AdvanceManaTime(PlayerMana target, float totalSeconds)\r\n    96\t        {\r\n    97\t            const float step = 0.05f;\r\n    98\t            var elapsed = 0f;\r\n    99\t            while (elapsed < totalSeconds)\r\n  