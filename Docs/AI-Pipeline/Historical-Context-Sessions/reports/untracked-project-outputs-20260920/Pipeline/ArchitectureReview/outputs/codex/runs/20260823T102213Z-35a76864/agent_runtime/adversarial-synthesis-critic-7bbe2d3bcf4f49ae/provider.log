{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -lc \"nl -ba Pipeline/TaskExecution/contracts.py | sed -n '1,260p'\"","aggregated_output":"     1\t\"\"\"Immutable No Safe Circle task-execution identity contracts.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\tfrom dataclasses import dataclass\n     6\timport re\n     7\tfrom typing import Any, Mapping\n     8\t\n     9\tfrom Pipeline.AgentRuntime.contracts import (\n    10\t    AgentInvocationRequest,\n    11\t    ContractValidationError,\n    12\t    validate_repository_path,\n    13\t)\n    14\t\n    15\t\n    16\tTASK_EXECUTION_REQUEST_SCHEMA_VERSION = \"1.0\"\n    17\t_TASK_ID = re.compile(r\"^NSC-[0-9]{3}$\")\n    18\t_SHA256 = re.compile(r\"^[0-9a-f]{64}$\")\n    19\t\n    20\t\n    21\tdef _expect_fields(value: Mapping[str, Any], expected: set[str], *, where: str) -> None:\n    22\t    if not isinstance(value, Mapping):\n    23\t        raise ContractValidationError(f\"{where} must be an object\")\n    24\t    unknown = set(value) - expected\n    25\t    missing = expected - set(value)\n    26\t    if unknown:\n    27\t        raise ContractValidationError(f\"unsupported {where} fields: {sorted(unknown)}\")\n    28\t    if missing:\n    29\t        raise ContractValidationError(f\"missing {where} fields: {sorted(missing)}\")\n    30\t\n    31\t\n    32\t@dataclass(frozen=True)\n    33\tclass TaskContractIdentity:\n    34\t    path: str\n    35\t    revision: int\n    36\t    sha256: str\n    37\t\n    38\t    def __post_init__(self) -> None:\n    39\t        validate_repository_path(self.path, field=\"task_contract_identity.path\")\n    40\t        if (\n    41\t            isinstance(self.revision, bool)\n    42\t            or not isinstance(self.revision, int)\n    43\t            or self.revision <= 0\n    44\t        ):\n    45\t            raise ContractValidationError(\"task contract revision must be positive\")\n    46\t        if not isinstance(self.sha256, str) or not _SHA256.fullmatch(self.sha256):\n    47\t            raise ContractValidationError(\n    48\t                \"task contract sha256 must be 64 lowercase hex characters\"\n    49\t            )\n    50\t\n    51\t    def to_dict(self) -> dict[str, Any]:\n    52\t        return {\"path\": self.path, \"revision\": self.revision, \"sha256\": self.sha256}\n    53\t\n    54\t    @classmethod\n    55\t    def from_dict(cls, value: Mapping[str, Any]) -> \"TaskContractIdentity\":\n    56\t        _expect_fields(\n    57\t            value,\n    58\t            {\"path\", \"revision\", \"sha256\"},\n    59\t            where=\"task_contract_identity\",\n    60\t        )\n    61\t        return cls(value[\"path\"], value[\"revision\"], value[\"sha256\"])\n    62\t\n    63\t\n    64\t@dataclass(frozen=True)\n    65\tclass TaskExecutionRequest:\n    66\t    schema_version: str\n    67\t    task_id: str\n    68\t    task_contract_identity: TaskContractIdentity\n    69\t    invocation: AgentInvocationRequest\n    70\t\n    71\t    def __post_init__(self) -> None:\n    72\t        if self.schema_version != TASK_EXECUTION_REQUEST_SCHEMA_VERSION:\n    73\t            raise ContractValidationError(\"unsupported TaskExecutionRequest schema_version\")\n    74\t        if not isinstance(self.task_id, str) or not _TASK_ID.fullmatch(self.task_id):\n    75\t            raise ContractValidationError(\"task_id must match NSC-###\")\n    76\t        if type(self.task_contract_identity) is not TaskContractIdentity:\n    77\t            raise ContractValidationError(\"task_contract_identity has the wrong type\")\n    78\t        expected_path = f\"Tasks/{self.task_id}.yaml\"\n    79\t        if self.task_contract_identity.path != expected_path:\n    80\t            raise ContractValidationError(\n    81\t                f\"task_contract_identity.path must equal {expected_path}\"\n    82\t            )\n    83\t        if type(self.invocation) is not AgentInvocationRequest:\n    84\t            raise ContractValidationError(\n    85\t                \"invocation must be an exact AgentInvocationRequest\"\n    86\t            )\n    87\t\n    88\t    def to_dict(self) -> dict[str, Any]:\n    89\t        return {\n    90\t            \"schema_version\": self.schema_version,\n    91\t            \"task_id\": self.task_id,\n    92\t            \"task_contract_identity\": TaskContractIdentity.to_dict(\n    93\t                self.task_contract_identity\n    94\t            ),\n    95\t            \"invocation\": AgentInvocationRequest.to_dict(self.invocation),\n    96\t        }\n    97\t\n    98\t    @classmethod\n    99\t    def from_dict(cls, value: Mapping[str, Any]) -> \"TaskExecutionRequest\":\n   100\t        _expect_fields(\n   101\t            value,\n   102\t            {\"schema_version\", \"task_id\", \"task_contract_identity\", \"invocation\"},\n   103\t            where=\"TaskExecutionRequest\",\n   104\t        )\n   105\t        return cls(\n   106\t            value[\"schema_version\"],\n   107\t            value[\"task_id\"],\n   108\t            TaskContractIdentity.from_dict(value[\"task_contract_identity\"]),\n   109\t            AgentInvocationRequest.from_dict(value[\"invocation\"]),\n   110\t        )\n","exit_code":0,"status":"completed"}}
