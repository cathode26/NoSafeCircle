{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"git show 9f2485dca1b61360e6d02810adc71e021346496e:Tasks/NSC-023.yaml; git show 9f2485dca1b61360e6d02810adc71e021346496e:Pipeline/TaskGraph/evidence/NSC-023/records/BASE-NSC-023-86af98f41ab5.json; git show 9f2485dca1b61360e6d02810adc71e021346496e:Pipeline/Testing/scene_location_smoke_test.py | sed -n '1,240p'\"","aggregated_output":"{\n  \"schema_version\": \"2.0\",\n  \"id\": \"NSC-023\",\n  \"contract_revision\": 1,\n  \"contract_disposition\": \"active\",\n  \"title\": \"Fixed Isometric Camera\",\n  \"reconciliation_key\": \"fixed-isometric-camera\",\n  \"kind\": \"implementation\",\n  \"type\": \"world-foundation\",\n  \"execution_scope\": \"single_agent\",\n  \"execution_reason\": \"The fixed-camera behavior is a bounded implementation contract. Historical delivery does not make its execution scope not-applicable; current completion is derived elsewhere.\",\n  \"decomposition_state\": \"concrete\",\n  \"decomposition_reason\": \"The fixed projection/no-free-rotation behavior is a concrete bounded contract. Delivery state is intentionally separate from decomposition state.\",\n  \"parent\": \"NSC-022\",\n  \"depends_on\": [],\n  \"exclusive_resources\": [],\n  \"acceptance_criteria\": [\n    {\n      \"reference\": \"GDD - Executive Summary / 2.5D Isometric Visual and World Representation\",\n      \"requirement\": \"Camera renders the gameplay world using a fixed orthographic 2.5D isometric projection at a consistent dimetric angle.\",\n      \"criterion_id\": \"AC-001\"\n    },\n    {\n      \"reference\": \"GDD - 2.5D Isometric Visual and World Representation\",\n      \"requirement\": \"No player-controllable free rotation of the world view is exposed; the camera's rotation never changes at runtime.\",\n      \"criterion_id\": \"AC-002\"\n    }\n  ],\n  \"completion_gates\": [\n    {\n      \"reference\": \"Bootstrap repository evidence — DoorPrototypeSceneBuilderTests\",\n      \"requirement\": \"Unity validation confirms the canonical camera is orthographic and uses the fixed approved isometric rotation without a runtime rotation controller.\",\n      \"gate_id\": \"VAL-001\"\n    },\n    {\n      \"reference\": \"Bootstrap repository evidence — IsometricCameraFollow validation\",\n      \"requirement\": \"Unity validation confirms target-follow translation does not change the camera's fixed rotation.\",\n      \"gate_id\": \"VAL-002\"\n    }\n  ],\n  \"downstream_integration_obligations\": [\n    {\n      \"reference\": \"GDD - Camera completion and future integration\",\n      \"requirement\": \"Once the Tilemap/SpriteRenderer world-visual foundation exists, validate that the fixed isometric camera framing remains visually compatible with the new visual layer (alignment/sorting check), without reopening the already-satisfied fixed-angle/no-rotation requirement.\",\n      \"obligation_id\": \"INT-001\"\n    }\n  ],\n  \"gdd_evidence\": [\n    {\n      \"reference\": \"GDD - Executive Summary\",\n      \"requirement\": \"The camera is fixed, the world is viewed at an angle, and the visible environment is authored as isometric art rather than a free-rotation 3D space.\"\n    },\n    {\n      \"reference\": \"GDD - 2.5D Isometric Visual and World Representation\",\n      \"requirement\": \"The camera is fixed in an isometric presentation; the player does not rotate the world view freely.\"\n    }\n  ],\n  \"basis\": \"direct_gdd\",\n  \"source_scope\": \"required\",\n  \"confidence\": \"high\",\n  \"notes\": \"Per current provenance boundary: only the fixed-angle/no-free-rotation requirement is treated as GDD-backed acceptance criteria. The camera's player-follow translation (IsometricCameraFollow) is a valid current implementation detail and is recorded as repository evidence only, since the current GDD does not require player-follow camera behavior.\",\n  \"repository_state_at_bootstrap\": \"implemented\",\n  \"repository_evidence_at_bootstrap\": [\n    {\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Editor/DoorPrototypeSceneBuilder.cs\",\n      \"evidence_type\": \"code\",\n      \"observation\": \"BuildCamera sets camera.orthographic = true, camera.orthographicSize = 8f, and cameraObject.transform.rotation = Quaternion.Euler(30f, -45f, 0f) once; no later code path in the builder modifies camera rotation.\"\n    },\n    {\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scripts/IsometricCameraFollow.cs\",\n      \"evidence_type\": \"code\",\n      \"observation\": \"LateUpdate only writes transform.position = target.position + offset; rotation is never read or written after Initialize captures the position offset.\"\n    },\n    {\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\",\n      \"evidence_type\": \"scene\",\n      \"observation\": \"Serialized Main Camera has orthographic: 1, orthographic size: 8, and a wired IsometricCameraFollow component (target + offset {10,10,-10}); no rotation-modifying component is attached.\"\n    },\n    {\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Tests/Editor/DoorPrototypeSceneBuilderTests.cs\",\n      \"evidence_type\": \"test\",\n      \"observation\": \"Build_MainCamera_IsFixedOrthographicIsometric asserts orthographic mode and rotation equal to Quaternion.Euler(30,-45,0) within 0.01 degrees and absence of any Rotate/Orbit-named component; Build_MainCamera_TranslatesWithPlayerButRotationStaysFixed asserts rotation is unchanged after the player moves and LateUpdate runs.\"\n    }\n  ],\n  \"provenance\": {\n    \"origin\": \"verified_reconciliation_bootstrap\",\n    \"source_schema_version\": \"1.0\",\n    \"reconciliation_run_id\": \"20260821T193541Z-998ee7b5\",\n    \"verification_run_id\": \"20260821T195959Z-43dba5de\",\n    \"bootstrap_status_observation\": \"complete\",\n    \"migration_id\": \"task-contract-schema-v2-20260822-r2\"\n  }\n}\n{\n  \"schema_version\": \"1.0\",\n  \"record_type\": \"baseline\",\n  \"record_id\": \"BASE-NSC-023-86af98f41ab5\",\n  \"task_id\": \"NSC-023\",\n  \"task_contract\": {\n    \"path\": \"Tasks/NSC-023.yaml\",\n    \"revision\": 1,\n    \"sha256\": \"49d6ef99fab8a4a405d1ef16abaf5f84810fe45f511c618437978579957df88c\"\n  },\n  \"canon\": {\n    \"path\": \"Docs/GDD/No_Safe_Circle_GDD.md\",\n    \"sha256\": \"ee2eebd911e92feffc00f7c443873dde31f54e4188244832b2ea018bacba958c\"\n  },\n  \"validated_state\": {\n    \"commit\": \"86af98f41ab53016ef55eca9516cc339a1e4f5d1\",\n    \"tree\": \"3e89c4a4879d1bf4179ae48f95b85dee1abc0d4d\"\n  },\n  \"conformance_surfaces\": [\n    {\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Editor/DoorPrototypeSceneBuilder.cs\",\n      \"blob_sha\": \"5aed87d28ed649fd861c0e35e9d046ec99ce78a2\",\n      \"role\": \"camera_authoring\"\n    },\n    {\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scripts/IsometricCameraFollow.cs\",\n      \"blob_sha\": \"b0b4e7826d97339532771ddc8a63509fd2eb6c0f\",\n      \"role\": \"runtime_camera_follow\"\n    },\n    {\n      \"path\": \"Assets/Scenes/DoorPrototype.unity\",\n      \"blob_sha\": \"d3ac44eaf6b8c12e02db7bd0e5652bb8d7b19c55\",\n      \"role\": \"committed_scene\"\n    },\n    {\n      \"path\": \"Assets/Scenes/DoorPrototype.unity.meta\",\n      \"blob_sha\": \"4e3c78726f7091c0ef0f77460f359b076e673bc6\",\n      \"role\": \"scene_asset_identity\"\n    },\n    {\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Tests/Editor/CommittedSceneCameraConformanceTests.cs\",\n      \"blob_sha\": \"998ee74f2e50e88ac841714dbe81a402aefbc9f3\",\n      \"role\": \"completion_gate_test\"\n    },\n    {\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Tests/Editor/DoorPrototypeSceneBuilderTests.cs\",\n      \"blob_sha\": \"9400822723d7b44ef7a6cf80ab257ba2bdb9c3e1\",\n      \"role\": \"builder_regression_test\"\n    },\n    {\n      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Tests/Editor/NoSafeCircle.DoorPrototype.Tests.Editor.asmdef\",\n      \"blob_sha\": \"8050fe85f86e911e58e7a0ebb9edac46e6c4ef55\",\n      \"role\": \"test_assembly\"\n    },\n    {\n      \"path\": \"ProjectSettings/ProjectVersion.txt\",\n      \"blob_sha\": \"93366d537cbb7326567cbbf55872a00d336c5c99\",\n      \"role\": \"unity_toolchain\"\n    }\n  ],\n  \"gate_results\": [\n    {\n      \"gate_id\": \"VAL-001\",\n      \"result\": \"pass\",\n      \"evidence\": [\n        {\n          \"path\": \"Pipeline/TaskGraph/evidence/NSC-023/artifacts/CommittedSceneCameraConformanceTests-86af98f41ab5.xml\",\n          \"blob_sha\": \"0fc2a56bbd79aaab567cade3554ad2a8a0d34a93\"\n        },\n        {\n          \"path\": \"Pipeline/TaskGraph/evidence/NSC-023/artifacts/DoorPrototypeSceneBuilderTests-86af98f41ab5.xml\",\n          \"blob_sha\": \"ffdca75975f7e6e17cd3b968eec39ec97cf1b6f8\"\n        }\n      ],\n      \"notes\": \"Clean EditMode validation passed the in-memory builder camera checks and direct inspection of the authoritative Assets/Scenes/DoorPrototype.unity fixed orthographic isometric camera.\"\n    },\n    {\n      \"gate_id\": \"VAL-002\",\n      \"result\": \"pass\",\n      \"evidence\": [\n        {\n          \"path\": \"Pipeline/TaskGraph/evidence/NSC-023/artifacts/CommittedSceneCameraConformanceTests-86af98f41ab5.xml\",\n          \"blob_sha\": \"0fc2a56bbd79aaab567cade3554ad2a8a0d34a93\"\n        },\n        {\n          \"path\": \"Pipeline/TaskGraph/evidence/NSC-023/artifacts/DoorPrototypeSceneBuilderTests-86af98f41ab5.xml\",\n          \"blob_sha\": \"ffdca75975f7e6e17cd3b968eec39ec97cf1b6f8\"\n        }\n      ],\n      \"notes\": \"Clean EditMode validation confirmed that the camera follows player translation while preserving its offset and fixed rotation in the authoritative committed scene.\"\n    }\n  ],\n  \"human_approval\": {\n    \"required\": true,\n    \"decision\": \"approved\",\n    \"approved_by\": \"Vincent Liguori\",\n    \"notes\": \"The human approver explicitly opened Assets/Scenes/DoorPrototype.unity without rebuilding it, entered Play Mode, and confirmed orthographic isometric presentation, player-follow translation, fixed camera rotation, usable initial framing, and no blocking missing-reference or Console errors. Git remained clean after the check.\"\n  },\n  \"recorded_at\": \"2026-08-22T20:06:48Z\",\n  \"baseline\": {\n    \"reason_type\": \"pre_evidence_existing_implementation\",\n    \"summary\": \"Establish the first Phase 3 evidence baseline for the pre-existing NSC-023 fixed isometric camera after centralizing the authoritative DoorPrototype scene under Assets/Scenes.\"\n  }\n}\n#!/usr/bin/env python3\n\"\"\"Static checks for the authoritative DoorPrototype Unity scene location.\"\"\"\n\nfrom pathlib import Path, PurePosixPath\nimport re\nimport subprocess\nimport sys\n\n\nROOT = Path(__file__).resolve().parents[2]\nSCENE_PATH = \"Assets/Scenes/DoorPrototype.unity\"\nMETA_PATH = SCENE_PATH + \".meta\"\nEXPECTED_GUID = \"92dbd0a3e6c18e245896a66c5120379d\"\nOBSOLETE_DIRECTORY = Path(\"Assets/NoSafeCircle/DoorPrototype/Scenes\")\nBUILDER_PATH = Path(\"Assets/NoSafeCircle/DoorPrototype/Editor/DoorPrototypeSceneBuilder.cs\")\nCAMERA_FIXTURES = (\n    Path(\"Assets/NoSafeCircle/DoorPrototype/Tests/Editor/DoorPrototypeSceneBuilderTests.cs\"),\n    Path(\"Assets/NoSafeCircle/DoorPrototype/Tests/Editor/CommittedSceneCameraConformanceTests.cs\"),\n)\n\n\ndef read(relative_path: Path | str) -> str:\n    path = ROOT / relative_path\n    if not path.is_file():\n        raise AssertionError(f\"Required file does not exist: {relative_path}\")\n    return path.read_text(encoding=\"utf-8-sig\")\n\n\ndef tracked_files() -> list[str]:\n    result = subprocess.run(\n        [\"git\", \"ls-files\", \"-z\"],\n        cwd=ROOT,\n        check=True,\n        capture_output=True,\n    )\n    return [path.decode(\"utf-8\") for path in result.stdout.split(b\"\\0\") if path]\n\n\ndef main() -> int:\n    tracked = tracked_files()\n    tracked_scenes = [path for path in tracked if PurePosixPath(path).name == \"DoorPrototype.unity\"]\n    if tracked_scenes != [SCENE_PATH]:\n        raise AssertionError(\n            f\"Expected exactly one tracked DoorPrototype.unity at {SCENE_PATH}; found {tracked_scenes}\"\n        )\n\n    if not (ROOT / SCENE_PATH).is_file():\n        raise AssertionError(f\"Authoritative scene does not exist: {SCENE_PATH}\")\n\n    meta = read(META_PATH)\n    guid_match = re.search(r\"(?m)^guid:\\s*([0-9a-fA-F]+)\\s*$\", meta)\n    if guid_match is None or guid_match.group(1) != EXPECTED_GUID:\n        actual = guid_match.group(1) if guid_match else \"missing\"\n        raise AssertionError(f\"Expected {META_PATH} GUID {EXPECTED_GUID}; found {actual}\")\n\n    obsolete_paths = (\n        OBSOLETE_DIRECTORY / \"DoorPrototype.unity\",\n        OBSOLETE_DIRECTORY / \"DoorPrototype.unity.meta\",\n        Path(str(OBSOLETE_DIRECTORY) + \".meta\"),\n    )\n    for obsolete_path in obsolete_paths:\n        if (ROOT / obsolete_path).exists():\n            raise AssertionError(f\"Obsolete Unity asset path still exists: {obsolete_path}\")\n\n    builder = read(BUILDER_PATH)\n    if not re.search(r'private const string SceneFolder\\s*=\\s*\"Assets/Scenes\"\\s*;', builder):\n        raise AssertionError(\"Production scene builder does not use Assets/Scenes\")\n    if not re.search(r'ScenePath\\s*=\\s*SceneFolder\\s*\\+\\s*\"/DoorPrototype\\.unity\"', builder):\n        raise AssertionError(\"Production scene builder does not build DoorPrototype.unity in SceneFolder\")\n\n    for fixture_path in CAMERA_FIXTURES:\n        fixture = read(fixture_path)\n        if SCENE_PATH not in fixture:\n            raise AssertionError(f\"Camera test fixture does not use {SCENE_PATH}: {fixture_path}\")\n\n    obsolete_scene_path = (OBSOLETE_DIRECTORY / \"DoorPrototype.unity\").as_posix()\n    active_files = [\n        path for path in (ROOT / \"Assets\").rglob(\"*.cs\")\n        if path.is_file()\n    ]\n    offenders = [\n        path.relative_to(ROOT).as_posix()\n        for path in active_files\n        if obsolete_scene_path in path.read_text(encoding=\"utf-8-sig\")\n    ]\n    if offenders:\n        raise AssertionError(f\"Active production/test files reference obsolete scene path: {offenders}\")\n\n    print(\"PASS: DoorPrototype scene location and Unity asset identity are authoritative.\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    try:\n        raise SystemExit(main())\n    except (AssertionError, subprocess.CalledProcessError) as error:\n        print(f\"FAIL: {error}\", file=sys.stderr)\n        raise SystemExit(1)\n","exit_code":0,"status":"completed"}}
