{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"nl -ba Docs/Engineering/UNITY_TESTING_POLICY.md | sed -n '43,105p'\nnl -ba Tasks/NSC-005.yaml | sed -n '1,120p'\nnl -ba Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerMana.cs | sed -n '1,90p'\nnl -ba Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerManaUI.cs | sed -n '1,60p'\nnl -ba Assets/NoSafeCircle/DoorPrototype/Scripts/DebugManaSpendControl.cs | sed -n '1,75p'\"","aggregated_output":"    43\t\r\n    44\t- Move scenes, prefabs, and other Unity assets together with their `.meta` files.\r\n    45\t- Never delete or regenerate a tracked `.meta` file as a relocation mechanism.\r\n    46\t- Duplicate authoritative scenes with the same filename are prohibited.\r\n    47\t\r\n    48\t## Committed-artifact conformance tests\r\n    49\t\r\n    50\t- Open the exact committed scene or prefab deliberately.\r\n    51\t- When scenes are loaded additively, scope object lookup to that exact scene.\r\n    52\t- Do not use ambiguous global `GameObject.Find` or `Object.Find` calls across scenes.\r\n    53\t- Close the artifact without saving.\r\n    54\t- Compare bytes or Git blob identity before and after where practical.\r\n    55\t- Distinguish “builder produces this” from “committed artifact currently contains this.” These are different claims and require different tests.\r\n    56\t\r\n    57\t## Isolation and repeatability\r\n    58\t\r\n    59\t- Use explicit setup and cleanup.\r\n    60\t- Do not create test-order dependencies.\r\n    61\t- Do not rely on the current Editor selection or previously loaded scenes.\r\n    62\t- Leave no static or global state behind.\r\n    63\t- Tests must work alone, as a class, in the broader suite, and on repeated runs.\r\n    64\t- Duplicate and idempotence tests must not persist canonical asset changes.\r\n    65\t\r\n    66\t## Contract and gate mapping\r\n    67\t\r\n    68\tEvery test must identify whether it proves:\r\n    69\t\r\n    70\t- an acceptance criterion;\r\n    71\t- a completion gate;\r\n    72\t- a downstream integration obligation; or\r\n    73\t- an explicit regression-only invariant.\r\n    74\t\r\n    75\tThe mapping must name the applicable stable contract or gate identifier when one exists. A regression-only test must not be presented as proof of an acceptance criterion or completion gate.\r\n    76\t\r\n    77\t## Evidence claims\r\n    78\t\r\n    79\tAgents and humans must report literally:\r\n    80\t\r\n    81\t- proposed command;\r\n    82\t- whether it was actually executed;\r\n    83\t- Unity executable and version;\r\n    84\t- exit code;\r\n    85\t- XML result path;\r\n    86\t- total, passed, failed, skipped, and result;\r\n    87\t- Git HEAD and tree tested;\r\n    88\t- working-tree state before and after;\r\n    89\t- known limitations;\r\n    90\t- required human runtime or visual checks.\r\n    91\t\r\n    92\tNever say “tests passed” solely because test source appears correct. Static review, an agent claim, a Unity exit code, XML assertions, and repository cleanliness are distinct facts and must not be conflated.\r\n    93\t\r\n    94\t## Human runtime validation\r\n    95\t\r\n    96\tRequire human Play Mode, visual, input-feel, framing, readability, animation, or interaction checks wherever source-level assertions cannot prove quality. Automated tests may narrow the review surface but do not replace these judgments.\r\n    97\t\r\n    98\t## Required checklists\r\n    99\t\r\n   100\t### Pre-authoring checklist\r\n   101\t\r\n   102\t- Name the selected task contract and approved canon sources.\r\n   103\t- Classify the requested test using the classifications above.\r\n   104\t- Map each planned test to an acceptance criterion, completion gate, downstream obligation, or regression-only invariant.\r\n   105\t- Identify every scene, prefab, asset, setting, and global state the test could touch.\r\n     1\t{\r\n     2\t  \"schema_version\": \"2.0\",\r\n     3\t  \"id\": \"NSC-005\",\r\n     4\t  \"contract_revision\": 1,\r\n     5\t  \"contract_disposition\": \"active\",\r\n     6\t  \"title\": \"Player Mana Ownership, Restart Reset, and Denied-Cast Feedback\",\r\n     7\t  \"reconciliation_key\": \"player-mana\",\r\n     8\t  \"kind\": \"implementation\",\r\n     9\t  \"type\": \"implementation\",\r\n    10\t  \"execution_scope\": \"single_agent\",\r\n    11\t  \"execution_reason\": \"Bounded addition to one existing component (PlayerMana.cs) that does not require new scene-wired UI, since the existing PlayerManaUI/fill Image can consume a new denied-cast event without builder changes.\",\r\n    12\t  \"decomposition_state\": \"concrete\",\r\n    13\t  \"decomposition_reason\": \"Required reset and denied-cast-signal behavior are fully specified by current GDD text without inventing new design; exact feedback presentation is explicitly an implementation choice.\",\r\n    14\t  \"parent\": \"NSC-002\",\r\n    15\t  \"depends_on\": [],\r\n    16\t  \"exclusive_resources\": [],\r\n    17\t  \"acceptance_criteria\": [\r\n    18\t    {\r\n    19\t      \"reference\": \"GDD §5 Runtime Implementation\",\r\n    20\t      \"requirement\": \"Exposes an owner-controlled reset entry point that restores current mana to full and clears post-cast regeneration-delay timer state for floor restart.\",\r\n    21\t      \"criterion_id\": \"AC-001\"\r\n    22\t    },\r\n    23\t    {\r\n    24\t      \"reference\": \"GDD §3 Player Experience Success Criteria — Failure is readable\",\r\n    25\t      \"requirement\": \"Exposes a signal (e.g. an event) when a cast attempt is denied due to insufficient mana, distinct from a successful spend, so a consuming spell/UI can present readable low-mana feedback; exact presentation is an implementation choice.\",\r\n    26\t      \"criterion_id\": \"AC-002\"\r\n    27\t    },\r\n    28\t    {\r\n    29\t      \"reference\": \"GDD §2 Player Mana ownership\",\r\n    30\t      \"requirement\": \"Continues to own only current mana and post-cast regeneration-delay state; does not absorb Fireball/Frost Field/Force Wave spell-local cooldown, charge, cast, placement, or active-field state.\",\r\n    31\t      \"criterion_id\": \"AC-003\"\r\n    32\t    }\r\n    33\t  ],\r\n    34\t  \"completion_gates\": [\r\n    35\t    {\r\n    36\t      \"reference\": \"GDD §2 Resources, Feedback, and Failure\",\r\n    37\t      \"requirement\": \"Existing Play Mode coverage of Spend/regen/post-cast-delay behavior (PlayerManaPlayModeTests.cs) continues to pass and is extended to cover the new reset entry point and denied-cast signal.\",\r\n    38\t      \"gate_id\": \"VAL-001\"\r\n    39\t    },\r\n    40\t    {\r\n    41\t      \"reference\": \"GDD §3 Player Experience Success Criteria\",\r\n    42\t      \"requirement\": \"Validate that failure is readable through low-mana feedback as one of the stated readable failure causes.\",\r\n    43\t      \"gate_id\": \"VAL-002\"\r\n    44\t    },\r\n    45\t    {\r\n    46\t      \"reference\": \"Section 3 - Player Experience Success Criteria\",\r\n    47\t      \"requirement\": \"Failure caused by low mana is readable to the player through the mana indicator, as part of the required 'failure is readable' success criterion.\",\r\n    48\t      \"gate_id\": \"VAL-003\"\r\n    49\t    }\r\n    50\t  ],\r\n    51\t  \"downstream_integration_obligations\": [],\r\n    52\t  \"gdd_evidence\": [\r\n    53\t    {\r\n    54\t      \"reference\": \"GDD §2 Resources, Feedback, and Failure — Player Mana ownership\",\r\n    55\t      \"requirement\": \"The shared Player Mana system is the single owner of current mana and the post-cast regeneration-delay state; spells spend mana through its owner-controlled spend interface; Player Mana does not own spell-local cooldown/charge/cast/placement/active-field state.\"\r\n    56\t    },\r\n    57\t    {\r\n    58\t      \"reference\": \"GDD §5 Runtime Implementation\",\r\n    59\t      \"requirement\": \"Player Mana owns current mana and post-cast regeneration-delay state and exposes an owner-controlled spend/reset interface to spells and restart orchestration.\"\r\n    60\t    },\r\n    61\t    {\r\n    62\t      \"reference\": \"GDD §2 Loss / Floor-run restart ownership\",\r\n    63\t      \"requirement\": \"Player Mana and its regeneration-delay state are required reset participants for the Floor Run/Restart Orchestrator.\"\r\n    64\t    }\r\n    65\t  ],\r\n    66\t  \"basis\": \"direct_gdd\",\r\n    67\t  \"source_scope\": \"required\",\r\n    68\t  \"confidence\": \"high\",\r\n    69\t  \"notes\": \"Force Wave's 25-mana cost and other spell-local spend amounts remain owned by the individual spells, not this item; this item only owns the shared pool, regen-delay, spend interface, reset, and denied-cast signal.\",\r\n    70\t  \"repository_state_at_bootstrap\": \"partial\",\r\n    71\t  \"repository_evidence_at_bootstrap\": [\r\n    72\t    {\r\n    73\t      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerMana.cs\",\r\n    74\t      \"evidence_type\": \"code\",\r\n    75\t      \"observation\": \"Implements CurrentMana/MaxMana, Spend(amount) with silent-fail-on-insufficient behavior, Tick-driven post-cast-delay regeneration, and a ManaSpent event; no reset entry point and no denied-cast event exist.\"\r\n    76\t    },\r\n    77\t    {\r\n    78\t      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerManaUI.cs\",\r\n    79\t      \"evidence_type\": \"code\",\r\n    80\t      \"observation\": \"Continuously binds a fill Image to CurrentMana/MaxMana every Update, satisfying the GDD's continuous mana indicator requirement.\"\r\n    81\t    },\r\n    82\t    {\r\n    83\t      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\",\r\n    84\t      \"evidence_type\": \"scene\",\r\n    85\t      \"observation\": \"Both PlayerMana.cs (guid fd54c6f00e974856b70833ac4771b9ae) and PlayerManaUI.cs (guid 0a03ab321b0847f59d3f91214dabcf5c) are serialized and wired on the Player/Canvas GameObjects, confirming the continuous mana indicator is currently integrated, not just buildable.\"\r\n    86\t    },\r\n    87\t    {\r\n    88\t      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Tests/PlayerManaPlayModeTests.cs\",\r\n    89\t      \"evidence_type\": \"test\",\r\n    90\t      \"observation\": \"Real Play Mode tests cover Spend success/failure, post-cast-delay non-regeneration, regeneration after delay, and delay-reset on subsequent spend.\"\r\n    91\t    }\r\n    92\t  ],\r\n    93\t  \"provenance\": {\r\n    94\t    \"origin\": \"verified_reconciliation_bootstrap\",\r\n    95\t    \"source_schema_version\": \"1.0\",\r\n    96\t    \"reconciliation_run_id\": \"20260821T193541Z-998ee7b5\",\r\n    97\t    \"verification_run_id\": \"20260821T195959Z-43dba5de\",\r\n    98\t    \"bootstrap_status_observation\": \"open\",\r\n    99\t    \"migration_id\": \"task-contract-schema-v2-20260822-r2\"\r\n   100\t  }\r\n   101\t}\r\n     1\tusing System;\r\n     2\tusing UnityEngine;\r\n     3\t\r\n     4\tnamespace NoSafeCircle.DoorPrototype\r\n     5\t{\r\n     6\t    public class PlayerMana : MonoBehaviour\r\n     7\t    {\r\n     8\t        [SerializeField] private float maxMana = 100f;\r\n     9\t        [SerializeField] private float regenPerSecond = 10f;\r\n    10\t        [SerializeField] private float postCastRegenDelay = 2f;\r\n    11\t\r\n    12\t        private float timeSinceLastSpend;\r\n    13\t\r\n    14\t        public float MaxMana => maxMana;\r\n    15\t        public float PostCastRegenDelay => postCastRegenDelay;\r\n    16\t        public float CurrentMana { get; private set; }\r\n    17\t        public event Action<float> ManaSpent;\r\n    18\t\r\n    19\t        private void Awake()\r\n    20\t        {\r\n    21\t            CurrentMana = maxMana;\r\n    22\t            timeSinceLastSpend = postCastRegenDelay;\r\n    23\t        }\r\n    24\t\r\n    25\t        private void Update()\r\n    26\t        {\r\n    27\t            Tick(Time.deltaTime);\r\n    28\t        }\r\n    29\t\r\n    30\t        /// Advances the regen timer by deltaTime. Public so Play Mode tests can drive\r\n    31\t        /// it deterministically without waiting on real frames, mirroring DoorInteractable.Tick.\r\n    32\t        public void Tick(float deltaTime)\r\n    33\t        {\r\n    34\t            if (CurrentMana >= maxMana) return;\r\n    35\t\r\n    36\t            timeSinceLastSpend += deltaTime;\r\n    37\t            if (timeSinceLastSpend < postCastRegenDelay) return;\r\n    38\t\r\n    39\t            CurrentMana = Mathf.Min(maxMana, CurrentMana + regenPerSecond * deltaTime);\r\n    40\t        }\r\n    41\t\r\n    42\t        /// Attempts to spend mana. Returns false and leaves CurrentMana unchanged when\r\n    43\t        /// the pool doesn't have enough, so callers (spells) know the cast was refused.\r\n    44\t        public bool Spend(float amount)\r\n    45\t        {\r\n    46\t            if (amount <= 0f || amount > CurrentMana) return false;\r\n    47\t\r\n    48\t            CurrentMana -= amount;\r\n    49\t            timeSinceLastSpend = 0f;\r\n    50\t            ManaSpent?.Invoke(amount);\r\n    51\t            return true;\r\n    52\t        }\r\n    53\t    }\r\n    54\t}\r\n     1\tusing UnityEngine;\r\n     2\tusing UnityEngine.UI;\r\n     3\t\r\n     4\tnamespace NoSafeCircle.DoorPrototype\r\n     5\t{\r\n     6\t    public class PlayerManaUI : MonoBehaviour\r\n     7\t    {\r\n     8\t        [SerializeField] private PlayerMana mana;\r\n     9\t        [SerializeField] private Image fillImage;\r\n    10\t\r\n    11\t        private void Update()\r\n    12\t        {\r\n    13\t            if (mana == null || fillImage == null) return;\r\n    14\t\r\n    15\t            fillImage.fillAmount = mana.MaxMana > 0f ? mana.CurrentMana / mana.MaxMana : 0f;\r\n    16\t        }\r\n    17\t    }\r\n    18\t}\r\n     1\tusing UnityEngine;\r\n     2\tusing UnityEngine.InputSystem;\r\n     3\t\r\n     4\tnamespace NoSafeCircle.DoorPrototype\r\n     5\t{\r\n     6\t    /// Testing/demo affordance only, not a spell-casting system: lets a developer trigger\r\n     7\t    /// mana spend to demonstrate the pool's spend/post-cast-delay/regen behavior standalone,\r\n     8\t    /// ahead of the real spells that will consume it.\r\n     9\t    public class DebugManaSpendControl : MonoBehaviour\r\n    10\t    {\r\n    11\t        [SerializeField] private PlayerMana target;\r\n    12\t        [SerializeField] private Key spendKey = Key.L;\r\n    13\t        [SerializeField] private float spendAmount = 25f;\r\n    14\t\r\n    15\t        private void Awake()\r\n    16\t        {\r\n    17\t            if (target == null) target = GetComponent<PlayerMana>();\r\n    18\t        }\r\n    19\t\r\n    20\t        private void Update()\r\n    21\t        {\r\n    22\t            var keyboard = Keyboard.current;\r\n    23\t            if (keyboard != null && keyboard[spendKey].wasPressedThisFrame)\r\n    24\t            {\r\n    25\t                TriggerDebugSpend();\r\n    26\t            }\r\n    27\t        }\r\n    28\t\r\n    29\t        public void TriggerDebugSpend()\r\n    30\t        {\r\n    31\t            target?.Spend(spendAmount);\r\n    32\t        }\r\n    33\t    }\r\n    34\t}\r\n","exit_code":0,"status":"completed"}}
