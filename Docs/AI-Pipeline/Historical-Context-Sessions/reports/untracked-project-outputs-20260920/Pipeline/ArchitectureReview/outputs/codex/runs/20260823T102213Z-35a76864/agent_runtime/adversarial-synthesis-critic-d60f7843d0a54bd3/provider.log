{"type":"item.completed","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -lc \"nl -ba Pipeline/Testing/scene_location_smoke_test.py | sed -n '1,135p'\"","aggregated_output":"     1\t#!/usr/bin/env python3\r\n     2\t\"\"\"Static checks for the authoritative DoorPrototype Unity scene location.\"\"\"\r\n     3\t\r\n     4\tfrom pathlib import Path, PurePosixPath\r\n     5\timport re\r\n     6\timport subprocess\r\n     7\timport sys\r\n     8\t\r\n     9\t\r\n    10\tROOT = Path(__file__).resolve().parents[2]\r\n    11\tSCENE_PATH = \"Assets/Scenes/DoorPrototype.unity\"\r\n    12\tMETA_PATH = SCENE_PATH + \".meta\"\r\n    13\tEXPECTED_GUID = \"92dbd0a3e6c18e245896a66c5120379d\"\r\n    14\tOBSOLETE_DIRECTORY = Path(\"Assets/NoSafeCircle/DoorPrototype/Scenes\")\r\n    15\tBUILDER_PATH = Path(\"Assets/NoSafeCircle/DoorPrototype/Editor/DoorPrototypeSceneBuilder.cs\")\r\n    16\tCAMERA_FIXTURES = (\r\n    17\t    Path(\"Assets/NoSafeCircle/DoorPrototype/Tests/Editor/DoorPrototypeSceneBuilderTests.cs\"),\r\n    18\t    Path(\"Assets/NoSafeCircle/DoorPrototype/Tests/Editor/CommittedSceneCameraConformanceTests.cs\"),\r\n    19\t)\r\n    20\t\r\n    21\t\r\n    22\tdef read(relative_path: Path | str) -> str:\r\n    23\t    path = ROOT / relative_path\r\n    24\t    if not path.is_file():\r\n    25\t        raise AssertionError(f\"Required file does not exist: {relative_path}\")\r\n    26\t    return path.read_text(encoding=\"utf-8-sig\")\r\n    27\t\r\n    28\t\r\n    29\tdef tracked_files() -> list[str]:\r\n    30\t    result = subprocess.run(\r\n    31\t        [\"git\", \"ls-files\", \"-z\"],\r\n    32\t        cwd=ROOT,\r\n    33\t        check=True,\r\n    34\t        capture_output=True,\r\n    35\t    )\r\n    36\t    return [path.decode(\"utf-8\") for path in result.stdout.split(b\"\\0\") if path]\r\n    37\t\r\n    38\t\r\n    39\tdef main() -> int:\r\n    40\t    tracked = tracked_files()\r\n    41\t    tracked_scenes = [path for path in tracked if PurePosixPath(path).name == \"DoorPrototype.unity\"]\r\n    42\t    if tracked_scenes != [SCENE_PATH]:\r\n    43\t        raise AssertionError(\r\n    44\t            f\"Expected exactly one tracked DoorPrototype.unity at {SCENE_PATH}; found {tracked_scenes}\"\r\n    45\t        )\r\n    46\t\r\n    47\t    if not (ROOT / SCENE_PATH).is_file():\r\n    48\t        raise AssertionError(f\"Authoritative scene does not exist: {SCENE_PATH}\")\r\n    49\t\r\n    50\t    meta = read(META_PATH)\r\n    51\t    guid_match = re.search(r\"(?m)^guid:\\s*([0-9a-fA-F]+)\\s*$\", meta)\r\n    52\t    if guid_match is None or guid_match.group(1) != EXPECTED_GUID:\r\n    53\t        actual = guid_match.group(1) if guid_match else \"missing\"\r\n    54\t        raise AssertionError(f\"Expected {META_PATH} GUID {EXPECTED_GUID}; found {actual}\")\r\n    55\t\r\n    56\t    obsolete_paths = (\r\n    57\t        OBSOLETE_DIRECTORY / \"DoorPrototype.unity\",\r\n    58\t        OBSOLETE_DIRECTORY / \"DoorPrototype.unity.meta\",\r\n    59\t        Path(str(OBSOLETE_DIRECTORY) + \".meta\"),\r\n    60\t    )\r\n    61\t    for obsolete_path in obsolete_paths:\r\n    62\t        if (ROOT / obsolete_path).exists():\r\n    63\t            raise AssertionError(f\"Obsolete Unity asset path still exists: {obsolete_path}\")\r\n    64\t\r\n    65\t    builder = read(BUILDER_PATH)\r\n    66\t    if not re.search(r'private const string SceneFolder\\s*=\\s*\"Assets/Scenes\"\\s*;', builder):\r\n    67\t        raise AssertionError(\"Production scene builder does not use Assets/Scenes\")\r\n    68\t    if not re.search(r'ScenePath\\s*=\\s*SceneFolder\\s*\\+\\s*\"/DoorPrototype\\.unity\"', builder):\r\n    69\t        raise AssertionError(\"Production scene builder does not build DoorPrototype.unity in SceneFolder\")\r\n    70\t\r\n    71\t    for fixture_path in CAMERA_FIXTURES:\r\n    72\t        fixture = read(fixture_path)\r\n    73\t        if SCENE_PATH not in fixture:\r\n    74\t            raise AssertionError(f\"Camera test fixture does not use {SCENE_PATH}: {fixture_path}\")\r\n    75\t\r\n    76\t    obsolete_scene_path = (OBSOLETE_DIRECTORY / \"DoorPrototype.unity\").as_posix()\r\n    77\t    active_files = [\r\n    78\t        path for path in (ROOT / \"Assets\").rglob(\"*.cs\")\r\n    79\t        if path.is_file()\r\n    80\t    ]\r\n    81\t    offenders = [\r\n    82\t        path.relative_to(ROOT).as_posix()\r\n    83\t        for path in active_files\r\n    84\t        if obsolete_scene_path in path.read_text(encoding=\"utf-8-sig\")\r\n    85\t    ]\r\n    86\t    if offenders:\r\n    87\t        raise AssertionError(f\"Active production/test files reference obsolete scene path: {offenders}\")\r\n    88\t\r\n    89\t    print(\"PASS: DoorPrototype scene location and Unity asset identity are authoritative.\")\r\n    90\t    return 0\r\n    91\t\r\n    92\t\r\n    93\tif __name__ == \"__main__\":\r\n    94\t    try:\r\n    95\t        raise SystemExit(main())\r\n    96\t    except (AssertionError, subprocess.CalledProcessError) as error:\r\n    97\t        print(f\"FAIL: {error}\", file=sys.stderr)\r\n    98\t        raise SystemExit(1)\r\n","exit_code":0,"status":"completed"}}
