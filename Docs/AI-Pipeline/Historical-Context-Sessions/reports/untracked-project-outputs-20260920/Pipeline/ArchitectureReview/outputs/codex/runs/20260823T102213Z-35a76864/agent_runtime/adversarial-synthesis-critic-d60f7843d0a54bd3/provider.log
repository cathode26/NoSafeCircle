",\r\n     6\t  \"title\": \"Mouse-Directed Player Movement, Shared Pointer Projection, and Movement Restriction\",\r\n     7\t  \"reconciliation_key\": \"player-movement\",\r\n     8\t  \"kind\": \"implementation\",\r\n     9\t  \"type\": \"implementation\",\r\n    10\t  \"execution_scope\": \"single_agent\",\r\n    11\t  \"execution_reason\": \"All required responsibilities are cohesively owned by one system (PlayerMovement.cs) plus its Input Actions and builder/scene wiring; it is a bounded rewrite of one component's input/locomotion model rather than a multi-system integration.\",\r\n    12\t  \"decomposition_state\": \"concrete\",\r\n    13\t  \"decomposition_reason\": \"The required behavior (mouse-directed movement via Input System, shared pointer projection, movement-restriction interface, reset entry point) is fully specified by current GDD text without inventing new design.\",\r\n    14\t  \"parent\": \"NSC-002\",\r\n    15\t  \"depends_on\": [],\r\n    16\t  \"exclusive_resources\": [\r\n    17\t    \"repo-file:Assets/InputSystem_Actions.inputactions\",\r\n    18\t    \"repo-file:Assets/NoSafeCircle/DoorPrototype/Editor/DoorPrototypeSceneBuilder.cs\",\r\n    19\t    \"unity-scene:Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\"\r\n    20\t  ],\r\n    21\t  \"acceptance_criteria\": [\r\n    22\t    {\r\n    23\t      \"reference\": \"GDD §2 Move and Aim\",\r\n    24\t      \"requirement\": \"Movement is mouse-directed: a click sets a destination the wizard walks toward, and holding continues steering toward the current cursor position, consumed through Unity Input System/Input Actions rather than direct hardware polling.\",\r\n    25\t      \"criterion_id\": \"AC-001\"\r\n    26\t    },\r\n    27\t    {\r\n    28\t      \"reference\": \"GDD §2 Player Movement ownership\",\r\n    29\t      \"requirement\": \"Exposes a shared world-space pointer target produced by projecting the cursor onto the gameplay plane, consumable by cursor-aimed spells and Door/Interaction without those systems independently projecting screen coordinates.\",\r\n    30\t      \"criterion_id\": \"AC-002\"\r\n    31\t    },\r\n    32\t    {\r\n    33\t      \"reference\": \"GDD §2 Player Movement ownership; §4 Development Agent Ownership Invariants\",\r\n    34\t      \"requirement\": \"Exposes an owner-controlled movement-restriction request/release interface that Charged Fireball can use to restrict movement while charging without Fireball mutating movement internals directly.\",\r\n    35\t      \"criterion_id\": \"AC-003\"\r\n    36\t    },\r\n    37\t    {\r\n    38\t      \"reference\": \"GDD §2 Floor-run restart ownership\",\r\n    39\t      \"requirement\": \"Exposes an owner-controlled reset entry point that restores player position/movement state to the floor's initial state, consumed by the Floor Run/Restart Orchestrator rather than having position mutated externally.\",\r\n    40\t      \"criterion_id\": \"AC-004\"\r\n    41\t    },\r\n    42\t    {\r\n    43\t      \"reference\": \"GDD §2 Victory/input-shutdown ownership; §4 Development Agent Ownership Invariants and final escape/victory coordination\",\r\n    44\t      \"requirement\": \"Exposes an owner-controlled gameplay-enable/suspend interface, consumed by the Game Flow/Victory capability, that immediately stops or cancels any in-progress input-driven movement (including an active click-to-destination approach), rejects new movement commands while suspended, and can be re-enabled only through an authorized reset/test flow rather than external mutation of movement internals.\",\r\n    45\t      \"criterion_id\": \"AC-005\"\r\n    46\t    }\r\n    47\t  ],\r\n    48\t  \"completion_gates\": [\r\n    49\t    {\r\n    50\t      \"reference\": \"GDD §2 Move and Aim\",\r\n    51\t      \"requirement\": \"Play Mode validation that clicking a location moves the wizard toward it and that holding steers continuously toward the live cursor position.\",\r\n    52\t      \"gate_id\": \"VAL-001\"\r\n    53\t    },\r\n    54\t    {\r\n    55\t      \"reference\": \"Victory/input-shutdown ownership\",\r\n    56\t      \"requirement\": \"Play Mode check: invoking the suspend interface while movement is active immediately halts the wizard's in-progress movement (including an active click-to-destination approach), and further movement input has no effect until an authorized re-enable/reset flow runs.\",\r\n    57\t      \"gate_id\": \"VAL-002\"\r\n    58\t    }\r\n    59\t  ],\r\n    60\t  \"downstream_integration_obligations\": [\r\n    61\t    {\r\n    62\t      \"reference\": \"GDD §2 Player Movement ownership\",\r\n    63\t      \"requirement\": \"Validate that the exposed world-space pointer target is correctly consumable by a cursor-aimed spell or Door/Interaction integration once those systems exist.\",\r\n    64\t      \"obligation_id\": \"INT-001\"\r\n    65\t    }\r\n    66\t  ],\r\n    67\t  \"gdd_evidence\": [\r\n    68\t    {\r\n    69\t      \"reference\": \"GDD §2 Player Actions and Systems — Move and Aim\",\r\n    70\t      \"requirement\": \"Mouse-directed movement through the shared Unity Input System/Input Actions layer: click to set a destination or hold to keep steering toward the cursor; Player Movement owns the shared cursor-to-gameplay-plane projection and exposes the resulting world-space pointer target consumed by movement, cursor-aimed spells, and cursor-targeted interactions (Force Wave is the exception).\"\r\n    71\t    },\r\n    72\t    {\r\n    73\t      \"reference\": \"GDD §2 Resources, Feedback, and Failure — Player Movement ownership\",\r\n    74\t      \"requirement\": \"Player Movement owns position, locomotion, movement-restriction state, and the shared cursor-to-gameplay-plane projection; runtime input is routed through Input System/Input Actions rather than direct hardware polling; Charged Fireball requests/releases its movement restriction through an owner-controlled Player Movement interface without mutating movement internals.\"\r\n    75\t    },\r\n    76\t    {\r\n    77\t      \"reference\": \"GDD §2 Loss — Floor-run restart ownership\",\r\n    78\t      \"requirement\": \"Player Movement/player position is a required reset participant invoked by the Floor Run/Restart Orchestrator through an owner-controlled reset entry point.\"\r\n    79\t    },\r\n    80\t    {\r\n    81\t      \"reference\": \"Section 2 — Victory/input-shutdown ownership bullet\",\r\n    82\t      \"requirement\": \"Player Movement, Door/Interaction, Fireball, Frost Field, and Force Wave each expose an owner-controlled gameplay-enable/suspend interface that can immediately stop or cancel their current input-driven activity, reject new gameplay commands while suspended, and be re-enabled by an authorized reset/test flow.\"\r\n    83\t    }\r\n    84\t  ],\r\n    85\t  \"basis\": \"direct_gdd\",\r\n    86\t  \"source_scope\": \"required\",\r\n    87\t  \"confidence\": \"high\",\r\n    88\t  \"notes\": \"Exact movement speed/feel tuning is left to playtesting per GDD and is not part of this item's required acceptance surface.\",\r\n    89\t  \"repository_state_at_bootstrap\": \"partial\",\r\n    90\t  \"repository_evidence_at_bootstrap\": [\r\n    91\t    {\r\n    92\t      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerMovement.cs\",\r\n    93\t      \"evidence_type\": \"code\",\r\n    94\t      \"observation\": \"Implements only CharacterController-driven WASD movement via direct Keyboard.current polling; no mouse-directed movement, cursor projection, movement-restriction interface, or reset entry point exist.\"\r\n    95\t    },\r\n    96\t    {\r\n    97\t      \"path\": \"Assets/InputSystem_Actions.inputactions\",\r\n    98\t      \"evidence_type\": \"project_setting\",\r\n    99\t      \"observation\": \"Unmodified stock Unity template action asset; Player map has only WASD/Dpad Move and button actions (Attack/Interact/Crouch/Jump/etc.), no cursor-to-gameplay-plane or click-to-move action, and PlayerMovement.cs does not reference it.\"\r\n   100\t    },\r\n   101\t    {\r\n   102\t      \"path\": \"Assets/NoSafeCircle/DoorPrototype/Scenes/DoorPrototype.unity\",\r\n   103\t      \"evidence_type\": \"scene\",\r\n   104\t      \"observation\": \"PlayerMovement.cs (guid 356044e6782dd0641a7e69b0abfa5c4a) is serialized on the Player GameObject, confirming current WASD movement is the integrated state, not merely available via the builder.\"\r\n   105\t    }\r\n   106\t  ],\r\n   107\t  \"provenance\": {\r\n   108\t    \"origin\": \"verified_reconciliation_bootstrap\",\r\n   109\t    \"source_schema_version\": \"1.0\",\r\n   110\t    \"reconciliation_run_id\": \"20260821T193541Z-998ee7b5\",\r\n   111\t    \"verification_run_id\": \"20260821T195959Z-43dba5de\",\r\n   112\t    \"bootstrap_status_observation\": \"open\",\r\n   113\t    \"migration_id\": \"task-contract-schema-v2-20260822-r2\"\r\n   114\t  }\r\n   115\t}\r\nNSC-007\tCharged Fireball\tNSC-003,NSC-012\nNSC-008\tFrost Field\tNSC-003,NSC-013\nNSC-019\tCursor-Targeted Door Opening (Click-to-Approach, Arm's-Reach Auto-Timer, Interruption)\tNSC-003\nNSC-032\tFloor Run/Restart Bootstrap (Current-Owner Stage)\tNSC-004,NSC-005,NSC-003,NSC-019\nNSC-033\tFloor Run/Restart Persistent-Systems Closure\tNSC-032,NSC-004,NSC-005,NSC-003,NSC-019,NSC-020,NSC-021,NSC-012,NSC-014,NSC-013,NSC-011,NSC-028,NSC-007,NSC-008,NSC-009,NSC-015,NSC-016,NSC-017\nNSC-035\tFinal Escape / Victory (Game Flow/Victory Capability)\tNSC-020,NSC-003,NSC-019,NSC-007,NSC-008,NSC-009\n","exit_code":0,"status":"completed"}}
