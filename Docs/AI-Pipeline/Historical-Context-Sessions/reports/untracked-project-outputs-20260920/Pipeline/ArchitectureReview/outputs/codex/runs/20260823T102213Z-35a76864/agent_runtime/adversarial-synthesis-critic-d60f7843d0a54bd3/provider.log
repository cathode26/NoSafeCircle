       f\"{task_id} has invalid contract_disposition: {disposition!r}\"\r\n   176\t        )\r\n   177\t\r\n   178\t    superseded_by = str(task.get(\"superseded_by\") or \"\").strip()\r\n   179\t    if disposition == \"superseded\" and not superseded_by:\r\n   180\t        raise WorkGraphValidationError(\r\n   181\t            f\"Superseded task {task_id} must identify superseded_by.\"\r\n   182\t        )\r\n   183\t    if disposition != \"superseded\" and superseded_by:\r\n   184\t        raise WorkGraphValidationError(\r\n   185\t            f\"{task_id}.superseded_by is only valid when contract_disposition='superseded'.\"\r\n   186\t        )\r\n   187\t\r\n   188\t    for field in ENTRY_ID_PATTERNS:\r\n   189\t        _validate_numbered_entries(task_id, task, field)\r\n   190\t\r\n   191\t    provenance = task.get(\"provenance\")\r\n   192\t    if not isinstance(provenance, dict):\r\n   193\t        raise WorkGraphValidationError(f\"{task_id}.provenance must be an object.\")\r\n   194\t    origin = _require_non_empty_text(provenance.get(\"origin\"), f\"{task_id}.provenance.origin\")\r\n   195\t    if origin == \"verified_reconciliation_bootstrap\":\r\n   196\t        _require_non_empty_text(\r\n   197\t            provenance.get(\"reconciliation_run_id\"),\r\n   198\t            f\"{task_id}.provenance.reconciliation_run_id\",\r\n   199\t        )\r\n   200\t        _require_non_empty_text(\r\n   201\t            provenance.get(\"verification_run_id\"),\r\n   202\t            f\"{task_id}.provenance.verification_run_id\",\r\n   203\t        )\r\n   204\t    observed_status = provenance.get(\"bootstrap_status_observation\")\r\n   205\t    if observed_status is not None and observed_status not in LEGACY_BOOTSTRAP_STATUSES:\r\n   206\t        raise WorkGraphValidationError(\r\n   207\t            f\"{task_id}.provenance.bootstrap_status_observation is invalid: {observed_status!r}\"\r\n   208\t        )\r\n   209\t\r\n   210\t\r\n   211\tdef validate_work_graph_plan(plan: Any) -> WorkGraphValidationSummary:\r\n   212\t    if not plan.tasks:\r\n   213\t        raise WorkGraphValidationError(\"Work graph contains no tasks.\")\r\n   214\t    if len(plan.id_map) != len(plan.tasks):\r\n   215\t        raise WorkGraphValidationError(\r\n   216\t            f\"ID map/task count mismatch: id_map={len(plan.id_map)}, tasks={len(plan.tasks)}\"\r\n   217\t        )\r\n   218\t\r\n   219\t    schema_version = _task_schema_version(plan.tasks)\r\n   220\t    tasks_by_id: dict[str, dict[str, Any]] = {}\r\n   221\t    tasks_by_key: dict[str, dict[str, Any]] = {}\r\n   222\t\r\n   223\t    for index, task in enumerate(plan.tasks):\r\n   224\t        if not isinstance(task, dict):\r\n   225\t            raise WorkGraphValidationError(f\"tasks[{index}] is not an object.\")\r\n    55\t    value = payload.get(field)\r\n    56\t    if not isinstance(value, str) or not value.strip():\r\n    57\t        raise PersistentWorkGraphError(f\"{label}.{field} must be a non-empty string.\")\r\n    58\t    return value.strip()\r\n    59\t\r\n    60\t\r\n    61\tdef _validate_bootstrap_marker(marker: dict[str, Any], root: Path) -> None:\r\n    62\t    if marker.get(\"schema_version\") != \"1.0\":\r\n    63\t        raise PersistentWorkGraphError(\r\n    64\t            f\"Unsupported bootstrap marker schema: {marker.get('schema_version')!r}\"\r\n    65\t        )\r\n    66\t    if marker.get(\"bootstrap_status\") != \"complete\":\r\n    67\t        raise PersistentWorkGraphError(\r\n    68\t            f\"Persistent graph bootstrap is not complete: {marker.get('bootstrap_status')!r}\"\r\n    69\t        )\r\n    70\t    if marker.get(\"serialization_format\") != SERIALIZATION_FORMAT:\r\n    71\t        raise PersistentWorkGraphError(\r\n    72\t            \"Unsupported persistent graph serialization format: \"\r\n    73\t            f\"{marker.get('serialization_format')!r}\"\r\n    74\t        )\r\n    75\t\r\n    76\t    baseline_hashes = marker.get(\"output_sha256\")\r\n    77\t    if not isinstance(baseline_hashes, dict) or not baseline_hashes:\r\n    78\t        raise PersistentWorkGraphError(\"Bootstrap marker is missing output_sha256 baseline entries.\")\r\n    79\t\r\n    80\t    # These hashes preserve historical bootstrap identity. Live contract bytes\r\n    81\t    # legitimately change during approved schema migrations and later contract\r\n    82\t    # revisions, so the loader requires the original paths to remain present but\r\n    83\t    # does not compare current bytes with the old bootstrap hashes.\r\n    84\t    root_resolved = root.resolve()\r\n    85\t    for relative_path in baseline_hashes:\r\n    86\t        if not isinstance(relative_path, str) or not relative_path.strip():\r\n    87\t            raise PersistentWorkGraphError(\"Bootstrap marker contains an invalid baseline path.\")\r\n    88\t        candidate = (root_resolved / relative_path).resolve()\r\n    89\t        try:\r\n    90\t            candidate.relative_to(root_resolved)\r\n    91\t        except ValueError as exc:\r\n    92\t            raise PersistentWorkGraphError(\r\n    93\t                f\"Bootstrap baseline path escapes repository root: {relative_path!r}\"\r\n    94\t            ) from exc\r\n    95\t        if not candidate.is_file():\r\n    96\t            raise PersistentWorkGraphError(\r\n    97\t                f\"Bootstrap baseline output is missing from the live graph: {relative_path}\"\r\n    98\t            )\r\n    99\t\r\n   100\t\r\n","exit_code":0,"status":"completed"}}
