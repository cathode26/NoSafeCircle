Scripts/IsometricCameraFollow.cs\n   26 Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerHealth.cs\n   90 Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerInteractionController.cs\n   54 Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerMana.cs\n   18 Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerManaUI.cs\n   48 Assets/NoSafeCircle/DoorPrototype/Scripts/PlayerMovement.cs\n  441 total\n","exit_code":1,"status":"failed"}}
